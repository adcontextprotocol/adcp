{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "tracker-execution-contracts.schema.json",
  "title": "Tracker execution contract vectors",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "contract": { "$ref": "/schemas/core/tracker-execution-contract.json" },
          "format_slots": {
            "type": "array",
            "items": { "$ref": "/schemas/formats/canonical/_base.json#/properties/slots/items" }
          },
          "tracker": {
            "oneOf": [
              { "$ref": "/schemas/core/assets/pixel-tracker-asset.json" },
              { "$ref": "/schemas/core/assets/vast-tracker-asset.json" },
              { "$ref": "/schemas/core/assets/daast-tracker-asset.json" }
            ]
          },
          "execution_version": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": ["matched", "rejected", "undeclared"]
              },
              "selector_id": { "type": "string", "minLength": 1 },
              "rejection_code": { "type": "string", "const": "tracker_contract_mismatch" }
            },
            "required": ["status"],
            "additionalProperties": false
          }
        },
        "required": ["name", "contract", "format_slots", "tracker", "expected"],
        "additionalProperties": false
      }
    },
    "derivation_vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "parent": { "$ref": "/schemas/core/tracker-execution-contract.json" },
          "child": { "$ref": "/schemas/core/tracker-execution-contract.json" },
          "expected_valid": { "type": "boolean" }
        },
        "required": ["name", "parent", "child", "expected_valid"],
        "additionalProperties": false
      }
    },
    "package_snapshot": {
      "$ref": "/schemas/core/package-format-snapshot.json"
    }
  },
  "required": ["vectors", "derivation_vectors", "package_snapshot"],
  "additionalProperties": false
}
