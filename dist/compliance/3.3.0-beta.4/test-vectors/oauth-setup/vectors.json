{
  "title": "OAuth setup metadata-graph conformance vectors",
  "description": "Deterministic network fixtures for runner implementations of the oauth_metadata_graph check. Hosts and organizations are fictional. No request may escape the fixture response map.",
  "fixture_contract": {
    "responses": "Exact METHOD URL keys. A request missing from the map fails closed; token endpoint probes use credential-free GET under the passive transport-reachability policy from the runner contract.",
    "dns": "Optional hostname fixtures declare all resolved addresses, lookup sequences, or the connected peer address. Implementations must inject these values rather than consult live DNS. When fixture_address_classes is present, it is index-aligned with addresses and is the authoritative test-double classification: globally_routable_fixture_only must pass pre-connect address classification, while named blocked classes (for example private) must fail it. The literal address remains documentation-safe and must not be reclassified from the live IANA registry in that case.",
    "redirects": "A fixture response may carry headers.location. Redirect targets are validated before lookup or request and consume graph budgets.",
    "network": "No live network access is permitted while executing this corpus."
  },
  "evaluation_order": [
    "protected_resource_document",
    "resource_identifier",
    "authorization_servers_shape",
    "authorization_server_document_in_array_order",
    "issuer_self_consistency",
    "rfc8414_required_and_conditional_fields",
    "endpoint_url_shape",
    "authorization_endpoint_reachability",
    "token_endpoint_reachability",
    "jwks_document"
  ],
  "positive": [
    {
      "id": "001-same-origin-complete",
      "coverage": ["complete_graph", "same_origin_authorization_server", "advertised_jwks"],
      "agent_url": "https://agent.example.com/mcp",
      "responses": {
        "GET https://agent.example.com/.well-known/oauth-protected-resource/mcp": {
          "status": 200,
          "content_type": "application/json",
          "json": {
            "resource": "https://agent.example.com/mcp",
            "authorization_servers": ["https://agent.example.com"],
            "bearer_methods_supported": ["header"]
          }
        },
        "GET https://agent.example.com/.well-known/oauth-authorization-server": {
          "status": 200,
          "content_type": "application/json",
          "json": {
            "issuer": "https://agent.example.com",
            "authorization_endpoint": "https://agent.example.com/authorize",
            "token_endpoint": "https://agent.example.com/token",
            "jwks_uri": "https://agent.example.com/jwks.json",
            "response_types_supported": ["code"],
            "grant_types_supported": ["authorization_code"],
            "scopes_supported": ["openid", "adcp"]
          }
        },
        "GET https://agent.example.com/authorize": {
          "status": 302,
          "content_type": "text/html"
        },
        "GET https://agent.example.com/token": {
          "status": 400,
          "content_type": "application/json"
        },
        "GET https://agent.example.com/jwks.json": {
          "status": 200,
          "content_type": "application/json",
          "json": { "keys": [] }
        }
      },
      "expected_outcome": { "success": true }
    },
