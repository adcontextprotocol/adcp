{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "date": { "type": "string", "format": "date" },
    "impressions": { "type": "string", "pattern": "^[0-9]+$" },
    "media_buy_id": { "type": "string" },
    "spend": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$" }
  },
  "required": ["date", "impressions", "media_buy_id", "spend"],
  "additionalProperties": false
}
