{
  "contract_version": "3.3",
  "feature": "media_buy.reporting_subscriptions",
  "status": "experimental",
  "description": "Seller-side offering checks an SDK runs before it enables reporting subscriptions, with the codes from error-codes.json in this directory: SUBSCRIPTIONS_REQUIRE_STANDARD_DIMENSIONS and SUBSCRIPTIONS_REQUIRE_ACCOUNT_ID_KEY. Each case gives the advertised offerings and, keyed by reporting_profile.schema_uri, the row schemas the SDK has fetched, and expected lists every failure: in offering order and, per offering, standard_dimensions, then the primary_keys part of the account_id rule, then the row-schema part. Empty expected means the offerings pass. scripts/reference/reporting-coverage/offering-checks.cjs reproduces every case, and every offering validates against core/reporting-delivery-offering.json.",
  "cases": [
    {
      "id": "managed-offering-keyed-by-account-id-passes",
      "rule": "A managed-delivery offering whose primary_keys include account_id and whose row schema declares account_id as a required string passes.",
      "spec_refs": [
        "static/schemas/source/core/reporting-delivery-offering.json#/x-adcp-validation/subscription_rows",
        "static/schemas/source/core/reporting-subscription.json#/x-adcp-validation/destination"
      ],
      "input": {
        "offerings": [
          {
            "offering_id": "off_s3_pkg",
            "feed_purpose": "analytics",
            "report_definition_id": "rd_off_s3_pkg",
            "report_definition_uri": "https://seller.example/report-definitions/off_s3_pkg.json",
            "report_definition_sha256": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
            "reporting_profile": {
              "id": "adcp.delivery.v1",
              "version": "1.0.0",
              "schema_uri": "https://seller.example/schemas/delivery.json",
              "schema_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
              "schema_dialect": "https://json-schema.org/draft/2020-12/schema",
              "schema_ref_policy": "local_fragment_only",
              "grain": "daily",
              "primary_keys": [
                "account_id",
                "package_id"
              ]
            },
            "schedule": {
              "period_duration": "P1D",
              "alignment": "utc",
              "delivery_sla": "PT6H"
            },
            "supported_finality": [
              "official"
            ],
            "reconciliation_mode": "delivery_only",
            "standard_dimensions": [
              "package"
            ],
            "method": {
              "pattern": "file_transfer",
              "transport": "s3",
              "orchestration": "producer_managed",
              "destination_modes": [
                "existing"
              ],
              "provider": {
                "domain": "seller.example"
              },
              "format": "jsonl"
            }
          }
        ],
        "row_schemas": {
          "https://seller.example/schemas/delivery.json": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "required": [
              "account_id",
              "package_id",
              "impressions"
            ],
            "properties": {
              "account_id": {
                "type": "string"
              },
              "package_id": {
                "type": "string"
              },
              "impressions": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      },
      "expected": []
    },
