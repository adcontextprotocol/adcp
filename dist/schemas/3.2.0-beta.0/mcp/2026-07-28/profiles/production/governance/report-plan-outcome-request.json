{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adcontextprotocol.org/schemas/3.2.0-beta.0/mcp/2026-07-28/profiles/production/governance/report-plan-outcome-request.json",
  "type": "object",
  "allOf": [
    {
      "$ref": "#/$defs/external:core~1version-envelope.json"
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "completed"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "required": [
          "check_id",
          "governance_context",
          "seller_response"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "failed"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "required": [
          "check_id",
          "governance_context",
          "error"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "delivery"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "required": [
          "check_id",
          "governance_context",
          "delivery"
        ]
      }
    }
  ],
  "x-status": "experimental",
  "x-mutates-state": true,
  "properties": {
    "plan_id": {
      "type": "string",
      "x-entity": "governance_plan"
    },
    "check_id": {
      "type": "string",
      "x-entity": "governance_check"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 16,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9_.:-]{16,255}$"
    },
    "purchase_type": {
      "$ref": "#/$defs/external:enums~1purchase-type.json",
      "default": "media_buy"
    },
    "outcome": {
      "$ref": "#/$defs/external:enums~1outcome-type.json"
    },
    "seller_response": {
      "type": "object",
      "properties": {
        "seller_reference": {
          "type": "string",
          "maxLength": 255
        },
        "committed_budget": {
          "type": "number",
          "minimum": 0
        },
        "packages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "budget": {
                "type": "number",
                "minimum": 0
              }
            },
            "additionalProperties": true
          }
        },
        "planned_delivery": {
          "$ref": "#/$defs/external:core~1planned-delivery.json"
        },
        "creative_deadline": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": true
    },
    "delivery": {
      "type": "object",
      "properties": {
        "observation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "x-entity": "governance_delivery_observation"
        },
        "source": {
          "type": "string",
          "enum": [
            "seller_statement_copy",
            "buyer_measurement"
          ]
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "seller_statement_id": {
          "type": "string",
          "x-entity": "governance_delivery_statement"
        },
        "seller_statement_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "reporting_period": {
          "type": "object",
          "properties": {
            "start": {
              "type": "string",
              "format": "date-time"
            },
            "end": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "start",
            "end"
          ],
          "additionalProperties": false
        },
        "cumulative_spend": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "period_closed": {
          "type": "boolean",
          "default": false
        },
        "impressions": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "observation_id",
        "source",
        "observed_at",
        "reporting_period",
        "cumulative_spend",
        "currency"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "seller_statement_copy"
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {
            "required": [
              "seller_statement_id",
              "seller_statement_digest"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "governance_context": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[\\x20-\\x7E]+$"
    },
    "context": {
      "$ref": "#/$defs/external:core~1context.json"
    },
    "ext": {
      "$ref": "#/$defs/external:core~1ext.json"
    }
  },
  "required": [
    "idempotency_key",
    "plan_id",
    "outcome"
  ],
  "additionalProperties": true,
  "$defs": {
    "external:core/version-envelope.json": {
      "type": "object",
      "properties": {
        "adcp_version": {
          "type": "string",
          "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-[a-zA-Z0-9](?:[a-zA-Z0-9.-]*[a-zA-Z0-9])?)?$"
        },
        "adcp_major_version": {
          "type": "integer",
          "deprecated": true,
          "minimum": 1,
          "maximum": 99
        }
      }
    },
    "external:enums/purchase-type.json": {
      "type": "string",
      "enum": [
        "media_buy",
        "rights_license",
        "signal_activation",
        "creative_services"
      ]
    },
    "external:enums/outcome-type.json": {
      "type": "string",
      "enum": [
        "completed",
        "failed",
        "delivery"
      ]
    },
    "external:core/planned-delivery.json": {
      "type": "object",
      "properties": {
        "media_buy_id": {
          "type": "string",
          "minLength": 1,
          "x-entity": "media_buy"
        },
        "proposal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "x-entity": "proposal"
        },
        "proposal_terms_digest": {
          "type": "string",
          "pattern": "^sha256:[A-Za-z0-9_-]{43}$"
        },
        "geo": {
          "type": "object",
          "properties": {
            "countries": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "regions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": true
        },
        "channels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/external:enums~1channels.json"
          }
        },
        "start_time": {
          "type": "string",
          "format": "date-time"
        },
        "end_time": {
          "type": "string",
          "format": "date-time"
        },
        "frequency_cap": {
          "$ref": "#/$defs/external:core~1frequency-cap.json"
        },
        "audience_summary": {
          "type": "string"
        },
        "audience_targeting": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/external:core~1audience-selector.json"
          },
          "minItems": 1
        },
        "total_budget": {
          "type": "number",
          "minimum": 0
        },
        "daily_budget_cap": {
          "type": "number",
          "minimum": 0
        },
        "budget_cap_timezone": {
          "type": "string"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "budget_allocation": {
          "allOf": [
            {
              "$ref": "#/$defs/external:core~1budget-allocation.json"
            }
          ]
        },
        "pacing": {
          "$ref": "#/$defs/external:enums~1pacing.json"
        },
        "bidding": {
          "allOf": [
            {
              "$ref": "#/$defs/external:core~1bidding-policy.json"
            }
          ]
        },
        "enforced_policies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ext": {
          "$ref": "#/$defs/external:core~1ext.json"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "proposal_id"
            ]
          },
          "then": {
            "required": [
              "proposal_terms_digest"
            ]
          }
        },
        {
          "if": {
            "required": [
              "proposal_terms_digest"
            ]
          },
          "then": {
            "required": [
              "proposal_id"
            ]
          }
        }
      ],
      "additionalProperties": true
    },
    "external:enums/channels.json": {
      "type": "string",
      "enum": [
        "display",
        "olv",
        "social",
        "search",
        "ctv",
        "linear_tv",
        "radio",
        "streaming_audio",
        "podcast",
        "dooh",
        "ooh",
        "print",
        "cinema",
        "email",
        "gaming",
        "retail_media",
        "influencer",
        "affiliate",
        "product_placement",
        "sponsored_intelligence"
      ]
    },
    "external:core/frequency-cap.json": {
      "type": "object",
      "properties": {
        "suppress": {
          "allOf": [
            {
              "$ref": "#/$defs/external:core~1duration.json"
            }
          ]
        },
        "suppress_minutes": {
          "type": "number",
          "deprecated": true,
          "minimum": 0
        },
        "max_impressions": {
          "type": "integer",
          "minimum": 1
        },
        "per": {
          "allOf": [
            {
              "$ref": "#/$defs/external:enums~1reach-unit.json"
            }
          ]
        },
        "window": {
          "allOf": [
            {
              "$ref": "#/$defs/external:core~1duration.json"
            }
          ]
        }
      },
      "anyOf": [
        {
          "required": [
            "suppress"
          ]
        },
        {
          "required": [
            "suppress_minutes"
          ]
        },
        {
          "required": [
            "max_impressions"
          ]
        }
      ],
      "additionalProperties": true,
      "dependentRequired": {
        "max_impressions": [
          "per",
          "window"
        ],
        "per": [
          "max_impressions"
        ],
        "window": [
          "max_impressions"
        ]
      }
    },
    "external:core/duration.json": {
      "type": "object",
      "properties": {
        "interval": {
          "type": "integer",
          "minimum": 1
        },
        "unit": {
          "type": "string",
          "enum": [
            "seconds",
            "minutes",
            "hours",
            "days",
            "campaign"
          ]
        }
      },
      "required": [
        "interval",
        "unit"
      ],
      "additionalProperties": false
    },
    "external:enums/reach-unit.json": {
      "type": "string",
      "enum": [
        "individuals",
        "households",
        "devices",
        "accounts",
        "cookies",
        "custom"
      ]
    },
    "external:core/audience-selector.json": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "signal"
            },
            "signal_ref": {
              "$ref": "#/$defs/external:core~1signal-ref.json"
            },
            "signal_id": {
              "$ref": "#/$defs/external:core~1signal-id.json",
              "deprecated": true
            },
            "value_type": {
              "type": "string",
              "const": "binary"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "value_type",
            "value"
          ],
          "anyOf": [
            {
              "required": [
                "signal_ref"
              ]
            },
            {
              "required": [
                "signal_id"
              ]
            }
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "signal"
            },
            "signal_ref": {
              "$ref": "#/$defs/external:core~1signal-ref.json"
            },
            "signal_id": {
              "$ref": "#/$defs/external:core~1signal-id.json",
              "deprecated": true
            },
            "value_type": {
              "type": "string",
              "const": "categorical"
            },
            "values": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          },
          "required": [
            "type",
            "value_type",
            "values"
          ],
          "anyOf": [
            {
              "required": [
                "signal_ref"
              ]
            },
            {
              "required": [
                "signal_id"
              ]
            }
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "signal"
            },
            "signal_ref": {
              "$ref": "#/$defs/external:core~1signal-ref.json"
            },
            "signal_id": {
              "$ref": "#/$defs/external:core~1signal-id.json",
              "deprecated": true
            },
            "value_type": {
              "type": "string",
              "const": "numeric"
            },
            "min_value": {
              "type": "number"
            },
            "max_value": {
              "type": "number"
            }
          },
          "required": [
            "type",
            "value_type"
          ],
          "anyOf": [
            {
              "required": [
                "signal_ref"
              ]
            },
            {
              "required": [
                "signal_id"
              ]
            }
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "description"
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "category": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "description"
          ],
          "additionalProperties": true
        }
      ]
    },
    "external:core/signal-ref.json": {
      "x-entity": "signal",
      "discriminator": {
        "propertyName": "scope"
      },
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "scope": {
              "type": "string",
              "const": "product"
            },
            "signal_id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]+$"
            }
          },
          "required": [
            "scope",
            "signal_id"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "data_provider_domain"
                ]
              },
              {
                "required": [
                  "signal_source_url"
                ]
              },
              {
                "required": [
                  "agent_url"
                ]
              },
              {
                "required": [
                  "source"
                ]
              },
              {
                "required": [
                  "id"
                ]
              }
            ]
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "scope": {
              "type": "string",
              "const": "data_provider"
            },
            "data_provider_domain": {
              "type": "string",
              "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$"
            },
            "signal_id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]+$"
            }
          },
          "required": [
            "scope",
            "data_provider_domain",
            "signal_id"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "agent_url"
                ]
              },
              {
                "required": [
                  "signal_source_url"
                ]
              },
              {
                "required": [
                  "source"
                ]
              },
              {
                "required": [
                  "id"
                ]
              }
            ]
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "scope": {
              "type": "string",
              "const": "signal_source"
            },
            "signal_source_url": {
              "type": "string",
              "format": "uri"
            },
            "signal_id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]+$"
            }
          },
          "required": [
            "scope",
            "signal_source_url",
            "signal_id"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "data_provider_domain"
                ]
              },
              {
                "required": [
                  "agent_url"
                ]
              },
              {
                "required": [
                  "source"
                ]
              },
              {
                "required": [
                  "id"
                ]
              }
            ]
          },
          "additionalProperties": true
        }
      ]
    },
    "external:core/signal-id.json": {
      "deprecated": true,
      "x-entity": "signal",
      "discriminator": {
        "propertyName": "source"
      },
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "const": "catalog"
            },
            "data_provider_domain": {
              "type": "string",
              "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$"
            },
            "id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]+$"
            }
          },
          "required": [
            "source",
            "data_provider_domain",
            "id"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "const": "agent"
            },
            "agent_url": {
              "type": "string",
              "format": "uri"
            },
            "id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]+$"
            }
          },
          "required": [
            "source",
            "agent_url",
            "id"
          ],
          "additionalProperties": true
        }
      ]
    },
    "external:core/budget-allocation.json": {
      "x-adcp-hoist": true,
      "discriminator": {
        "propertyName": "mode"
      },
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "fixed"
            }
          },
          "required": [
            "mode"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "seller_optimized"
            },
            "optimization_goals": {
              "type": "array",
              "items": {
                "allOf": [
                  {
                    "$ref": "#/$defs/external:core~1optimization-goal.json"
                  },
                  {
                    "not": {
                      "properties": {
                        "target": {
                          "properties": {
                            "kind": {
                              "enum": [
                                "cost_per",
                                "per_ad_spend"
                              ]
                            }
                          },
                          "required": [
                            "kind"
                          ]
                        }
                      },
                      "required": [
                        "target"
                      ]
                    }
                  }
                ]
              },
              "minItems": 1
            }
          },
          "required": [
            "mode",
            "optimization_goals"
          ],
          "additionalProperties": false
        }
      ]
    },
    "external:core/optimization-goal.json": {
      "discriminator": {
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "metric"
            },
            "metric": {
              "type": "string",
              "enum": [
                "clicks",
                "views",
                "completed_views",
                "viewed_seconds",
                "attention_seconds",
                "attention_score",
                "engagements",
                "follows",
                "saves",
                "profile_visits",
                "reach"
              ]
            },
            "reach_unit": {
              "allOf": [
                {
                  "$ref": "#/$defs/external:enums~1reach-unit.json"
                }
              ]
            },
            "target_frequency": {
              "type": "object",
              "properties": {
                "min": {
                  "type": "integer",
                  "minimum": 1
                },
                "max": {
                  "type": "integer",
                  "minimum": 1
                },
                "window": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/external:core~1duration.json"
                    }
                  ]
                }
              },
              "required": [
                "window"
              ],
              "anyOf": [
                {
                  "required": [
                    "min"
                  ]
                },
                {
                  "required": [
                    "max"
                  ]
                }
              ],
              "additionalProperties": true
            },
            "view_duration_seconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "target": {
              "discriminator": {
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "type": "object",
                  "deprecated": true,
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "cost_per"
                    },
                    "value": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  },
                  "required": [
                    "kind",
                    "value"
                  ],
                  "additionalProperties": true
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "threshold_rate"
                    },
                    "value": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  },
                  "required": [
                    "kind",
                    "value"
                  ],
                  "additionalProperties": true
                }
              ]
            },
            "priority": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "kind",
            "metric"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
