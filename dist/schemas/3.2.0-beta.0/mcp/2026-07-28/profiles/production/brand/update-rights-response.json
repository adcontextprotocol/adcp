    "external:core/attestation-reference.json": {
      "type": "object",
      "properties": {
        "issuer": {
          "$ref": "#/$defs/external:core~1attestation-issuer.json"
        },
        "claim_type": {
          "type": "string",
          "format": "uri"
        },
        "subject": {
          "$ref": "#/$defs/external:core~1attestation-subject.json"
        },
        "locator": {
          "discriminator": {
            "propertyName": "type"
          },
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "credential_uri"
                },
                "credential_uri": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://[^/?#@]+(?:/[^?#]*)?(?:\\?[^#]*)?$"
                },
                "ext": {
                  "$ref": "#/$defs/external:core~1ext.json"
                }
              },
              "required": [
                "type",
                "credential_uri"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "issuer_credential_id"
                },
                "credential_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024,
                  "x-entity": "attestation_credential"
                },
                "resolver_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255,
                  "pattern": "^[A-Za-z0-9._:-]+$"
                },
                "ext": {
                  "$ref": "#/$defs/external:core~1ext.json"
                }
              },
              "required": [
                "type",
                "credential_id",
                "resolver_id"
              ],
              "additionalProperties": false
            }
          ]
        },
        "embedded_credential": {
          "type": "object",
          "properties": {
            "format": {
              "type": "string",
              "format": "uri"
            },
            "value": {
              "type": [
                "object",
                "string"
              ],
              "minLength": 1
            },
            "ext": {
              "$ref": "#/$defs/external:core~1ext.json"
            }
          },
          "required": [
            "format",
            "value"
          ],
          "additionalProperties": false
        },
        "content_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "credential_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "validity_hint": {
          "type": "object",
          "properties": {
            "not_before": {
              "type": "string",
              "format": "date-time"
            },
            "expires_at": {
              "type": "string",
              "format": "date-time"
            }
          },
          "additionalProperties": false,
          "minProperties": 1
        },
        "verify_agent": {
          "type": "object",
          "properties": {
            "agent_url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://[^/?#@]+(?:/[^?#]*)?(?:\\?[^#]*)?$"
            }
          },
          "required": [
            "agent_url"
          ],
          "additionalProperties": false
        },
        "ext": {
          "$ref": "#/$defs/external:core~1ext.json"
        }
      },
      "required": [
        "issuer",
        "claim_type",
        "subject"
      ],
      "anyOf": [
        {
          "required": [
            "locator"
          ]
        },
        {
          "required": [
            "embedded_credential"
          ]
        }
      ],
      "allOf": [
        {
          "if": {
            "required": [
              "locator",
              "embedded_credential"
            ]
          },
          "then": {
            "required": [
              "content_digest"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
