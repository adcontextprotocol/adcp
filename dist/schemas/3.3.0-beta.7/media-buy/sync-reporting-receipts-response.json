{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://adcontextprotocol.org/schemas/3.3.0-beta.7/media-buy/sync-reporting-receipts-response.json",
  "title": "Sync Reporting Receipts Response",
  "x-status": "experimental",
  "description": "Per-receipt durable recording results for revisions and post-official adjustments. Successful readback lets a consumer prove the seller recorded its reconciliation outcome; failed results expose no cross-caller or cross-account resource metadata.",
  "type": "object",
  "allOf": [
    {
      "$ref": "https://adcontextprotocol.org/schemas/3.3.0-beta.7/core/protocol-envelope.json"
    }
  ],
  "properties": {
    "status": {
      "type": "string",
      "const": "completed",
      "description": "Receipt batches complete synchronously with one result per submitted receipt."
    },
    "results": {
      "type": "array",
      "items": {
        "description": "A result carries a receipt or an adjustment receipt, never both, and a failed result carries neither.",
        "anyOf": [
          {
            "title": "Recorded reporting receipt",
            "type": "object",
            "properties": {
              "result": {
                "type": "string",
                "const": "recorded"
              },
              "receipt": {
                "allOf": [
                  {
                    "$ref": "https://adcontextprotocol.org/schemas/3.3.0-beta.7/core/reporting-receipt.json"
                  },
                  {
                    "required": [
                      "received_at"
                    ]
                  }
                ]
              }
            },
            "required": [
              "result",
              "receipt"
            ],
            "not": {
              "required": [
                "adjustment_receipt"
              ]
            },
            "additionalProperties": true
          },
          {
            "title": "Unchanged reporting receipt",
            "type": "object",
            "properties": {
              "result": {
                "type": "string",
                "const": "unchanged"
              },
              "receipt": {
                "allOf": [
                  {
                    "$ref": "https://adcontextprotocol.org/schemas/3.3.0-beta.7/core/reporting-receipt.json"
                  },
                  {
                    "required": [
                      "received_at"
                    ]
                  }
                ]
              }
            },
            "required": [
              "result",
              "receipt"
            ],
            "not": {
              "required": [
                "adjustment_receipt"
              ]
            },
            "additionalProperties": true
          },
          {
            "title": "Recorded reporting adjustment receipt",
            "type": "object",
            "properties": {
              "result": {
                "type": "string",
                "const": "recorded"
              },
              "adjustment_receipt": {
                "allOf": [
                  {
                    "$ref": "https://adcontextprotocol.org/schemas/3.3.0-beta.7/core/reporting-adjustment-receipt.json"
                  },
                  {
                    "required": [
                      "received_at"
                    ]
                  }
                ]
              }
            },
            "required": [
              "result",
              "adjustment_receipt"
            ],
            "not": {
              "required": [
                "receipt"
              ]
            },
            "additionalProperties": true
          },
          {
            "title": "Unchanged reporting adjustment receipt",
            "type": "object",
            "properties": {
              "result": {
                "type": "string",
                "const": "unchanged"
              },
              "adjustment_receipt": {
                "allOf": [
                  {
                    "$ref": "https://adcontextprotocol.org/schemas/3.3.0-beta.7/core/reporting-adjustment-receipt.json"
                  },
                  {
                    "required": [
                      "received_at"
                    ]
                  }
                ]
              }
            },
            "required": [
              "result",
              "adjustment_receipt"
            ],
            "not": {
              "required": [
                "receipt"
              ]
            },
            "additionalProperties": true
          },
          {
            "title": "Failed reporting receipt",
            "type": "object",
            "properties": {
              "result": {
                "type": "string",
                "const": "failed"
              },
              "reporting_receipt_id": {
                "type": "string",
                "minLength": 16,
                "maxLength": 255,
                "pattern": "^[A-Za-z0-9_.:-]{16,255}$",
                "x-entity": "reporting_receipt"
              },
              "errors": {
                "type": "array",
                "items": {
                  "$ref": "https://adcontextprotocol.org/schemas/3.3.0-beta.7/core/error.json"
                },
                "minItems": 1,
                "maxItems": 16
              }
            },
            "required": [
              "result",
              "reporting_receipt_id",
              "errors"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "receipt"
                  ]
                },
                {
                  "required": [
                    "adjustment_receipt"
                  ]
                }
              ]
            },
            "additionalProperties": true
          }
        ]
      },
      "minItems": 1,
      "maxItems": 100
    },
    "context": {
      "$ref": "https://adcontextprotocol.org/schemas/3.3.0-beta.7/core/context.json"
    },
    "ext": {
      "$ref": "https://adcontextprotocol.org/schemas/3.3.0-beta.7/core/ext.json"
    }
  },
  "required": [
    "status",
    "results"
  ],
  "additionalProperties": true
}
