          "x-added-in": "3.3.0"
        },
        "special": {
          "$ref": "https://adcontextprotocol.org/schemas/3.3.0-beta.1/mcp/2026-07-28/profiles/media-buy/media-buy/list-collections-response.json#/$defs/external:core~1special.json"
        },
        "limited_series": {
          "$ref": "https://adcontextprotocol.org/schemas/3.3.0-beta.1/mcp/2026-07-28/profiles/media-buy/media-buy/list-collections-response.json#/$defs/external:core~1limited-series.json"
        },
        "distribution": {
          "type": "array",
          "items": {
            "$ref": "https://adcontextprotocol.org/schemas/3.3.0-beta.1/mcp/2026-07-28/profiles/media-buy/media-buy/list-collections-response.json#/$defs/external:core~1collection-distribution.json"
          }
        },
        "deadline_policy": {
          "$ref": "https://adcontextprotocol.org/schemas/3.3.0-beta.1/mcp/2026-07-28/profiles/media-buy/media-buy/list-collections-response.json#/$defs/external:core~1deadline-policy.json"
