      "required": [
        "outcome",
        "collections",
        "collections_version",
        "cache_scope"
      ]
    },
    {
      "properties": {
        "outcome": {
          "type": "string",
          "const": "unchanged"
        }
      },
      "required": [
        "outcome",
        "collections_version",
        "cache_scope"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "collections"
            ]
          },
          {
            "required": [
              "pagination"
            ]
          }
        ]
      }
    }
  ],
  "additionalProperties": false,
