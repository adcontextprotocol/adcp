{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://adcontextprotocol.org/schemas/3.3.0-beta.1/media-buy/report-media-buy-issue-request.json",
  "title": "Report Media Buy Issue Request",
  "x-added-in": "3.3.0",
  "description": "Raise a seller-action report against an authorized media buy, optionally scoped to a package or creative. Completion of this task means the report was stored, not human acknowledgement or resolution. Reporting does not pause a buy or remove a creative. Requires advertised media_buy.issue_reporting and a matching available_actions entry.",
  "x-tool-summary": "Report urgent seller-side delivery, creative, safety, or tracking issues.",
  "x-mutates-state": true,
  "x-operation-family": "report_media_buy_issue",
  "x-legacy-fallback": {
    "mode": "none"
  },
  "type": "object",
  "properties": {
    "adcp_version": {
      "$ref": "https://adcontextprotocol.org/schemas/3.3.0-beta.1/core/version-envelope.json#/properties/adcp_version"
    },
    "adcp_major_version": {
      "$ref": "https://adcontextprotocol.org/schemas/3.3.0-beta.1/core/version-envelope.json#/properties/adcp_major_version"
    },
    "account": {
      "$ref": "https://adcontextprotocol.org/schemas/3.3.0-beta.1/core/canonical-account-ref.json"
    },
    "media_buy_id": {
      "type": "string",
      "minLength": 1,
      "x-entity": "media_buy"
    },
    "context": {
      "$ref": "https://adcontextprotocol.org/schemas/3.3.0-beta.1/core/context.json"
    },
    "ext": {
      "$ref": "https://adcontextprotocol.org/schemas/3.3.0-beta.1/core/ext.json"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 16,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9_.:-]{16,255}$"
    },
    "package_id": {
      "type": "string",
      "minLength": 1,
      "x-entity": "package"
    },
    "creative_id": {
      "type": "string",
      "minLength": 1,
      "x-entity": "creative"
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "warning"
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "malicious_creative",
        "wrong_creative",
        "brand_safety",
        "tracking",
        "delivery",
        "other"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "governance_context": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "push_notification_config": {
      "$ref": "https://adcontextprotocol.org/schemas/3.3.0-beta.1/core/push-notification-config.json",
      "description": "Uniform SDK envelope field. Does not subscribe to issue state changes; use get_media_buy_issue to observe acknowledgement and resolution."
    }
  },
  "required": [
    "idempotency_key",
    "account",
    "media_buy_id",
    "severity",
    "category",
    "description"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "$ref": "https://adcontextprotocol.org/schemas/3.3.0-beta.1/core/version-envelope.json"
    }
  ]
}
