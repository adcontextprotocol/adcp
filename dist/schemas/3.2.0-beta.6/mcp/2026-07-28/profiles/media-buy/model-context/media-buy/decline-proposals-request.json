{
  "type": "object",
  "properties": {
    "adcp_version": {
      "$ref": "#/$defs/external:core~1version-envelope.json/properties/adcp_version"
    },
    "adcp_major_version": {
      "$ref": "#/$defs/external:core~1version-envelope.json/properties/adcp_major_version"
    },
    "context_id": {
      "type": "string"
    },
    "context": {
      "allOf": [
        {
          "$ref": "#/$defs/external:core~1context.json"
        }
      ]
    },
    "governance_context": {
      "type": "string"
    },
    "push_notification_config": {
      "allOf": [
        {
          "$ref": "#/$defs/external:core~1push-notification-config.json"
        }
      ]
    },
    "idempotency_key": {
      "type": "string"
    },
    "declines": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/external:media-buy~1proposal-decline.json"
      }
    },
    "opportunity": {
      "$ref": "#/$defs/external:core~1opportunity-context.json"
    }
  },
  "required": [
    "idempotency_key",
    "declines"
  ],
  "$defs": {
    "external:core/version-envelope.json": {
      "type": "object",
      "properties": {
        "adcp_version": {
          "type": "string"
        },
        "adcp_major_version": {
          "type": "integer"
        }
      }
    },
    "external:core/context.json": {
      "type": "object",
      "additionalProperties": true
    },
    "external:core/push-notification-config.json": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "operation_id": {
          "type": "string"
        },
        "token": {
          "type": "string"
        },
        "authentication": {
          "type": "object",
          "properties": {
            "schemes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/external:enums~1auth-scheme.json"
              }
            },
            "credentials": {
              "type": "string"
            }
          },
          "required": [
            "schemes",
            "credentials"
          ]
        }
      },
      "required": [
        "url"
      ]
    },
    "external:enums/auth-scheme.json": {
      "type": "string",
      "enum": [
        "Bearer",
        "HMAC-SHA256"
      ]
    },
    "external:media-buy/proposal-decline.json": {
      "type": "object",
      "properties": {
        "proposal_id": {
          "type": "string"
        },
        "reason": {
          "$ref": "#/$defs/external:enums~1proposal-decline-reason.json"
        },
        "detail": {
          "type": "string"
        }
      },
      "required": [
        "proposal_id",
        "reason"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "reason": {
                "const": "other"
              }
            },
            "required": [
              "reason"
            ]
          },
          "then": {
            "required": [
              "detail"
            ]
          }
        }
      ]
    },
    "external:enums/proposal-decline-reason.json": {
      "type": "string",
      "enum": [
        "price",
        "inventory_fit",
        "audience_fit",
        "creative_unsupported",
        "measurement_unsupported",
        "policy",
        "timing",
        "budget_changed",
        "selected_alternative",
        "other"
      ]
    },
    "external:core/opportunity-context.json": {
      "type": "object",
      "properties": {
        "opportunity_id": {
          "type": "string"
        },
        "phase": {
          "type": "string",
          "enum": [
            "exploratory",
            "planning",
            "active_sourcing"
          ]
        },
        "intent": {
          "type": "string",
          "enum": [
            "test",
            "speculative",
            "planning",
            "live_rfp"
          ]
        },
        "planning_horizon": {
          "$ref": "#/$defs/external:core~1date-range.json"
        },
        "response_deadline": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "closed"
          ]
        },
        "close_reason": {
          "type": "string",
          "enum": [
            "accepted_with_seller",
            "purchased_elsewhere",
            "selected_alternative",
            "not_pursued",
            "budget_changed",
            "timing_changed",
            "other"
          ]
        },
        "close_detail": {
          "type": "string"
        }
      },
      "required": [
        "opportunity_id"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "closed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "close_reason"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "close_reason"
                  ]
                },
                {
                  "required": [
                    "close_detail"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "close_reason": {
                "const": "other"
              }
            },
            "required": [
              "close_reason"
            ]
          },
          "then": {
            "required": [
              "close_detail"
            ]
          }
        }
      ]
    },
    "external:core/date-range.json": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string"
        },
        "end": {
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": true
    }
  }
}
