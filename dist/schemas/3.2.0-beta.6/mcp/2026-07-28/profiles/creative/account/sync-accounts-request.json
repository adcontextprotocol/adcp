    },
    "external:core/notification-config.json": {
      "type": "object",
      "properties": {
        "subscriber_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_.:-]{1,64}$"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "event_types": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "creative.status_changed",
              "creative.assignment_changed",
              "indicators.changed",
              "creative.purged",
              "account.status_changed",
              "product.created",
              "product.updated",
              "product.priced",
              "product.removed",
              "signal.created",
              "signal.updated",
              "signal.priced",
              "signal.removed",
              "wholesale_feed.bulk_change"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "product_payload_view": {
          "type": "string",
          "enum": [
            "canonical",
            "legacy"
          ],
          "default": "legacy"
        },
        "authentication": {
          "type": "object",
          "deprecated": true,
          "properties": {
            "schemes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/external:enums~1auth-scheme.json"
              },
              "minItems": 1,
              "maxItems": 1
            },
            "credentials": {
              "type": "string",
              "minLength": 32
            }
          },
          "required": [
            "schemes"
          ],
          "additionalProperties": false
        },
        "active": {
          "type": "boolean",
          "default": true
        },
        "ext": {
          "$ref": "#/$defs/external:core~1ext.json"
        }
      },
      "required": [
        "subscriber_id",
        "url",
        "event_types"
      ],
      "allOf": [
        {
          "if": {
            "required": [
              "product_payload_view"
            ]
          },
          "then": {
            "properties": {
              "event_types": {
                "contains": {
                  "enum": [
                    "product.created",
                    "product.updated",
                    "product.priced",
                    "product.removed"
                  ]
                }
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
