{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://adcontextprotocol.org/schemas/3.2.0-beta.6/core/catalog-item-availability-state.json",
  "title": "Catalog Item Availability State",
  "description": "Current buyer-authored availability overlay state for one requested catalog item. Results are returned in request order and identify their request position explicitly.",
  "type": "object",
  "properties": {
    "request_index": {
      "type": "integer",
      "minimum": 0,
      "description": "Zero-based index of the corresponding item_availability_queries entry."
    },
    "catalog_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "x-entity": "catalog"
    },
    "catalog_generation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "x-entity": "catalog_generation"
    },
    "item_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "x-entity": "catalog_item"
    },
    "status": {
      "type": "string",
      "enum": [
        "found",
        "failed"
      ],
      "description": "found returns current state; failed means the reference could not be read."
    },
    "availability": {
      "type": "string",
      "enum": [
        "active",
        "suppressed"
      ],
      "description": "Current buyer-authored overlay state. active does not imply seller approval or delivery eligibility."
    },
    "overlay_revision": {
      "type": "integer",
      "minimum": 0,
      "description": "Current optimistic-concurrency token. Revision 0 is the initial active state. Every applied suppress, applied restore, and automatic expiry increments it exactly once; unchanged updates, reads, and idempotent replays do not increment it."
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Current automatic expiry, present only while availability is suppressed with an expiry."
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Seller timestamp of the state represented by overlay_revision."
    },
    "errors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://adcontextprotocol.org/schemas/3.2.0-beta.6/core/catalog-item-availability-error.json"
      }
    },
    "ext": {
      "$ref": "https://adcontextprotocol.org/schemas/3.2.0-beta.6/core/ext.json"
    }
  },
  "required": [
    "request_index",
    "catalog_id",
    "catalog_generation",
    "item_id",
    "status"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "found"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "availability",
          "overlay_revision",
          "updated_at"
        ],
        "not": {
          "required": [
            "errors"
          ]
        }
      },
      "else": {
        "required": [
          "errors"
        ],
        "propertyNames": {
          "enum": [
            "request_index",
            "catalog_id",
            "catalog_generation",
            "item_id",
            "status",
            "errors"
          ]
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "availability"
              ]
            },
            {
              "required": [
                "overlay_revision"
              ]
            },
            {
              "required": [
                "expires_at"
              ]
            },
            {
              "required": [
                "updated_at"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "required": [
          "expires_at"
        ]
      },
      "then": {
        "properties": {
          "availability": {
            "const": "suppressed"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "errors": {
            "contains": {
              "properties": {
                "code": {
                  "const": "REFERENCE_NOT_FOUND"
                }
              },
              "required": [
                "code"
              ]
            }
          }
        },
        "required": [
          "errors"
        ]
      },
      "then": {
        "properties": {
          "errors": {
            "maxItems": 1,
            "items": {
              "$ref": "https://adcontextprotocol.org/schemas/3.2.0-beta.6/core/catalog-item-reference-not-found-error.json"
            }
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
