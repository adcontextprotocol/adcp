{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adcontextprotocol.org/schemas/3.2.0-rc.4/mcp/2026-07-28/profiles/production/media-buy/sync-reporting-status-response.json",
  "x-status": "experimental",
  "type": "object",
  "allOf": [
    {
      "$ref": "#/$defs/external:core~1version-envelope.json"
    },
    {
      "$ref": "#/$defs/external:core~1protocol-envelope.json"
    }
  ],
  "properties": {
    "status": {
      "type": "string",
      "const": "completed"
    },
    "results": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "result": {
                "type": "string",
                "const": "recorded"
              },
              "consumer_status": {
                "allOf": [
                  {
                    "$ref": "#/$defs/external:core~1reporting-consumer-status.json"
                  },
                  {
                    "required": [
                      "recorded_at"
                    ]
                  }
                ]
              }
            },
            "required": [
              "result",
              "consumer_status"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "result": {
                "type": "string",
                "const": "unchanged"
              },
              "consumer_status": {
                "allOf": [
                  {
                    "$ref": "#/$defs/external:core~1reporting-consumer-status.json"
                  },
                  {
                    "required": [
                      "recorded_at"
                    ]
                  }
                ]
              }
            },
            "required": [
              "result",
              "consumer_status"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "result": {
                "type": "string",
                "const": "failed"
              },
              "reporting_status_id": {
                "type": "string",
                "minLength": 16,
                "maxLength": 255,
                "pattern": "^[A-Za-z0-9_.:-]{16,255}$",
                "x-entity": "reporting_consumer_status"
              },
              "errors": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/external:core~1error.json"
                },
                "minItems": 1,
                "maxItems": 16
              }
            },
            "required": [
              "result",
              "reporting_status_id",
              "errors"
            ],
            "additionalProperties": false
          }
        ]
      },
      "minItems": 1,
      "maxItems": 100
    },
    "context": {
      "$ref": "#/$defs/external:core~1context.json"
    },
    "ext": {
      "$ref": "#/$defs/external:core~1ext.json"
    }
  },
  "required": [
    "status",
    "results"
  ],
  "x-adcp-validation": {
    "result_mapping": "Return exactly one result per submitted statement in request order. An exact batch idempotency replay returns the original response; unchanged is used when the identical immutable reporting_status_id was already recorded through another batch. Reusing either identity with changed content is an idempotency conflict."
  },
  "additionalProperties": true,
  "$defs": {
    "external:core/version-envelope.json": {
      "$id": "https://adcontextprotocol.org/schemas/3.2.0-rc.4/core/version-envelope.json",
      "type": "object",
      "properties": {
        "adcp_version": {
          "type": "string",
          "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-[a-zA-Z0-9](?:[a-zA-Z0-9.-]*[a-zA-Z0-9])?)?$"
        },
        "adcp_major_version": {
          "type": "integer",
          "deprecated": true,
          "minimum": 1,
          "maximum": 99
        }
      }
    },
    "external:core/protocol-envelope.json": {
      "$id": "https://adcontextprotocol.org/schemas/3.2.0-rc.4/core/protocol-envelope.json",
      "type": "object",
      "properties": {
        "context_id": {
          "type": "string"
        },
        "context": {
          "$ref": "https://adcontextprotocol.org/schemas/3.2.0-rc.4/mcp/2026-07-28/profiles/production/media-buy/sync-reporting-status-response.json#/$defs/external:core~1context.json"
        },
        "task_id": {
          "type": "string",
          "x-entity": "task"
        },
        "status": {
          "$ref": "https://adcontextprotocol.org/schemas/3.2.0-rc.4/mcp/2026-07-28/profiles/production/media-buy/sync-reporting-status-response.json#/$defs/external:enums~1task-status.json"
        },
        "message": {
          "type": "string"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "replayed": {
          "type": "boolean",
          "default": false
        },
        "adcp_error": {
          "$ref": "https://adcontextprotocol.org/schemas/3.2.0-rc.4/mcp/2026-07-28/profiles/production/media-buy/sync-reporting-status-response.json#/$defs/external:core~1error.json"
        },
        "push_notification_config": {
          "$ref": "https://adcontextprotocol.org/schemas/3.2.0-rc.4/mcp/2026-07-28/profiles/production/media-buy/sync-reporting-status-response.json#/$defs/external:core~1push-notification-config.json"
        },
        "governance_context": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[\\x20-\\x7E]+$"
        },
        "payload": {
          "type": "object",
          "x-adcp-open-payload": true,
          "additionalProperties": true
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": true,
      "not": {
        "anyOf": [
          {
            "required": [
              "task_status"
            ]
          },
          {
            "required": [
              "response_status"
            ]
          }
        ]
      },
      "notes": [
        "Task response schemas (e.g., get-products-response.json) define ONLY the body fields; protocol-layer fields live on this envelope.",
        "Transport serialization (normative):",
        "  - MCP: envelope fields and task-body fields are siblings at the root of the tool response. The `payload` object is NOT serialized as a nested key — its body fields are flattened to the root alongside `status`, `context_id`, `context`, etc. This matches MCP's native `structuredContent` convention and is what shipping SDKs (@adcp/client) emit. Conformant MCP receivers parse from the flat root; receivers that expect a nested `payload` key MUST migrate.",
        "  - A2A 1.0 with the AdCP profile extension: `task.status.state` carries the transport invocation lifecycle used to select the extraction location; `task.contextId` carries `context_id`, while `task.id` is an independent A2A transport identifier. The complete AdCP response, including its protocol-level `status` and any application-layer `task_id`, is canonically carried in `task.artifacts[0].parts[].DataPart` on final states; `task.status.message.parts[].DataPart` is the fallback container used only for interim A2A states (working, native submitted, input-required) where no final artifact has been emitted yet. For a structured AdCP business rejection or Submitted response, A2A is `completed` while the DataPart carries `status: rejected` or `status: submitted` because the handler invocation succeeded. An AdCP `task_id` MUST NOT be copied into artifact metadata or inferred from `task.id`. Receivers MUST prefer artifacts when present and MUST NOT overwrite a DataPart's status with the A2A state. See `a2a-profile-extension.mdx` and `a2a-response-extraction.mdx` for the full binding and extraction algorithm.",
        "  - REST: envelope fields MAY ride on HTTP headers (e.g., `X-AdCP-Status`, `X-AdCP-Context-Id`) or as JSON body siblings; body fields appear at the JSON body root. Implementers choosing the header path SHOULD also mirror to body siblings for non-streaming callers.",
        "Across all three: envelope and body fields are conceptually a single response object. A task response schema MAY declare body fields with the same name as envelope fields (e.g., `errors[]` body-level for per-record validation results vs envelope-level for fatal task failure) and the two MUST be treated as distinct fields by name within their respective namespaces — see `error-handling.mdx#envelope-vs-payload-errors-the-two-layer-model`.",
        "`status` is REQUIRED on the conceptual AdCP response across all transports. On MCP and REST it appears as a sibling field at the JSON root (or `structuredContent` root for MCP). On A2A it is carried inside the authoritative DataPart alongside the task body; `task.status.state` separately carries the A2A transport lifecycle and selects where that DataPart is found. Receivers MUST preserve the DataPart status when present. The schema-level `required: [status]` enforces the post-extraction AdCP shape. `payload` remains intentionally NOT required — it is a documentary grouping construct, never a required wire field. See `mcp-guide.mdx` and `a2a-guide.mdx` for the wire-level patterns receivers MUST implement.",
        "Receivers MUST handle absence of an envelope field (e.g., `replayed` omitted) as the field's documented default — see each field's `default` clause."
      ]
    },
    "external:core/context.json": {
      "$id": "https://adcontextprotocol.org/schemas/3.2.0-rc.4/core/context.json",
      "type": "object",
      "additionalProperties": true
    },
    "external:enums/task-status.json": {
      "$id": "https://adcontextprotocol.org/schemas/3.2.0-rc.4/enums/task-status.json",
      "type": "string",
      "enum": [
        "submitted",
        "working",
        "input-required",
        "completed",
        "canceled",
        "failed",
        "rejected",
        "auth-required",
        "unknown"
      ]
    },
    "external:core/error.json": {
      "$id": "https://adcontextprotocol.org/schemas/3.2.0-rc.4/core/error.json",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "message": {
          "type": "string"
        },
        "buyer_reason": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "message": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": true
        },
        "field": {
          "type": "string"
        },
        "suggestion": {
          "type": "string"
        },
        "retry_after": {
          "type": "number",
          "minimum": 1,
          "maximum": 3600
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pointer": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "keyword": {
                "type": "string"
              },
              "schemaPath": {
                "type": "string"
              },
              "schema_id": {
                "type": "string"
              },
              "discriminator": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "property_name": {
                      "type": "string"
                    },
                    "value": {
                      "type": [
                        "string",
                        "number",
                        "boolean",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "property_name",
                    "value"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "pointer",
              "message",
              "keyword"
            ],
            "additionalProperties": true
          }
        },
        "details": {
          "type": "object",
          "additionalProperties": true
        },
        "recovery": {
          "type": "string",
          "enum": [
            "transient",
            "correctable",
            "terminal"
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "producer",
            "sdk"
          ]
        },
        "sdk_id": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": true,
      "dependentRequired": {
        "buyer_reason": [
          "recovery"
        ]
      }
    },
    "external:core/push-notification-config.json": {
      "$id": "https://adcontextprotocol.org/schemas/3.2.0-rc.4/core/push-notification-config.json",
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9_.:-]{1,255}$"
        },
        "token": {
          "type": "string",
          "minLength": 16,
          "maxLength": 4096
        },
        "authentication": {
          "type": "object",
          "deprecated": true,
          "properties": {
            "schemes": {
              "type": "array",
              "items": {
                "$ref": "https://adcontextprotocol.org/schemas/3.2.0-rc.4/mcp/2026-07-28/profiles/production/media-buy/sync-reporting-status-response.json#/$defs/external:enums~1auth-scheme.json"
              },
              "minItems": 1,
              "maxItems": 1
            },
            "credentials": {
              "type": "string",
              "minLength": 32
            }
          },
          "required": [
            "schemes",
            "credentials"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "url"
      ]
    },
    "external:enums/auth-scheme.json": {
      "$id": "https://adcontextprotocol.org/schemas/3.2.0-rc.4/enums/auth-scheme.json",
      "deprecated": true,
      "type": "string",
      "enum": [
        "Bearer",
        "HMAC-SHA256"
      ]
    },
    "external:core/reporting-consumer-status.json": {
      "$id": "https://adcontextprotocol.org/schemas/3.2.0-rc.4/core/reporting-consumer-status.json",
      "x-status": "experimental",
      "type": "object",
      "properties": {
        "reporting_status_id": {
          "type": "string",
          "minLength": 16,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9_.:-]{16,255}$",
          "x-entity": "reporting_consumer_status"
        },
        "supersedes_reporting_status_id": {
          "type": "string",
          "minLength": 16,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9_.:-]{16,255}$",
          "x-entity": "reporting_consumer_status"
        },
        "delivery_config_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_.:-]{1,64}$",
          "x-entity": "reporting_delivery_config"
        },
        "delivery_config_version": {
          "type": "integer",
          "minimum": 1
        },
        "report_definition_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9_.:-]{1,255}$",
          "x-entity": "reporting_definition"
        },
        "period": {
          "type": "object",
          "properties": {
            "start": {
              "type": "string",
              "format": "date-time"
            },
            "end": {
              "type": "string",
              "format": "date-time"
            },
            "source_timezone": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "start",
            "end",
            "source_timezone"
          ],
          "additionalProperties": false
        },
        "reporting_obligation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9_.:-]{1,255}$",
          "x-entity": "reporting_obligation"
        },
        "reporting_revision_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9_.:-]{1,255}$",
          "x-entity": "reporting_revision"
        },
        "observed_revision_content_sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "consumer_status": {
          "type": "string",
          "enum": [
            "received",
            "obligation_missing",
            "revision_missing",
            "unreadable",
            "content_mismatch"
          ]
        },
        "status_as_of": {
          "type": "string",
          "format": "date-time"
        },
        "mismatch_code": {
          "type": "string",
          "enum": [
            "scope_media_buy_missing",
            "coverage_short",
            "metric_missing",
            "schema_nonconformant",
            "currency_mismatch",
            "period_mismatch"
          ]
        },
        "failure_code": {
          "type": "string",
          "enum": [
            "access_denied",
            "resource_not_found",
            "integrity_mismatch",
            "reader_incompatible",
            "transport_failed"
          ]
        },
        "consumer_commit_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[A-Za-z0-9_.:-]{1,512}$"
        },
        "seller_ledger_snapshot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "seller_ledger_as_of": {
          "type": "string",
          "format": "date-time"
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time",
          "readOnly": true
        }
      },
      "required": [
        "reporting_status_id",
        "delivery_config_id",
        "delivery_config_version",
        "report_definition_id",
        "period",
        "consumer_status",
        "status_as_of"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "consumer_status": {
                "const": "received"
              }
            },
            "required": [
              "consumer_status"
            ]
          },
          "then": {
            "required": [
              "reporting_obligation_id",
              "reporting_revision_id",
              "observed_revision_content_sha256"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "failure_code"
                  ]
                },
                {
                  "required": [
                    "mismatch_code"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "consumer_status": {
                "const": "obligation_missing"
              }
            },
            "required": [
              "consumer_status"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "reporting_obligation_id"
                  ]
                },
                {
                  "required": [
                    "reporting_revision_id"
                  ]
                },
                {
                  "required": [
                    "observed_revision_content_sha256"
                  ]
                },
                {
                  "required": [
                    "failure_code"
                  ]
                },
                {
                  "required": [
                    "mismatch_code"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "consumer_status": {
                "const": "revision_missing"
              }
            },
            "required": [
              "consumer_status"
            ]
          },
          "then": {
            "required": [
              "reporting_obligation_id"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "reporting_revision_id"
                  ]
                },
                {
                  "required": [
                    "observed_revision_content_sha256"
                  ]
                },
                {
                  "required": [
                    "failure_code"
                  ]
                },
                {
                  "required": [
                    "mismatch_code"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "consumer_status": {
                "const": "unreadable"
              }
            },
            "required": [
              "consumer_status"
            ]
          },
          "then": {
            "required": [
              "reporting_obligation_id",
              "reporting_revision_id",
              "failure_code"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "observed_revision_content_sha256"
                  ]
                },
                {
                  "required": [
                    "mismatch_code"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "consumer_status": {
                "const": "content_mismatch"
              }
            },
            "required": [
              "consumer_status"
            ]
          },
          "then": {
            "required": [
              "reporting_obligation_id",
              "reporting_revision_id",
              "observed_revision_content_sha256",
              "mismatch_code"
            ],
            "not": {
              "required": [
                "failure_code"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "seller_ledger_snapshot_id"
            ]
          },
          "then": {
            "required": [
              "seller_ledger_as_of"
            ]
          },
          "else": {
            "not": {
              "required": [
                "seller_ledger_as_of"
              ]
            }
          }
        }
      ],
      "x-adcp-validation": {
        "attribution": "The consumer principal comes only from authenticated transport and is never asserted in the payload. Sellers disclose a status only to the same authenticated consumer that submitted it. A consumer status never overwrites or becomes authoritative seller obligation, revision, materialization, receipt, or adjustment evidence. The one reserved carve-out is a configuration generation declaring reporting-delivery-config authoritative_party: consumer, where a later minor will define a separate buyer-deposited revision task rather than change the meaning of this statement; no released version defines that task, so in 3.2 sellers reject that value with UNSUPPORTED_FEATURE and this attribution rule has no exception (see https://github.com/adcontextprotocol/adcp/issues/7440).",
        "expected_period": "The configuration generation and report_definition_id MUST resolve for the authenticated caller/account, and period MUST be one exact eligible period derived from that immutable generation. obligation_missing and revision_missing are valid only when status_as_of is at or after the obligation's expected_at; content_mismatch is valid only against a revision the seller currently requires for that period. The seller MUST accept obligation_missing without a seller-issued obligation or revision ID when this independently derivable identity is valid.",
        "revision_binding": "For received, unreadable, or content_mismatch, reporting_revision_id and reporting_obligation_id MUST match the same configuration generation, report definition, and period. received requires the consumer to recompute the Core revision binding and submit the matching revision_content_sha256; it does not assert matching Managed materialization evidence, billing control totals, canonical billing evidence, invoice approval, or dispute waiver. content_mismatch requires the same recomputed binding so the disagreement names the exact bytes the consumer read, and its mismatch_code MUST identify a fact the accepted configuration generation already fixed — denominator membership, coverage, promised metrics, the pinned profile schema, the pinned metric units, or the half-open period. A consumer MUST NOT use content_mismatch to dispute how many impressions the seller counted; that is a measurement disagreement, handled by measurement_terms and makegood_policy rather than by this operational loop.",
        "immutability": "reporting_status_id is immutable. Exact retries are unchanged; reuse with different content is an idempotency conflict. Each consumer has exactly one current leaf per account, configuration generation, report definition, and period. This logical key remains the chain identity when an obligation_missing statement predates a repaired seller obligation; the seller attaches that chain to the later obligation and never resets or forks it. If a leaf already exists, a new statement MUST name that exact leaf in supersedes_reporting_status_id; omission, a stale leaf, or any attempt to fork the chain fails atomically with a conflict. The new statement becomes current only after that comparison succeeds.",
        "retention_and_limits": "Superseded statements remain readable as append-only history for at least the advertised status_retention_days. After that retention boundary, sellers MAY prune expired superseded statements while retaining enough chain metadata to reject ID reuse and stale supersession. Sellers apply ordinary authenticated task rate limits and per-caller/account resource limits to pathological status churn without allowing one caller to affect another.",
        "snapshot_provenance": "When seller_ledger_snapshot_id is present, the seller MUST resolve it and require seller_ledger_as_of to exactly match the issued snapshot for this authenticated caller, account, and applicable filter scope. Unknown, unauthorized, cross-account, cross-caller, expired, or mismatched snapshot identities fail with the same unavailable result.",
        "time": "status_as_of MUST be no earlier than the superseded statement's status_as_of and no later than recorded_at except for the seller's documented clock-skew tolerance. Sellers reject unreasonable future timestamps and retain the submitted value as consumer-attributed evidence rather than rewriting it."
      },
      "additionalProperties": false
    },
    "external:core/ext.json": {
      "$id": "https://adcontextprotocol.org/schemas/3.2.0-rc.4/core/ext.json",
      "type": "object",
      "additionalProperties": true
    }
  }
}
