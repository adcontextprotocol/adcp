{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adcontextprotocol.org/schemas/3.2.0-beta.5/mcp/2026-07-28/profiles/production/governance/report-plan-adjustment-response.json",
  "type": "object",
  "allOf": [
    {
      "$ref": "#/$defs/external:core~1version-envelope.json"
    }
  ],
  "x-status": "experimental",
  "properties": {
    "adjustment_id": {
      "type": "string",
      "x-entity": "governance_adjustment"
    },
    "adjustment_state": {
      "type": "string",
      "enum": [
        "reported",
        "verified",
        "disputed"
      ]
    },
    "adjustment_type": {
      "type": "string",
      "enum": [
        "decommitment",
        "refund",
        "credit",
        "makegood"
      ]
    },
    "amount": {
      "type": "object",
      "properties": {
        "amount": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "additionalProperties": false
    },
    "headroom_restored": {
      "type": "number",
      "minimum": 0
    },
    "plan_summary": {
      "type": "object",
      "properties": {
        "accounting_mode": {
          "type": "string",
          "enum": [
            "gross_commitment",
            "verified_net_cost"
          ]
        },
        "gross_committed": {
          "type": "number",
          "minimum": 0
        },
        "adjustments_reported": {
          "type": "number",
          "minimum": 0
        },
        "adjustments_verified": {
          "type": "number",
          "minimum": 0
        },
        "net_cost": {
          "type": "number",
          "minimum": 0
        },
        "headroom_restored": {
          "type": "number",
          "minimum": 0
        },
        "ledger_committed": {
          "type": "number",
          "minimum": 0
        },
        "net_committed": {
          "type": "number",
          "minimum": 0
        },
        "budget_remaining": {
          "type": "number"
        }
      },
      "required": [
        "accounting_mode",
        "gross_committed",
        "adjustments_reported",
        "adjustments_verified",
        "net_cost",
        "headroom_restored",
        "ledger_committed",
        "net_committed",
        "budget_remaining"
      ],
      "additionalProperties": false
    },
    "replayed": {
      "type": "boolean",
      "default": false
    },
    "context": {
      "$ref": "#/$defs/external:core~1context.json"
    },
    "ext": {
      "$ref": "#/$defs/external:core~1ext.json"
    }
  },
  "required": [
    "adjustment_id",
    "adjustment_state",
    "adjustment_type",
    "amount",
    "headroom_restored",
    "plan_summary"
  ],
  "additionalProperties": true,
  "$defs": {
    "external:core/version-envelope.json": {
      "type": "object",
      "properties": {
        "adcp_version": {
          "type": "string",
          "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-[a-zA-Z0-9](?:[a-zA-Z0-9.-]*[a-zA-Z0-9])?)?$"
        },
        "adcp_major_version": {
          "type": "integer",
          "deprecated": true,
          "minimum": 1,
          "maximum": 99
        }
      }
    },
    "external:core/context.json": {
      "type": "object",
      "additionalProperties": true
    },
    "external:core/ext.json": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
