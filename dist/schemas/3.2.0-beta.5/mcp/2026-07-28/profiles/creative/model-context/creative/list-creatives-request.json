{
  "type": "object",
  "properties": {
    "adcp_version": {
      "type": "string"
    },
    "adcp_major_version": {
      "type": "integer"
    },
    "filters": {
      "$ref": "#/$defs/external:core~1creative-filters.json"
    },
    "sort": {
      "type": "object",
      "properties": {
        "field": {
          "$ref": "#/$defs/external:enums~1creative-sort-field.json"
        },
        "direction": {
          "$ref": "#/$defs/external:enums~1sort-direction.json"
        }
      },
      "additionalProperties": true
    },
    "pagination": {
      "$ref": "#/$defs/external:core~1pagination-request.json"
    },
    "include_assignments": {
      "type": "boolean"
    },
    "assignment_projection": {
      "type": "string",
      "enum": [
        "all",
        "matching"
      ]
    },
    "assignment_limit": {
      "type": "integer"
    },
    "include_snapshot": {
      "type": "boolean"
    },
    "include_items": {
      "type": "boolean"
    },
    "include_variables": {
      "type": "boolean"
    },
    "include_pricing": {
      "type": "boolean"
    },
    "include_purged": {
      "type": "boolean"
    },
    "include_webhook_activity": {
      "type": "boolean"
    },
    "webhook_activity_limit": {
      "type": "integer"
    },
    "account": {
      "$ref": "#/$defs/external:core~1account-ref.json"
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "creative_id",
          "name",
          "format_id",
          "format_kind",
          "format_option_ref",
          "assets",
          "status",
          "created_date",
          "updated_date",
          "tags",
          "rights",
          "rights_attestation_evaluations",
          "localization",
          "localization_unavailable",
          "assignments",
          "snapshot",
          "items",
          "variables",
          "concept",
          "pricing_options"
        ]
      }
    },
    "context": {
      "$ref": "#/$defs/external:core~1context.json"
    },
    "ext": {
      "$ref": "#/$defs/external:core~1ext.json"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "external:core/version-envelope.json": {
      "type": "object",
      "properties": {
        "adcp_version": {
          "type": "string"
        },
        "adcp_major_version": {
          "type": "integer"
        }
      }
    },
    "external:core/creative-filters.json": {
      "type": "object",
      "properties": {
        "accounts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/external:core~1account-ref.json"
          }
        },
        "statuses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/external:enums~1creative-status.json"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tags_any": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "name_contains": {
          "type": "string"
        },
        "creative_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "created_after": {
          "type": "string"
        },
        "created_before": {
          "type": "string"
        },
        "updated_after": {
          "type": "string"
        },
        "updated_before": {
          "type": "string"
        },
        "assigned_to_packages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "media_buy_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unassigned": {
          "type": "boolean"
        },
        "has_served": {
          "type": "boolean"
        },
        "indicator_types": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/external:enums~1indicator-type.json"
          }
        },
        "concept_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "format_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/external:core~1format-id.json"
          }
        },
        "format_kinds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/external:core~1canonical-format-kind.json"
          }
        },
        "asset_types": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/external:enums~1asset-content-type.json"
          }
        },
        "has_variables": {
          "type": "boolean"
        },
        "ext": {
          "$ref": "#/$defs/external:core~1ext.json"
        }
      },
      "additionalProperties": true
    },
    "external:core/account-ref.json": {
      "type": "object",
      "oneOf": [
        {
          "properties": {
            "account_id": {
              "type": "string"
            }
          },
          "required": [
            "account_id"
          ]
        },
        {
          "properties": {
            "brand": {
              "$ref": "#/$defs/external:core~1brand-ref.json"
            },
            "operator": {
              "type": "string"
            },
            "operator_unit": {
              "$ref": "#/$defs/external:core~1operator-unit.json"
            },
            "currency": {
              "type": "string"
            },
            "timezone": {
              "type": "string"
            },
            "sandbox": {
              "type": "boolean"
            }
          },
          "required": [
            "brand",
            "operator"
          ]
        }
      ]
    },
    "external:core/brand-ref.json": {
      "type": "object",
      "properties": {
        "domain": {
          "type": "string"
        },
        "brand_id": {
          "$ref": "#/$defs/external:core~1brand-id.json"
        },
        "countries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "industries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "data_subject_contestation": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string"
            },
            "email": {
              "type": "string"
            },
            "languages": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "anyOf": [
            {
              "required": [
                "url"
              ]
            },
            {
              "required": [
                "email"
              ]
            }
          ]
        },
        "brand_kit_override": {
          "type": "object",
          "properties": {
            "logo": {
              "$ref": "#/$defs/external:core~1assets~1image-asset.json"
            },
            "colors": {
              "type": "object",
              "properties": {
                "primary": {
                  "type": "string"
                },
                "secondary": {
                  "type": "string"
                },
                "accent": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            },
            "voice": {
              "type": "string"
            },
            "tagline": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      },
      "required": [
        "domain"
      ]
    },
    "external:core/brand-id.json": {
      "type": "string"
    },
    "external:core/assets/image-asset.json": {
      "type": "object",
      "properties": {
        "asset_type": {
          "type": "string",
          "const": "image"
        },
        "url": {
          "type": "string"
        },
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        },
        "file_size_bytes": {
          "type": "integer"
        },
        "pixel_ratio": {
          "type": "number"
        },
        "format": {
          "type": "string"
        },
        "alt_text": {
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/external:core~1provenance.json"
        }
      },
      "required": [
        "asset_type",
        "url",
        "width",
        "height"
      ],
      "additionalProperties": true
    },
    "external:core/provenance.json": {
      "type": "object",
      "properties": {
        "digital_source_type": {
          "$ref": "#/$defs/external:enums~1digital-source-type.json"
        },
        "synthetic_depiction": {
          "type": "boolean"
        },
        "ai_tool": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "provider": {
              "type": "string"
            }
          },
          "required": [
            "name"
          ]
        },
        "human_oversight": {
          "type": "string",
          "enum": [
            "none",
            "prompt_only",
            "selected",
            "edited",
            "directed"
          ]
        },
        "declared_by": {
          "type": "object",
          "properties": {
            "agent_url": {
              "type": "string"
            },
            "role": {
              "type": "string",
              "enum": [
                "creator",
                "advertiser",
                "agency",
                "platform",
                "tool"
              ]
            }
          },
          "required": [
            "role"
          ]
        },
        "declared_at": {
          "type": "string"
        },
        "created_time": {
          "type": "string"
        },
        "c2pa": {
          "type": "object",
          "properties": {
            "manifest_url": {
              "type": "string"
            }
          },
          "required": [
            "manifest_url"
          ]
        },
        "embedded_provenance": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "method": {
                "$ref": "#/$defs/external:enums~1embedded-provenance-method.json"
              },
              "standard": {
                "type": "string"
              },
              "provider": {
                "type": "string"
              },
              "verify_agent": {
                "type": "object",
                "properties": {
                  "agent_url": {
                    "type": "string"
                  },
                  "feature_id": {
                    "type": "string"
                  }
                },
                "required": [
                  "agent_url"
                ]
              },
              "embedded_at": {
                "type": "string"
              }
            },
            "required": [
              "method",
              "provider"
            ]
          }
        },
        "watermarks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "media_type": {
                "$ref": "#/$defs/external:enums~1watermark-media-type.json"
              },
              "provider": {
                "type": "string"
              },
              "verify_agent": {
                "type": "object",
                "properties": {
                  "agent_url": {
                    "type": "string"
                  },
                  "feature_id": {
                    "type": "string"
                  }
                },
                "required": [
                  "agent_url"
                ]
              },
              "c2pa_action": {
                "$ref": "#/$defs/external:enums~1c2pa-watermark-action.json"
              },
              "embedded_at": {
                "type": "string"
              }
            },
            "required": [
              "media_type",
              "provider"
            ]
          }
        },
        "disclosure": {
          "type": "object",
          "properties": {
            "required": {
              "type": "boolean"
            },
            "jurisdictions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "country": {
                    "type": "string"
                  },
                  "region": {
                    "type": "string"
                  },
                  "regulation": {
                    "type": "string"
                  },
                  "label_text": {
                    "type": "string"
                  },
                  "render_guidance": {
                    "type": "object",
                    "properties": {
                      "persistence": {
                        "$ref": "#/$defs/external:enums~1disclosure-persistence.json"
                      },
                      "min_duration_ms": {
                        "type": "integer"
                      },
                      "positions": {
                        "type": "array",
                        "items": {
                          "$ref": "#/$defs/external:enums~1disclosure-position.json"
                        }
                      },
                      "ext": {
                        "$ref": "#/$defs/external:core~1ext.json"
                      }
                    }
                  }
                },
                "required": [
                  "country",
                  "regulation"
                ]
              }
            }
          },
          "required": [
            "required"
          ]
        },
        "verification": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "verified_by": {
                "type": "string"
              },
              "verified_time": {
                "type": "string"
              },
              "result": {
                "type": "string",
                "enum": [
                  "authentic",
                  "ai_generated",
                  "ai_modified",
                  "inconclusive"
                ]
              },
              "confidence": {
                "type": "number"
              },
              "details_url": {
                "type": "string"
              }
            },
            "required": [
              "verified_by",
              "result"
            ]
          }
        },
        "ext": {
          "$ref": "#/$defs/external:core~1ext.json"
        }
      }
    },
    "external:enums/digital-source-type.json": {
      "type": "string",
      "enum": [
        "digital_capture",
        "digital_creation",
        "trained_algorithmic_media",
        "composite_with_trained_algorithmic_media",
        "algorithmic_media",
        "composite_capture",
        "composite_synthetic",
        "human_edits",
        "data_driven_media"
      ]
    },
    "external:enums/embedded-provenance-method.json": {
      "type": "string",
      "enum": [
        "manifest_wrapper",
        "provenance_markers"
      ]
    },
    "external:enums/watermark-media-type.json": {
      "type": "string",
      "enum": [
        "audio",
        "image",
        "video",
        "text"
      ]
    },
    "external:enums/c2pa-watermark-action.json": {
      "type": "string",
      "enum": [
        "c2pa.watermarked.bound",
        "c2pa.watermarked.unbound"
      ]
    },
    "external:enums/disclosure-persistence.json": {
      "type": "string",
      "enum": [
        "continuous",
        "initial",
        "flexible"
      ]
    },
    "external:enums/disclosure-position.json": {
      "type": "string",
      "enum": [
        "prominent",
        "footer",
        "audio",
        "subtitle",
        "overlay",
        "end_card",
        "pre_roll",
        "companion"
      ]
    },
    "external:core/ext.json": {
      "type": "object",
      "additionalProperties": true
    },
    "external:core/operator-unit.json": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ]
    },
    "external:enums/creative-status.json": {
      "type": "string",
      "enum": [
        "processing",
        "pending_review",
        "approved",
        "suspended",
        "rejected",
        "archived"
      ]
    },
    "external:enums/indicator-type.json": {
      "type": "string",
      "enum": [
        "creative_fatigue",
        "creative_quality_opportunity",
        "creative_diversity_low",
        "audience_saturation",
        "inventory_shortfall_forecast",
        "pacing_risk",
        "budget_constrained"
      ]
    },
    "external:core/format-id.json": {
      "type": "object",
      "properties": {
        "agent_url": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        },
        "duration_ms": {
          "type": "number"
        },
        "pixel_ratio": {
          "type": "number"
        }
      },
      "required": [
        "agent_url",
        "id"
      ],
      "additionalProperties": true,
      "dependentRequired": {
        "width": [
          "height"
        ],
        "height": [
          "width"
        ],
        "pixel_ratio": [
          "width",
          "height"
        ]
      }
    },
    "external:core/canonical-format-kind.json": {
      "type": "string",
      "enum": [
        "image",
        "html5",
        "display_tag",
        "image_carousel",
        "video_hosted",
        "video_vast",
        "audio_hosted",
        "audio_daast",
        "sponsored_placement",
        "native_in_feed",
        "responsive_creative",
        "agent_placement",
        "custom"
      ]
    },
    "external:enums/asset-content-type.json": {
      "type": "string",
      "enum": [
        "image",
        "video",
        "audio",
        "text",
        "markdown",
        "html",
        "css",
        "javascript",
        "zip",
        "vast",
        "daast",
        "url",
        "webhook",
        "brief",
        "catalog",
        "published_post"
      ]
    },
    "external:enums/creative-sort-field.json": {
      "type": "string",
      "enum": [
        "created_date",
        "updated_date",
        "name",
        "status",
        "assignment_count"
      ]
    },
    "external:enums/sort-direction.json": {
      "type": "string",
      "enum": [
        "asc",
        "desc"
      ]
    },
    "external:core/pagination-request.json": {
      "type": "object",
      "properties": {
        "max_results": {
          "type": "integer"
        },
        "cursor": {
          "type": "string"
        }
      }
    },
    "external:core/context.json": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
