{
  "type": "object",
  "allOf": [
    {
      "$ref": "#/$defs/external:core~1version-envelope.json"
    }
  ],
  "properties": {
    "idempotency_key": {
      "type": "string"
    },
    "accounts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "account": {
            "$ref": "#/$defs/external:core~1account-ref.json"
          },
          "revision": {
            "type": "integer"
          },
          "operator_identity": {
            "$ref": "#/$defs/external:core~1operator-identity.json"
          },
          "destination_billing_entity": {
            "$ref": "#/$defs/external:core~1business-entity.json"
          },
          "brand": {
            "$ref": "#/$defs/external:core~1brand-ref.json"
          },
          "operator": {
            "type": "string"
          },
          "operator_unit": {
            "$ref": "#/$defs/external:core~1operator-unit.json"
          },
          "currency": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          },
          "billing": {
            "$ref": "#/$defs/external:enums~1billing-party.json"
          },
          "billing_entity": {
            "$ref": "#/$defs/external:core~1business-entity.json"
          },
          "payment_terms": {
            "$ref": "#/$defs/external:enums~1payment-terms.json"
          },
          "sandbox": {
            "type": "boolean"
          },
          "preferred_reporting_protocol": {
            "$ref": "#/$defs/external:enums~1cloud-storage-protocol.json"
          },
          "notification_configs": {
            "type": "array",
            "items": {
              "allOf": [
                {
                  "$ref": "#/$defs/external:core~1notification-config.json"
                },
                {
                  "if": {
                    "required": [
                      "authentication"
                    ]
                  },
                  "then": {
                    "properties": {
                      "authentication": {
                        "required": [
                          "credentials"
                        ]
                      }
                    }
                  }
                }
              ]
            }
          }
        },
        "oneOf": [
          {
            "required": [
              "brand",
              "operator",
              "billing"
            ],
            "allOf": [
              {
                "not": {
                  "required": [
                    "account"
                  ]
                }
              },
              {
                "not": {
                  "required": [
                    "revision"
                  ]
                }
              },
              {
                "not": {
                  "required": [
                    "operator_identity"
                  ]
                }
              },
              {
                "not": {
                  "required": [
                    "destination_billing_entity"
                  ]
                }
              }
            ]
          },
          {
            "required": [
              "account"
            ],
            "allOf": [
              {
                "not": {
                  "required": [
                    "brand"
                  ]
                }
              },
              {
                "not": {
                  "required": [
                    "operator"
                  ]
                }
              },
              {
                "not": {
                  "required": [
                    "operator_unit"
                  ]
                }
              },
              {
                "not": {
                  "required": [
                    "currency"
                  ]
                }
              },
              {
                "not": {
                  "required": [
                    "timezone"
                  ]
                }
              },
              {
                "not": {
                  "required": [
                    "billing"
                  ]
                }
              }
            ]
          }
        ],
        "additionalProperties": true,
        "dependentRequired": {
          "operator_identity": [
            "revision"
          ],
          "destination_billing_entity": [
            "operator_identity",
            "revision"
          ]
        }
      }
    },
    "delete_missing": {
      "type": "boolean"
    },
    "dry_run": {
      "type": "boolean"
    },
    "push_notification_config": {
      "$ref": "#/$defs/external:core~1push-notification-config.json"
    },
    "context": {
      "$ref": "#/$defs/external:core~1context.json"
    },
    "ext": {
      "$ref": "#/$defs/external:core~1ext.json"
    }
  },
  "required": [
    "idempotency_key",
    "accounts"
  ],
  "additionalProperties": true,
  "$defs": {
    "external:core/version-envelope.json": {
      "type": "object",
      "properties": {
        "adcp_version": {
          "type": "string"
        },
        "adcp_major_version": {
          "type": "integer"
        }
      }
    },
    "external:core/account-ref.json": {
      "type": "object",
      "oneOf": [
        {
          "properties": {
            "account_id": {
              "type": "string"
            }
          },
          "required": [
            "account_id"
          ]
        },
        {
          "properties": {
            "brand": {
              "$ref": "#/$defs/external:core~1brand-ref.json"
            },
            "operator": {
              "type": "string"
            },
            "operator_unit": {
              "$ref": "#/$defs/external:core~1operator-unit.json"
            },
            "currency": {
              "type": "string"
            },
            "timezone": {
              "type": "string"
            },
            "sandbox": {
              "type": "boolean"
            }
          },
          "required": [
            "brand",
            "operator"
          ]
        }
      ]
    },
    "external:core/brand-ref.json": {
      "type": "object",
      "properties": {
        "domain": {
          "type": "string"
        },
        "brand_id": {
          "$ref": "#/$defs/external:core~1brand-id.json"
        },
        "countries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "industries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "data_subject_contestation": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string"
            },
            "email": {
              "type": "string"
            },
            "languages": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "anyOf": [
            {
              "required": [
                "url"
              ]
            },
            {
              "required": [
                "email"
              ]
            }
          ]
        },
        "brand_kit_override": {
          "type": "object",
          "properties": {
            "logo": {
              "$ref": "#/$defs/external:core~1assets~1image-asset.json"
            },
            "colors": {
              "type": "object",
              "properties": {
                "primary": {
                  "type": "string"
                },
                "secondary": {
                  "type": "string"
                },
                "accent": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            },
            "voice": {
              "type": "string"
            },
            "tagline": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      },
      "required": [
        "domain"
      ]
    },
    "external:core/brand-id.json": {
      "type": "string"
    },
    "external:core/assets/image-asset.json": {
      "type": "object",
      "properties": {
        "asset_type": {
          "type": "string",
          "const": "image"
        },
        "url": {
          "type": "string"
        },
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        },
        "file_size_bytes": {
          "type": "integer"
        },
        "pixel_ratio": {
          "type": "number"
        },
        "format": {
          "type": "string"
        },
        "alt_text": {
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/external:core~1provenance.json"
        }
      },
      "required": [
        "asset_type",
        "url",
        "width",
        "height"
      ],
      "additionalProperties": true
    },
    "external:core/provenance.json": {
      "type": "object",
      "properties": {
        "digital_source_type": {
          "$ref": "#/$defs/external:enums~1digital-source-type.json"
        },
        "synthetic_depiction": {
          "type": "boolean"
        },
        "ai_tool": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "provider": {
              "type": "string"
            }
          },
          "required": [
            "name"
          ]
        },
        "human_oversight": {
          "type": "string",
          "enum": [
            "none",
            "prompt_only",
            "selected",
            "edited",
            "directed"
          ]
        },
        "declared_by": {
          "type": "object",
          "properties": {
            "agent_url": {
              "type": "string"
            },
            "role": {
              "type": "string",
              "enum": [
                "creator",
                "advertiser",
                "agency",
                "platform",
                "tool"
              ]
            }
          },
          "required": [
            "role"
          ]
        },
        "declared_at": {
          "type": "string"
        },
        "created_time": {
          "type": "string"
        },
        "c2pa": {
          "type": "object",
          "properties": {
            "manifest_url": {
              "type": "string"
            }
          },
          "required": [
            "manifest_url"
          ]
        },
        "embedded_provenance": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "method": {
                "$ref": "#/$defs/external:enums~1embedded-provenance-method.json"
              },
              "standard": {
                "type": "string"
              },
              "provider": {
                "type": "string"
              },
              "verify_agent": {
                "type": "object",
                "properties": {
                  "agent_url": {
                    "type": "string"
                  },
                  "feature_id": {
                    "type": "string"
                  }
                },
                "required": [
                  "agent_url"
                ]
              },
              "embedded_at": {
                "type": "string"
              }
            },
            "required": [
              "method",
              "provider"
            ]
          }
        },
        "watermarks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "media_type": {
                "$ref": "#/$defs/external:enums~1watermark-media-type.json"
              },
              "provider": {
                "type": "string"
              },
              "verify_agent": {
                "type": "object",
                "properties": {
                  "agent_url": {
                    "type": "string"
                  },
                  "feature_id": {
                    "type": "string"
                  }
                },
                "required": [
                  "agent_url"
                ]
              },
              "c2pa_action": {
                "$ref": "#/$defs/external:enums~1c2pa-watermark-action.json"
              },
              "embedded_at": {
                "type": "string"
              }
            },
            "required": [
              "media_type",
              "provider"
            ]
          }
        },
        "disclosure": {
          "type": "object",
          "properties": {
            "required": {
              "type": "boolean"
            },
            "jurisdictions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "country": {
                    "type": "string"
                  },
                  "region": {
                    "type": "string"
                  },
                  "regulation": {
                    "type": "string"
                  },
                  "label_text": {
                    "type": "string"
                  },
                  "render_guidance": {
                    "type": "object",
                    "properties": {
                      "persistence": {
                        "$ref": "#/$defs/external:enums~1disclosure-persistence.json"
                      },
                      "min_duration_ms": {
                        "type": "integer"
                      },
                      "positions": {
                        "type": "array",
                        "items": {
                          "$ref": "#/$defs/external:enums~1disclosure-position.json"
                        }
                      },
                      "ext": {
                        "$ref": "#/$defs/external:core~1ext.json"
                      }
                    }
                  }
                },
                "required": [
                  "country",
                  "regulation"
                ]
              }
            }
          },
          "required": [
            "required"
          ]
        },
        "verification": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "verified_by": {
                "type": "string"
              },
              "verified_time": {
                "type": "string"
              },
              "result": {
                "type": "string",
                "enum": [
                  "authentic",
                  "ai_generated",
                  "ai_modified",
                  "inconclusive"
                ]
              },
              "confidence": {
                "type": "number"
              },
              "details_url": {
                "type": "string"
              }
            },
            "required": [
              "verified_by",
              "result"
            ]
          }
        },
        "ext": {
          "$ref": "#/$defs/external:core~1ext.json"
        }
      }
    },
    "external:enums/digital-source-type.json": {
      "type": "string",
      "enum": [
        "digital_capture",
        "digital_creation",
        "trained_algorithmic_media",
        "composite_with_trained_algorithmic_media",
        "algorithmic_media",
        "composite_capture",
        "composite_synthetic",
        "human_edits",
        "data_driven_media"
      ]
    },
    "external:enums/embedded-provenance-method.json": {
      "type": "string",
      "enum": [
        "manifest_wrapper",
        "provenance_markers"
      ]
    },
    "external:enums/watermark-media-type.json": {
      "type": "string",
      "enum": [
        "audio",
        "image",
        "video",
        "text"
      ]
    },
    "external:enums/c2pa-watermark-action.json": {
      "type": "string",
      "enum": [
        "c2pa.watermarked.bound",
        "c2pa.watermarked.unbound"
      ]
    },
    "external:enums/disclosure-persistence.json": {
      "type": "string",
      "enum": [
        "continuous",
        "initial",
        "flexible"
      ]
    },
    "external:enums/disclosure-position.json": {
      "type": "string",
      "enum": [
        "prominent",
        "footer",
        "audio",
        "subtitle",
        "overlay",
        "end_card",
        "pre_roll",
        "companion"
      ]
    },
    "external:core/ext.json": {
      "type": "object",
      "additionalProperties": true
    },
    "external:core/operator-unit.json": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ]
    },
    "external:core/operator-identity.json": {
      "type": "object",
      "properties": {
        "operator": {
          "type": "string"
        },
        "operator_unit": {
          "$ref": "#/$defs/external:core~1operator-unit.json"
        }
      },
      "required": [
        "operator"
      ]
    },
    "external:core/business-entity.json": {
      "type": "object",
      "properties": {
        "legal_name": {
          "type": "string"
        },
        "vat_id": {
          "type": "string"
        },
        "tax_id": {
          "type": "string"
        },
        "registration_number": {
          "type": "string"
        },
        "address": {
          "type": "object",
          "properties": {
            "street": {
              "type": "string"
            },
            "city": {
              "type": "string"
            },
            "postal_code": {
              "type": "string"
            },
            "region": {
              "type": "string"
            },
            "country": {
              "type": "string"
            }
          },
          "required": [
            "street",
            "city",
            "postal_code",
            "country"
          ]
        },
        "contacts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string",
                "enum": [
                  "billing",
                  "legal",
                  "creative",
                  "general"
                ]
              },
              "name": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "phone": {
                "type": "string"
              }
            },
            "required": [
              "role"
            ]
          }
        },
        "bank": {
          "type": "object",
          "properties": {
            "account_holder": {
              "type": "string"
            },
            "iban": {
              "type": "string"
            },
            "bic": {
              "type": "string"
            },
            "routing_number": {
              "type": "string"
            },
            "account_number": {
              "type": "string"
            }
          },
          "required": [
            "account_holder"
          ]
        },
        "ext": {
          "$ref": "#/$defs/external:core~1ext.json"
        }
      },
      "required": [
        "legal_name"
      ]
    },
    "external:enums/billing-party.json": {
      "type": "string",
      "enum": [
        "operator",
        "agent",
        "advertiser"
      ]
    },
    "external:enums/payment-terms.json": {
      "type": "string",
      "enum": [
        "net_15",
        "net_30",
        "net_45",
        "net_60",
        "net_90",
        "prepay"
      ]
    },
    "external:enums/cloud-storage-protocol.json": {
      "type": "string",
      "enum": [
        "s3",
        "gcs",
        "azure_blob"
      ]
    },
    "external:core/notification-config.json": {
      "type": "object",
      "properties": {
        "subscriber_id": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "event_types": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "creative.status_changed",
              "creative.assignment_changed",
              "indicators.changed",
              "creative.purged",
              "account.status_changed",
              "product.created",
              "product.updated",
              "product.priced",
              "product.removed",
              "signal.created",
              "signal.updated",
              "signal.priced",
              "signal.removed",
              "wholesale_feed.bulk_change"
            ]
          }
        },
        "product_payload_view": {
          "type": "string",
          "enum": [
            "canonical",
            "legacy"
          ]
        },
        "authentication": {
          "type": "object",
          "properties": {
            "schemes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/external:enums~1auth-scheme.json"
              }
            },
            "credentials": {
              "type": "string"
            }
          },
          "required": [
            "schemes"
          ]
        },
        "active": {
          "type": "boolean"
        },
        "ext": {
          "$ref": "#/$defs/external:core~1ext.json"
        }
      },
      "required": [
        "subscriber_id",
        "url",
        "event_types"
      ],
      "allOf": [
        {
          "if": {
            "required": [
              "product_payload_view"
            ]
          },
          "then": {
            "properties": {
              "event_types": {
                "contains": {
                  "enum": [
                    "product.created",
                    "product.updated",
                    "product.priced",
                    "product.removed"
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "external:enums/auth-scheme.json": {
      "type": "string",
      "enum": [
        "Bearer",
        "HMAC-SHA256"
      ]
    },
    "external:core/push-notification-config.json": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "operation_id": {
          "type": "string"
        },
        "token": {
          "type": "string"
        },
        "authentication": {
          "type": "object",
          "properties": {
            "schemes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/external:enums~1auth-scheme.json"
              }
            },
            "credentials": {
              "type": "string"
            }
          },
          "required": [
            "schemes",
            "credentials"
          ]
        }
      },
      "required": [
        "url"
      ]
    },
    "external:core/context.json": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
