{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adcontextprotocol.org/schemas/3.2.0-beta.1/mcp/2026-07-28/profiles/media-buy/protocol/sync-agent-notification-configs-request.json",
  "type": "object",
  "allOf": [
    {
      "$ref": "#/$defs/external:core~1version-envelope.json"
    }
  ],
  "x-mutates-state": true,
  "properties": {
    "idempotency_key": {
      "type": "string",
      "minLength": 16,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9_.:-]{16,255}$"
    },
    "notification_configs": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/external:core~1agent-notification-config.json"
          },
          {
            "if": {
              "required": [
                "authentication"
              ]
            },
            "then": {
              "properties": {
                "authentication": {
                  "required": [
                    "credentials"
                  ]
                }
              }
            }
          }
        ]
      },
      "maxItems": 16
    },
    "dry_run": {
      "type": "boolean",
      "default": false
    },
    "context": {
      "$ref": "#/$defs/external:core~1context.json"
    },
    "ext": {
      "$ref": "#/$defs/external:core~1ext.json"
    }
  },
  "required": [
    "idempotency_key",
    "notification_configs"
  ],
  "additionalProperties": true,
  "$defs": {
    "external:core/version-envelope.json": {
      "type": "object",
      "properties": {
        "adcp_version": {
          "type": "string",
          "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-[a-zA-Z0-9](?:[a-zA-Z0-9.-]*[a-zA-Z0-9])?)?$"
        },
        "adcp_major_version": {
          "type": "integer",
          "deprecated": true,
          "minimum": 1,
          "maximum": 99
        }
      }
    },
    "external:core/agent-notification-config.json": {
      "type": "object",
      "properties": {
        "subscriber_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_.:-]{1,64}$"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "event_types": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "capabilities.changed"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "authentication": {
          "type": "object",
          "deprecated": true,
          "properties": {
            "schemes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/external:enums~1auth-scheme.json"
              },
              "minItems": 1,
              "maxItems": 1
            },
            "credentials": {
              "type": "string",
              "minLength": 32
            }
          },
          "required": [
            "schemes"
          ],
          "additionalProperties": false
        },
        "active": {
          "type": "boolean",
          "default": true
        },
        "ext": {
          "$ref": "#/$defs/external:core~1ext.json"
        }
      },
      "required": [
        "subscriber_id",
        "url",
        "event_types"
      ],
      "additionalProperties": false
    },
    "external:enums/auth-scheme.json": {
      "deprecated": true,
      "type": "string",
      "enum": [
        "Bearer",
        "HMAC-SHA256"
      ]
    },
    "external:core/ext.json": {
      "type": "object",
      "additionalProperties": true
    },
    "external:core/context.json": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
