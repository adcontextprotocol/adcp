{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adcontextprotocol.org/schemas/3.2.0-beta.1/mcp/2026-07-28/profiles/production/media-buy/sync-catalogs-request.json",
  "type": "object",
  "allOf": [
    {
      "$ref": "#/$defs/external:core~1version-envelope.json"
    },
    {
      "not": {
        "properties": {
          "dry_run": {
            "const": true
          }
        },
        "required": [
          "dry_run",
          "item_availability_updates"
        ]
      },
      "errorMessage": "dry_run cannot be combined with item_availability_updates because immediate availability acknowledgements represent applied state, not a preview"
    }
  ],
  "x-mutates-state": true,
  "properties": {
    "idempotency_key": {
      "type": "string",
      "minLength": 16,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9_.:-]{16,255}$"
    },
    "account": {
      "$ref": "#/$defs/external:core~1account-ref.json"
    },
    "catalogs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/external:core~1catalog.json"
      },
      "minItems": 1,
      "maxItems": 50
    },
    "item_availability_updates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/external:core~1catalog-item-availability-update.json"
      },
      "minItems": 1,
      "maxItems": 1000
    },
    "item_availability_queries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/external:core~1catalog-item-availability-ref.json"
      },
      "minItems": 1,
      "maxItems": 1000
    },
    "catalog_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "x-entity": "catalog"
      },
      "minItems": 1,
      "maxItems": 50
    },
    "delete_missing": {
      "type": "boolean",
      "default": false
    },
    "dry_run": {
      "type": "boolean",
      "default": false
    },
    "validation_mode": {
      "$ref": "#/$defs/external:enums~1validation-mode.json",
      "default": "strict"
    },
    "push_notification_config": {
      "$ref": "#/$defs/external:core~1push-notification-config.json"
    },
    "context": {
      "$ref": "#/$defs/external:core~1context.json"
    },
    "ext": {
      "$ref": "#/$defs/external:core~1ext.json"
    }
  },
  "required": [
    "idempotency_key",
    "account"
  ],
  "if": {
    "properties": {
      "delete_missing": {
        "const": true
      }
    },
    "required": [
      "delete_missing"
    ]
  },
  "then": {
    "required": [
      "catalogs"
    ],
    "errorMessage": "catalogs is required when delete_missing is true — omitting it would delete all buyer-managed catalogs on the account"
  },
  "additionalProperties": true,
  "$defs": {
    "external:core/version-envelope.json": {
      "type": "object",
      "properties": {
        "adcp_version": {
          "type": "string",
          "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-[a-zA-Z0-9](?:[a-zA-Z0-9.-]*[a-zA-Z0-9])?)?$"
        },
        "adcp_major_version": {
          "type": "integer",
          "deprecated": true,
          "minimum": 1,
          "maximum": 99
        }
      }
    },
    "external:core/account-ref.json": {
      "type": "object",
      "oneOf": [
        {
          "properties": {
            "account_id": {
              "type": "string",
              "x-entity": "account"
            }
          },
          "required": [
            "account_id"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "brand": {
              "$ref": "#/$defs/external:core~1brand-ref.json"
            },
            "operator": {
              "type": "string",
              "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$",
              "x-entity": "operator"
            },
            "operator_unit": {
              "$ref": "#/$defs/external:core~1operator-unit.json"
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "timezone": {
              "type": "string",
              "minLength": 1
            },
            "sandbox": {
              "type": "boolean",
              "default": false
            }
          },
          "required": [
            "brand",
            "operator"
          ],
          "additionalProperties": false
        }
      ]
    },
    "external:core/brand-ref.json": {
      "type": "object",
      "properties": {
        "domain": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$"
        },
        "brand_id": {
          "$ref": "#/$defs/external:core~1brand-id.json"
        },
        "countries": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "industries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "data_subject_contestation": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            "email": {
              "type": "string",
              "format": "email"
            },
            "languages": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "anyOf": [
            {
              "required": [
                "url"
              ]
            },
            {
              "required": [
                "email"
              ]
            }
          ],
          "additionalProperties": false
        },
        "brand_kit_override": {
          "type": "object",
          "properties": {
            "logo": {
              "$ref": "#/$defs/external:core~1assets~1image-asset.json"
            },
            "colors": {
              "type": "object",
              "properties": {
                "primary": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "secondary": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "accent": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                }
              },
              "additionalProperties": true
            },
            "voice": {
              "type": "string"
            },
            "tagline": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      },
      "required": [
        "domain"
      ],
      "additionalProperties": false
    },
    "external:core/brand-id.json": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "x-entity": "advertiser_brand"
    },
    "external:core/assets/image-asset.json": {
      "type": "object",
      "properties": {
        "asset_type": {
          "type": "string",
          "const": "image"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "file_size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "pixel_ratio": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "format": {
          "type": "string"
        },
        "alt_text": {
          "type": "string",
          "x-accessibility": true
        },
        "provenance": {
          "$ref": "#/$defs/external:core~1provenance.json"
        }
      },
      "required": [
        "asset_type",
        "url",
        "width",
        "height"
      ],
      "additionalProperties": true
    },
    "external:core/provenance.json": {
      "type": "object",
      "properties": {
        "digital_source_type": {
          "$ref": "#/$defs/external:enums~1digital-source-type.json"
        },
        "synthetic_depiction": {
          "type": "boolean"
        },
        "ai_tool": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "provider": {
              "type": "string"
            }
          },
          "required": [
            "name"
          ]
        },
        "human_oversight": {
          "type": "string",
          "enum": [
            "none",
            "prompt_only",
            "selected",
            "edited",
            "directed"
          ]
        },
        "declared_by": {
          "type": "object",
          "properties": {
            "agent_url": {
              "type": "string",
              "format": "uri"
            },
            "role": {
              "type": "string",
              "enum": [
                "creator",
                "advertiser",
                "agency",
                "platform",
                "tool"
              ]
            }
          },
          "required": [
            "role"
          ]
        },
        "declared_at": {
          "type": "string",
          "format": "date-time"
        },
        "created_time": {
          "type": "string",
          "format": "date-time"
        },
        "c2pa": {
          "type": "object",
          "properties": {
            "manifest_url": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "manifest_url"
          ]
        },
        "embedded_provenance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "method": {
                "$ref": "#/$defs/external:enums~1embedded-provenance-method.json"
              },
              "standard": {
                "type": "string"
              },
              "provider": {
                "type": "string"
              },
              "verify_agent": {
                "type": "object",
                "properties": {
                  "agent_url": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https://"
                  },
                  "feature_id": {
                    "type": "string"
                  }
                },
                "required": [
                  "agent_url"
                ],
                "additionalProperties": false
              },
              "embedded_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "method",
              "provider"
            ]
          }
        },
        "watermarks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "media_type": {
                "$ref": "#/$defs/external:enums~1watermark-media-type.json"
              },
              "provider": {
                "type": "string"
              },
              "verify_agent": {
                "type": "object",
                "properties": {
                  "agent_url": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https://"
                  },
                  "feature_id": {
                    "type": "string"
                  }
                },
                "required": [
                  "agent_url"
                ],
                "additionalProperties": false
              },
              "c2pa_action": {
                "$ref": "#/$defs/external:enums~1c2pa-watermark-action.json"
              },
              "embedded_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "media_type",
              "provider"
            ]
          }
        },
        "disclosure": {
          "type": "object",
          "properties": {
            "required": {
              "type": "boolean"
            },
            "jurisdictions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "country": {
                    "type": "string"
                  },
                  "region": {
                    "type": "string"
                  },
                  "regulation": {
                    "type": "string"
                  },
                  "label_text": {
                    "type": "string"
                  },
                  "render_guidance": {
                    "type": "object",
                    "minProperties": 1,
                    "properties": {
                      "persistence": {
                        "$ref": "#/$defs/external:enums~1disclosure-persistence.json"
                      },
                      "min_duration_ms": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "positions": {
                        "type": "array",
                        "items": {
                          "$ref": "#/$defs/external:enums~1disclosure-position.json"
                        },
                        "minItems": 1,
                        "uniqueItems": true
                      },
                      "ext": {
                        "$ref": "#/$defs/external:core~1ext.json"
                      }
                    }
                  }
                },
                "required": [
                  "country",
                  "regulation"
                ]
              },
              "minItems": 1
            }
          },
          "required": [
            "required"
          ]
        },
        "verification": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "verified_by": {
                "type": "string"
              },
              "verified_time": {
                "type": "string",
                "format": "date-time"
              },
              "result": {
                "type": "string",
                "enum": [
                  "authentic",
                  "ai_generated",
                  "ai_modified",
                  "inconclusive"
                ]
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "details_url": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "verified_by",
              "result"
            ]
          }
        },
        "ext": {
          "$ref": "#/$defs/external:core~1ext.json"
        }
      }
    },
    "external:enums/digital-source-type.json": {
      "type": "string",
      "enum": [
        "digital_capture",
        "digital_creation",
        "trained_algorithmic_media",
        "composite_with_trained_algorithmic_media",
        "algorithmic_media",
        "composite_capture",
        "composite_synthetic",
        "human_edits",
        "data_driven_media"
      ]
    },
    "external:enums/embedded-provenance-method.json": {
      "type": "string",
      "enum": [
        "manifest_wrapper",
        "provenance_markers"
      ]
    },
    "external:enums/watermark-media-type.json": {
      "type": "string",
      "enum": [
        "audio",
        "image",
        "video",
        "text"
      ]
    },
    "external:enums/c2pa-watermark-action.json": {
      "type": "string",
      "enum": [
        "c2pa.watermarked.bound",
        "c2pa.watermarked.unbound"
      ]
    },
    "external:enums/disclosure-persistence.json": {
      "type": "string",
      "enum": [
        "continuous",
        "initial",
        "flexible"
      ]
    },
    "external:enums/disclosure-position.json": {
      "type": "string",
      "enum": [
        "prominent",
        "footer",
        "audio",
        "subtitle",
        "overlay",
        "end_card",
        "pre_roll",
        "companion"
      ]
    },
    "external:core/ext.json": {
      "type": "object",
      "additionalProperties": true
    },
    "external:core/operator-unit.json": {
      "x-entity": "operator_unit",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "external:core/catalog.json": {
      "type": "object",
      "properties": {
        "catalog_id": {
          "type": "string",
          "x-entity": "catalog"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/external:enums~1catalog-type.json"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "feed_format": {
          "$ref": "#/$defs/external:enums~1feed-format.json"
        },
        "update_frequency": {
          "$ref": "#/$defs/external:enums~1update-frequency.json"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "minItems": 1
        },
        "ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "gtins": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]{8,14}$"
          },
          "minItems": 1
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "category": {
          "type": "string"
        },
        "query": {
          "type": "string"
        },
        "conversion_events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/external:enums~1event-type.json"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "content_id_type": {
          "$ref": "#/$defs/external:enums~1content-id-type.json"
        },
        "feed_field_mappings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/external:core~1catalog-field-mapping.json"
          },
          "minItems": 1
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": true
    },
    "external:enums/catalog-type.json": {
      "type": "string",
      "enum": [
        "offering",
        "product",
        "inventory",
        "store",
        "promotion",
        "hotel",
        "flight",
        "job",
        "vehicle",
        "real_estate",
        "education",
        "destination",
        "app"
      ]
    },
    "external:enums/feed-format.json": {
      "type": "string",
      "enum": [
        "google_merchant_center",
        "facebook_catalog",
        "shopify",
        "linkedin_jobs",
        "tiktok_shop",
        "pinterest_catalog",
        "openai_product_feed",
        "custom"
      ]
    },
    "external:enums/update-frequency.json": {
      "type": "string",
      "enum": [
        "realtime",
        "hourly",
        "daily",
        "weekly"
      ]
    },
    "external:enums/event-type.json": {
      "type": "string",
      "enum": [
        "page_view",
        "view_content",
        "select_content",
        "select_item",
        "search",
        "share",
        "add_to_cart",
        "remove_from_cart",
        "viewed_cart",
        "add_to_wishlist",
        "initiate_checkout",
        "add_payment_info",
        "purchase",
        "refund",
        "lead",
        "qualify_lead",
        "close_convert_lead",
        "disqualify_lead",
        "complete_registration",
        "subscribe",
        "follow",
        "content_view",
        "watch_milestone",
        "start_trial",
        "app_install",
        "app_launch",
        "contact",
        "schedule",
        "donate",
        "submit_application",
        "custom"
      ]
    },
    "external:enums/content-id-type.json": {
      "type": "string",
      "enum": [
        "sku",
        "gtin",
        "offering_id",
        "job_id",
        "hotel_id",
        "flight_id",
        "vehicle_id",
        "listing_id",
        "store_id",
        "program_id",
        "destination_id",
        "app_id"
      ]
    },
    "external:core/catalog-field-mapping.json": {
      "type": "object",
      "properties": {
        "feed_field": {
          "type": "string"
        },
        "catalog_field": {
          "type": "string"
        },
        "asset_group_id": {
          "type": "string"
        },
        "value": {},
        "transform": {
          "type": "string",
          "enum": [
            "date",
            "divide",
            "boolean",
            "split"
          ]
        },
        "format": {
          "type": "string"
        },
        "timezone": {
          "type": "string"
        },
        "by": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "separator": {
          "type": "string",
          "default": ","
        },
        "default": {},
        "ext": {
          "$ref": "#/$defs/external:core~1ext.json"
        }
      },
      "allOf": [
        {
          "not": {
            "required": [
              "feed_field",
              "value"
            ]
          }
        },
        {
          "not": {
            "required": [
              "catalog_field",
              "asset_group_id"
            ]
          }
        }
      ],
      "additionalProperties": true
    },
    "external:core/catalog-item-availability-update.json": {
      "type": "object",
      "properties": {
        "catalog_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "x-entity": "catalog"
        },
        "catalog_generation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "x-entity": "catalog_generation"
        },
        "item_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "x-entity": "catalog_item"
        },
        "expected_overlay_revision": {
          "type": "integer",
          "minimum": 0
        },
        "action": {
          "type": "string",
          "enum": [
            "suppress",
            "restore"
          ]
        },
        "reason": {
          "type": "string",
          "enum": [
            "out_of_stock",
            "back_in_stock",
            "content_unavailable",
            "content_available",
            "promotion_start",
            "promotion_end",
            "time_window_started",
            "time_window_expired",
            "buyer_request",
            "other"
          ]
        },
        "reason_detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "ext": {
          "$ref": "#/$defs/external:core~1ext.json"
        }
      },
      "required": [
        "catalog_id",
        "catalog_generation",
        "item_id",
        "expected_overlay_revision",
        "action",
        "reason"
      ],
      "if": {
        "properties": {
          "reason": {
            "const": "other"
          }
        },
        "required": [
          "reason"
        ]
      },
      "then": {
        "required": [
          "reason_detail"
        ]
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "suppress"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "properties": {
              "reason": {
                "enum": [
                  "out_of_stock",
                  "content_unavailable",
