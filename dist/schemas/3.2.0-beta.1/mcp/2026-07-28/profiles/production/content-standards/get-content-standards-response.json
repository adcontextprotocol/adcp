                  "type": "object",
                  "properties": {
                    "property_name": {
                      "type": "string"
                    },
                    "value": {
                      "type": [
                        "string",
                        "number",
                        "boolean",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "property_name",
                    "value"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "pointer",
              "message",
              "keyword"
            ],
            "additionalProperties": true
          }
        },
        "details": {
          "type": "object",
          "additionalProperties": true
        },
        "recovery": {
          "type": "string",
          "enum": [
            "transient",
            "correctable",
            "terminal"
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "producer",
            "sdk"
          ]
        },
        "sdk_id": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": true
    },
    "external:core/push-notification-config.json": {
      "type": "object",
