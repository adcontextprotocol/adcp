{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adcontextprotocol.org/schemas/3.2.0-beta.1/mcp/2026-07-28/profiles/production/collection/create-collection-list-request.json",
  "type": "object",
  "allOf": [
    {
      "$ref": "#/$defs/external:core~1version-envelope.json"
    }
  ],
  "x-mutates-state": true,
  "properties": {
    "account": {
      "$ref": "#/$defs/external:core~1account-ref.json"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "base_collections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/external:collection~1base-collection-source.json"
      },
      "minItems": 1
    },
    "filters": {
      "$ref": "#/$defs/external:collection~1collection-list-filters.json"
    },
    "brand": {
      "$ref": "#/$defs/external:core~1brand-ref.json"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 16,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9_.:-]{16,255}$"
    },
    "context": {
      "$ref": "#/$defs/external:core~1context.json"
    },
    "ext": {
      "$ref": "#/$defs/external:core~1ext.json"
    }
  },
  "required": [
    "idempotency_key",
    "name"
  ],
  "additionalProperties": true,
  "$defs": {
    "external:core/version-envelope.json": {
      "type": "object",
      "properties": {
        "adcp_version": {
          "type": "string",
          "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-[a-zA-Z0-9](?:[a-zA-Z0-9.-]*[a-zA-Z0-9])?)?$"
        },
        "adcp_major_version": {
          "type": "integer",
          "deprecated": true,
          "minimum": 1,
          "maximum": 99
        }
      }
    },
    "external:core/account-ref.json": {
      "type": "object",
      "oneOf": [
        {
          "properties": {
            "account_id": {
              "type": "string",
              "x-entity": "account"
            }
          },
          "required": [
            "account_id"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "brand": {
              "$ref": "#/$defs/external:core~1brand-ref.json"
            },
            "operator": {
              "type": "string",
              "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$",
              "x-entity": "operator"
            },
            "operator_unit": {
              "$ref": "#/$defs/external:core~1operator-unit.json"
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "timezone": {
              "type": "string",
              "minLength": 1
            },
            "sandbox": {
              "type": "boolean",
              "default": false
            }
          },
          "required": [
            "brand",
            "operator"
          ],
          "additionalProperties": false
        }
      ]
    },
    "external:core/brand-ref.json": {
      "type": "object",
      "properties": {
        "domain": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$"
        },
        "brand_id": {
          "$ref": "#/$defs/external:core~1brand-id.json"
        },
        "countries": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "industries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "data_subject_contestation": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            "email": {
              "type": "string",
              "format": "email"
            },
            "languages": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "anyOf": [
            {
              "required": [
                "url"
              ]
            },
            {
              "required": [
                "email"
              ]
            }
          ],
          "additionalProperties": false
        },
        "brand_kit_override": {
          "type": "object",
          "properties": {
            "logo": {
              "$ref": "#/$defs/external:core~1assets~1image-asset.json"
            },
            "colors": {
              "type": "object",
              "properties": {
                "primary": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "secondary": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "accent": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                }
              },
              "additionalProperties": true
            },
            "voice": {
              "type": "string"
            },
            "tagline": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      },
      "required": [
        "domain"
      ],
      "additionalProperties": false
    },
    "external:core/brand-id.json": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "x-entity": "advertiser_brand"
    },
    "external:core/assets/image-asset.json": {
      "type": "object",
      "properties": {
        "asset_type": {
          "type": "string",
          "const": "image"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "file_size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "pixel_ratio": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "format": {
          "type": "string"
        },
        "alt_text": {
          "type": "string",
          "x-accessibility": true
        },
        "provenance": {
          "$ref": "#/$defs/external:core~1provenance.json"
        }
      },
      "required": [
        "asset_type",
        "url",
        "width",
        "height"
      ],
      "additionalProperties": true
    },
    "external:core/provenance.json": {
      "type": "object",
      "properties": {
        "digital_source_type": {
          "$ref": "#/$defs/external:enums~1digital-source-type.json"
        },
        "synthetic_depiction": {
          "type": "boolean"
        },
        "ai_tool": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "provider": {
              "type": "string"
            }
          },
          "required": [
            "name"
          ]
        },
        "human_oversight": {
          "type": "string",
          "enum": [
            "none",
            "prompt_only",
            "selected",
            "edited",
            "directed"
          ]
        },
        "declared_by": {
          "type": "object",
          "properties": {
            "agent_url": {
              "type": "string",
              "format": "uri"
            },
            "role": {
              "type": "string",
              "enum": [
                "creator",
                "advertiser",
                "agency",
                "platform",
                "tool"
              ]
            }
          },
          "required": [
            "role"
          ]
        },
        "declared_at": {
          "type": "string",
          "format": "date-time"
        },
        "created_time": {
          "type": "string",
          "format": "date-time"
        },
        "c2pa": {
          "type": "object",
          "properties": {
            "manifest_url": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "manifest_url"
          ]
        },
        "embedded_provenance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "method": {
                "$ref": "#/$defs/external:enums~1embedded-provenance-method.json"
              },
              "standard": {
                "type": "string"
              },
              "provider": {
                "type": "string"
              },
              "verify_agent": {
                "type": "object",
                "properties": {
                  "agent_url": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https://"
                  },
                  "feature_id": {
                    "type": "string"
                  }
                },
                "required": [
                  "agent_url"
                ],
                "additionalProperties": false
              },
              "embedded_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "method",
              "provider"
            ]
          }
        },
        "watermarks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "media_type": {
                "$ref": "#/$defs/external:enums~1watermark-media-type.json"
              },
              "provider": {
                "type": "string"
              },
              "verify_agent": {
                "type": "object",
                "properties": {
                  "agent_url": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https://"
                  },
                  "feature_id": {
                    "type": "string"
                  }
                },
                "required": [
                  "agent_url"
                ],
                "additionalProperties": false
              },
              "c2pa_action": {
                "$ref": "#/$defs/external:enums~1c2pa-watermark-action.json"
              },
              "embedded_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "media_type",
              "provider"
            ]
          }
        },
        "disclosure": {
          "type": "object",
          "properties": {
            "required": {
              "type": "boolean"
            },
            "jurisdictions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "country": {
                    "type": "string"
                  },
                  "region": {
                    "type": "string"
                  },
                  "regulation": {
                    "type": "string"
                  },
                  "label_text": {
                    "type": "string"
                  },
                  "render_guidance": {
                    "type": "object",
                    "minProperties": 1,
                    "properties": {
                      "persistence": {
                        "$ref": "#/$defs/external:enums~1disclosure-persistence.json"
                      },
                      "min_duration_ms": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "positions": {
                        "type": "array",
                        "items": {
                          "$ref": "#/$defs/external:enums~1disclosure-position.json"
                        },
                        "minItems": 1,
                        "uniqueItems": true
                      },
                      "ext": {
                        "$ref": "#/$defs/external:core~1ext.json"
                      }
                    }
                  }
                },
                "required": [
                  "country",
                  "regulation"
                ]
              },
              "minItems": 1
            }
          },
          "required": [
            "required"
          ]
        },
        "verification": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "verified_by": {
                "type": "string"
              },
              "verified_time": {
                "type": "string",
                "format": "date-time"
              },
              "result": {
                "type": "string",
                "enum": [
                  "authentic",
                  "ai_generated",
                  "ai_modified",
                  "inconclusive"
                ]
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "details_url": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "verified_by",
              "result"
            ]
          }
        },
        "ext": {
          "$ref": "#/$defs/external:core~1ext.json"
        }
      }
    },
    "external:enums/digital-source-type.json": {
      "type": "string",
      "enum": [
        "digital_capture",
        "digital_creation",
        "trained_algorithmic_media",
        "composite_with_trained_algorithmic_media",
        "algorithmic_media",
        "composite_capture",
        "composite_synthetic",
        "human_edits",
        "data_driven_media"
      ]
    },
    "external:enums/embedded-provenance-method.json": {
      "type": "string",
      "enum": [
        "manifest_wrapper",
        "provenance_markers"
      ]
    },
    "external:enums/watermark-media-type.json": {
      "type": "string",
      "enum": [
        "audio",
        "image",
        "video",
        "text"
      ]
    },
    "external:enums/c2pa-watermark-action.json": {
      "type": "string",
      "enum": [
        "c2pa.watermarked.bound",
        "c2pa.watermarked.unbound"
      ]
    },
    "external:enums/disclosure-persistence.json": {
      "type": "string",
      "enum": [
        "continuous",
        "initial",
        "flexible"
      ]
    },
    "external:enums/disclosure-position.json": {
      "type": "string",
      "enum": [
        "prominent",
        "footer",
        "audio",
        "subtitle",
        "overlay",
        "end_card",
        "pre_roll",
        "companion"
      ]
    },
    "external:core/ext.json": {
      "type": "object",
      "additionalProperties": true
    },
    "external:core/operator-unit.json": {
      "x-entity": "operator_unit",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "external:collection/base-collection-source.json": {
      "discriminator": {
        "propertyName": "selection_type"
      },
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "selection_type": {
              "type": "string",
              "const": "distribution_ids"
            },
            "identifiers": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "type": {
                    "$ref": "#/$defs/external:enums~1distribution-identifier-type.json"
                  },
                  "value": {
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "value"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            }
          },
          "required": [
            "selection_type",
            "identifiers"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "selection_type": {
              "type": "string",
              "const": "publisher_collections"
            },
            "publisher_domain": {
              "type": "string",
              "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$"
            },
            "collection_ids": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          },
          "required": [
            "selection_type",
            "publisher_domain",
            "collection_ids"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "selection_type": {
              "type": "string",
              "const": "publisher_genres"
            },
            "publisher_domain": {
              "type": "string",
              "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$"
            },
            "genres": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "genre_taxonomy": {
              "$ref": "#/$defs/external:enums~1genre-taxonomy.json"
            }
          },
          "required": [
            "selection_type",
            "publisher_domain",
            "genres",
            "genre_taxonomy"
          ],
          "additionalProperties": false
        }
      ]
    },
    "external:enums/distribution-identifier-type.json": {
      "type": "string",
      "enum": [
        "apple_podcast_id",
        "spotify_collection_id",
        "rss_url",
        "podcast_guid",
        "amazon_music_id",
        "iheart_id",
        "podcast_index_id",
        "youtube_channel_id",
        "youtube_channel_handle",
        "youtube_channel_url",
        "youtube_playlist_id",
        "amazon_title_id",
        "roku_channel_id",
        "pluto_channel_id",
        "tubi_id",
        "peacock_id",
        "tiktok_id",
        "twitch_channel",
        "imdb_id",
        "gracenote_id",
        "eidr_id",
        "domain",
        "substack_id"
      ]
    },
    "external:enums/genre-taxonomy.json": {
      "type": "string",
      "enum": [
        "iab_content_3.0",
        "iab_content_2.2",
        "gracenote",
        "eidr",
        "apple_genres",
        "google_genres",
        "roku",
        "amazon_genres",
        "custom"
      ]
    },
    "external:collection/collection-list-filters.json": {
      "type": "object",
      "properties": {
        "content_ratings_exclude": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/external:core~1content-rating.json"
          },
          "minItems": 1
        },
        "content_ratings_include": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/external:core~1content-rating.json"
          },
          "minItems": 1
        },
        "genres_exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "genres_include": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "genre_taxonomy": {
          "$ref": "#/$defs/external:enums~1genre-taxonomy.json"
        },
        "kinds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/external:enums~1collection-kind.json"
          },
          "minItems": 1
        },
        "exclude_distribution_ids": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "$ref": "#/$defs/external:enums~1distribution-identifier-type.json"
              },
              "value": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "value"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "production_quality": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/external:enums~1production-quality.json"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "external:core/content-rating.json": {
      "type": "object",
      "properties": {
        "system": {
          "$ref": "#/$defs/external:enums~1content-rating-system.json"
        },
        "rating": {
          "type": "string"
        }
      },
      "required": [
        "system",
        "rating"
      ],
      "additionalProperties": true
    },
    "external:enums/content-rating-system.json": {
      "type": "string",
      "enum": [
        "tv_parental",
        "mpaa",
        "podcast",
        "esrb",
        "bbfc",
        "fsk",
        "acb",
        "chvrs",
        "csa",
        "pegi",
        "custom"
      ]
    },
    "external:enums/collection-kind.json": {
      "type": "string",
      "enum": [
        "series",
        "publication",
        "event_series",
        "rotation"
      ]
    },
    "external:enums/production-quality.json": {
      "type": "string",
      "enum": [
        "professional",
        "prosumer",
        "ugc"
      ]
    },
    "external:core/context.json": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
