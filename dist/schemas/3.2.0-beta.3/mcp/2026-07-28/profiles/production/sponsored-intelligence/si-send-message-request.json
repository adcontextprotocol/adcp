{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adcontextprotocol.org/schemas/3.2.0-beta.3/mcp/2026-07-28/profiles/production/sponsored-intelligence/si-send-message-request.json",
  "type": "object",
  "x-status": "experimental",
  "x-mutates-state": true,
  "properties": {
    "adcp_version": {
      "type": "string",
      "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-[a-zA-Z0-9](?:[a-zA-Z0-9.-]*[a-zA-Z0-9])?)?$",
      "description": "Release-precision AdCP version (VERSION.RELEASE, e.g. \"3.0\", \"3.1\", \"3.1-beta\"). On a request: the buyer's release pin — the seller validates against its supported_versions and returns VERSION_UNSUPPORTED on cross-major mismatch, or downshifts to the highest supported release within the same major. On a response: the release the seller actually served — clients SHOULD validate the response against that release's schema, not against their pin. Patches are not negotiated; surface them as build_version on capabilities for operational visibility. When omitted, falls back to adcp_major_version (deprecated) or server default. Buyers SHOULD emit both adcp_version and adcp_major_version through 3.x to remain compatible with sellers that only read the legacy field. NORMALIZATION: SDKs that read full-semver values from bundle metadata (e.g. ComplianceIndex.published_version = \"3.1.0-beta.1\") MUST normalize to release-precision (\"3.1-beta.1\") before emitting on the wire — meta-field values are NOT valid wire values."
    },
    "adcp_major_version": {
      "type": "integer",
      "deprecated": true,
      "minimum": 1,
      "maximum": 99,
      "description": "DEPRECATED in favor of adcp_version (release-precision string). Servers MUST continue to honor this field through 3.x. Removed in 4.0. Original semantics: the AdCP major version the buyer's payloads conform to. Sellers validate against their supported major_versions and return VERSION_UNSUPPORTED if unsupported. When omitted, the seller assumes its highest supported version."
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 16,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9_.:-]{16,255}$"
    },
    "session_id": {
      "type": "string",
      "x-entity": "si_session"
    },
    "message": {
      "type": "string",
      "description": "User's message to the brand agent"
    },
    "action_response": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string"
        },
        "payload": {
          "type": "object"
        }
      },
      "additionalProperties": true,
      "description": "Response to a previous action_button (e.g., user clicked checkout)"
    },
    "sponsored_context_receipt": {
      "$ref": "#/$defs/external:sponsored-intelligence~1si-sponsored-context-receipt.json"
    },
    "context": {
      "$ref": "#/$defs/external:core~1context.json"
    },
    "ext": {
      "$ref": "#/$defs/external:core~1ext.json"
    }
  },
  "required": [
    "idempotency_key",
    "session_id"
  ],
  "additionalProperties": true,
  "$defs": {
    "external:core/version-envelope.json": {
      "type": "object",
      "properties": {
        "adcp_version": {
          "type": "string",
          "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-[a-zA-Z0-9](?:[a-zA-Z0-9.-]*[a-zA-Z0-9])?)?$"
        },
        "adcp_major_version": {
          "type": "integer",
          "deprecated": true,
          "minimum": 1,
          "maximum": 99
        }
      }
    },
    "external:sponsored-intelligence/si-sponsored-context-receipt.json": {
      "x-status": "experimental",
      "type": "object",
      "properties": {
        "sponsored_context": {
          "$ref": "#/$defs/external:sponsored-intelligence~1si-sponsored-context.json"
        },
        "host_receipt": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "accepted",
                "rejected"
              ]
            },
            "accepted_context_use": {
              "$ref": "#/$defs/external:sponsored-intelligence~1si-context-use.json"
            },
            "received_at": {
              "type": "string",
              "format": "date-time"
            },
            "host_surface": {
              "type": "string"
            },
            "disclosure_commitment": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "accepted",
                    "not_required"
                  ]
                },
                "label_text": {
                  "type": "string"
                },
                "notes": {
                  "type": "string"
                }
              },
              "required": [
                "status"
              ],
              "additionalProperties": true
            },
            "rejection_reason": {
              "type": "string"
            }
          },
          "required": [
            "status",
            "received_at"
          ],
          "additionalProperties": true,
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "accepted"
                  }
                },
                "required": [
                  "status"
                ]
              },
              "then": {
                "required": [
                  "accepted_context_use",
                  "disclosure_commitment"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "rejected"
                  }
                },
                "required": [
                  "status"
                ]
              },
              "then": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "accepted_context_use"
                      ]
                    },
                    {
                      "required": [
                        "disclosure_commitment"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        },
        "ext": {
          "$ref": "#/$defs/external:core~1ext.json"
        }
      },
      "required": [
        "sponsored_context",
        "host_receipt"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "sponsored_context": {
                "properties": {
                  "context_use": {
                    "const": "presentation_only"
                  }
                },
                "required": [
                  "context_use"
                ]
              },
              "host_receipt": {
                "properties": {
                  "status": {
                    "const": "accepted"
                  }
                },
                "required": [
                  "status"
                ]
              }
            },
            "required": [
              "sponsored_context",
              "host_receipt"
            ]
          },
          "then": {
            "properties": {
              "host_receipt": {
                "properties": {
                  "accepted_context_use": {
                    "const": "presentation_only"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "sponsored_context": {
                "properties": {
                  "context_use": {
                    "const": "comparison_set"
                  }
                },
                "required": [
                  "context_use"
                ]
              },
              "host_receipt": {
                "properties": {
                  "status": {
                    "const": "accepted"
                  }
                },
                "required": [
                  "status"
                ]
              }
            },
            "required": [
              "sponsored_context",
              "host_receipt"
            ]
          },
          "then": {
            "properties": {
              "host_receipt": {
                "properties": {
                  "accepted_context_use": {
                    "const": "comparison_set"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "sponsored_context": {
                "properties": {
                  "context_use": {
                    "const": "reasoning_context"
                  }
                },
                "required": [
                  "context_use"
                ]
              },
              "host_receipt": {
                "properties": {
                  "status": {
                    "const": "accepted"
                  }
                },
                "required": [
                  "status"
                ]
              }
            },
            "required": [
              "sponsored_context",
              "host_receipt"
            ]
          },
          "then": {
            "properties": {
              "host_receipt": {
                "properties": {
                  "accepted_context_use": {
                    "const": "reasoning_context"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "sponsored_context": {
                "properties": {
                  "disclosure_obligation": {
                    "properties": {
                      "required": {
                        "const": true
                      }
                    },
                    "required": [
                      "required"
                    ]
                  }
                },
                "required": [
                  "disclosure_obligation"
                ]
              },
              "host_receipt": {
                "properties": {
                  "status": {
                    "const": "accepted"
                  }
                },
                "required": [
                  "status"
                ]
              }
            },
            "required": [
              "sponsored_context",
              "host_receipt"
            ]
          },
          "then": {
            "properties": {
              "host_receipt": {
                "properties": {
                  "disclosure_commitment": {
                    "properties": {
                      "status": {
                        "const": "accepted"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ],
      "additionalProperties": true
    },
    "external:sponsored-intelligence/si-sponsored-context.json": {
      "x-status": "experimental",
      "type": "object",
      "properties": {
        "paying_principal": {
          "type": "object",
          "properties": {
            "brand": {
              "$ref": "#/$defs/external:core~1brand-ref.json"
            },
            "account": {
              "type": "object",
              "properties": {
                "account_id": {
                  "type": "string",
                  "x-entity": "account"
                }
              },
              "required": [
                "account_id"
              ],
              "additionalProperties": false
            },
            "operator": {
              "type": "string",
              "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$",
              "x-entity": "operator"
            },
            "display_name": {
              "type": "string"
            }
          },
          "required": [
            "brand"
          ],
          "additionalProperties": true
        },
        "context_use": {
          "$ref": "#/$defs/external:sponsored-intelligence~1si-context-use.json"
        },
        "disclosure_obligation": {
          "type": "object",
          "properties": {
            "required": {
              "type": "boolean"
            },
            "label_text": {
              "type": "string"
            },
            "timing": {
              "type": "string",
              "enum": [
                "before_use",
                "at_first_influenced_output",
                "near_each_influenced_output"
              ]
            },
            "proximity": {
              "type": "string",
              "enum": [
                "session_level",
                "near_rendered_unit",
                "near_influenced_output"
              ]
            },
            "jurisdictions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "country": {
                    "type": "string"
                  },
                  "region": {
                    "type": "string"
                  },
                  "regulation": {
                    "type": "string"
                  }
                },
                "required": [
                  "country",
                  "regulation"
                ],
                "additionalProperties": true
              },
              "minItems": 1
            }
          },
          "required": [
            "required"
          ],
          "additionalProperties": true
        },
        "declared_at": {
          "type": "string",
          "format": "date-time"
        },
        "declared_by": {
          "type": "object",
          "properties": {
            "agent_url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            "role": {
              "type": "string",
              "enum": [
                "brand_agent",
                "seller",
                "network",
                "platform"
              ]
            }
          },
          "required": [
            "role"
          ],
          "additionalProperties": true
        },
        "ext": {
          "$ref": "#/$defs/external:core~1ext.json"
        }
      },
      "required": [
        "paying_principal",
        "context_use",
        "disclosure_obligation"
      ],
      "additionalProperties": true
    },
    "external:core/brand-ref.json": {
      "type": "object",
      "properties": {
        "domain": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$"
        },
        "brand_id": {
          "$ref": "#/$defs/external:core~1brand-id.json"
        },
        "countries": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "industries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "data_subject_contestation": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            "email": {
              "type": "string",
              "format": "email"
            },
            "languages": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "anyOf": [
            {
              "required": [
                "url"
              ]
            },
            {
              "required": [
                "email"
              ]
            }
          ],
          "additionalProperties": false
        },
        "brand_kit_override": {
          "type": "object",
          "properties": {
            "logo": {
              "$ref": "#/$defs/external:core~1assets~1image-asset.json"
            },
            "colors": {
              "type": "object",
              "properties": {
                "primary": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "secondary": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "accent": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                }
              },
              "additionalProperties": true
            },
            "voice": {
              "type": "string"
            },
            "tagline": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      },
      "required": [
        "domain"
      ],
      "additionalProperties": false
    },
    "external:core/brand-id.json": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "x-entity": "advertiser_brand"
    },
    "external:core/assets/image-asset.json": {
      "type": "object",
      "properties": {
        "asset_type": {
          "type": "string",
          "const": "image"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "file_size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "pixel_ratio": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "format": {
          "type": "string"
        },
        "alt_text": {
          "type": "string",
          "x-accessibility": true
        },
        "provenance": {
          "$ref": "#/$defs/external:core~1provenance.json"
        }
      },
      "required": [
        "asset_type",
        "url",
        "width",
        "height"
      ],
      "additionalProperties": true
    },
    "external:core/provenance.json": {
      "type": "object",
      "properties": {
        "digital_source_type": {
          "$ref": "#/$defs/external:enums~1digital-source-type.json"
        },
        "synthetic_depiction": {
          "type": "boolean"
        },
        "ai_tool": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "provider": {
              "type": "string"
            }
          },
          "required": [
            "name"
          ]
        },
        "human_oversight": {
          "type": "string",
          "enum": [
            "none",
            "prompt_only",
            "selected",
            "edited",
            "directed"
          ]
        },
        "declared_by": {
          "type": "object",
          "properties": {
            "agent_url": {
              "type": "string",
              "format": "uri"
            },
            "role": {
              "type": "string",
              "enum": [
                "creator",
                "advertiser",
                "agency",
                "platform",
                "tool"
              ]
            }
          },
          "required": [
            "role"
          ]
        },
        "declared_at": {
          "type": "string",
          "format": "date-time"
        },
        "created_time": {
          "type": "string",
          "format": "date-time"
        },
        "c2pa": {
          "type": "object",
          "properties": {
            "manifest_url": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "manifest_url"
          ]
        },
        "embedded_provenance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "method": {
                "$ref": "#/$defs/external:enums~1embedded-provenance-method.json"
              },
              "standard": {
                "type": "string"
              },
              "provider": {
                "type": "string"
              },
              "verify_agent": {
                "type": "object",
                "properties": {
                  "agent_url": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https://"
                  },
                  "feature_id": {
                    "type": "string"
                  }
                },
                "required": [
                  "agent_url"
                ],
                "additionalProperties": false
              },
              "embedded_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "method",
              "provider"
            ]
          }
        },
        "watermarks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "media_type": {
                "$ref": "#/$defs/external:enums~1watermark-media-type.json"
              },
              "provider": {
                "type": "string"
              },
              "verify_agent": {
                "type": "object",
                "properties": {
                  "agent_url": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https://"
                  },
                  "feature_id": {
                    "type": "string"
                  }
                },
                "required": [
                  "agent_url"
                ],
                "additionalProperties": false
              },
              "c2pa_action": {
                "$ref": "#/$defs/external:enums~1c2pa-watermark-action.json"
              },
              "embedded_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "media_type",
              "provider"
            ]
          }
        },
        "disclosure": {
          "type": "object",
          "properties": {
            "required": {
              "type": "boolean"
            },
            "jurisdictions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "country": {
                    "type": "string"
                  },
                  "region": {
                    "type": "string"
                  },
                  "regulation": {
                    "type": "string"
                  },
                  "label_text": {
                    "type": "string"
                  },
                  "render_guidance": {
                    "type": "object",
                    "minProperties": 1,
                    "properties": {
                      "persistence": {
                        "$ref": "#/$defs/external:enums~1disclosure-persistence.json"
                      },
                      "min_duration_ms": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "positions": {
                        "type": "array",
                        "items": {
                          "$ref": "#/$defs/external:enums~1disclosure-position.json"
                        },
                        "minItems": 1,
                        "uniqueItems": true
                      },
                      "ext": {
                        "$ref": "#/$defs/external:core~1ext.json"
                      }
                    }
                  }
                },
                "required": [
                  "country",
                  "regulation"
                ]
              },
              "minItems": 1
            }
          },
          "required": [
            "required"
          ]
        },
        "verification": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "verified_by": {
                "type": "string"
              },
              "verified_time": {
                "type": "string",
                "format": "date-time"
              },
              "result": {
                "type": "string",
                "enum": [
                  "authentic",
                  "ai_generated",
                  "ai_modified",
                  "inconclusive"
                ]
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "details_url": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "verified_by",
              "result"
            ]
          }
        },
        "ext": {
          "$ref": "#/$defs/external:core~1ext.json"
        }
      }
    },
    "external:enums/digital-source-type.json": {
      "type": "string",
      "enum": [
        "digital_capture",
        "digital_creation",
        "trained_algorithmic_media",
        "composite_with_trained_algorithmic_media",
        "algorithmic_media",
        "composite_capture",
        "composite_synthetic",
        "human_edits",
        "data_driven_media"
      ]
    },
    "external:enums/embedded-provenance-method.json": {
      "type": "string",
      "enum": [
        "manifest_wrapper",
        "provenance_markers"
      ]
    },
    "external:enums/watermark-media-type.json": {
      "type": "string",
      "enum": [
        "audio",
        "image",
        "video",
        "text"
      ]
    },
    "external:enums/c2pa-watermark-action.json": {
      "type": "string",
      "enum": [
        "c2pa.watermarked.bound",
        "c2pa.watermarked.unbound"
      ]
    },
    "external:enums/disclosure-persistence.json": {
      "type": "string",
      "enum": [
        "continuous",
        "initial",
        "flexible"
      ]
    },
    "external:enums/disclosure-position.json": {
      "type": "string",
      "enum": [
        "prominent",
        "footer",
        "audio",
        "subtitle",
        "overlay",
        "end_card",
        "pre_roll",
        "companion"
      ]
    },
    "external:core/ext.json": {
      "type": "object",
      "additionalProperties": true
    },
    "external:sponsored-intelligence/si-context-use.json": {
      "x-status": "experimental",
      "type": "string",
      "enum": [
        "presentation_only",
        "comparison_set",
        "reasoning_context"
      ]
    },
    "external:core/context.json": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "description": "Send a message to the brand agent within an active session"
}
