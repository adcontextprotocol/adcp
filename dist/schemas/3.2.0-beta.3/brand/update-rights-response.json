{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://adcontextprotocol.org/schemas/3.2.0-beta.3/brand/update-rights-response.json",
  "title": "Update Rights Response",
  "description": "Result of a rights update request. Returns updated terms and re-issued credentials on success, or errors if the update cannot be applied.",
  "type": "object",
  "allOf": [
    {
      "$ref": "https://adcontextprotocol.org/schemas/3.2.0-beta.3/core/version-envelope.json"
    },
    {
      "$ref": "https://adcontextprotocol.org/schemas/3.2.0-beta.3/core/protocol-envelope.json"
    }
  ],
  "x-status": "experimental",
  "oneOf": [
    {
      "title": "UpdateRightsSuccess",
      "properties": {
        "rights_id": {
          "type": "string",
          "description": "Rights grant identifier",
          "x-entity": "rights_grant"
        },
        "terms": {
          "$ref": "https://adcontextprotocol.org/schemas/3.2.0-beta.3/brand/rights-terms.json",
          "description": "Updated contractual terms (same shape as acquire_rights acquired response)"
        },
        "generation_credentials": {
          "type": "array",
          "description": "Re-issued credentials reflecting updated terms (new expiration dates, adjusted caps)",
          "items": {
            "$ref": "https://adcontextprotocol.org/schemas/3.2.0-beta.3/core/generation-credential.json"
          }
        },
        "rights_constraint": {
          "allOf": [
            {
              "$ref": "https://adcontextprotocol.org/schemas/3.2.0-beta.3/core/rights-constraint.json"
            },
            {
              "required": [
                "rights_holder",
                "grant_status",
                "content_digest",
                "attestation_refs"
              ]
            }
          ],
          "description": "Updated rights constraint for re-embedding in creative manifests"
        },
        "paused": {
          "type": "boolean",
          "description": "Whether the grant is currently paused. Included when the update changes pause state."
        },
        "implementation_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "When changes take effect (null if pending approval from rights holder)"
        },
        "context": {
          "$ref": "https://adcontextprotocol.org/schemas/3.2.0-beta.3/core/context.json"
        },
        "ext": {
          "$ref": "https://adcontextprotocol.org/schemas/3.2.0-beta.3/core/ext.json"
        }
      },
      "required": [
        "rights_id",
        "terms",
        "generation_credentials",
        "rights_constraint"
      ],
      "additionalProperties": true,
      "not": {
        "required": [
          "errors"
        ]
      }
    },
    {
      "title": "UpdateRightsError",
      "properties": {
        "errors": {
          "type": "array",
          "items": {
            "$ref": "https://adcontextprotocol.org/schemas/3.2.0-beta.3/core/error.json"
          },
          "minItems": 1
        },
        "context": {
          "$ref": "https://adcontextprotocol.org/schemas/3.2.0-beta.3/core/context.json"
        },
        "ext": {
          "$ref": "https://adcontextprotocol.org/schemas/3.2.0-beta.3/core/ext.json"
        }
      },
      "required": [
        "errors"
      ],
      "additionalProperties": true,
      "not": {
        "anyOf": [
          {
            "required": [
              "rights_id"
            ]
          },
          {
            "required": [
              "terms"
            ]
          }
        ]
      }
    }
  ],
  "properties": {}
}
