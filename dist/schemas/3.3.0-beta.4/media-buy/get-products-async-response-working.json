{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://adcontextprotocol.org/schemas/3.3.0-beta.4/media-buy/get-products-async-response-working.json",
  "title": "Get Products - Working",
  "description": "Progress payload for active get_products task.",
  "type": "object",
  "allOf": [
    {
      "$ref": "https://adcontextprotocol.org/schemas/3.3.0-beta.4/core/protocol-envelope.json"
    },
    {
      "$ref": "https://adcontextprotocol.org/schemas/3.3.0-beta.4/core/task-working.json"
    }
  ],
  "properties": {
    "percentage": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Progress percentage of the search operation"
    },
    "current_step": {
      "type": "string",
      "description": "Current step in the search process (e.g., 'searching_inventory', 'validating_availability')"
    },
    "total_steps": {
      "type": "integer",
      "description": "Total number of steps in the search process"
    },
    "step_number": {
      "type": "integer",
      "description": "Current step number (1-indexed)"
    },
    "context": {
      "$ref": "https://adcontextprotocol.org/schemas/3.3.0-beta.4/core/context.json"
    },
    "ext": {
      "$ref": "https://adcontextprotocol.org/schemas/3.3.0-beta.4/core/ext.json"
    }
  },
  "additionalProperties": true
}
