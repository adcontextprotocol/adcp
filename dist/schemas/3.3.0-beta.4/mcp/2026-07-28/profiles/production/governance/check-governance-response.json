{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adcontextprotocol.org/schemas/3.3.0-beta.4/mcp/2026-07-28/profiles/production/governance/check-governance-response.json",
  "type": "object",
  "allOf": [
    {
      "$ref": "#/$defs/external:core~1protocol-envelope.json"
    },
    {
      "if": {
        "required": [
          "check_type"
        ]
      },
      "then": {
        "allOf": [
          {
            "if": {
              "properties": {
                "verdict": {
                  "const": "conditions"
                }
              },
              "required": [
                "verdict"
              ]
            },
            "then": {
              "required": [
                "conditions",
                "consultation_context"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "governance_context"
                    ]
                  },
                  {
                    "required": [
                      "expires_at"
                    ]
                  }
                ]
              },
              "properties": {
                "check_type": {
                  "const": "intent"
                },
                "conditions": {
                  "minItems": 1
                }
              }
            },
            "else": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "conditions"
                    ]
                  },
                  {
                    "required": [
                      "consultation_context"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "verdict": {
                  "const": "denied"
                }
              },
              "required": [
                "verdict"
              ]
            },
            "then": {
              "required": [
                "findings"
              ],
              "properties": {
                "findings": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "verdict": {
                  "const": "approved"
                }
              },
              "required": [
                "verdict"
              ]
            },
            "then": {
              "required": [
                "expires_at",
                "governance_context"
              ]
            },
            "else": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "governance_context"
                    ]
                  },
                  {
                    "required": [
                      "expires_at"
                    ]
                  }
                ]
              }
            }
          }
        ]
      },
      "else": {
        "allOf": [
          {
            "required": [
              "plan_id"
            ]
          },
          {
            "if": {
              "properties": {
                "verdict": {
                  "const": "conditions"
                }
              },
              "required": [
                "verdict"
              ]
            },
            "then": {
              "required": [
                "conditions"
              ],
              "properties": {
                "conditions": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "verdict": {
                  "const": "denied"
                }
              },
              "required": [
                "verdict"
              ]
            },
            "then": {
              "required": [
                "findings"
              ],
              "properties": {
                "findings": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "verdict": {
                  "enum": [
                    "approved",
                    "conditions"
                  ]
                }
              },
              "required": [
                "verdict"
              ]
            },
            "then": {
              "required": [
                "expires_at"
              ]
            }
          }
        ]
      }
    },
    {
      "if": {
        "required": [
          "runtime_attestation_evaluations"
        ]
      },
      "then": {
        "required": [
          "runtime_attestation_binding_digest"
        ]
      }
    }
  ],
  "x-status": "experimental",
  "properties": {
    "check_id": {
      "type": "string",
      "x-entity": "governance_check"
    },
    "verdict": {
      "$ref": "#/$defs/external:enums~1governance-decision.json"
    },
    "check_type": {
      "type": "string",
      "enum": [
        "intent",
        "execution"
      ]
    },
    "plan_id": {
      "type": "string",
      "x-entity": "governance_plan"
    },
    "budget_period_id": {
      "x-added-in": "3.3.0",
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "x-entity": "governance_budget_period"
    },
    "explanation": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category_id": {
            "type": "string"
          },
          "policy_id": {
            "type": "string"
          },
          "source_plan_id": {
            "type": "string",
            "x-entity": "governance_plan"
          },
          "severity": {
            "$ref": "#/$defs/external:enums~1escalation-severity.json"
          },
          "explanation": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "additionalProperties": true
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "uncertainty_reason": {
            "type": "string"
          },
          "attestation_reference_digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        },
        "required": [
          "category_id",
          "severity",
          "explanation"
        ],
        "additionalProperties": false
      }
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "required_value": {},
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "field",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "consultation_context": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "next_check": {
      "type": "string",
      "format": "date-time"
    },
    "delivery_statement": {
      "type": "object",
      "properties": {
        "statement_id": {
          "type": "string",
          "x-entity": "governance_delivery_statement"
        },
        "statement_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "issued_at": {
          "type": "string",
          "format": "date-time"
        },
        "seller_reference": {
          "type": "string"
        },
        "reporting_period": {
          "type": "object",
          "properties": {
            "start": {
              "type": "string",
              "format": "date-time"
            },
            "end": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "start",
            "end"
          ],
          "additionalProperties": false
        },
        "cumulative_spend": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "canonical_payload": {
          "type": "object",
          "properties": {
            "seller_reference": {
              "type": "string"
            },
            "delivery_metrics": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "required": [
            "seller_reference",
            "delivery_metrics"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "statement_id",
        "statement_digest",
        "sequence",
        "issued_at",
        "seller_reference",
        "reporting_period",
        "cumulative_spend",
        "currency",
        "canonical_payload"
      ],
      "additionalProperties": false
    },
    "categories_evaluated": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "policies_evaluated": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mode": {
      "$ref": "#/$defs/external:enums~1governance-mode.json"
    },
    "runtime_attestation_evaluations": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/external:core~1attestation-evaluation.json"
          },
          {
            "type": "object",
            "properties": {
              "action_binding": {
                "type": "object",
                "properties": {
                  "action_type": {
                    "type": "string",
                    "const": "https://adcontextprotocol.org/actions/governance-check"
                  }
                },
                "required": [
                  "action_type",
                  "action_id"
                ]
              }
            },
            "required": [
              "action_binding"
            ]
          }
        ]
      },
      "minItems": 1,
      "maxItems": 10
    },
    "runtime_attestation_binding_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "context": {
      "$ref": "#/$defs/external:core~1context.json"
    },
    "ext": {
      "$ref": "#/$defs/external:core~1ext.json"
    }
  },
  "required": [
    "check_id",
    "verdict",
    "explanation"
  ],
  "additionalProperties": true,
  "$defs": {
    "external:core/protocol-envelope.json": {
      "$id": "https://adcontextprotocol.org/schemas/3.3.0-beta.4/core/protocol-envelope.json",
      "type": "object",
      "allOf": [
        {
          "$ref": "https://adcontextprotocol.org/schemas/3.3.0-beta.4/mcp/2026-07-28/profiles/production/governance/check-governance-response.json#/$defs/external:core~1version-envelope.json"
        }
      ],
      "properties": {
        "context_id": {
          "type": "string",
          "x-max-length-4.0": 128
        },
        "context": {
          "$ref": "https://adcontextprotocol.org/schemas/3.3.0-beta.4/mcp/2026-07-28/profiles/production/governance/check-governance-response.json#/$defs/external:core~1context.json"
        },
        "task_id": {
          "$ref": "https://adcontextprotocol.org/schemas/3.3.0-beta.4/mcp/2026-07-28/profiles/production/governance/check-governance-response.json#/$defs/external:core~1task-id.json"
        },
        "status": {
          "$ref": "https://adcontextprotocol.org/schemas/3.3.0-beta.4/mcp/2026-07-28/profiles/production/governance/check-governance-response.json#/$defs/external:enums~1task-status.json"
        },
        "message": {
          "$ref": "https://adcontextprotocol.org/schemas/3.3.0-beta.4/mcp/2026-07-28/profiles/production/governance/check-governance-response.json#/$defs/external:core~1task-message.json"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "replayed": {
          "type": "boolean",
          "default": false
        },
        "adcp_error": {
          "$ref": "https://adcontextprotocol.org/schemas/3.3.0-beta.4/mcp/2026-07-28/profiles/production/governance/check-governance-response.json#/$defs/external:core~1error.json"
        },
        "push_notification_config": {
          "$ref": "https://adcontextprotocol.org/schemas/3.3.0-beta.4/mcp/2026-07-28/profiles/production/governance/check-governance-response.json#/$defs/external:core~1push-notification-config.json"
        },
        "governance_context": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[\\x20-\\x7E]+$"
        },
        "payload": {
          "type": "object",
          "x-adcp-open-payload": true,
          "additionalProperties": true
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": true,
      "not": {
        "anyOf": [
          {
            "required": [
              "task_status"
            ]
          },
          {
            "required": [
              "response_status"
            ]
          }
        ]
      },
      "notes": [
        "Task response schemas (e.g., get-products-response.json) define ONLY the body fields. The only envelope fields a task response schema declares are a `status` `const` or `enum` that discriminates a `oneOf`/`anyOf` branch, a `context` `$ref` identical to the envelope's, and a `const` that pins a fixed value; it does not restate any other envelope field. Each one composes this envelope through its root `allOf`, and the envelope supplies the protocol-layer fields, including `adcp_version` and `adcp_major_version` through `core/version-envelope.json`. Task response schemas do not compose `core/version-envelope.json` directly.",
        "Task response roots and status branches stay open (`additionalProperties` is not `false`). A closed root or branch would reject envelope fields, because draft-07 `additionalProperties` does not see properties declared through `allOf`.",
        "A body for one task status composes that status's schema through `allOf`: a submitted body or `oneOf`/`anyOf` branch composes `core/task-submitted.json`, which requires `status: submitted` and a `task_id` (`core/task-id.json`, never empty); a working body composes `core/task-working.json`; an input-required body composes `core/task-input-required.json`. The envelope states no conditional rule of its own.",
        "Transport serialization (normative):",
        "  - MCP: envelope fields and task-body fields are siblings at the root of the tool response. The `payload` object is NOT serialized as a nested key — its body fields are flattened to the root alongside `status`, `context_id`, `context`, etc. This matches MCP's native `structuredContent` convention and is what shipping SDKs (@adcp/client) emit. Conformant MCP receivers parse from the flat root; receivers that expect a nested `payload` key MUST migrate.",
        "  - A2A 1.0 with the AdCP profile extension: `task.status.state` carries the transport invocation lifecycle used to select the extraction location; `task.contextId` carries `context_id`, while `task.id` is an independent A2A transport identifier. The complete AdCP response, including its protocol-level `status` and any application-layer `task_id`, is canonically carried in `task.artifacts[0].parts[].DataPart` on final states; `task.status.message.parts[].DataPart` is the fallback container used only for interim A2A states (working, native submitted, input-required) where no final artifact has been emitted yet. For a structured AdCP business rejection or Submitted response, A2A is `completed` while the DataPart carries `status: rejected` or `status: submitted` because the handler invocation succeeded. An AdCP `task_id` MUST NOT be copied into artifact metadata or inferred from `task.id`. Receivers MUST prefer artifacts when present and MUST NOT overwrite a DataPart's status with the A2A state. See `a2a-profile-extension.mdx` and `a2a-response-extraction.mdx` for the full binding and extraction algorithm.",
        "  - REST: envelope fields MAY ride on HTTP headers (e.g., `X-AdCP-Status`, `X-AdCP-Context-Id`) or as JSON body siblings; body fields appear at the JSON body root. Implementers choosing the header path SHOULD also mirror to body siblings for non-streaming callers.",
        "Across all three: envelope and body fields are conceptually a single response object. A task response schema MAY declare body fields with the same name as envelope fields (e.g., `errors[]` body-level for per-record validation results vs envelope-level for fatal task failure) and the two MUST be treated as distinct fields by name within their respective namespaces — see `error-handling.mdx#envelope-vs-payload-errors-the-two-layer-model`.",
        "`status` is REQUIRED on the conceptual AdCP response across all transports. On MCP and REST it appears as a sibling field at the JSON root (or `structuredContent` root for MCP). On A2A it is carried inside the authoritative DataPart alongside the task body; `task.status.state` separately carries the A2A transport lifecycle and selects where that DataPart is found. Receivers MUST preserve the DataPart status when present. The schema-level `required: [status]` enforces the post-extraction AdCP shape. `payload` remains intentionally NOT required — it is a documentary grouping construct, never a required wire field. See `mcp-guide.mdx` and `a2a-guide.mdx` for the wire-level patterns receivers MUST implement.",
        "Receivers MUST handle absence of an envelope field (e.g., `replayed` omitted) as the field's documented default — see each field's `default` clause."
      ]
    },
    "external:core/version-envelope.json": {
      "$id": "https://adcontextprotocol.org/schemas/3.3.0-beta.4/core/version-envelope.json",
      "type": "object",
      "properties": {
        "adcp_version": {
          "type": "string",
          "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-[a-zA-Z0-9](?:[a-zA-Z0-9.-]*[a-zA-Z0-9])?)?$",
          "x-max-length-4.0": 32
        },
        "adcp_major_version": {
          "type": "integer",
          "deprecated": true,
          "x-removed-in": "4.0.0",
          "minimum": 1,
          "maximum": 99
        }
      }
    },
    "external:core/context.json": {
      "$id": "https://adcontextprotocol.org/schemas/3.3.0-beta.4/core/context.json",
      "type": "object",
      "additionalProperties": true
    },
    "external:core/task-id.json": {
      "$id": "https://adcontextprotocol.org/schemas/3.3.0-beta.4/core/task-id.json",
      "type": "string",
      "minLength": 1,
      "x-entity": "task",
      "x-max-length-4.0": 128
    },
    "external:enums/task-status.json": {
      "$id": "https://adcontextprotocol.org/schemas/3.3.0-beta.4/enums/task-status.json",
      "type": "string",
      "enum": [
        "submitted",
        "working",
        "input-required",
        "completed",
        "canceled",
        "failed",
        "rejected",
        "auth-required",
        "unknown"
      ]
    },
    "external:core/task-message.json": {
      "$id": "https://adcontextprotocol.org/schemas/3.3.0-beta.4/core/task-message.json",
      "type": "string",
      "maxLength": 2000
    },
    "external:core/error.json": {
      "$id": "https://adcontextprotocol.org/schemas/3.3.0-beta.4/core/error.json",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "message": {
          "type": "string",
          "x-max-length-4.0": 1024
        },
        "buyer_reason": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "x-max-length-4.0": 1024
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": true
        },
        "field": {
          "type": "string",
          "x-max-length-4.0": 256
        },
        "suggestion": {
          "type": "string",
          "x-max-length-4.0": 1024
        },
        "retry_after": {
          "type": "number",
          "minimum": 1,
          "maximum": 3600
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pointer": {
                "type": "string",
                "x-max-length-4.0": 256
              },
              "message": {
                "type": "string",
                "x-max-length-4.0": 512
              },
              "keyword": {
                "type": "string",
                "x-max-length-4.0": 64
              },
              "schemaPath": {
                "type": "string",
                "x-max-length-4.0": 256
              },
              "schema_id": {
                "type": "string",
                "x-max-length-4.0": 256
              },
              "discriminator": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "property_name": {
                      "type": "string",
                      "x-max-length-4.0": 128
                    },
                    "value": {
                      "type": [
                        "string",
                        "number",
                        "boolean",
                        "null"
                      ],
                      "x-max-length-4.0": 128
                    }
                  },
                  "required": [
                    "property_name",
                    "value"
                  ],
                  "additionalProperties": false
                },
                "x-max-items-4.0": 8
              }
            },
            "required": [
              "pointer",
              "message",
              "keyword"
            ],
            "additionalProperties": true
          },
          "x-max-items-4.0": 10
        },
        "details": {
          "type": "object",
          "additionalProperties": true
        },
        "recovery": {
          "type": "string",
          "enum": [
            "transient",
            "correctable",
            "terminal"
          ]
        },
        "mutation_outcome": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "x-added-in": "3.3.0"
        },
        "source": {
          "type": "string",
          "enum": [
            "producer",
            "sdk"
          ]
        },
        "sdk_id": {
          "type": "string",
          "x-max-length-4.0": 128
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": true,
      "dependentRequired": {
        "buyer_reason": [
          "recovery"
        ]
      }
    },
    "external:core/push-notification-config.json": {
      "$id": "https://adcontextprotocol.org/schemas/3.3.0-beta.4/core/push-notification-config.json",
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9_.:-]{1,255}$"
        },
        "token": {
          "type": "string",
          "minLength": 16,
          "maxLength": 4096
        },
        "authentication": {
          "type": "object",
          "deprecated": true,
          "x-removed-in": "4.0.0",
          "properties": {
            "schemes": {
              "type": "array",
              "items": {
                "$ref": "https://adcontextprotocol.org/schemas/3.3.0-beta.4/mcp/2026-07-28/profiles/production/governance/check-governance-response.json#/$defs/external:enums~1auth-scheme.json"
              },
              "minItems": 1,
              "maxItems": 1
            },
            "credentials": {
              "type": "string",
              "minLength": 32,
              "x-max-length-4.0": 512
            }
          },
          "required": [
            "schemes",
            "credentials"
          ],
          "additionalProperties": false
        },
        "signing_profile": {
          "x-status": "experimental",
          "$ref": "https://adcontextprotocol.org/schemas/3.3.0-beta.4/mcp/2026-07-28/profiles/production/governance/check-governance-response.json#/$defs/external:enums~1webhook-signing-profile.json",
          "x-added-in": "3.3.0"
        }
      },
      "required": [
        "url"
      ],
      "not": {
        "required": [
          "authentication",
          "signing_profile"
        ]
      }
    },
    "external:enums/auth-scheme.json": {
      "$id": "https://adcontextprotocol.org/schemas/3.3.0-beta.4/enums/auth-scheme.json",
      "deprecated": true,
      "x-removed-in": "4.0.0",
      "type": "string",
      "enum": [
        "Bearer",
        "HMAC-SHA256"
      ]
    },
    "external:enums/webhook-signing-profile.json": {
      "$id": "https://adcontextprotocol.org/schemas/3.3.0-beta.4/enums/webhook-signing-profile.json",
      "type": "string",
      "enum": [
        "adcp/webhook-signing/v1",
