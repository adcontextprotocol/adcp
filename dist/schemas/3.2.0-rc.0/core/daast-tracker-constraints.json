{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://adcontextprotocol.org/schemas/3.2.0-rc.0/core/daast-tracker-constraints.json",
  "title": "DAAST Tracker Constraints",
  "description": "Shared DAAST tracker vocabulary and execution-selector constraints. The legacy asset vocabulary retains AdCP's historical close extension, while the closed standards selector matrix excludes it. Progress alone carries offset in selectors.",
  "type": "object",
  "definitions": {
    "daast_event": {
      "type": "string",
      "enum": [
        "creativeView",
        "start",
        "firstQuartile",
        "midpoint",
        "thirdQuartile",
        "complete",
        "mute",
        "unmute",
        "pause",
        "resume",
        "rewind",
        "skip",
        "progress",
        "close"
      ]
    },
    "daast_target": {
      "type": "string",
      "enum": [
        "linear",
        "companion"
      ],
      "default": "linear"
    },
    "daast_offset": {
      "type": "string",
      "pattern": "^(\\d{2}:[0-5]\\d:[0-5]\\d(\\.\\d{3})?|(100|\\d{1,2})%)$"
    },
    "daast_versions": {
      "type": "array",
      "items": {
        "$ref": "https://adcontextprotocol.org/schemas/3.2.0-rc.0/enums/daast-version.json"
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "properties": {
    "daast_event": {
      "$ref": "#/definitions/daast_event"
    },
    "target": {
      "$ref": "#/definitions/daast_target"
    },
    "offset": {
      "$ref": "#/definitions/daast_offset"
    },
    "daast_versions": {
      "$ref": "#/definitions/daast_versions"
    }
  },
  "allOf": [
    {
      "if": {
        "anyOf": [
          {
            "not": {
              "required": [
                "target"
              ]
            }
          },
          {
            "properties": {
              "target": {
                "const": "linear"
              }
            },
            "required": [
              "target"
            ]
          }
        ]
      },
      "then": {
        "properties": {
          "daast_event": {
            "enum": [
              "creativeView",
              "start",
              "firstQuartile",
              "midpoint",
              "thirdQuartile",
              "complete",
              "mute",
              "unmute",
              "pause",
              "resume",
              "rewind",
              "skip",
              "progress"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "target": {
            "const": "companion"
          }
        },
        "required": [
          "target"
        ]
      },
      "then": {
        "properties": {
          "daast_event": {
            "const": "creativeView"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "daast_event": {
            "const": "progress"
          }
        },
        "required": [
          "daast_event"
        ]
      },
      "then": {
        "required": [
          "offset"
        ]
      },
      "else": {
        "not": {
          "required": [
            "offset"
          ]
        }
      }
    }
  ]
}
