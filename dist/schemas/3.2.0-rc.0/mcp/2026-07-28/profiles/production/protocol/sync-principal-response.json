              "ed25519",
              "ecdsa-p256-sha256"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "experimental_features": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/external:core~1experimental-feature-id.json"
          },
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "external:core/experimental-feature-id.json": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
    }
  }
