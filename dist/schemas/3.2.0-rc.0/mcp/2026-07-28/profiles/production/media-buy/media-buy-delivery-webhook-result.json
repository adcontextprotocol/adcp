{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adcontextprotocol.org/schemas/3.2.0-rc.0/mcp/2026-07-28/profiles/production/media-buy/media-buy-delivery-webhook-result.json",
  "type": "object",
  "properties": {
    "notification_type": {
      "type": "string",
      "enum": [
        "scheduled",
        "final",
        "delayed",
        "adjusted",
        "window_update"
      ]
    },
    "partial_data": {
      "type": "boolean"
    },
    "unavailable_count": {
      "type": "integer",
      "minimum": 0
    },
    "sequence_number": {
      "type": "integer",
      "minimum": 1
    },
    "next_expected_at": {
      "type": "string",
      "format": "date-time"
    },
    "reporting_period": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": true
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "attribution_window": {
      "$ref": "#/$defs/external:core~1attribution-window.json"
    },
    "media_buy_deliveries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "media_buy_id": {
            "type": "string",
            "x-entity": "media_buy"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending_creatives",
              "pending_start",
              "pending",
              "active",
              "paused",
              "completed",
              "rejected",
              "canceled",
              "failed",
              "reporting_delayed"
            ]
          },
          "expected_availability": {
            "type": "string",
            "format": "date-time"
          },
          "is_adjusted": {
            "type": "boolean"
          },
          "is_final": {
            "type": "boolean"
          },
          "finalized_at": {
            "type": "string",
            "format": "date-time"
          },
          "pricing_model": {
            "$ref": "#/$defs/external:enums~1pricing-model.json"
          },
          "pacing_index": {
            "type": "number",
            "minimum": 0
          },
          "totals": {
            "allOf": [
              {
                "$ref": "#/$defs/external:core~1delivery-metrics.json"
              },
              {
                "type": "object",
                "properties": {
                  "effective_rate": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "spend"
                ],
                "additionalProperties": true
              }
            ]
          },
          "by_package": {
            "type": "array",
            "items": {
              "allOf": [
                {
                  "$ref": "#/$defs/external:core~1delivery-metrics.json"
                },
                {
                  "type": "object",
                  "properties": {
                    "package_id": {
                      "type": "string",
                      "x-entity": "package"
                    },
                    "pacing_index": {
                      "type": "number",
                      "minimum": 0
                    },
                    "pricing_model": {
                      "$ref": "#/$defs/external:enums~1pricing-model.json"
                    },
                    "rate": {
                      "type": "number",
                      "minimum": 0
                    },
                    "currency": {
                      "type": "string",
                      "pattern": "^[A-Z]{3}$"
                    },
                    "delivery_status": {
                      "$ref": "#/$defs/external:enums~1delivery-status.json"
                    },
                    "paused": {
                      "type": "boolean"
                    },
                    "is_final": {
                      "type": "boolean"
                    },
                    "finalized_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "measurement_window": {
                      "type": "string",
                      "maxLength": 50
                    },
                    "supersedes_window": {
                      "type": "string",
                      "maxLength": 50
                    }
                  },
                  "required": [
                    "spend"
                  ],
                  "additionalProperties": true
                }
              ]
            }
          }
        },
        "required": [
          "media_buy_id",
          "status",
          "totals",
          "by_package"
        ],
        "additionalProperties": true
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/external:core~1error.json"
      }
    },
    "sandbox": {
      "type": "boolean"
    },
    "context": {
      "$ref": "#/$defs/external:core~1context.json"
    },
    "ext": {
      "$ref": "#/$defs/external:core~1ext.json"
    }
  },
  "required": [
    "notification_type",
    "reporting_period",
    "currency",
    "media_buy_deliveries"
  ],
  "additionalProperties": true,
  "$defs": {
    "external:core/attribution-window.json": {
      "type": "object",
      "properties": {
        "post_click": {
          "allOf": [
            {
              "$ref": "#/$defs/external:core~1duration.json"
            }
          ]
        },
        "post_view": {
          "allOf": [
            {
              "$ref": "#/$defs/external:core~1duration.json"
            }
          ]
        },
        "model": {
          "$ref": "#/$defs/external:enums~1attribution-model.json"
        }
      },
      "additionalProperties": true
    },
    "external:core/duration.json": {
      "type": "object",
      "properties": {
        "interval": {
          "type": "integer",
          "minimum": 1
        },
        "unit": {
          "type": "string",
          "enum": [
            "seconds",
            "minutes",
            "hours",
            "days",
            "campaign"
          ]
        }
      },
      "required": [
        "interval",
        "unit"
      ],
      "additionalProperties": false
    },
    "external:enums/attribution-model.json": {
      "type": "string",
      "enum": [
        "last_touch",
        "first_touch",
        "linear",
        "time_decay",
        "data_driven"
      ]
    },
    "external:enums/pricing-model.json": {
      "type": "string",
      "enum": [
        "cpm",
        "vcpm",
        "cpc",
        "cpcv",
        "cpv",
        "cpp",
        "cpa",
        "revenue_share",
        "flat_rate",
        "time"
      ]
    },
    "external:core/delivery-metrics.json": {
      "type": "object",
      "properties": {
        "impressions": {
          "type": "number",
          "minimum": 0
        },
        "spend": {
          "type": "number",
          "minimum": 0
        },
        "clicks": {
          "type": "number",
          "minimum": 0
        },
        "ctr": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "views": {
          "type": "number",
          "minimum": 0
        },
        "completed_views": {
          "type": "number",
          "minimum": 0
        },
        "completion_rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "conversions": {
          "type": "number",
          "minimum": 0
        },
        "conversion_value": {
          "type": "number",
          "minimum": 0
        },
        "commissionable_value": {
          "type": "number",
          "minimum": 0
        },
        "roas": {
          "type": "number",
          "minimum": 0
        },
        "cost_per_acquisition": {
          "type": "number",
          "minimum": 0
        },
        "new_to_brand_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "leads": {
          "type": "number",
          "minimum": 0
        },
        "incremental_sales_lift": {
          "type": "number",
          "minimum": 0
        },
        "brand_lift": {
          "type": "number",
          "minimum": 0
        },
        "foot_traffic": {
          "type": "number",
          "minimum": 0
        },
        "conversion_lift": {
          "type": "number",
          "minimum": 0
        },
        "brand_search_lift": {
          "type": "number",
          "minimum": 0
        },
        "plays": {
          "type": "number",
          "minimum": 0
        },
        "measurement_source": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z0-9_]+$"
        },
        "by_event_type": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "event_type": {
                "$ref": "#/$defs/external:enums~1event-type.json"
              },
              "event_source_id": {
                "type": "string"
              },
              "count": {
                "type": "number",
                "minimum": 0
              },
              "value": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "event_type",
              "count"
            ],
            "additionalProperties": true
          }
        },
        "grps": {
          "type": "number",
          "minimum": 0
        },
        "reach": {
          "type": "number",
          "minimum": 0
        },
        "reach_unit": {
          "allOf": [
            {
              "$ref": "#/$defs/external:enums~1reach-unit.json"
            }
          ]
        },
        "reach_window": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "cumulative",
                "period",
                "rolling"
              ]
            },
            "period": {
              "allOf": [
                {
                  "$ref": "#/$defs/external:core~1duration.json"
                }
              ]
            }
          },
          "required": [
            "kind"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "enum": [
                      "period",
                      "rolling"
                    ]
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "then": {
                "required": [
                  "period"
                ]
              }
            }
          ],
          "additionalProperties": true
        },
        "frequency": {
          "type": "number",
          "minimum": 0
        },
        "quartile_data": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "q1_views": {
              "type": "number",
              "minimum": 0
            },
            "q2_views": {
              "type": "number",
              "minimum": 0
            },
            "q3_views": {
              "type": "number",
              "minimum": 0
            },
            "q4_views": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "time_based_views": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "threshold_seconds": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "basis": {
                "$ref": "#/$defs/external:enums~1view-threshold-basis.json"
              },
              "views": {
                "type": "number",
                "minimum": 0
              },
              "standard": {
                "$ref": "#/$defs/external:enums~1viewability-standard.json"
              }
            },
            "required": [
              "threshold_seconds",
              "basis",
              "views"
            ],
            "additionalProperties": true
          }
        },
        "dooh_metrics": {
          "type": "object",
          "properties": {
            "loop_plays": {
              "type": "integer",
              "minimum": 0
            },
            "screens_used": {
              "type": "integer",
              "minimum": 0
            },
            "screen_time_seconds": {
              "type": "integer",
              "minimum": 0
            },
            "sov_achieved": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "calculation_notes": {
              "type": "string"
            },
            "venue_breakdown": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "venue_id": {
                    "type": "string"
                  },
                  "venue_name": {
                    "type": "string"
                  },
                  "venue_type": {
                    "type": "string"
                  },
                  "impressions": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "loop_plays": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "screens_used": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "venue_id",
                  "impressions"
                ],
                "additionalProperties": true
              }
            }
          },
          "additionalProperties": true
        },
        "ooh_metrics": {
          "type": "object",
          "x-status": "experimental",
          "properties": {
            "panels": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "identifiers": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "id_type": {
                          "type": "string",
                          "enum": [
                            "geopath",
                            "route_frame",
                            "plant_face",
                            "other"
                          ]
                        }
                      },
                      "required": [
                        "id",
                        "id_type"
                      ],
                      "additionalProperties": true
                    }
                  },
                  "name": {
                    "type": "string"
                  }
                },
                "required": [
                  "identifiers"
                ],
                "additionalProperties": true
              }
            },
            "posting_period_start": {
              "type": "string",
              "format": "date"
            },
            "posting_period_end": {
              "type": "string",
              "format": "date"
            },
            "average_posted_date": {
              "type": "string",
              "format": "date"
            },
            "materials_timely": {
              "type": "boolean"
            },
            "share_of_voice_contracted": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "illuminated_hours": {
              "type": "number",
              "minimum": 0,
              "maximum": 24
            },
            "estimated_impressions": {
              "type": "integer",
              "minimum": 0
            },
            "estimation_basis": {
              "type": "string",
              "enum": [
                "currency_measured",
                "seller_modeled"
              ]
            },
            "postings": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "panel_id": {
                    "type": "string"
                  },
                  "event_type": {
                    "type": "string",
                    "enum": [
                      "posted",
                      "rotated",
                      "repaired",
                      "removed"
                    ],
                    "default": "posted"
                  },
                  "occurred_at": {
                    "type": "string",
                    "format": "date"
                  },
                  "evidence": {
                    "$ref": "#/$defs/external:core~1placement-evidence.json"
                  }
                },
                "required": [
                  "panel_id",
                  "occurred_at"
                ],
                "additionalProperties": true
              }
            },
            "calculation_notes": {
              "type": "string"
            }
          },
          "additionalProperties": true,
          "dependentRequired": {
            "estimated_impressions": [
              "estimation_basis"
            ]
          }
        },
        "viewability": {
          "type": "object",
          "x-adcp-validation": {
            "verifier_constraints": {
              "viewed_seconds_percentile_order": "p25 <= p50 <= p75 <= p90 <= p95",
              "viewed_seconds_histogram_bounds": "buckets are ordered by lower_bound_seconds; each bounded bucket has upper_bound_seconds > lower_bound_seconds; buckets do not overlap; gaps between buckets are permitted only when zero impressions fall in the gap (enforced by the sum-equals-measurable_impressions rule, not a separate contiguity check); only the final bucket may omit upper_bound_seconds",
              "viewed_seconds_histogram_population": "sum(bucket.impressions) equals measurable_impressions"
            },
            "spec": "docs/media-buy/media-buys/optimization-reporting.mdx#available-metrics"
          },
          "properties": {
            "vendor": {
              "$ref": "#/$defs/external:core~1brand-ref.json"
            },
            "measurable_impressions": {
              "type": "number",
              "minimum": 0
            },
            "viewable_impressions": {
              "type": "number",
              "minimum": 0
            },
            "viewable_rate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "viewed_seconds": {
              "type": "number",
              "minimum": 0
            },
            "viewed_seconds_percentiles": {
              "type": "object",
              "properties": {
                "p25": {
                  "type": "number",
                  "minimum": 0
                },
                "p50": {
                  "type": "number",
                  "minimum": 0
                },
                "p75": {
                  "type": "number",
                  "minimum": 0
                },
                "p90": {
                  "type": "number",
                  "minimum": 0
                },
                "p95": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "p25",
                "p50",
                "p75",
                "p90",
                "p95"
              ],
              "additionalProperties": false
            },
            "viewed_seconds_histogram": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "properties": {
                  "lower_bound_seconds": {
                    "type": "number",
                    "minimum": 0
                  },
                  "upper_bound_seconds": {
                    "type": "number",
                    "minimum": 0
                  },
                  "impressions": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "lower_bound_seconds",
                  "impressions"
                ],
                "additionalProperties": false
              }
            },
            "standard": {
              "$ref": "#/$defs/external:enums~1viewability-standard.json"
            }
          },
          "allOf": [
            {
              "if": {
                "required": [
                  "viewed_seconds_percentiles"
                ]
              },
              "then": {
                "properties": {
                  "measurable_impressions": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            },
            {
              "if": {
                "required": [
                  "viewed_seconds_histogram"
                ]
              },
              "then": {
                "properties": {
                  "measurable_impressions": {
                    "type": "integer"
                  }
                }
              }
            }
          ],
          "additionalProperties": true,
          "dependentRequired": {
            "viewed_seconds_percentiles": [
              "viewed_seconds",
              "measurable_impressions"
            ],
            "viewed_seconds_histogram": [
              "viewed_seconds",
              "measurable_impressions"
            ]
          }
        },
        "engagements": {
          "type": "number",
          "minimum": 0
        },
        "follows": {
          "type": "number",
          "minimum": 0
        },
        "saves": {
          "type": "number",
          "minimum": 0
        },
        "profile_visits": {
          "type": "number",
          "minimum": 0
        },
        "engagement_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "cost_per_click": {
          "type": "number",
          "minimum": 0
        },
        "cost_per_completed_view": {
          "type": "number",
          "minimum": 0
        },
        "cpm": {
          "type": "number",
          "minimum": 0
        },
        "downloads": {
          "type": "number",
          "minimum": 0
        },
        "units_sold": {
          "type": "number",
          "minimum": 0
        },
        "new_to_brand_units": {
          "type": "number",
          "minimum": 0
        },
        "by_action_source": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "action_source": {
                "$ref": "#/$defs/external:enums~1action-source.json"
              },
              "event_source_id": {
                "type": "string"
              },
              "count": {
                "type": "number",
                "minimum": 0
              },
              "value": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "action_source",
              "count"
            ],
            "additionalProperties": true
          }
        },
        "vendor_metric_values": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/external:core~1vendor-metric-value.json"
          }
        }
      },
      "additionalProperties": true,
      "dependentRequired": {
        "reach": [
          "reach_unit"
        ]
      }
    },
    "external:enums/event-type.json": {
      "type": "string",
      "enum": [
        "page_view",
        "view_content",
        "select_content",
        "select_item",
        "search",
        "share",
        "add_to_cart",
        "remove_from_cart",
        "viewed_cart",
        "add_to_wishlist",
        "initiate_checkout",
        "add_payment_info",
        "purchase",
        "refund",
        "lead",
        "qualify_lead",
        "close_convert_lead",
        "disqualify_lead",
        "complete_registration",
        "subscribe",
        "follow",
        "content_view",
        "watch_milestone",
        "start_trial",
        "app_install",
        "app_launch",
        "contact",
        "schedule",
        "donate",
        "submit_application",
        "custom"
      ]
    },
    "external:enums/reach-unit.json": {
      "type": "string",
      "enum": [
        "individuals",
        "households",
        "devices",
        "accounts",
        "cookies",
        "custom"
      ]
    },
    "external:enums/view-threshold-basis.json": {
      "type": "string",
      "enum": [
        "play_time",
        "in_view"
      ]
    },
    "external:enums/viewability-standard.json": {
      "type": "string",
      "enum": [
        "mrc",
        "groupm"
      ]
    },
    "external:core/placement-evidence.json": {
      "x-status": "experimental",
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "additionalProperties": true
    },
    "external:core/brand-ref.json": {
      "type": "object",
      "properties": {
        "domain": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$"
        },
        "brand_id": {
          "$ref": "#/$defs/external:core~1brand-id.json"
        },
        "countries": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "industries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "data_subject_contestation": {
          "type": "object",
          "properties": {
            "url": {
