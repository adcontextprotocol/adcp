{
  "type": "object",
  "properties": {
    "adcp_version": {
      "type": "string"
    },
    "adcp_major_version": {
      "type": "integer"
    },
    "account": {
      "$ref": "#/$defs/external:core~1account-ref.json"
    },
    "media_buy_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status_filter": {
      "oneOf": [
        {
          "$ref": "#/$defs/external:enums~1media-buy-status.json"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/external:enums~1media-buy-status.json"
          }
        }
      ]
    },
    "start_date": {
      "type": "string"
    },
    "end_date": {
      "type": "string"
    },
    "include_package_daily_breakdown": {
      "type": "boolean"
    },
    "requested_metrics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/external:enums~1available-metric.json"
      }
    },
    "time_granularity": {
      "$ref": "#/$defs/external:enums~1reporting-frequency.json"
    },
    "include_window_breakdown": {
      "type": "boolean"
    },
    "attribution_window": {
      "type": "object",
      "properties": {
        "post_click": {
          "allOf": [
            {
              "$ref": "#/$defs/external:core~1duration.json"
            }
          ]
        },
        "post_view": {
          "allOf": [
            {
              "$ref": "#/$defs/external:core~1duration.json"
            }
          ]
        },
        "model": {
          "$ref": "#/$defs/external:enums~1attribution-model.json"
        }
      },
      "additionalProperties": true
    },
    "reporting_dimensions": {
      "type": "object",
      "properties": {
        "catalog_item": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer"
            },
            "sort_by": {
              "$ref": "#/$defs/external:enums~1sort-metric.json"
            },
            "sort_direction": {
              "$ref": "#/$defs/external:enums~1sort-direction.json"
            }
          },
          "additionalProperties": true
        },
        "creative": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer"
            },
            "sort_by": {
              "$ref": "#/$defs/external:enums~1sort-metric.json"
            },
            "sort_direction": {
              "$ref": "#/$defs/external:enums~1sort-direction.json"
            }
          },
          "additionalProperties": true
        },
        "keyword": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer"
            },
            "sort_by": {
              "$ref": "#/$defs/external:enums~1sort-metric.json"
            },
            "sort_direction": {
              "$ref": "#/$defs/external:enums~1sort-direction.json"
            }
          },
          "additionalProperties": true
        },
        "geo": {
          "type": "object",
          "properties": {
            "geo_level": {
              "$ref": "#/$defs/external:enums~1geo-level.json"
            },
            "system": {
              "anyOf": [
                {
                  "$ref": "#/$defs/external:enums~1metro-system.json"
                },
                {
                  "$ref": "#/$defs/external:enums~1postal-system.json"
                },
                {
                  "$ref": "#/$defs/external:enums~1legacy-postal-system.json"
                }
              ]
            },
            "country": {
              "type": "string"
            },
            "limit": {
              "type": "integer"
            },
            "sort_by": {
              "$ref": "#/$defs/external:enums~1sort-metric.json"
            },
            "sort_direction": {
              "$ref": "#/$defs/external:enums~1sort-direction.json"
            }
          },
          "required": [
            "geo_level"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "geo_level": {
                    "enum": [
                      "country",
                      "region"
                    ]
                  }
                },
                "required": [
                  "geo_level"
                ]
              },
              "then": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "country"
                      ]
                    },
                    {
                      "required": [
                        "system"
                      ]
                    }
                  ]
                }
              }
            },
            {
              "if": {
                "properties": {
                  "geo_level": {
                    "const": "metro"
                  }
                },
                "required": [
                  "geo_level"
                ]
              },
              "then": {
                "anyOf": [
                  {
                    "not": {
                      "required": [
                        "system"
                      ]
                    }
                  },
                  {
                    "properties": {
                      "system": {
                        "$ref": "#/$defs/external:enums~1metro-system.json"
                      }
                    },
                    "required": [
                      "system"
                    ]
                  }
                ],
                "not": {
                  "required": [
                    "country"
                  ]
                }
              }
            },
            {
              "if": {
                "properties": {
                  "geo_level": {
                    "const": "postal_area"
                  }
                },
                "required": [
                  "geo_level"
                ]
              },
              "then": {
                "anyOf": [
                  {
                    "not": {
                      "anyOf": [
                        {
                          "required": [
                            "country"
                          ]
                        },
                        {
                          "required": [
                            "system"
                          ]
                        }
                      ]
                    }
                  },
                  {
                    "$ref": "#/$defs/external:core~1postal-country-system.json"
                  },
                  {
                    "properties": {
                      "system": {
                        "$ref": "#/$defs/external:enums~1legacy-postal-system.json"
                      }
                    },
                    "required": [
                      "system"
                    ],
                    "not": {
                      "required": [
                        "country"
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "additionalProperties": true
        },
        "device_type": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer"
            },
            "sort_by": {
              "$ref": "#/$defs/external:enums~1sort-metric.json"
            },
            "sort_direction": {
              "$ref": "#/$defs/external:enums~1sort-direction.json"
            }
          },
          "additionalProperties": true
        },
        "device_platform": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer"
            },
            "sort_by": {
              "$ref": "#/$defs/external:enums~1sort-metric.json"
            },
            "sort_direction": {
              "$ref": "#/$defs/external:enums~1sort-direction.json"
            }
          },
          "additionalProperties": true
        },
        "format": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer"
            },
            "sort_by": {
              "$ref": "#/$defs/external:enums~1sort-metric.json"
            },
            "sort_direction": {
              "$ref": "#/$defs/external:enums~1sort-direction.json"
            }
          },
          "additionalProperties": true
        },
        "audience": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer"
            },
            "sort_by": {
              "$ref": "#/$defs/external:enums~1sort-metric.json"
            },
            "sort_direction": {
              "$ref": "#/$defs/external:enums~1sort-direction.json"
            }
          },
          "additionalProperties": true
        },
        "demographic": {
          "type": "object",
          "properties": {
            "age_ranges": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/external:core~1demographic-age-range.json"
              }
            },
            "limit": {
              "type": "integer"
            },
            "sort_by": {
              "$ref": "#/$defs/external:enums~1sort-metric.json"
            },
            "sort_direction": {
              "$ref": "#/$defs/external:enums~1sort-direction.json"
            }
          }
        },
        "spot": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer"
            }
          },
          "additionalProperties": true
        },
        "placement": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer"
            },
            "sort_by": {
              "$ref": "#/$defs/external:enums~1sort-metric.json"
            },
            "sort_direction": {
              "$ref": "#/$defs/external:enums~1sort-direction.json"
            }
          },
          "additionalProperties": true
        },
        "property": {
          "$ref": "#/$defs/external:core~1delivery-breakdown-controls.json"
        },
        "collection": {
          "$ref": "#/$defs/external:core~1delivery-breakdown-controls.json"
        },
        "installment": {
          "$ref": "#/$defs/external:core~1delivery-breakdown-controls.json"
        },
        "collection_property": {
          "$ref": "#/$defs/external:core~1delivery-breakdown-controls.json"
        },
        "installment_property": {
          "$ref": "#/$defs/external:core~1delivery-breakdown-controls.json"
        },
        "placement_property": {
          "$ref": "#/$defs/external:core~1delivery-breakdown-controls.json"
        }
      },
      "additionalProperties": true
    },
    "context": {
      "$ref": "#/$defs/external:core~1context.json"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "external:core/account-ref.json": {
      "type": "object",
      "oneOf": [
        {
          "properties": {
            "account_id": {
              "type": "string"
            }
          },
          "required": [
            "account_id"
          ]
        },
        {
          "properties": {
            "brand": {
              "$ref": "#/$defs/external:core~1brand-ref.json"
            },
            "operator": {
              "type": "string"
            },
            "operator_unit": {
              "$ref": "#/$defs/external:core~1operator-unit.json"
            },
            "currency": {
              "type": "string"
            },
            "timezone": {
              "type": "string"
            },
            "sandbox": {
              "type": "boolean"
            }
          },
          "required": [
            "brand",
            "operator"
          ]
        }
      ]
    },
    "external:core/brand-ref.json": {
      "type": "object",
      "properties": {
        "domain": {
          "type": "string"
        },
        "brand_id": {
          "$ref": "#/$defs/external:core~1brand-id.json"
        },
        "countries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "industries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "data_subject_contestation": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string"
            },
            "email": {
              "type": "string"
            },
            "languages": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "anyOf": [
            {
              "required": [
                "url"
              ]
            },
            {
              "required": [
                "email"
              ]
            }
          ]
        },
        "brand_kit_override": {
          "type": "object",
          "properties": {
            "logo": {
              "$ref": "#/$defs/external:core~1assets~1image-asset.json"
            },
            "colors": {
              "type": "object",
              "properties": {
                "primary": {
                  "type": "string"
                },
                "secondary": {
                  "type": "string"
                },
                "accent": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            },
            "voice": {
              "type": "string"
            },
            "tagline": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      },
      "required": [
        "domain"
      ]
    },
    "external:core/brand-id.json": {
      "type": "string"
    },
    "external:core/assets/image-asset.json": {
      "type": "object",
      "properties": {
        "asset_type": {
          "const": "image"
        },
        "url": {
          "type": "string"
        },
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        },
        "file_size_bytes": {
          "type": "integer"
        },
        "pixel_ratio": {
          "type": "number"
        },
        "state_id": {
          "type": "string"
        },
        "breakpoint_id": {
          "type": "string"
        },
        "focal_point": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "format": {
          "type": "string"
        },
        "alt_text": {
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/external:core~1provenance.json"
        }
      },
      "required": [
        "asset_type",
        "url",
        "width",
        "height"
      ],
      "additionalProperties": true
    },
    "external:core/provenance.json": {
      "type": "object",
      "properties": {
        "digital_source_type": {
          "$ref": "#/$defs/external:enums~1digital-source-type.json"
        },
        "synthetic_depiction": {
          "type": "boolean"
        },
        "ai_tool": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "provider": {
              "type": "string"
            }
          },
          "required": [
            "name"
          ]
        },
        "human_oversight": {
          "enum": [
            "none",
            "prompt_only",
            "selected",
            "edited",
            "directed"
          ]
        },
        "declared_by": {
          "type": "object",
          "properties": {
            "agent_url": {
              "type": "string"
            },
            "role": {
              "enum": [
                "creator",
                "advertiser",
                "agency",
                "platform",
                "tool"
              ]
            }
          },
          "required": [
            "role"
          ]
        },
        "declared_at": {
          "type": "string"
        },
        "created_time": {
          "type": "string"
        },
        "c2pa": {
          "type": "object",
          "properties": {
            "manifest_url": {
              "type": "string"
            }
          },
          "required": [
            "manifest_url"
          ]
        },
        "embedded_provenance": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "method": {
                "$ref": "#/$defs/external:enums~1embedded-provenance-method.json"
              },
              "standard": {
                "type": "string"
              },
              "provider": {
                "type": "string"
              },
              "verify_agent": {
                "type": "object",
                "properties": {
                  "agent_url": {
                    "type": "string"
                  },
                  "feature_id": {
                    "type": "string"
                  }
                },
                "required": [
                  "agent_url"
                ]
              },
              "embedded_at": {
                "type": "string"
              }
            },
            "required": [
              "method",
              "provider"
            ]
          }
        },
        "watermarks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "media_type": {
                "$ref": "#/$defs/external:enums~1watermark-media-type.json"
              },
              "provider": {
                "type": "string"
              },
              "verify_agent": {
                "type": "object",
                "properties": {
                  "agent_url": {
                    "type": "string"
                  },
                  "feature_id": {
                    "type": "string"
                  }
                },
                "required": [
                  "agent_url"
                ]
              },
              "c2pa_action": {
                "$ref": "#/$defs/external:enums~1c2pa-watermark-action.json"
              },
              "embedded_at": {
                "type": "string"
              }
            },
            "required": [
              "media_type",
              "provider"
            ]
          }
        },
        "disclosure": {
          "type": "object",
          "properties": {
            "required": {
              "type": "boolean"
            },
            "jurisdictions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "country": {
                    "type": "string"
                  },
                  "region": {
                    "type": "string"
                  },
                  "regulation": {
                    "type": "string"
                  },
                  "label_text": {
                    "type": "string"
                  },
                  "render_guidance": {
                    "type": "object",
                    "properties": {
                      "persistence": {
                        "$ref": "#/$defs/external:enums~1disclosure-persistence.json"
                      },
                      "min_duration_ms": {
                        "type": "integer"
                      },
                      "positions": {
                        "type": "array",
                        "items": {
                          "$ref": "#/$defs/external:enums~1disclosure-position.json"
                        }
                      }
                    }
                  }
                },
                "required": [
                  "country",
                  "regulation"
                ]
              }
            }
          },
          "required": [
            "required"
          ]
        },
        "verification": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "verified_by": {
                "type": "string"
              },
              "verified_time": {
                "type": "string"
              },
              "result": {
                "enum": [
                  "authentic",
                  "ai_generated",
                  "ai_modified",
                  "inconclusive"
                ]
              },
              "confidence": {
                "type": "number"
              },
              "details_url": {
                "type": "string"
              }
            },
            "required": [
              "verified_by",
              "result"
            ]
          }
        }
      }
    },
    "external:enums/digital-source-type.json": {
      "enum": [
        "digital_capture",
        "digital_creation",
        "trained_algorithmic_media",
        "composite_with_trained_algorithmic_media",
        "algorithmic_media",
        "composite_capture",
        "composite_synthetic",
        "human_edits",
        "data_driven_media"
      ]
    },
    "external:enums/embedded-provenance-method.json": {
