        "profile_visits",
        "engagement_rate",
        "cost_per_click",
        "commissionable_value",
        "plays",
        "cost_per_completed_view",
        "cpm",
        "downloads",
        "units_sold",
        "new_to_brand_units",
        "viewable_rate",
        "viewable_impressions",
        "measurable_impressions",
        "viewed_seconds",
        "quartile_25",
