        "unit": {
          "enum": [
            "seconds",
            "minutes",
            "hours",
            "days",
            "campaign"
          ]
        }
      },
      "required": [
        "interval",
        "unit"
      ]
    },
    "external:enums/attribution-model.json": {
      "enum": [
        "last_touch",
        "first_touch",
        "linear",
