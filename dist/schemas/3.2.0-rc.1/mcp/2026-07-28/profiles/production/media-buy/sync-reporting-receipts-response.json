{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adcontextprotocol.org/schemas/3.2.0-rc.1/mcp/2026-07-28/profiles/production/media-buy/sync-reporting-receipts-response.json",
  "x-status": "experimental",
  "type": "object",
  "allOf": [
    {
      "$ref": "#/$defs/external:core~1version-envelope.json"
    },
    {
      "$ref": "#/$defs/external:core~1protocol-envelope.json"
    }
  ],
  "properties": {
    "status": {
      "type": "string",
      "const": "completed"
    },
    "results": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "result": {
                "type": "string",
                "const": "recorded"
              },
              "receipt": {
                "allOf": [
                  {
                    "$ref": "#/$defs/external:core~1reporting-receipt.json"
                  },
                  {
                    "required": [
                      "received_at"
                    ]
                  }
                ]
              }
            },
            "required": [
              "result",
              "receipt"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "result": {
                "type": "string",
                "const": "unchanged"
              },
              "receipt": {
                "allOf": [
                  {
                    "$ref": "#/$defs/external:core~1reporting-receipt.json"
                  },
                  {
                    "required": [
                      "received_at"
                    ]
                  }
                ]
              }
            },
            "required": [
              "result",
              "receipt"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "result": {
                "type": "string",
                "const": "recorded"
              },
              "adjustment_receipt": {
                "allOf": [
                  {
                    "$ref": "#/$defs/external:core~1reporting-adjustment-receipt.json"
                  },
                  {
                    "required": [
                      "received_at"
                    ]
                  }
                ]
              }
            },
            "required": [
              "result",
              "adjustment_receipt"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "result": {
                "type": "string",
                "const": "unchanged"
              },
              "adjustment_receipt": {
                "allOf": [
                  {
                    "$ref": "#/$defs/external:core~1reporting-adjustment-receipt.json"
                  },
                  {
                    "required": [
                      "received_at"
                    ]
                  }
                ]
              }
            },
            "required": [
              "result",
              "adjustment_receipt"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "result": {
                "type": "string",
                "const": "failed"
              },
              "reporting_receipt_id": {
                "type": "string",
                "minLength": 16,
                "maxLength": 255,
                "pattern": "^[A-Za-z0-9_.:-]{16,255}$",
                "x-entity": "reporting_receipt"
              },
              "errors": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/external:core~1error.json"
                },
                "minItems": 1,
                "maxItems": 16
              }
            },
            "required": [
              "result",
              "reporting_receipt_id",
              "errors"
            ],
            "additionalProperties": false
          }
        ]
      },
      "minItems": 1,
      "maxItems": 100
    },
    "context": {
      "$ref": "#/$defs/external:core~1context.json"
    },
    "ext": {
      "$ref": "#/$defs/external:core~1ext.json"
    }
  },
  "required": [
    "status",
    "results"
  ],
  "additionalProperties": true,
  "$defs": {
    "external:core/version-envelope.json": {
      "type": "object",
      "properties": {
        "adcp_version": {
          "type": "string",
          "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-[a-zA-Z0-9](?:[a-zA-Z0-9.-]*[a-zA-Z0-9])?)?$"
        },
        "adcp_major_version": {
          "type": "integer",
          "deprecated": true,
          "minimum": 1,
          "maximum": 99
        }
      }
    },
    "external:core/protocol-envelope.json": {
      "type": "object",
      "properties": {
        "context_id": {
          "type": "string"
        },
        "context": {
          "$ref": "#/$defs/external:core~1context.json"
        },
        "task_id": {
          "type": "string",
          "x-entity": "task"
        },
        "status": {
          "$ref": "#/$defs/external:enums~1task-status.json"
        },
        "message": {
          "type": "string"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "replayed": {
          "type": "boolean",
          "default": false
        },
        "adcp_error": {
          "$ref": "#/$defs/external:core~1error.json"
        },
        "push_notification_config": {
          "$ref": "#/$defs/external:core~1push-notification-config.json"
        },
        "governance_context": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[\\x20-\\x7E]+$"
        },
        "payload": {
          "type": "object",
          "x-adcp-open-payload": true,
          "additionalProperties": true
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": true,
      "not": {
        "anyOf": [
          {
            "required": [
              "task_status"
            ]
          },
          {
            "required": [
              "response_status"
            ]
          }
        ]
      },
      "notes": [
        "Task response schemas (e.g., get-products-response.json) define ONLY the body fields; protocol-layer fields live on this envelope.",
        "Transport serialization (normative):",
        "  - MCP: envelope fields and task-body fields are siblings at the root of the tool response. The `payload` object is NOT serialized as a nested key — its body fields are flattened to the root alongside `status`, `context_id`, `context`, etc. This matches MCP's native `structuredContent` convention and is what shipping SDKs (@adcp/client) emit. Conformant MCP receivers parse from the flat root; receivers that expect a nested `payload` key MUST migrate.",
        "  - A2A 1.0 with the AdCP profile extension: `task.status.state` carries the transport invocation lifecycle used to select the extraction location; `task.contextId` carries `context_id`, while `task.id` is an independent A2A transport identifier. The complete AdCP response, including its protocol-level `status` and any application-layer `task_id`, is canonically carried in `task.artifacts[0].parts[].DataPart` on final states; `task.status.message.parts[].DataPart` is the fallback container used only for interim A2A states (working, native submitted, input-required) where no final artifact has been emitted yet. For a structured AdCP business rejection or Submitted response, A2A is `completed` while the DataPart carries `status: rejected` or `status: submitted` because the handler invocation succeeded. An AdCP `task_id` MUST NOT be copied into artifact metadata or inferred from `task.id`. Receivers MUST prefer artifacts when present and MUST NOT overwrite a DataPart's status with the A2A state. See `a2a-profile-extension.mdx` and `a2a-response-extraction.mdx` for the full binding and extraction algorithm.",
        "  - REST: envelope fields MAY ride on HTTP headers (e.g., `X-AdCP-Status`, `X-AdCP-Context-Id`) or as JSON body siblings; body fields appear at the JSON body root. Implementers choosing the header path SHOULD also mirror to body siblings for non-streaming callers.",
        "Across all three: envelope and body fields are conceptually a single response object. A task response schema MAY declare body fields with the same name as envelope fields (e.g., `errors[]` body-level for per-record validation results vs envelope-level for fatal task failure) and the two MUST be treated as distinct fields by name within their respective namespaces — see `error-handling.mdx#envelope-vs-payload-errors-the-two-layer-model`.",
        "`status` is REQUIRED on the conceptual AdCP response across all transports. On MCP and REST it appears as a sibling field at the JSON root (or `structuredContent` root for MCP). On A2A it is carried inside the authoritative DataPart alongside the task body; `task.status.state` separately carries the A2A transport lifecycle and selects where that DataPart is found. Receivers MUST preserve the DataPart status when present. The schema-level `required: [status]` enforces the post-extraction AdCP shape. `payload` remains intentionally NOT required — it is a documentary grouping construct, never a required wire field. See `mcp-guide.mdx` and `a2a-guide.mdx` for the wire-level patterns receivers MUST implement.",
        "Receivers MUST handle absence of an envelope field (e.g., `replayed` omitted) as the field's documented default — see each field's `default` clause."
      ]
    },
    "external:core/context.json": {
      "type": "object",
      "additionalProperties": true
    },
    "external:enums/task-status.json": {
      "type": "string",
      "enum": [
        "submitted",
        "working",
        "input-required",
        "completed",
        "canceled",
        "failed",
        "rejected",
        "auth-required",
        "unknown"
      ]
    },
    "external:core/error.json": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "message": {
          "type": "string"
        },
        "buyer_reason": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "message": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": true
        },
        "field": {
          "type": "string"
        },
        "suggestion": {
          "type": "string"
        },
        "retry_after": {
          "type": "number",
          "minimum": 1,
          "maximum": 3600
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pointer": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "keyword": {
                "type": "string"
              },
              "schemaPath": {
                "type": "string"
              },
              "schema_id": {
                "type": "string"
              },
              "discriminator": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "property_name": {
                      "type": "string"
                    },
                    "value": {
                      "type": [
                        "string",
                        "number",
                        "boolean",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "property_name",
                    "value"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "pointer",
              "message",
              "keyword"
            ],
            "additionalProperties": true
          }
        },
        "details": {
          "type": "object",
          "additionalProperties": true
        },
        "recovery": {
          "type": "string",
          "enum": [
            "transient",
            "correctable",
            "terminal"
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "producer",
            "sdk"
          ]
        },
        "sdk_id": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": true,
      "dependentRequired": {
        "buyer_reason": [
          "recovery"
        ]
      }
    },
    "external:core/push-notification-config.json": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9_.:-]{1,255}$"
        },
        "token": {
          "type": "string",
          "minLength": 16,
          "maxLength": 4096
        },
        "authentication": {
          "type": "object",
          "deprecated": true,
          "properties": {
            "schemes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/external:enums~1auth-scheme.json"
              },
              "minItems": 1,
              "maxItems": 1
            },
            "credentials": {
              "type": "string",
              "minLength": 32
            }
          },
          "required": [
            "schemes",
            "credentials"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "url"
      ]
    },
    "external:enums/auth-scheme.json": {
      "deprecated": true,
      "type": "string",
      "enum": [
        "Bearer",
        "HMAC-SHA256"
      ]
    },
    "external:core/reporting-receipt.json": {
      "x-status": "experimental",
      "type": "object",
      "properties": {
        "reporting_receipt_id": {
          "type": "string",
          "minLength": 16,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9_.:-]{16,255}$",
          "x-entity": "reporting_receipt"
        },
        "reporting_obligation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9_.:-]{1,255}$",
          "x-entity": "reporting_obligation"
        },
        "reporting_revision_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9_.:-]{1,255}$",
          "x-entity": "reporting_revision"
        },
        "reporting_materialization_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9_.:-]{1,255}$",
          "x-entity": "reporting_materialization"
        },
        "supersedes_reporting_receipt_id": {
          "type": "string",
          "minLength": 16,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9_.:-]{16,255}$",
          "x-entity": "reporting_receipt"
        },
        "status": {
          "type": "string",
          "enum": [
            "accepted",
            "rejected"
          ]
        },
        "verification_profile": {
          "$ref": "#/$defs/external:core~1reporting-verification-profile.json"
        },
        "observed_row_count": {
          "type": "integer",
          "minimum": 0
        },
        "observed_control_totals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/external:core~1reporting-control-total.json"
          },
          "uniqueItems": true
        },
        "observed_canonical_content_digest": {
          "$ref": "#/$defs/external:core~1reporting-canonical-content-digest.json"
        },
        "observed_manifest_sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "observed_native_version_ref": {
          "$ref": "#/$defs/external:core~1reporting-native-version-ref.json"
        },
        "consumer_commit_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "rejection_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "received_at": {
          "type": "string",
          "format": "date-time",
          "readOnly": true
        }
      },
      "required": [
        "reporting_receipt_id",
        "reporting_obligation_id",
        "reporting_revision_id",
        "reporting_materialization_id",
        "status",
        "verification_profile",
        "observed_row_count",
        "observed_control_totals",
        "observed_at"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "rejected"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "rejection_codes"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "verification_profile": {
                "const": "canonical_digest"
              },
              "status": {
                "const": "accepted"
              }
            },
            "required": [
              "verification_profile",
              "status"
            ]
          },
          "then": {
            "required": [
              "observed_canonical_content_digest"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "verification_profile": {
                "const": "manifest_checksums"
              },
              "status": {
                "const": "accepted"
              }
            },
            "required": [
              "verification_profile",
              "status"
            ]
          },
          "then": {
            "required": [
              "observed_manifest_sha256"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "verification_profile": {
                "const": "native_commit"
              },
              "status": {
                "const": "accepted"
              }
            },
            "required": [
              "verification_profile",
              "status"
            ]
          },
          "then": {
            "required": [
              "observed_native_version_ref"
            ]
          }
        }
      ],
      "x-adcp-validation": {
        "authorization": "The seller derives the consumer principal from authenticated transport and accepts receipts only for that principal's account-bound obligation and materialization. Unknown, unauthorized, cross-account, and cross-caller identifiers are indistinguishable.",
        "acceptance_match": "accepted requires exact equality with the selected materialization verification evidence: row count and control totals always; canonical digest or manifest digest when selected. A mismatch MUST be submitted or recorded as rejected.",
        "immutability": "A reporting_receipt_id is immutable. Exact retries are idempotent; reuse with different content is a conflict. A consumer retains one current leaf per obligation and revision: a new ID may supersede only that current rejected leaf. History remains append-only; an accepted current leaf is terminal."
      },
      "additionalProperties": false
    },
    "external:core/reporting-verification-profile.json": {
      "x-status": "experimental",
      "type": "string",
      "enum": [
        "native_commit",
        "manifest_checksums",
        "canonical_digest"
      ]
    },
    "external:core/reporting-control-total.json": {
      "x-status": "experimental",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
            },
            "value": {
              "type": "string",
              "pattern": "^-?(?:0|[1-9][0-9]*)$"
            },
            "value_type": {
              "type": "string",
              "const": "integer"
            },
            "unit": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            }
          },
          "required": [
            "name",
            "value",
            "value_type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
            },
            "value": {
              "type": "string",
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
            },
            "value_type": {
              "type": "string",
              "const": "decimal"
            },
            "unit": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            }
          },
          "required": [
            "name",
            "value",
            "value_type"
          ],
          "additionalProperties": false
        }
      ]
    },
    "external:core/reporting-canonical-content-digest.json": {
      "x-status": "experimental",
      "type": "object",
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "sha256"
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "canonicalization_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "canonicalization_uri": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://(?![^/]*@)(?!localhost(?:[:/]|$))(?!\\[)(?!\\d+(?:\\.\\d+){3}(?::|/|$))(?:[A-Za-z0-9-]+\\.)+[A-Za-z]{2,}(?::\\d+)?(?:/|$)"
        },
        "canonicalization_sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        }
      },
      "required": [
        "algorithm",
        "value",
        "canonicalization_id",
        "canonicalization_uri",
        "canonicalization_sha256"
      ],
      "additionalProperties": false
    },
    "external:core/reporting-native-version-ref.json": {
      "x-status": "experimental",
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "external:core/reporting-adjustment-receipt.json": {
      "x-status": "experimental",
      "type": "object",
      "properties": {
        "reporting_receipt_id": {
          "type": "string",
          "minLength": 16,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9_.:-]{16,255}$",
          "x-entity": "reporting_receipt"
        },
        "reporting_adjustment_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9_.:-]{1,255}$",
          "x-entity": "reporting_adjustment"
        },
        "adjusts_reporting_revision_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9_.:-]{1,255}$",
          "x-entity": "reporting_revision"
        },
        "supersedes_reporting_receipt_id": {
          "type": "string",
          "minLength": 16,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9_.:-]{16,255}$",
          "x-entity": "reporting_receipt"
        },
        "status": {
          "type": "string",
          "enum": [
            "accepted",
            "rejected"
          ]
        },
        "observed_adjustment_sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "rejection_codes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/external:core~1reporting-adjustment-receipt.json/$defs/ReportingAdjustmentRejectionCode"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "received_at": {
          "type": "string",
          "format": "date-time",
          "readOnly": true
        }
      },
      "required": [
        "reporting_receipt_id",
        "reporting_adjustment_id",
        "adjusts_reporting_revision_id",
        "status",
        "observed_adjustment_sha256",
        "observed_at"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "rejected"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "rejection_codes"
            ]
          },
          "else": {
            "not": {
              "required": [
                "rejection_codes"
              ]
            }
          }
        }
      ],
      "x-adcp-validation": {
        "authorization": "Derive consumer identity from authenticated transport. The adjustment and its official revision must be visible to that caller/account; unavailable and unauthorized identifiers are indistinguishable.",
        "acceptance_match": "accepted requires observed_adjustment_sha256 to equal the referenced adjustment's canonical_adjustment_sha256 and adjusts_reporting_revision_id to equal its target. A digest or semantic disagreement is rejected with stable rejection_codes.",
