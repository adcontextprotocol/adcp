{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adcontextprotocol.org/schemas/3.3.0-beta.3/mcp/2026-07-28/profiles/production/media-buy/control-media-buy-response.json",
  "type": "object",
  "allOf": [
    {
      "$ref": "#/$defs/external:core~1protocol-envelope.json"
    }
  ],
  "discriminator": {
    "propertyName": "status"
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "completed"
        },
        "media_buy_id": {
          "type": "string",
          "minLength": 1,
          "x-entity": "media_buy"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "media_buy_status": {
          "$ref": "#/$defs/external:enums~1media-buy-status.json"
        },
        "implementation_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "affected_package_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "x-entity": "package"
          },
          "uniqueItems": true
        },
        "available_actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/external:core~1canonical-media-buy-action.json"
          },
          "uniqueItems": true
        },
        "warnings": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/external:core~1warning.json"
              },
              {
                "properties": {
                  "code": {
                    "const": "inventory_shortfall_forecast"
                  }
                }
              }
            ]
          },
          "minItems": 1
        },
        "context": {
          "$ref": "#/$defs/external:core~1context.json"
        },
        "ext": {
          "$ref": "#/$defs/external:core~1ext.json"
        }
      },
      "required": [
        "status",
        "media_buy_id",
        "revision"
      ],
      "additionalProperties": true,
      "not": {
        "required": [
          "errors"
        ]
      }
    },
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "failed"
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/external:core~1error.json"
          },
          "minItems": 1
        },
        "context": {
          "$ref": "#/$defs/external:core~1context.json"
        },
        "ext": {
          "$ref": "#/$defs/external:core~1ext.json"
        }
      },
      "required": [
        "status",
        "errors"
      ],
      "additionalProperties": true,
      "not": {
        "anyOf": [
          {
            "required": [
              "media_buy_id"
            ]
          },
          {
            "required": [
              "warnings"
            ]
          }
        ]
      }
    },
    {
      "allOf": [
        {
          "$ref": "#/$defs/external:core~1task-submitted.json"
        }
      ],
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "submitted"
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/external:core~1error.json"
          }
        },
        "context": {
          "$ref": "#/$defs/external:core~1context.json"
        },
        "ext": {
          "$ref": "#/$defs/external:core~1ext.json"
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": true,
      "not": {
        "anyOf": [
          {
            "required": [
              "media_buy_id"
            ]
          },
          {
            "required": [
              "warnings"
            ]
          }
        ]
      }
    }
  ],
  "$defs": {
    "external:core/protocol-envelope.json": {
      "$id": "https://adcontextprotocol.org/schemas/3.3.0-beta.3/core/protocol-envelope.json",
      "type": "object",
      "allOf": [
        {
          "$ref": "https://adcontextprotocol.org/schemas/3.3.0-beta.3/mcp/2026-07-28/profiles/production/media-buy/control-media-buy-response.json#/$defs/external:core~1version-envelope.json"
        }
      ],
      "properties": {
        "context_id": {
          "type": "string",
          "x-max-length-4.0": 128
        },
        "context": {
          "$ref": "https://adcontextprotocol.org/schemas/3.3.0-beta.3/mcp/2026-07-28/profiles/production/media-buy/control-media-buy-response.json#/$defs/external:core~1context.json"
        },
        "task_id": {
          "$ref": "https://adcontextprotocol.org/schemas/3.3.0-beta.3/mcp/2026-07-28/profiles/production/media-buy/control-media-buy-response.json#/$defs/external:core~1task-id.json"
        },
        "status": {
          "$ref": "https://adcontextprotocol.org/schemas/3.3.0-beta.3/mcp/2026-07-28/profiles/production/media-buy/control-media-buy-response.json#/$defs/external:enums~1task-status.json"
        },
        "message": {
          "$ref": "https://adcontextprotocol.org/schemas/3.3.0-beta.3/mcp/2026-07-28/profiles/production/media-buy/control-media-buy-response.json#/$defs/external:core~1task-message.json"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "replayed": {
          "type": "boolean",
          "default": false
        },
        "adcp_error": {
          "$ref": "https://adcontextprotocol.org/schemas/3.3.0-beta.3/mcp/2026-07-28/profiles/production/media-buy/control-media-buy-response.json#/$defs/external:core~1error.json"
        },
        "push_notification_config": {
          "$ref": "https://adcontextprotocol.org/schemas/3.3.0-beta.3/mcp/2026-07-28/profiles/production/media-buy/control-media-buy-response.json#/$defs/external:core~1push-notification-config.json"
        },
        "governance_context": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[\\x20-\\x7E]+$"
        },
        "payload": {
          "type": "object",
          "x-adcp-open-payload": true,
          "additionalProperties": true
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": true,
      "not": {
        "anyOf": [
          {
            "required": [
              "task_status"
            ]
          },
          {
            "required": [
              "response_status"
            ]
          }
        ]
      },
      "notes": [
        "Task response schemas (e.g., get-products-response.json) define ONLY the body fields. The only envelope fields a task response schema declares are a `status` `const` or `enum` that discriminates a `oneOf`/`anyOf` branch, a `context` `$ref` identical to the envelope's, and a `const` that pins a fixed value; it does not restate any other envelope field. Each one composes this envelope through its root `allOf`, and the envelope supplies the protocol-layer fields, including `adcp_version` and `adcp_major_version` through `core/version-envelope.json`. Task response schemas do not compose `core/version-envelope.json` directly.",
        "Task response roots and status branches stay open (`additionalProperties` is not `false`). A closed root or branch would reject envelope fields, because draft-07 `additionalProperties` does not see properties declared through `allOf`.",
        "A body for one task status composes that status's schema through `allOf`: a submitted body or `oneOf`/`anyOf` branch composes `core/task-submitted.json`, which requires `status: submitted` and a `task_id` (`core/task-id.json`, never empty); a working body composes `core/task-working.json`; an input-required body composes `core/task-input-required.json`. The envelope states no conditional rule of its own.",
        "Transport serialization (normative):",
        "  - MCP: envelope fields and task-body fields are siblings at the root of the tool response. The `payload` object is NOT serialized as a nested key — its body fields are flattened to the root alongside `status`, `context_id`, `context`, etc. This matches MCP's native `structuredContent` convention and is what shipping SDKs (@adcp/client) emit. Conformant MCP receivers parse from the flat root; receivers that expect a nested `payload` key MUST migrate.",
        "  - A2A 1.0 with the AdCP profile extension: `task.status.state` carries the transport invocation lifecycle used to select the extraction location; `task.contextId` carries `context_id`, while `task.id` is an independent A2A transport identifier. The complete AdCP response, including its protocol-level `status` and any application-layer `task_id`, is canonically carried in `task.artifacts[0].parts[].DataPart` on final states; `task.status.message.parts[].DataPart` is the fallback container used only for interim A2A states (working, native submitted, input-required) where no final artifact has been emitted yet. For a structured AdCP business rejection or Submitted response, A2A is `completed` while the DataPart carries `status: rejected` or `status: submitted` because the handler invocation succeeded. An AdCP `task_id` MUST NOT be copied into artifact metadata or inferred from `task.id`. Receivers MUST prefer artifacts when present and MUST NOT overwrite a DataPart's status with the A2A state. See `a2a-profile-extension.mdx` and `a2a-response-extraction.mdx` for the full binding and extraction algorithm.",
        "  - REST: envelope fields MAY ride on HTTP headers (e.g., `X-AdCP-Status`, `X-AdCP-Context-Id`) or as JSON body siblings; body fields appear at the JSON body root. Implementers choosing the header path SHOULD also mirror to body siblings for non-streaming callers.",
        "Across all three: envelope and body fields are conceptually a single response object. A task response schema MAY declare body fields with the same name as envelope fields (e.g., `errors[]` body-level for per-record validation results vs envelope-level for fatal task failure) and the two MUST be treated as distinct fields by name within their respective namespaces — see `error-handling.mdx#envelope-vs-payload-errors-the-two-layer-model`.",
        "`status` is REQUIRED on the conceptual AdCP response across all transports. On MCP and REST it appears as a sibling field at the JSON root (or `structuredContent` root for MCP). On A2A it is carried inside the authoritative DataPart alongside the task body; `task.status.state` separately carries the A2A transport lifecycle and selects where that DataPart is found. Receivers MUST preserve the DataPart status when present. The schema-level `required: [status]` enforces the post-extraction AdCP shape. `payload` remains intentionally NOT required — it is a documentary grouping construct, never a required wire field. See `mcp-guide.mdx` and `a2a-guide.mdx` for the wire-level patterns receivers MUST implement.",
        "Receivers MUST handle absence of an envelope field (e.g., `replayed` omitted) as the field's documented default — see each field's `default` clause."
      ]
    },
    "external:core/version-envelope.json": {
      "$id": "https://adcontextprotocol.org/schemas/3.3.0-beta.3/core/version-envelope.json",
      "type": "object",
      "properties": {
        "adcp_version": {
          "type": "string",
          "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-[a-zA-Z0-9](?:[a-zA-Z0-9.-]*[a-zA-Z0-9])?)?$",
          "x-max-length-4.0": 32
        },
        "adcp_major_version": {
          "type": "integer",
          "deprecated": true,
          "x-removed-in": "4.0.0",
          "minimum": 1,
          "maximum": 99
        }
      }
    },
    "external:core/context.json": {
      "$id": "https://adcontextprotocol.org/schemas/3.3.0-beta.3/core/context.json",
      "type": "object",
      "additionalProperties": true
    },
    "external:core/task-id.json": {
      "$id": "https://adcontextprotocol.org/schemas/3.3.0-beta.3/core/task-id.json",
      "type": "string",
      "minLength": 1,
      "x-entity": "task",
      "x-max-length-4.0": 128
    },
    "external:enums/task-status.json": {
      "$id": "https://adcontextprotocol.org/schemas/3.3.0-beta.3/enums/task-status.json",
      "type": "string",
      "enum": [
        "submitted",
        "working",
        "input-required",
        "completed",
        "canceled",
        "failed",
        "rejected",
        "auth-required",
        "unknown"
      ]
    },
    "external:core/task-message.json": {
      "$id": "https://adcontextprotocol.org/schemas/3.3.0-beta.3/core/task-message.json",
      "type": "string",
      "maxLength": 2000
    },
    "external:core/error.json": {
      "$id": "https://adcontextprotocol.org/schemas/3.3.0-beta.3/core/error.json",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "message": {
          "type": "string",
          "x-max-length-4.0": 1024
        },
        "buyer_reason": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "x-max-length-4.0": 1024
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": true
        },
        "field": {
          "type": "string",
          "x-max-length-4.0": 256
        },
        "suggestion": {
          "type": "string",
          "x-max-length-4.0": 1024
        },
        "retry_after": {
          "type": "number",
          "minimum": 1,
          "maximum": 3600
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pointer": {
                "type": "string",
                "x-max-length-4.0": 256
              },
              "message": {
                "type": "string",
                "x-max-length-4.0": 512
              },
              "keyword": {
                "type": "string",
                "x-max-length-4.0": 64
              },
              "schemaPath": {
                "type": "string",
                "x-max-length-4.0": 256
              },
              "schema_id": {
                "type": "string",
                "x-max-length-4.0": 256
              },
              "discriminator": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "property_name": {
                      "type": "string",
                      "x-max-length-4.0": 128
                    },
                    "value": {
                      "type": [
                        "string",
                        "number",
                        "boolean",
                        "null"
                      ],
                      "x-max-length-4.0": 128
                    }
                  },
                  "required": [
                    "property_name",
                    "value"
                  ],
                  "additionalProperties": false
                },
                "x-max-items-4.0": 8
              }
            },
            "required": [
              "pointer",
              "message",
              "keyword"
            ],
            "additionalProperties": true
          },
          "x-max-items-4.0": 10
        },
        "details": {
          "type": "object",
          "additionalProperties": true
        },
        "recovery": {
          "type": "string",
          "enum": [
            "transient",
            "correctable",
            "terminal"
          ]
        },
        "mutation_outcome": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "x-added-in": "3.3.0"
        },
        "source": {
          "type": "string",
          "enum": [
            "producer",
            "sdk"
          ]
        },
        "sdk_id": {
          "type": "string",
          "x-max-length-4.0": 128
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": true,
      "dependentRequired": {
        "buyer_reason": [
          "recovery"
        ]
      }
    },
    "external:core/push-notification-config.json": {
      "$id": "https://adcontextprotocol.org/schemas/3.3.0-beta.3/core/push-notification-config.json",
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9_.:-]{1,255}$"
        },
        "token": {
          "type": "string",
          "minLength": 16,
          "maxLength": 4096
        },
        "authentication": {
          "type": "object",
          "deprecated": true,
          "x-removed-in": "4.0.0",
          "properties": {
            "schemes": {
              "type": "array",
              "items": {
                "$ref": "https://adcontextprotocol.org/schemas/3.3.0-beta.3/mcp/2026-07-28/profiles/production/media-buy/control-media-buy-response.json#/$defs/external:enums~1auth-scheme.json"
              },
              "minItems": 1,
              "maxItems": 1
            },
            "credentials": {
              "type": "string",
              "minLength": 32,
              "x-max-length-4.0": 512
            }
          },
          "required": [
            "schemes",
            "credentials"
          ],
          "additionalProperties": false
        },
        "signing_profile": {
          "x-status": "experimental",
          "$ref": "https://adcontextprotocol.org/schemas/3.3.0-beta.3/mcp/2026-07-28/profiles/production/media-buy/control-media-buy-response.json#/$defs/external:enums~1webhook-signing-profile.json",
          "x-added-in": "3.3.0"
        }
      },
      "required": [
        "url"
      ],
      "not": {
        "required": [
          "authentication",
          "signing_profile"
        ]
      }
    },
    "external:enums/auth-scheme.json": {
      "$id": "https://adcontextprotocol.org/schemas/3.3.0-beta.3/enums/auth-scheme.json",
      "deprecated": true,
      "x-removed-in": "4.0.0",
      "type": "string",
      "enum": [
        "Bearer",
        "HMAC-SHA256"
      ]
    },
    "external:enums/webhook-signing-profile.json": {
      "$id": "https://adcontextprotocol.org/schemas/3.3.0-beta.3/enums/webhook-signing-profile.json",
      "type": "string",
      "enum": [
        "adcp/webhook-signing/v1",
        "web-bot-auth"
      ],
      "x-added-in": "3.3.0"
    },
    "external:enums/media-buy-status.json": {
      "$id": "https://adcontextprotocol.org/schemas/3.3.0-beta.3/enums/media-buy-status.json",
      "type": "string",
      "enum": [
        "pending_creatives",
        "pending_start",
        "active",
        "paused",
        "completed",
        "rejected",
        "canceled"
      ]
    },
    "external:core/canonical-media-buy-action.json": {
      "$id": "https://adcontextprotocol.org/schemas/3.3.0-beta.3/core/canonical-media-buy-action.json",
      "x-adcp-validation": {
        "verifier_constraints": {
          "change_term_link": "When change_term_id is present, it resolves to the accepted proposal change term governing this action. The projected sla agrees with processing_sla. Issue reporting is an operational capability, not a negotiated change right.",
          "legacy_alias_agreement": "When both change_term_id and deprecated terms_ref are emitted as proposal-term links, their values are identical."
        }
      },
      "type": "object",
      "discriminator": {
        "propertyName": "task"
      },
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "https://adcontextprotocol.org/schemas/3.3.0-beta.3/mcp/2026-07-28/profiles/production/media-buy/control-media-buy-response.json#/$defs/external:core~1canonical-media-buy-action-fields.json"
            }
          ],
          "required": [
            "task"
          ],
          "properties": {
            "task": {
              "type": "string",
              "const": "report_media_buy_issue"
            },
            "action": {
              "type": "string",
              "enum": [
                "report_media_buy_issue"
              ]
            },
            "mode": {
              "type": "string",
              "const": "seller_managed"
            },
            "sla": {
              "$ref": "https://adcontextprotocol.org/schemas/3.3.0-beta.3/mcp/2026-07-28/profiles/production/media-buy/control-media-buy-response.json#/$defs/external:core~1escalation-sla.json"
            },
            "change_term_id": false,
            "terms_ref": false
          }
        },
        {
          "allOf": [
            {
              "$ref": "https://adcontextprotocol.org/schemas/3.3.0-beta.3/mcp/2026-07-28/profiles/production/media-buy/control-media-buy-response.json#/$defs/external:core~1canonical-media-buy-action-fields.json"
            },
            {
              "if": {
                "properties": {
                  "action": {
                    "type": "string",
                    "const": "update_creative_start_policy"
                  }
                },
                "required": [
                  "action"
                ]
              },
              "then": {
                "required": [
                  "applicable_package_ids"
                ],
                "properties": {
                  "change_term_id": false,
                  "terms_ref": false
                }
              }
            }
          ],
          "required": [
            "task"
          ],
          "properties": {
            "task": {
              "const": "control_media_buy"
            },
            "action": {
              "enum": [
                "pause",
                "resume",
                "cancel",
                "update_name",
                "update_creative_start_policy",
                "increase_budget",
                "decrease_budget",
                "reallocate_budget",
                "update_budget_allocation",
                "update_targeting",
                "update_pacing",
                "update_bidding",
                "update_frequency_caps",
                "update_media_buy_frequency_cap",
                "update_catalog_assignments",
                "update_keywords",
                "update_optimization_goals",
                "update_impression_goal",
                "update_spend_target",
                "update_reporting_webhook",
                "remove_packages"
              ]
            }
          }
        },
        {
          "allOf": [
            {
              "$ref": "https://adcontextprotocol.org/schemas/3.3.0-beta.3/mcp/2026-07-28/profiles/production/media-buy/control-media-buy-response.json#/$defs/external:core~1canonical-media-buy-action-fields.json"
            }
          ],
          "required": [
            "task"
          ],
          "properties": {
            "task": {
              "const": "refine_proposals"
            },
            "action": {
              "enum": [
                "cancel",
                "extend_flight",
                "shorten_flight",
                "update_flight_dates",
                "increase_budget",
                "decrease_budget",
                "reallocate_budget",
                "update_budget_allocation",
                "update_targeting",
                "update_pacing",
                "update_bidding",
                "update_frequency_caps",
                "update_media_buy_frequency_cap",
                "add_packages",
                "remove_packages"
              ]
            }
          }
        },
        {
          "allOf": [
            {
              "$ref": "https://adcontextprotocol.org/schemas/3.3.0-beta.3/mcp/2026-07-28/profiles/production/media-buy/control-media-buy-response.json#/$defs/external:core~1canonical-media-buy-action-fields.json"
            }
          ],
          "required": [
            "task"
          ],
          "properties": {
            "task": {
              "const": "sync_creatives"
            },
            "action": {
              "enum": [
                "replace_creative",
                "update_creative_assignments",
                "remove_creative"
              ]
            }
          }
        }
      ]
    },
    "external:core/canonical-media-buy-action-fields.json": {
      "$id": "https://adcontextprotocol.org/schemas/3.3.0-beta.3/core/canonical-media-buy-action-fields.json",
      "type": "object",
      "properties": {
        "task": {
          "type": "string",
          "enum": [
            "control_media_buy",
            "refine_proposals",
            "sync_creatives",
            "report_media_buy_issue"
          ]
        },
        "action": {
          "type": "string"
