{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://adcontextprotocol.org/schemas/3.3.0-beta.3/error-details/creative-merge-rejected.json",
  "title": "Creative Merge Rejected Details",
  "description": "Typed details for CREATIVE_MERGE_REJECTED. Lists every merge assignment operation the seller rejected in the request, with a reason, so the buyer can correct or drop those merges and resubmit the rest in one request.",
  "type": "object",
  "properties": {
    "rejections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "operation_index": {
            "type": "integer",
            "minimum": 0,
            "description": "Zero-based index of the rejected operation in the request's assignment_operations array."
          },
          "creative_id": {
            "type": "string",
            "minLength": 1,
            "x-entity": "creative"
          },
          "package_id": {
            "type": "string",
            "minLength": 1,
            "x-entity": "package"
          },
          "merged_creative_id": {
            "type": "string",
            "minLength": 1,
            "x-entity": "creative"
          },
          "reason": {
            "$ref": "https://adcontextprotocol.org/schemas/3.3.0-beta.3/enums/creative-merge-rejection-reason.json"
          }
        },
        "required": [
          "operation_index",
          "creative_id",
          "package_id",
          "merged_creative_id",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "rejections"
  ],
  "additionalProperties": false,
  "x-added-in": "3.3.0"
}
