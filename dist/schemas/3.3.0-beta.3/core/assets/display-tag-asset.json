{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://adcontextprotocol.org/schemas/3.3.0-beta.3/core/assets/display-tag-asset.json",
  "title": "Display Tag Asset",
  "description": "One atomic third-party display delivery representation. `delivery_type` distinguishes a single ad-request URL, byte-preserved inline markup, and a paired redirect whose ad-request and click-through URLs MUST travel together. This is not an HTML5 bundle: seller-hosted HTML5 zip files use `asset_type: \"zip\"` under `format_kind: \"html5\"`.",
  "type": "object",
  "properties": {
    "asset_type": {
      "type": "string",
      "const": "display_tag",
      "description": "Discriminator identifying an atomic third-party display-tag representation."
    },
    "macro_declarations": {
      "type": "array",
      "items": {
        "$ref": "https://adcontextprotocol.org/schemas/3.3.0-beta.3/core/macro-declaration.json"
      },
      "minItems": 1,
      "description": "Exact macro tokens present anywhere in this representation. Tokens remain byte-preserved until the resolver named by each declaration substitutes them."
    },
    "width": {
      "x-added-in": "3.3.0",
      "type": "integer",
      "minimum": 1,
      "description": "Rendered width in logical pixels of the entry canvas, independent of target placement and embedded image density. For expandable units, this is the initial width. When set, height must also be set. Mutually exclusive with sizes."
    },
    "height": {
      "x-added-in": "3.3.0",
      "type": "integer",
      "minimum": 1,
      "description": "Rendered height in logical pixels of the entry canvas. For expandable units, this is the initial height. When set, width must also be set. Mutually exclusive with sizes."
    },
    "sizes": {
      "x-added-in": "3.3.0",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "width",
          "height"
        ],
        "properties": {
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      },
      "description": "Selectable entry-canvas sizes in logical pixels at which the same representation can render, rather than placement constraints or expanded states. Mutually exclusive with width/height. Omit all size fields for an unsized or responsive asset; absence does not establish compatibility with a size-constrained option."
    },
    "provenance": {
      "$ref": "https://adcontextprotocol.org/schemas/3.3.0-beta.3/core/provenance.json",
      "description": "Provenance metadata for this asset, overriding manifest-level provenance."
    }
  },
  "required": [
    "asset_type"
  ],
  "discriminator": {
    "propertyName": "delivery_type"
  },
  "oneOf": [
    {
      "title": "Tag URL",
      "type": "object",
      "properties": {
        "asset_type": {
          "type": "string",
          "const": "display_tag"
        },
        "macro_declarations": {
          "items": {
            "properties": {
              "location": {
                "properties": {
                  "field": {
                    "const": "url"
                  }
                }
              }
            }
          }
        },
        "delivery_type": {
          "type": "string",
          "const": "tag_url"
        },
        "url": {
          "$ref": "https://adcontextprotocol.org/schemas/3.3.0-beta.3/core/macro-bearing-url.json",
          "description": "Ad-request URL invoked at impression time. It is equivalent to the backward-compatible `url` asset with `url_type: \"ad_request\"`."
        }
      },
      "required": [
        "asset_type",
        "delivery_type",
        "url"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "markup"
            ]
          },
          {
            "required": [
              "ad_request_url"
            ]
          },
          {
            "required": [
              "clickthrough_url"
            ]
          }
        ]
      }
    },
    {
      "title": "Inline markup",
      "type": "object",
      "properties": {
        "asset_type": {
          "type": "string",
          "const": "display_tag"
        },
        "macro_declarations": {
          "items": {
            "properties": {
              "location": {
                "properties": {
                  "field": {
                    "const": "markup"
                  }
                }
              }
            }
          }
        },
        "delivery_type": {
          "type": "string",
          "const": "inline_markup"
        },
        "markup_type": {
          "type": "string",
          "enum": [
            "iframe_javascript",
            "javascript",
            "standard"
          ],
          "description": "How the destination traffics the byte-preserved markup."
        },
        "markup": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1048576,
          "description": "Exact third-party tag markup. Receivers MUST preserve its bytes and MUST NOT reinterpret it as a seller-hosted HTML5 bundle."
        }
      },
      "required": [
        "asset_type",
        "delivery_type",
        "markup_type",
        "markup"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "url"
            ]
          },
          {
            "required": [
              "ad_request_url"
            ]
          },
          {
            "required": [
              "clickthrough_url"
            ]
          }
        ]
      }
    },
    {
      "title": "Paired redirect",
      "type": "object",
      "properties": {
        "asset_type": {
          "type": "string",
          "const": "display_tag"
        },
        "macro_declarations": {
          "items": {
            "properties": {
              "location": {
                "properties": {
                  "field": {
                    "enum": [
                      "ad_request_url",
                      "clickthrough_url"
                    ]
                  }
                }
              }
            }
          }
        },
        "delivery_type": {
          "type": "string",
          "const": "paired_redirect"
        },
        "ad_request_url": {
          "$ref": "https://adcontextprotocol.org/schemas/3.3.0-beta.3/core/macro-bearing-url.json",
          "description": "Image or ad-request URL entered into the destination ad server. This field deliberately accepts byte-preserved vendor tokens that are not RFC 6570 URI templates."
        },
        "clickthrough_url": {
          "$ref": "https://adcontextprotocol.org/schemas/3.3.0-beta.3/core/macro-bearing-url.json",
          "description": "Click-through URL paired with `ad_request_url`. This field deliberately accepts byte-preserved vendor tokens that are not RFC 6570 URI templates. The pair MUST NOT be split, mixed, or revised independently."
        }
      },
      "required": [
        "asset_type",
        "delivery_type",
        "ad_request_url",
        "clickthrough_url"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "url"
            ]
          },
          {
            "required": [
              "markup"
            ]
          }
        ]
      }
    }
  ],
  "dependencies": {
    "width": [
      "height"
    ],
    "height": [
      "width"
    ]
  },
  "not": {
    "anyOf": [
      {
        "required": [
          "width",
          "sizes"
        ]
      },
      {
        "required": [
          "height",
          "sizes"
        ]
      }
    ]
  },
  "additionalProperties": true
}
