{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://adcontextprotocol.org/schemas/3.2.0-beta.8/error-details/macro-resolution-failed.json",
  "title": "Macro Resolution Failed Details",
  "description": "Required details shape for MACRO_RESOLUTION_FAILED. Carries one path-addressable compatibility result for every declared macro occurrence considered by the resolver.",
  "type": "object",
  "properties": {
    "macro_resolution_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://adcontextprotocol.org/schemas/3.2.0-beta.8/core/macro-resolution-result.json"
      }
    }
  },
  "required": [
    "macro_resolution_results"
  ],
  "additionalProperties": true
}
