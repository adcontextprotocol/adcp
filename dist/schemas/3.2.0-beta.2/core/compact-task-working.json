{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://adcontextprotocol.org/schemas/3.2.0-beta.2/core/compact-task-working.json",
  "title": "Compact Task Working",
  "description": "Bounded progress payload shared by the compact lifecycle tools.",
  "type": "object",
  "properties": {
    "percentage": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "current_step": {
      "type": "string",
      "maxLength": 500
    },
    "total_steps": {
      "type": "integer",
      "minimum": 1
    },
    "step_number": {
      "type": "integer",
      "minimum": 1
    },
    "context": {
      "$ref": "https://adcontextprotocol.org/schemas/3.2.0-beta.2/core/context.json"
    },
    "ext": {
      "$ref": "https://adcontextprotocol.org/schemas/3.2.0-beta.2/core/ext.json"
    }
  },
  "additionalProperties": true
}
