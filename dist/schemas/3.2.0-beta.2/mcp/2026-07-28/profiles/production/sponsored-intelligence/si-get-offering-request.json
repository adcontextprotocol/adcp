{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adcontextprotocol.org/schemas/3.2.0-beta.2/mcp/2026-07-28/profiles/production/sponsored-intelligence/si-get-offering-request.json",
  "type": "object",
  "allOf": [
    {
      "$ref": "#/$defs/external:core~1version-envelope.json"
    }
  ],
  "x-status": "experimental",
  "properties": {
    "offering_id": {
      "type": "string",
      "x-entity": "offering"
    },
    "intent": {
      "type": "string"
    },
    "context": {
      "$ref": "#/$defs/external:core~1context.json"
    },
    "include_products": {
      "type": "boolean",
      "default": false
    },
    "product_limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50,
      "default": 5
    },
    "ext": {
      "$ref": "#/$defs/external:core~1ext.json"
    }
  },
  "required": [
    "offering_id"
  ],
  "additionalProperties": true,
  "$defs": {
    "external:core/version-envelope.json": {
      "type": "object",
      "properties": {
        "adcp_version": {
          "type": "string",
          "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-[a-zA-Z0-9](?:[a-zA-Z0-9.-]*[a-zA-Z0-9])?)?$"
        },
        "adcp_major_version": {
          "type": "integer",
          "deprecated": true,
          "minimum": 1,
          "maximum": 99
        }
      }
    },
    "external:core/context.json": {
      "type": "object",
      "additionalProperties": true
    },
    "external:core/ext.json": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
