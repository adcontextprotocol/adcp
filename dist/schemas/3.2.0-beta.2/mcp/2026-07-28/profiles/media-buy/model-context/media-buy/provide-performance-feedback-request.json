{
  "type": "object",
  "allOf": [
    {
      "$ref": "#/$defs/external:core~1version-envelope.json"
    },
    {
      "$ref": "#/$defs/external:core~1performance-feedback-assertion.json"
    }
  ],
  "properties": {
    "idempotency_key": {
      "type": "string"
    },
    "context": {
      "$ref": "#/$defs/external:core~1context.json"
    },
    "ext": {
      "$ref": "#/$defs/external:core~1ext.json"
    }
  },
  "required": [
    "idempotency_key"
  ],
  "additionalProperties": true,
  "$defs": {
    "external:core/version-envelope.json": {
      "type": "object",
      "properties": {
        "adcp_version": {
          "type": "string"
        },
        "adcp_major_version": {
          "type": "integer"
        }
      }
    },
    "external:core/performance-feedback-assertion.json": {
      "type": "object",
      "properties": {
        "media_buy_id": {
          "type": "string"
        },
        "package_id": {
          "type": "string"
        },
        "creative_id": {
          "type": "string"
        },
        "measurement_period": {
          "$ref": "#/$defs/external:core~1datetime-range.json"
        },
        "performance_index": {
          "type": "number"
        },
        "baseline": {
          "$ref": "#/$defs/external:enums~1performance-baseline.json"
        },
        "metric": {
          "$ref": "#/$defs/external:core~1performance-feedback-metric.json"
        },
        "metric_type": {
          "$ref": "#/$defs/external:enums~1metric-type.json"
        },
        "producer": {
          "$ref": "#/$defs/external:core~1brand-ref.json"
        },
        "vendor": {
          "$ref": "#/$defs/external:core~1brand-ref.json"
        },
        "feedback_source": {
          "$ref": "#/$defs/external:enums~1feedback-source.json"
        },
        "methodology": {
          "type": "string"
        },
        "methodology_version": {
          "type": "string"
        },
        "study_ref": {
          "type": "string"
        },
        "evidence": {
          "type": "object",
          "properties": {
            "sample_size": {
              "type": "integer"
            },
            "confidence_interval": {
              "type": "object",
              "properties": {
                "lower": {
                  "type": "number"
                },
                "upper": {
                  "type": "number"
                },
                "level": {
                  "type": "number"
                }
              },
              "required": [
                "lower",
                "upper",
                "level"
              ]
            }
          }
        },
        "evidence_ref": {
          "type": "string"
        },
        "as_of": {
          "type": "string"
        },
        "final": {
          "type": "boolean"
        },
        "supersedes_feedback_id": {
          "type": "string"
        }
      },
      "required": [
        "media_buy_id",
        "measurement_period",
        "performance_index"
      ],
      "additionalProperties": true,
      "dependentRequired": {
        "methodology": [
          "producer"
        ],
        "methodology_version": [
          "producer"
        ]
      }
    },
    "external:core/datetime-range.json": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string"
        },
        "end": {
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": true
    },
    "external:enums/performance-baseline.json": {
      "type": "string",
      "enum": [
        "campaign_target",
        "control_group",
        "seller_history",
        "buyer_portfolio",
        "market_benchmark",
        "other"
      ]
    },
    "external:core/performance-feedback-metric.json": {
      "type": "object",
      "discriminator": {
        "propertyName": "scope"
      },
      "oneOf": [
        {
          "properties": {
            "scope": {
              "type": "string",
              "const": "standard"
            },
            "metric_id": {
              "$ref": "#/$defs/external:enums~1available-metric.json"
            },
            "qualifier": {
              "type": "object",
              "properties": {
                "viewability_standard": {
                  "$ref": "#/$defs/external:enums~1viewability-standard.json"
                },
                "completion_source": {
                  "$ref": "#/$defs/external:enums~1completion-source.json"
                },
                "attribution_methodology": {
                  "$ref": "#/$defs/external:enums~1attribution-methodology.json"
                },
                "attribution_window": {
                  "$ref": "#/$defs/external:core~1duration.json"
                },
                "lift_dimension": {
                  "$ref": "#/$defs/external:enums~1lift-dimension.json"
                }
              }
            }
          },
          "required": [
            "scope",
            "metric_id"
          ]
        },
        {
          "properties": {
            "scope": {
              "type": "string",
              "const": "vendor"
            },
            "vendor": {
              "$ref": "#/$defs/external:core~1brand-ref.json"
            },
            "metric_id": {
              "$ref": "#/$defs/external:core~1vendor-metric-id.json"
            }
          },
          "required": [
            "scope",
            "vendor",
            "metric_id"
          ]
        }
      ]
    },
    "external:enums/available-metric.json": {
      "type": "string",
      "enum": [
        "impressions",
        "spend",
        "clicks",
        "ctr",
        "views",
        "completed_views",
        "completion_rate",
        "conversions",
        "conversion_value",
        "commissionable_value",
        "roas",
        "cost_per_acquisition",
        "new_to_brand_rate",
        "leads",
        "reach",
        "frequency",
        "grps",
        "engagements",
        "engagement_rate",
        "follows",
        "saves",
        "profile_visits",
        "viewability",
        "quartile_data",
        "dooh_metrics",
        "cost_per_click",
        "cost_per_completed_view",
        "cpm",
        "downloads",
        "units_sold",
        "new_to_brand_units",
        "plays",
        "incremental_sales_lift",
        "brand_lift",
        "foot_traffic",
        "conversion_lift",
        "brand_search_lift"
      ]
    },
    "external:enums/viewability-standard.json": {
      "type": "string",
      "enum": [
        "mrc",
        "groupm"
      ]
    },
    "external:enums/completion-source.json": {
      "type": "string",
      "enum": [
        "seller_attested",
        "vendor_attested"
      ]
    },
    "external:enums/attribution-methodology.json": {
      "type": "string",
      "enum": [
        "deterministic_purchase",
        "probabilistic",
        "panel_based",
        "modeled"
      ]
    },
    "external:core/duration.json": {
      "type": "object",
      "properties": {
        "interval": {
          "type": "integer"
        },
        "unit": {
          "type": "string",
          "enum": [
            "seconds",
            "minutes",
            "hours",
            "days",
            "campaign"
          ]
        }
      },
      "required": [
        "interval",
        "unit"
      ]
    },
    "external:enums/lift-dimension.json": {
      "type": "string",
      "enum": [
        "awareness",
        "consideration",
        "favorability",
        "purchase_intent",
        "ad_recall"
      ]
    },
    "external:core/brand-ref.json": {
      "type": "object",
      "properties": {
        "domain": {
          "type": "string"
        },
        "brand_id": {
          "$ref": "#/$defs/external:core~1brand-id.json"
        },
        "countries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "industries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "data_subject_contestation": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string"
            },
            "email": {
              "type": "string"
            },
            "languages": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "anyOf": [
            {
              "required": [
                "url"
              ]
            },
            {
              "required": [
                "email"
              ]
            }
          ]
        },
        "brand_kit_override": {
          "type": "object",
          "properties": {
            "logo": {
              "$ref": "#/$defs/external:core~1assets~1image-asset.json"
            },
            "colors": {
              "type": "object",
              "properties": {
                "primary": {
                  "type": "string"
                },
                "secondary": {
                  "type": "string"
                },
                "accent": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            },
            "voice": {
              "type": "string"
            },
            "tagline": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      },
      "required": [
        "domain"
      ]
    },
    "external:core/brand-id.json": {
      "type": "string"
    },
    "external:core/assets/image-asset.json": {
      "type": "object",
      "properties": {
        "asset_type": {
          "type": "string",
          "const": "image"
        },
        "url": {
          "type": "string"
        },
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        },
        "file_size_bytes": {
          "type": "integer"
        },
        "pixel_ratio": {
          "type": "number"
        },
        "format": {
          "type": "string"
        },
        "alt_text": {
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/external:core~1provenance.json"
        }
      },
      "required": [
        "asset_type",
        "url",
        "width",
        "height"
      ],
      "additionalProperties": true
    },
    "external:core/provenance.json": {
      "type": "object",
      "properties": {
        "digital_source_type": {
          "$ref": "#/$defs/external:enums~1digital-source-type.json"
        },
        "synthetic_depiction": {
          "type": "boolean"
        },
        "ai_tool": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "provider": {
              "type": "string"
            }
          },
          "required": [
            "name"
          ]
        },
        "human_oversight": {
          "type": "string",
          "enum": [
            "none",
            "prompt_only",
            "selected",
            "edited",
            "directed"
          ]
        },
        "declared_by": {
          "type": "object",
          "properties": {
            "agent_url": {
              "type": "string"
            },
            "role": {
              "type": "string",
              "enum": [
                "creator",
                "advertiser",
                "agency",
                "platform",
                "tool"
              ]
            }
          },
          "required": [
            "role"
          ]
        },
        "declared_at": {
          "type": "string"
        },
        "created_time": {
          "type": "string"
        },
        "c2pa": {
          "type": "object",
          "properties": {
            "manifest_url": {
              "type": "string"
            }
          },
          "required": [
            "manifest_url"
          ]
        },
        "embedded_provenance": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "method": {
                "$ref": "#/$defs/external:enums~1embedded-provenance-method.json"
              },
              "standard": {
                "type": "string"
              },
              "provider": {
                "type": "string"
              },
              "verify_agent": {
                "type": "object",
                "properties": {
                  "agent_url": {
                    "type": "string"
                  },
                  "feature_id": {
                    "type": "string"
                  }
                },
                "required": [
                  "agent_url"
                ]
              },
              "embedded_at": {
                "type": "string"
              }
            },
            "required": [
              "method",
              "provider"
            ]
          }
        },
        "watermarks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "media_type": {
                "$ref": "#/$defs/external:enums~1watermark-media-type.json"
              },
              "provider": {
                "type": "string"
              },
              "verify_agent": {
                "type": "object",
                "properties": {
                  "agent_url": {
                    "type": "string"
                  },
                  "feature_id": {
                    "type": "string"
                  }
                },
                "required": [
                  "agent_url"
                ]
              },
              "c2pa_action": {
                "$ref": "#/$defs/external:enums~1c2pa-watermark-action.json"
              },
              "embedded_at": {
                "type": "string"
              }
            },
            "required": [
              "media_type",
              "provider"
            ]
          }
        },
        "disclosure": {
          "type": "object",
          "properties": {
            "required": {
              "type": "boolean"
            },
            "jurisdictions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "country": {
                    "type": "string"
                  },
                  "region": {
                    "type": "string"
                  },
                  "regulation": {
                    "type": "string"
                  },
                  "label_text": {
                    "type": "string"
                  },
                  "render_guidance": {
                    "type": "object",
                    "properties": {
                      "persistence": {
                        "$ref": "#/$defs/external:enums~1disclosure-persistence.json"
                      },
                      "min_duration_ms": {
                        "type": "integer"
                      },
                      "positions": {
                        "type": "array",
                        "items": {
                          "$ref": "#/$defs/external:enums~1disclosure-position.json"
                        }
                      },
                      "ext": {
                        "$ref": "#/$defs/external:core~1ext.json"
                      }
                    }
                  }
                },
                "required": [
                  "country",
                  "regulation"
                ]
              }
            }
          },
          "required": [
            "required"
          ]
        },
        "verification": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "verified_by": {
                "type": "string"
              },
              "verified_time": {
                "type": "string"
              },
              "result": {
                "type": "string",
                "enum": [
                  "authentic",
                  "ai_generated",
                  "ai_modified",
                  "inconclusive"
                ]
              },
              "confidence": {
                "type": "number"
              },
              "details_url": {
                "type": "string"
              }
            },
            "required": [
              "verified_by",
              "result"
            ]
          }
        },
        "ext": {
          "$ref": "#/$defs/external:core~1ext.json"
        }
      }
    },
    "external:enums/digital-source-type.json": {
      "type": "string",
      "enum": [
        "digital_capture",
        "digital_creation",
        "trained_algorithmic_media",
        "composite_with_trained_algorithmic_media",
        "algorithmic_media",
        "composite_capture",
        "composite_synthetic",
        "human_edits",
        "data_driven_media"
      ]
    },
    "external:enums/embedded-provenance-method.json": {
      "type": "string",
      "enum": [
        "manifest_wrapper",
        "provenance_markers"
      ]
    },
    "external:enums/watermark-media-type.json": {
      "type": "string",
      "enum": [
        "audio",
        "image",
        "video",
        "text"
      ]
    },
    "external:enums/c2pa-watermark-action.json": {
      "type": "string",
      "enum": [
        "c2pa.watermarked.bound",
        "c2pa.watermarked.unbound"
      ]
    },
    "external:enums/disclosure-persistence.json": {
      "type": "string",
      "enum": [
        "continuous",
        "initial",
        "flexible"
      ]
    },
    "external:enums/disclosure-position.json": {
      "type": "string",
      "enum": [
        "prominent",
        "footer",
        "audio",
        "subtitle",
        "overlay",
        "end_card",
        "pre_roll",
        "companion"
      ]
    },
    "external:core/ext.json": {
      "type": "object",
      "additionalProperties": true
    },
    "external:core/vendor-metric-id.json": {
      "type": "string"
    },
    "external:enums/metric-type.json": {
      "type": "string",
      "enum": [
        "overall_performance",
        "conversion_rate",
        "brand_lift",
        "click_through_rate",
        "completion_rate",
        "viewability",
        "brand_safety",
        "cost_efficiency"
      ]
    },
    "external:enums/feedback-source.json": {
      "type": "string",
      "enum": [
        "buyer_attribution",
        "third_party_measurement",
        "platform_analytics",
        "verification_partner"
      ]
    },
    "external:core/context.json": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
