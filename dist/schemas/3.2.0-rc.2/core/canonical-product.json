{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://adcontextprotocol.org/schemas/3.2.0-rc.2/core/canonical-product.json",
  "title": "Canonical Product",
  "description": "Standalone compact Product view for the AdCP 3.2 lifecycle. product_id and name are the only always-returned fields; requested detail fields are optional. Legacy named formats, coarse MediaBuy actions, and the legacy Product inheritance graph are absent.",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string",
      "minLength": 1,
      "x-entity": "product"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "publisher_properties": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "https://adcontextprotocol.org/schemas/3.2.0-rc.2/core/publisher-property-selector.json"
          },
          {
            "not": {
              "required": [
                "publisher_domains"
              ]
            }
          }
        ]
      },
      "minItems": 1
    },
    "channels": {
      "type": "array",
      "items": {
        "$ref": "https://adcontextprotocol.org/schemas/3.2.0-rc.2/enums/channels.json"
      },
      "uniqueItems": true
    },
    "video_placement_types": {
      "type": "array",
      "items": {
        "$ref": "https://adcontextprotocol.org/schemas/3.2.0-rc.2/enums/video-placement-type.json"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "audio_distribution_types": {
      "type": "array",
      "items": {
        "$ref": "https://adcontextprotocol.org/schemas/3.2.0-rc.2/enums/audio-distribution-type.json"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "sponsored_placement_types": {
      "type": "array",
      "items": {
        "$ref": "https://adcontextprotocol.org/schemas/3.2.0-rc.2/enums/sponsored-placement-type.json"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "social_placement_surfaces": {
      "type": "array",
      "items": {
        "$ref": "https://adcontextprotocol.org/schemas/3.2.0-rc.2/enums/social-placement-surface.json"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "format_options": {
      "type": "array",
      "items": {
        "$ref": "https://adcontextprotocol.org/schemas/3.2.0-rc.2/core/canonical-format-option.json"
      },
      "minItems": 1
    },
    "placements": {
      "type": "array",
      "items": {
        "$ref": "https://adcontextprotocol.org/schemas/3.2.0-rc.2/core/canonical-placement.json"
      }
    },
    "delivery_type": {
      "$ref": "https://adcontextprotocol.org/schemas/3.2.0-rc.2/enums/delivery-type.json"
    },
    "exclusivity": {
      "$ref": "https://adcontextprotocol.org/schemas/3.2.0-rc.2/enums/exclusivity.json"
    },
    "pricing_options": {
      "type": "array",
      "items": {
        "$ref": "https://adcontextprotocol.org/schemas/3.2.0-rc.2/core/canonical-pricing-option.json"
      },
      "minItems": 1
    },
    "forecast": {
      "$ref": "https://adcontextprotocol.org/schemas/3.2.0-rc.2/core/canonical-delivery-forecast.json"
    },
    "reporting_capabilities": {
      "$ref": "https://adcontextprotocol.org/schemas/3.2.0-rc.2/core/canonical-reporting-capabilities.json"
    },
    "measurement_terms": {
      "$ref": "https://adcontextprotocol.org/schemas/3.2.0-rc.2/core/canonical-measurement-terms.json",
      "description": "Default billing measurement and makegood terms inherited by a direct purchase unless a negotiated proposal replaces them."
    },
    "performance_standards": {
      "type": "array",
      "items": {
        "$ref": "https://adcontextprotocol.org/schemas/3.2.0-rc.2/core/canonical-performance-standard.json"
      },
      "minItems": 1,
      "description": "Default performance thresholds and measurement vendors inherited by a direct purchase."
    },
    "catalog_types": {
      "type": "array",
      "items": {
        "$ref": "https://adcontextprotocol.org/schemas/3.2.0-rc.2/enums/catalog-type.json"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "signal_targeting_allowed": {
      "type": "boolean"
    },
    "signal_targeting_rules": {
      "$ref": "https://adcontextprotocol.org/schemas/3.2.0-rc.2/core/signal-targeting-rules.json"
    },
    "demographic_targeting": {
      "$ref": "https://adcontextprotocol.org/schemas/3.2.0-rc.2/core/demographic-targeting-capability.json"
    },
    "overlay_support": {
      "$ref": "https://adcontextprotocol.org/schemas/3.2.0-rc.2/core/targeting-overlay-support.json",
      "description": "Binding product-scoped targeting dimensions the buyer may set independently on a package after discovery."
    },
    "identity": {
      "$ref": "https://adcontextprotocol.org/schemas/3.2.0-rc.2/core/product-identity.json",
      "x-status": "experimental",
      "x-added-in": "3.2.0",
      "description": "Experimental product-scoped identity and reach-measurement facts. See Product.identity for the cross-object delivery and frequency-cap rules."
    },
    "audience_evidence": {
      "type": "array",
      "items": {
        "$ref": "https://adcontextprotocol.org/schemas/3.2.0-rc.2/core/canonical-audience-evidence.json"
      },
      "minItems": 1
    },
    "audience_evidence_selections": {
      "type": "array",
      "items": {
        "$ref": "https://adcontextprotocol.org/schemas/3.2.0-rc.2/core/canonical-audience-evidence-selection.json"
      },
      "minItems": 1,
      "description": "Exact evidence snapshots that affected eligibility or ranking. Returned whenever evidence requirements affected the result, even if not requested explicitly."
    },
    "max_optimization_goals": {
      "type": "integer",
      "minimum": 0
    },
    "catalog_match": {
      "type": "object",
      "properties": {
        "matched_gtins": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]{8,14}$"
          }
        },
        "matched_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "matched_count": {
          "type": "integer",
          "minimum": 0
        },
        "submitted_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "submitted_count"
      ],
      "additionalProperties": false
    },
    "list_applications": {
      "type": "array",
      "description": "Product-scoped receipts for every effective property- or collection-list targeting reference. Sellers MUST return one receipt per application regardless of response field projection; exclusion applications receive a receipt even when summary.matched is zero, while zero matches for any inclusion application make the product ineligible and it is not returned. Each receipt uses the same pre-list product inventory baseline; pricing and forecast reflect inventory remaining after all effective lists are composed.",
      "items": {
        "$ref": "https://adcontextprotocol.org/schemas/3.2.0-rc.2/core/inventory-list-application.json"
      },
      "minItems": 1
    },
    "brief_relevance": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "allowed_actions": {
      "type": "array",
      "items": {
        "$ref": "https://adcontextprotocol.org/schemas/3.2.0-rc.2/core/canonical-product-action.json"
      },
      "uniqueItems": true
    },
    "acceptance_policy_profile_ids": {
      "$ref": "https://adcontextprotocol.org/schemas/3.2.0-rc.2/core/acceptance-policy-profile-ids.json"
    },
    "ext": {
      "$ref": "https://adcontextprotocol.org/schemas/3.2.0-rc.2/core/ext.json"
    }
  },
  "required": [
    "product_id",
    "name"
  ],
  "allOf": [
    {
      "description": "A compact product that declares identity absence cannot promise identifier-backed frequency-cap execution.",
      "if": {
        "properties": {
          "identity": {
            "properties": {
              "persistent_identifier": {
                "const": false
              }
            },
            "required": [
              "persistent_identifier"
            ]
          }
        },
        "required": [
          "identity"
        ]
      },
      "then": {
        "properties": {
          "overlay_support": {
            "not": {
              "required": [
                "frequency_cap"
              ]
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
