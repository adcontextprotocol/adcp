{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://adcontextprotocol.org/schemas/3.2.0-rc.2/core/forecast-rate-range.json",
  "title": "Forecast Rate Range",
  "description": "A forecast range whose low, midpoint, and high values are rates in the inclusive interval from 0 to 1.",
  "allOf": [
    {
      "$ref": "https://adcontextprotocol.org/schemas/3.2.0-rc.2/core/forecast-range.json"
    },
    {
      "properties": {
        "low": {
          "maximum": 1
        },
        "mid": {
          "maximum": 1
        },
        "high": {
          "maximum": 1
        }
      }
    }
  ]
}
