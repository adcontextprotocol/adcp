{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://adcontextprotocol.org/schemas/3.3.0-beta.2/core/canonical-media-buy-action.json",
  "title": "Canonical Media Buy Action",
  "description": "A currently available MediaBuy action with the compact-lifecycle task an SDK calls to exercise it. Deprecated coarse action values are absent. In AdCP 3.3, update_creative_start_policy is an operational package control with an explicit eligible package scope, independent of commercial change terms.",
  "x-adcp-validation": {
    "verifier_constraints": {
      "change_term_link": "When change_term_id is present, it resolves to the accepted proposal change term governing this action. The projected sla agrees with processing_sla. Issue reporting is an operational capability, not a negotiated change right.",
      "legacy_alias_agreement": "When both change_term_id and deprecated terms_ref are emitted as proposal-term links, their values are identical."
    }
  },
  "type": "object",
  "discriminator": {
    "propertyName": "task"
  },
  "oneOf": [
    {
      "allOf": [
        {
          "$ref": "https://adcontextprotocol.org/schemas/3.3.0-beta.2/core/canonical-media-buy-action-fields.json"
        }
      ],
      "required": [
        "task"
      ],
      "properties": {
        "task": {
          "type": "string",
          "const": "report_media_buy_issue"
        },
        "action": {
          "type": "string",
          "enum": [
            "report_media_buy_issue"
          ]
        },
        "mode": {
          "type": "string",
          "const": "seller_managed"
        },
        "sla": {
          "$ref": "https://adcontextprotocol.org/schemas/3.3.0-beta.2/core/escalation-sla.json"
        },
        "change_term_id": false,
        "terms_ref": false
      }
    },
    {
      "allOf": [
        {
          "$ref": "https://adcontextprotocol.org/schemas/3.3.0-beta.2/core/canonical-media-buy-action-fields.json"
        },
        {
          "if": {
            "properties": {
              "action": {
                "type": "string",
                "const": "update_creative_start_policy"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "applicable_package_ids"
            ],
            "properties": {
              "change_term_id": false,
              "terms_ref": false
            }
          }
        }
      ],
      "required": [
        "task"
      ],
      "properties": {
        "task": {
          "const": "control_media_buy"
        },
        "action": {
          "enum": [
            "pause",
            "resume",
            "cancel",
            "update_name",
            "update_creative_start_policy",
            "increase_budget",
            "decrease_budget",
            "reallocate_budget",
            "update_budget_allocation",
            "update_targeting",
            "update_pacing",
            "update_bidding",
            "update_frequency_caps",
            "update_media_buy_frequency_cap",
            "update_catalog_assignments",
            "update_keywords",
            "update_optimization_goals",
            "update_impression_goal",
            "update_spend_target",
            "update_reporting_webhook",
            "remove_packages"
          ]
        }
      }
    },
    {
      "allOf": [
        {
          "$ref": "https://adcontextprotocol.org/schemas/3.3.0-beta.2/core/canonical-media-buy-action-fields.json"
        }
      ],
      "required": [
        "task"
      ],
      "properties": {
        "task": {
          "const": "refine_proposals"
        },
        "action": {
          "enum": [
            "cancel",
            "extend_flight",
            "shorten_flight",
            "update_flight_dates",
            "increase_budget",
            "decrease_budget",
            "reallocate_budget",
            "update_budget_allocation",
            "update_targeting",
            "update_pacing",
            "update_bidding",
            "update_frequency_caps",
            "update_media_buy_frequency_cap",
            "add_packages",
            "remove_packages"
          ]
        }
      }
    },
    {
      "allOf": [
        {
          "$ref": "https://adcontextprotocol.org/schemas/3.3.0-beta.2/core/canonical-media-buy-action-fields.json"
        }
      ],
      "required": [
        "task"
      ],
      "properties": {
        "task": {
          "const": "sync_creatives"
        },
        "action": {
          "enum": [
            "replace_creative",
            "update_creative_assignments",
            "remove_creative"
          ]
        }
      }
    }
  ]
}
