{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adcontextprotocol.org/schemas/3.2.0-beta.4/mcp/2026-07-28/profiles/media-buy/protocol/list-tasks-request.json",
  "type": "object",
  "properties": {
    "adcp_version": {
      "type": "string",
      "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-[a-zA-Z0-9](?:[a-zA-Z0-9.-]*[a-zA-Z0-9])?)?$",
      "description": "Release-precision AdCP version (VERSION.RELEASE, e.g. \"3.0\", \"3.1\", \"3.1-beta\"). On a request: the buyer's release pin — the seller validates against its supported_versions and returns VERSION_UNSUPPORTED on cross-major mismatch, or downshifts to the highest supported release within the same major. On a response: the release the seller actually served — clients SHOULD validate the response against that release's schema, not against their pin. Patches are not negotiated; surface them as build_version on capabilities for operational visibility. When omitted, falls back to adcp_major_version (deprecated) or server default. Buyers SHOULD emit both adcp_version and adcp_major_version through 3.x to remain compatible with sellers that only read the legacy field. NORMALIZATION: SDKs that read full-semver values from bundle metadata (e.g. ComplianceIndex.published_version = \"3.1.0-beta.1\") MUST normalize to release-precision (\"3.1-beta.1\") before emitting on the wire — meta-field values are NOT valid wire values."
    },
    "adcp_major_version": {
      "type": "integer",
      "deprecated": true,
      "minimum": 1,
      "maximum": 99,
      "description": "DEPRECATED in favor of adcp_version (release-precision string). Servers MUST continue to honor this field through 3.x. Removed in 4.0. Original semantics: the AdCP major version the buyer's payloads conform to. Sellers validate against their supported major_versions and return VERSION_UNSUPPORTED if unsupported. When omitted, the seller assumes its highest supported version."
    },
    "account": {
      "$ref": "#/$defs/external:core~1account-ref.json"
    },
    "filters": {
      "type": "object",
      "properties": {
        "protocol": {
          "$ref": "#/$defs/external:enums~1adcp-protocol.json"
        },
        "protocols": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/external:enums~1adcp-protocol.json"
          },
          "minItems": 1
        },
        "status": {
          "$ref": "#/$defs/external:enums~1task-status.json"
        },
        "statuses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/external:enums~1task-status.json"
          },
          "minItems": 1
        },
        "task_type": {
          "$ref": "#/$defs/external:enums~1task-type.json"
        },
        "task_types": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/external:enums~1task-type.json"
          },
          "minItems": 1
        },
        "created_after": {
          "type": "string",
          "format": "date-time"
        },
        "created_before": {
          "type": "string",
          "format": "date-time"
        },
        "updated_after": {
          "type": "string",
          "format": "date-time"
        },
        "updated_before": {
          "type": "string",
          "format": "date-time"
        },
        "task_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "maxItems": 100
        },
        "context_contains": {
          "type": "string"
        },
        "has_webhook": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "sort": {
      "type": "object",
      "properties": {
        "field": {
          "type": "string",
          "enum": [
            "created_at",
            "updated_at",
            "status",
            "task_type",
            "protocol"
          ],
          "default": "created_at"
        },
        "direction": {
          "$ref": "#/$defs/external:enums~1sort-direction.json",
          "default": "desc"
        }
      },
      "additionalProperties": true
    },
    "pagination": {
      "$ref": "#/$defs/external:core~1pagination-request.json"
    },
    "include_history": {
      "type": "boolean",
      "default": false
    },
    "context": {
      "$ref": "#/$defs/external:core~1context.json"
    },
    "ext": {
      "$ref": "#/$defs/external:core~1ext.json"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "external:core/version-envelope.json": {
      "type": "object",
      "properties": {
        "adcp_version": {
          "type": "string",
          "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-[a-zA-Z0-9](?:[a-zA-Z0-9.-]*[a-zA-Z0-9])?)?$"
        },
        "adcp_major_version": {
          "type": "integer",
          "deprecated": true,
          "minimum": 1,
          "maximum": 99
        }
      }
    },
    "external:core/account-ref.json": {
      "type": "object",
      "oneOf": [
        {
          "properties": {
            "account_id": {
              "type": "string",
              "x-entity": "account"
            }
          },
          "required": [
            "account_id"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "brand": {
              "$ref": "#/$defs/external:core~1brand-ref.json"
            },
            "operator": {
              "type": "string",
              "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$",
              "x-entity": "operator"
            },
            "operator_unit": {
              "$ref": "#/$defs/external:core~1operator-unit.json"
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "timezone": {
              "type": "string",
              "minLength": 1
            },
            "sandbox": {
              "type": "boolean",
              "default": false
            }
          },
          "required": [
            "brand",
            "operator"
          ],
          "additionalProperties": false
        }
      ]
    },
    "external:core/brand-ref.json": {
      "type": "object",
      "properties": {
        "domain": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$"
        },
        "brand_id": {
          "$ref": "#/$defs/external:core~1brand-id.json"
        },
        "countries": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "industries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "data_subject_contestation": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            "email": {
              "type": "string",
              "format": "email"
            },
            "languages": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "anyOf": [
            {
              "required": [
                "url"
              ]
            },
            {
              "required": [
                "email"
              ]
            }
          ],
          "additionalProperties": false
        },
        "brand_kit_override": {
          "type": "object",
          "properties": {
            "logo": {
              "$ref": "#/$defs/external:core~1assets~1image-asset.json"
            },
            "colors": {
              "type": "object",
              "properties": {
                "primary": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "secondary": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "accent": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                }
              },
              "additionalProperties": true
            },
            "voice": {
              "type": "string"
            },
            "tagline": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      },
      "required": [
        "domain"
      ],
      "additionalProperties": false
    },
    "external:core/brand-id.json": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "x-entity": "advertiser_brand"
    },
    "external:core/assets/image-asset.json": {
      "type": "object",
      "properties": {
        "asset_type": {
          "type": "string",
          "const": "image"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "file_size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "pixel_ratio": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "format": {
          "type": "string"
        },
        "alt_text": {
          "type": "string",
          "x-accessibility": true
        },
        "provenance": {
          "$ref": "#/$defs/external:core~1provenance.json"
        }
      },
      "required": [
        "asset_type",
        "url",
        "width",
        "height"
      ],
      "additionalProperties": true
    },
    "external:core/provenance.json": {
      "type": "object",
      "properties": {
        "digital_source_type": {
          "$ref": "#/$defs/external:enums~1digital-source-type.json"
        },
        "synthetic_depiction": {
          "type": "boolean"
        },
        "ai_tool": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "provider": {
              "type": "string"
            }
          },
          "required": [
            "name"
          ]
        },
        "human_oversight": {
          "type": "string",
          "enum": [
            "none",
            "prompt_only",
            "selected",
            "edited",
            "directed"
          ]
        },
        "declared_by": {
          "type": "object",
          "properties": {
            "agent_url": {
              "type": "string",
              "format": "uri"
            },
            "role": {
              "type": "string",
              "enum": [
                "creator",
                "advertiser",
                "agency",
                "platform",
                "tool"
              ]
            }
          },
          "required": [
            "role"
          ]
        },
        "declared_at": {
          "type": "string",
          "format": "date-time"
        },
        "created_time": {
          "type": "string",
          "format": "date-time"
        },
        "c2pa": {
          "type": "object",
          "properties": {
            "manifest_url": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "manifest_url"
          ]
        },
        "embedded_provenance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "method": {
                "$ref": "#/$defs/external:enums~1embedded-provenance-method.json"
              },
              "standard": {
                "type": "string"
              },
              "provider": {
                "type": "string"
              },
              "verify_agent": {
                "type": "object",
                "properties": {
                  "agent_url": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https://"
                  },
                  "feature_id": {
                    "type": "string"
                  }
                },
                "required": [
                  "agent_url"
                ],
                "additionalProperties": false
              },
              "embedded_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "method",
              "provider"
            ]
          }
        },
        "watermarks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "media_type": {
                "$ref": "#/$defs/external:enums~1watermark-media-type.json"
              },
              "provider": {
                "type": "string"
              },
              "verify_agent": {
                "type": "object",
                "properties": {
                  "agent_url": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https://"
                  },
                  "feature_id": {
                    "type": "string"
                  }
                },
                "required": [
                  "agent_url"
                ],
                "additionalProperties": false
              },
              "c2pa_action": {
                "$ref": "#/$defs/external:enums~1c2pa-watermark-action.json"
              },
              "embedded_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "media_type",
              "provider"
            ]
          }
        },
        "disclosure": {
          "type": "object",
          "properties": {
            "required": {
              "type": "boolean"
            },
            "jurisdictions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "country": {
                    "type": "string"
                  },
                  "region": {
                    "type": "string"
                  },
                  "regulation": {
                    "type": "string"
                  },
                  "label_text": {
                    "type": "string"
                  },
                  "render_guidance": {
                    "type": "object",
                    "minProperties": 1,
                    "properties": {
                      "persistence": {
                        "$ref": "#/$defs/external:enums~1disclosure-persistence.json"
                      },
                      "min_duration_ms": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "positions": {
                        "type": "array",
                        "items": {
                          "$ref": "#/$defs/external:enums~1disclosure-position.json"
                        },
                        "minItems": 1,
                        "uniqueItems": true
                      },
                      "ext": {
                        "$ref": "#/$defs/external:core~1ext.json"
                      }
                    }
                  }
                },
                "required": [
                  "country",
                  "regulation"
                ]
              },
              "minItems": 1
            }
          },
          "required": [
            "required"
          ]
        },
        "verification": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "verified_by": {
                "type": "string"
              },
              "verified_time": {
                "type": "string",
                "format": "date-time"
              },
              "result": {
                "type": "string",
                "enum": [
                  "authentic",
                  "ai_generated",
                  "ai_modified",
                  "inconclusive"
                ]
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "details_url": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "verified_by",
              "result"
            ]
          }
        },
        "ext": {
          "$ref": "#/$defs/external:core~1ext.json"
        }
      }
    },
    "external:enums/digital-source-type.json": {
      "type": "string",
      "enum": [
        "digital_capture",
        "digital_creation",
        "trained_algorithmic_media",
        "composite_with_trained_algorithmic_media",
        "algorithmic_media",
        "composite_capture",
        "composite_synthetic",
        "human_edits",
        "data_driven_media"
      ]
    },
    "external:enums/embedded-provenance-method.json": {
      "type": "string",
      "enum": [
        "manifest_wrapper",
        "provenance_markers"
      ]
    },
    "external:enums/watermark-media-type.json": {
      "type": "string",
      "enum": [
        "audio",
        "image",
        "video",
        "text"
      ]
    },
    "external:enums/c2pa-watermark-action.json": {
      "type": "string",
      "enum": [
        "c2pa.watermarked.bound",
        "c2pa.watermarked.unbound"
      ]
    },
    "external:enums/disclosure-persistence.json": {
      "type": "string",
      "enum": [
        "continuous",
        "initial",
        "flexible"
      ]
    },
    "external:enums/disclosure-position.json": {
      "type": "string",
      "enum": [
        "prominent",
        "footer",
        "audio",
        "subtitle",
        "overlay",
        "end_card",
        "pre_roll",
        "companion"
      ]
    },
    "external:core/ext.json": {
      "type": "object",
      "additionalProperties": true
    },
    "external:core/operator-unit.json": {
      "x-entity": "operator_unit",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "external:enums/adcp-protocol.json": {
      "type": "string",
      "enum": [
        "media-buy",
        "signals",
        "governance",
        "creative",
        "brand",
        "sponsored-intelligence",
        "measurement"
      ]
    },
    "external:enums/task-status.json": {
      "type": "string",
      "enum": [
        "submitted",
        "working",
        "input-required",
        "completed",
        "canceled",
        "failed",
        "rejected",
        "auth-required",
        "unknown"
      ]
    },
    "external:enums/task-type.json": {
      "type": "string",
      "enum": [
        "create_media_buy",
        "update_media_buy",
        "buy_products",
        "accept_proposal",
        "control_media_buy",
        "media_buy_delivery",
        "sync_creatives",
        "build_creative",
        "preview_creative",
        "activate_signal",
        "get_products",
        "request_proposals",
        "refine_proposals",
        "decline_proposals",
        "get_signals",
        "create_property_list",
        "update_property_list",
        "get_property_list",
        "list_property_lists",
        "delete_property_list",
        "sync_accounts",
        "get_account_financials",
        "get_creative_delivery",
        "sync_event_sources",
        "sync_audiences",
        "sync_catalogs",
        "log_event",
        "get_brand_identity",
        "search_brands",
        "get_rights",
        "acquire_rights",
        "update_rights",
        "sync_agent_notification_configs"
      ],
      "x-task-result-schema-overrides": {
        "media_buy_delivery": "media-buy/media-buy-delivery-webhook-result.json"
      },
      "notes": [
        "Task types map to specific AdCP task operations",
        "Each task type belongs to the 'media-buy', 'signals', 'property', 'account', 'creative', or 'brand' domain",
        "This enum is used in task management APIs (tasks/list, tasks/get) and webhook payloads",
        "New task types require a minor version bump per semantic versioning"
      ]
    },
    "external:enums/sort-direction.json": {
      "type": "string",
      "enum": [
        "asc",
        "desc"
      ]
    },
    "external:core/pagination-request.json": {
      "type": "object",
      "properties": {
        "max_results": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 50
        },
        "cursor": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "external:core/context.json": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "description": "Request parameters for the list_tasks AdCP tool. This is a 3.x protocol-namespace alias for the legacy AdCP tasks/list reconciliation surface, not a transport-native MCP/A2A tasks/* method. It lists and filters AdCP application-layer async tasks for state reconciliation while preserving the legacy 3.x payload shape."
}
