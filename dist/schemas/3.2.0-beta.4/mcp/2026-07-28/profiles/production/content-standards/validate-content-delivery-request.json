{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adcontextprotocol.org/schemas/3.2.0-beta.4/mcp/2026-07-28/profiles/production/content-standards/validate-content-delivery-request.json",
  "type": "object",
  "properties": {
    "adcp_version": {
      "type": "string",
      "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-[a-zA-Z0-9](?:[a-zA-Z0-9.-]*[a-zA-Z0-9])?)?$",
      "description": "Release-precision AdCP version (VERSION.RELEASE, e.g. \"3.0\", \"3.1\", \"3.1-beta\"). On a request: the buyer's release pin — the seller validates against its supported_versions and returns VERSION_UNSUPPORTED on cross-major mismatch, or downshifts to the highest supported release within the same major. On a response: the release the seller actually served — clients SHOULD validate the response against that release's schema, not against their pin. Patches are not negotiated; surface them as build_version on capabilities for operational visibility. When omitted, falls back to adcp_major_version (deprecated) or server default. Buyers SHOULD emit both adcp_version and adcp_major_version through 3.x to remain compatible with sellers that only read the legacy field. NORMALIZATION: SDKs that read full-semver values from bundle metadata (e.g. ComplianceIndex.published_version = \"3.1.0-beta.1\") MUST normalize to release-precision (\"3.1-beta.1\") before emitting on the wire — meta-field values are NOT valid wire values."
    },
    "adcp_major_version": {
      "type": "integer",
      "deprecated": true,
      "minimum": 1,
      "maximum": 99,
      "description": "DEPRECATED in favor of adcp_version (release-precision string). Servers MUST continue to honor this field through 3.x. Removed in 4.0. Original semantics: the AdCP major version the buyer's payloads conform to. Sellers validate against their supported major_versions and return VERSION_UNSUPPORTED if unsupported. When omitted, the seller assumes its highest supported version."
    },
    "standards_id": {
      "type": "string"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "properties": {
          "record_id": {
            "type": "string"
          },
          "media_buy_id": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "artifact": {
            "$ref": "#/$defs/external:content-standards~1artifact.json"
          },
          "country": {
            "type": "string"
          },
          "channel": {
            "type": "string"
          },
          "brand_context": {
            "type": "object",
            "properties": {
              "brand_id": {
                "type": "string"
              },
              "sku_id": {
                "type": "string"
              }
            }
          }
        },
        "required": [
          "record_id",
          "artifact"
        ]
      }
    },
    "feature_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "include_passed": {
      "type": "boolean",
      "default": true
    },
    "context": {
      "$ref": "#/$defs/external:core~1context.json"
    },
    "ext": {
      "$ref": "#/$defs/external:core~1ext.json"
    }
  },
  "required": [
    "standards_id",
    "records"
  ],
  "$defs": {
    "external:core/version-envelope.json": {
      "type": "object",
      "properties": {
        "adcp_version": {
          "type": "string",
          "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-[a-zA-Z0-9](?:[a-zA-Z0-9.-]*[a-zA-Z0-9])?)?$"
        },
        "adcp_major_version": {
          "type": "integer",
          "deprecated": true,
          "minimum": 1,
          "maximum": 99
        }
      }
    },
    "external:content-standards/artifact.json": {
      "type": "object",
      "properties": {
        "property_rid": {
          "type": "string"
        },
        "artifact_id": {
          "type": "string"
        },
        "variant_id": {
          "type": "string"
        },
        "format_id": {
          "$ref": "#/$defs/external:core~1format-id.json",
          "deprecated": true
        },
        "format_kind": {
          "$ref": "#/$defs/external:core~1canonical-format-kind.json"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "published_time": {
          "type": "string",
          "format": "date-time"
        },
        "last_update_time": {
          "type": "string",
          "format": "date-time"
        },
        "assets": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "discriminator": {
              "propertyName": "type"
            },
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "text"
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "title",
                      "paragraph",
                      "heading",
                      "caption",
                      "quote",
                      "list_item",
                      "description"
                    ]
                  },
                  "content": {
                    "type": "string",
                    "maxLength": 100000
                  },
                  "content_format": {
                    "type": "string",
                    "enum": [
                      "text/plain",
                      "text/markdown",
                      "text/html",
                      "application/json"
                    ],
                    "default": "text/plain"
                  },
                  "language": {
                    "type": "string"
                  },
                  "heading_level": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 6
                  },
                  "provenance": {
                    "$ref": "#/$defs/external:core~1provenance.json"
                  }
                },
                "required": [
                  "type",
                  "content"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "image"
                  },
                  "url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "access": {
                    "$ref": "#/$defs/external:content-standards~1artifact.json/$defs/asset_access"
                  },
                  "alt_text": {
                    "type": "string"
                  },
                  "caption": {
                    "type": "string"
                  },
                  "width": {
                    "type": "integer"
                  },
                  "height": {
                    "type": "integer"
                  },
                  "provenance": {
                    "$ref": "#/$defs/external:core~1provenance.json"
                  }
                },
                "required": [
                  "type",
                  "url"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "video"
                  },
                  "url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "access": {
                    "$ref": "#/$defs/external:content-standards~1artifact.json/$defs/asset_access"
                  },
                  "duration_ms": {
                    "type": "integer"
                  },
                  "transcript": {
                    "type": "string",
                    "maxLength": 200000
                  },
                  "transcript_format": {
                    "type": "string",
                    "enum": [
                      "text/plain",
                      "text/markdown",
                      "application/json"
                    ],
                    "default": "text/plain"
                  },
                  "transcript_source": {
                    "type": "string",
                    "enum": [
                      "original_script",
                      "subtitles",
                      "closed_captions",
                      "dub",
                      "generated"
                    ]
                  },
                  "thumbnail_url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "provenance": {
                    "$ref": "#/$defs/external:core~1provenance.json"
                  }
                },
                "required": [
                  "type",
                  "url"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "audio"
                  },
                  "url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "access": {
                    "$ref": "#/$defs/external:content-standards~1artifact.json/$defs/asset_access"
                  },
                  "duration_ms": {
                    "type": "integer"
                  },
                  "transcript": {
                    "type": "string",
                    "maxLength": 200000
                  },
                  "transcript_format": {
                    "type": "string",
                    "enum": [
                      "text/plain",
                      "text/markdown",
                      "application/json"
                    ],
                    "default": "text/plain"
                  },
                  "transcript_source": {
                    "type": "string",
                    "enum": [
                      "original_script",
                      "closed_captions",
                      "generated"
                    ]
                  },
                  "provenance": {
                    "$ref": "#/$defs/external:core~1provenance.json"
                  }
                },
                "required": [
                  "type",
                  "url"
                ]
              }
            ]
          }
        },
        "metadata": {
          "type": "object",
          "properties": {
            "canonical": {
              "type": "string",
              "format": "uri"
            },
            "author": {
              "type": "string"
            },
            "keywords": {
              "type": "string"
            },
            "open_graph": {
              "type": "object",
              "additionalProperties": true
            },
            "twitter_card": {
              "type": "object",
              "additionalProperties": true
            },
            "json_ld": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          },
          "additionalProperties": true
        },
        "provenance": {
          "$ref": "#/$defs/external:core~1provenance.json"
        },
        "identifiers": {
          "type": "object",
          "properties": {
            "apple_podcast_id": {
              "type": "string"
            },
            "spotify_collection_id": {
              "type": "string"
            },
            "podcast_guid": {
              "type": "string"
            },
            "youtube_video_id": {
              "type": "string"
            },
            "rss_url": {
              "type": "string",
              "format": "uri"
            }
          },
          "additionalProperties": true
        }
      },
      "required": [
        "property_rid",
        "artifact_id",
        "assets"
      ],
      "additionalProperties": true,
      "$defs": {
        "asset_access": {
          "type": "object",
          "discriminator": {
            "propertyName": "method"
          },
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "method": {
                  "type": "string",
                  "const": "bearer_token"
                },
                "token": {
                  "type": "string"
                }
              },
              "required": [
                "method",
                "token"
              ]
            },
            {
              "type": "object",
              "properties": {
                "method": {
                  "type": "string",
                  "const": "service_account"
                },
                "provider": {
                  "type": "string",
                  "enum": [
                    "gcp",
                    "aws"
                  ]
                },
                "credentials": {
                  "type": "object",
                  "deprecated": true,
                  "additionalProperties": true
                }
              },
              "required": [
                "method",
                "provider"
              ]
            },
            {
              "type": "object",
              "properties": {
                "method": {
                  "type": "string",
                  "const": "signed_url"
                }
              },
              "required": [
                "method"
              ]
            }
          ]
        }
      }
    },
    "external:core/format-id.json": {
      "deprecated": true,
      "x-entity": "creative_format",
      "type": "object",
      "properties": {
        "agent_url": {
          "type": "string",
          "format": "uri"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "duration_ms": {
          "type": "number",
          "minimum": 1
        },
        "pixel_ratio": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "agent_url",
        "id"
      ],
      "additionalProperties": true,
      "dependentRequired": {
        "width": [
          "height"
        ],
        "height": [
          "width"
        ],
        "pixel_ratio": [
          "width",
          "height"
        ]
      }
    },
    "external:core/canonical-format-kind.json": {
      "type": "string",
      "enum": [
        "image",
        "html5",
        "display_tag",
        "image_carousel",
        "video_hosted",
        "video_vast",
        "audio_hosted",
        "audio_daast",
        "sponsored_placement",
        "native_in_feed",
        "responsive_creative",
        "agent_placement",
        "custom"
      ]
    },
    "external:core/provenance.json": {
      "type": "object",
      "properties": {
        "digital_source_type": {
          "$ref": "#/$defs/external:enums~1digital-source-type.json"
        },
        "synthetic_depiction": {
          "type": "boolean"
        },
        "ai_tool": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "provider": {
              "type": "string"
            }
          },
          "required": [
            "name"
          ]
        },
        "human_oversight": {
          "type": "string",
          "enum": [
            "none",
            "prompt_only",
            "selected",
            "edited",
            "directed"
          ]
        },
        "declared_by": {
          "type": "object",
          "properties": {
            "agent_url": {
              "type": "string",
              "format": "uri"
            },
            "role": {
              "type": "string",
              "enum": [
                "creator",
                "advertiser",
                "agency",
                "platform",
                "tool"
              ]
            }
          },
          "required": [
            "role"
          ]
        },
        "declared_at": {
          "type": "string",
          "format": "date-time"
        },
        "created_time": {
          "type": "string",
          "format": "date-time"
        },
        "c2pa": {
          "type": "object",
          "properties": {
            "manifest_url": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "manifest_url"
          ]
        },
        "embedded_provenance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "method": {
                "$ref": "#/$defs/external:enums~1embedded-provenance-method.json"
              },
              "standard": {
                "type": "string"
              },
              "provider": {
                "type": "string"
              },
              "verify_agent": {
                "type": "object",
                "properties": {
                  "agent_url": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https://"
                  },
                  "feature_id": {
                    "type": "string"
                  }
                },
                "required": [
                  "agent_url"
                ],
                "additionalProperties": false
              },
              "embedded_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "method",
              "provider"
            ]
          }
        },
        "watermarks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "media_type": {
                "$ref": "#/$defs/external:enums~1watermark-media-type.json"
              },
              "provider": {
                "type": "string"
              },
              "verify_agent": {
                "type": "object",
                "properties": {
                  "agent_url": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https://"
                  },
                  "feature_id": {
                    "type": "string"
                  }
                },
                "required": [
                  "agent_url"
                ],
                "additionalProperties": false
              },
              "c2pa_action": {
                "$ref": "#/$defs/external:enums~1c2pa-watermark-action.json"
              },
              "embedded_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "media_type",
              "provider"
            ]
          }
        },
        "disclosure": {
          "type": "object",
          "properties": {
            "required": {
              "type": "boolean"
            },
            "jurisdictions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "country": {
                    "type": "string"
                  },
                  "region": {
                    "type": "string"
                  },
                  "regulation": {
                    "type": "string"
                  },
                  "label_text": {
                    "type": "string"
                  },
                  "render_guidance": {
                    "type": "object",
                    "minProperties": 1,
                    "properties": {
                      "persistence": {
                        "$ref": "#/$defs/external:enums~1disclosure-persistence.json"
                      },
                      "min_duration_ms": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "positions": {
                        "type": "array",
                        "items": {
                          "$ref": "#/$defs/external:enums~1disclosure-position.json"
                        },
                        "minItems": 1,
                        "uniqueItems": true
                      },
                      "ext": {
                        "$ref": "#/$defs/external:core~1ext.json"
                      }
                    }
                  }
                },
                "required": [
                  "country",
                  "regulation"
                ]
              },
              "minItems": 1
            }
          },
          "required": [
            "required"
          ]
        },
        "verification": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "verified_by": {
                "type": "string"
              },
              "verified_time": {
                "type": "string",
                "format": "date-time"
              },
              "result": {
                "type": "string",
                "enum": [
                  "authentic",
                  "ai_generated",
                  "ai_modified",
                  "inconclusive"
                ]
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "details_url": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "verified_by",
              "result"
            ]
          }
        },
        "ext": {
          "$ref": "#/$defs/external:core~1ext.json"
        }
      }
    },
    "external:enums/digital-source-type.json": {
      "type": "string",
      "enum": [
        "digital_capture",
        "digital_creation",
        "trained_algorithmic_media",
        "composite_with_trained_algorithmic_media",
        "algorithmic_media",
        "composite_capture",
        "composite_synthetic",
        "human_edits",
        "data_driven_media"
      ]
    },
    "external:enums/embedded-provenance-method.json": {
      "type": "string",
      "enum": [
        "manifest_wrapper",
        "provenance_markers"
      ]
    },
    "external:enums/watermark-media-type.json": {
      "type": "string",
      "enum": [
        "audio",
        "image",
        "video",
        "text"
      ]
    },
    "external:enums/c2pa-watermark-action.json": {
      "type": "string",
      "enum": [
        "c2pa.watermarked.bound",
        "c2pa.watermarked.unbound"
      ]
    },
    "external:enums/disclosure-persistence.json": {
      "type": "string",
      "enum": [
        "continuous",
        "initial",
        "flexible"
      ]
    },
    "external:enums/disclosure-position.json": {
      "type": "string",
      "enum": [
        "prominent",
        "footer",
        "audio",
        "subtitle",
        "overlay",
        "end_card",
        "pre_roll",
        "companion"
      ]
    },
    "external:core/ext.json": {
      "type": "object",
      "additionalProperties": true
    },
    "external:core/context.json": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "description": "Request parameters for batch validating delivery records against content safety policies"
}
