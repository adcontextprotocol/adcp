{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://adcontextprotocol.org/schemas/3.2.0-beta.4/governance/get-plan-audit-logs-response.json",
  "title": "Get Plan Audit Logs Response",
  "description": "Governance state and audit trail for one or more plans.",
  "type": "object",
  "allOf": [
    {
      "$ref": "https://adcontextprotocol.org/schemas/3.2.0-beta.4/core/version-envelope.json"
    },
    {
      "$ref": "https://adcontextprotocol.org/schemas/3.2.0-beta.4/core/protocol-envelope.json"
    }
  ],
  "x-status": "experimental",
  "properties": {
    "plans": {
      "type": "array",
      "description": "Audit data for each requested plan.",
      "items": {
        "type": "object",
        "properties": {
          "plan_id": {
            "type": "string",
            "description": "Plan identifier.",
            "x-entity": "governance_plan"
          },
          "plan_version": {
            "type": "integer",
            "description": "Current plan version."
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "suspended",
              "completed"
            ],
            "description": "Plan lifecycle status."
          },
          "budget": {
            "type": "object",
            "description": "Budget state.",
            "properties": {
              "authorized": {
                "type": "number",
                "description": "Total authorized budget from the plan."
              },
              "accounting_mode": {
                "type": "string",
                "enum": [
                  "gross_commitment",
                  "verified_net_cost"
                ]
              },
              "committed": {
                "type": "number",
                "description": "Legacy 3.x alias for net_committed after verified headroom-restoring adjustments."
              },
              "gross_committed": {
                "type": "number",
                "description": "Total authoritative commitment recorded from completed outcomes before adjustments."
              },
              "adjustments_reported": {
                "type": "number",
                "description": "Sum of all append-only adjustment amounts, including audit-only refunds, credits, and makegoods."
              },
              "adjustments_verified": {
                "type": "number",
                "description": "Sum of buyer-accepted economic reductions in plan currency; accepted makegoods contribute zero."
              },
              "net_cost": {
                "type": "number",
                "description": "Gross commitment minus verified economic reductions, independent of whether accounting_mode restores headroom."
              },
              "headroom_restored": {
                "type": "number",
                "description": "Sum of verified adjustments eligible to restore reusable headroom under accounting_mode."
              },
              "net_committed": {
                "type": "number",
                "description": "Current plan obligation after verified headroom-restoring adjustments."
              },
              "ledger_committed": {
                "type": "number",
                "description": "Current amount charged against plan headroom under accounting_mode."
              },
              "remaining": {
                "type": "number",
                "description": "Authorized minus committed."
              },
              "utilization_pct": {
                "type": "number",
                "description": "Committed as a percentage of authorized."
              }
            },
            "additionalProperties": false
          },
          "channel_allocation": {
            "type": "object",
            "description": "Current channel mix. Keyed by channel ID.",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "committed": {
                  "type": "number",
                  "description": "Budget committed to this channel."
                },
                "pct": {
                  "type": "number",
                  "description": "Channel's share of the authorized total budget."
                }
              },
              "additionalProperties": false
            }
          },
          "summary": {
            "type": "object",
            "description": "Aggregate validation and outcome statistics.",
            "properties": {
              "checks_performed": {
                "type": "integer",
                "description": "Total governance checks performed."
              },
              "outcomes_reported": {
                "type": "integer",
                "description": "Total outcomes reported."
              },
              "adjustments_reported": {
                "type": "integer",
                "description": "Total append-only adjustment records reported."
              },
              "adjustments_verified": {
                "type": "integer",
                "description": "Count of adjustment records accepted by the plan owner, including makegoods."
              },
              "statuses": {
                "type": "object",
                "description": "Count of each governance check status.",
                "properties": {
                  "approved": {
                    "type": "integer"
                  },
                  "denied": {
                    "type": "integer"
                  },
                  "conditions": {
                    "type": "integer"
                  },
                  "human_reviewed": {
                    "type": "integer",
                    "description": "Supplementary count of checks that went through internal human review. These checks are also counted in approved or denied."
                  }
                },
                "additionalProperties": false
              },
              "findings_count": {
                "type": "integer",
                "description": "Total findings across all checks and outcomes."
              },
              "escalations": {
                "type": "array",
                "description": "All escalations and their resolutions.",
                "items": {
                  "type": "object",
                  "properties": {
                    "check_id": {
                      "type": "string",
                      "description": "The escalated governance check.",
                      "x-entity": "governance_check"
                    },
                    "reason": {
                      "type": "string",
                      "description": "Why it was escalated."
                    },
                    "resolution": {
                      "type": "string",
                      "description": "How it was resolved (e.g., 'approved_by_human', 'rejected_by_human')."
                    },
                    "resolved_at": {
                      "type": "string",
                      "format": "date-time",
                      "description": "ISO 8601 resolution timestamp."
                    }
                  },
                  "required": [
                    "check_id",
                    "reason"
                  ],
                  "additionalProperties": false
                }
              },
              "drift_metrics": {
                "type": "object",
                "description": "Aggregate governance metrics for detecting oversight drift. A declining escalation rate may indicate well-calibrated governance or eroding human oversight -- surfacing the trend lets the organization make that judgment.",
                "properties": {
                  "escalation_rate": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "Fraction of checks that resulted in escalation."
                  },
                  "escalation_rate_trend": {
                    "type": "string",
                    "enum": [
                      "increasing",
                      "stable",
                      "declining"
                    ],
                    "description": "Direction of escalation rate over the plan's lifetime."
                  },
                  "auto_approval_rate": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "Fraction of checks approved without human intervention."
                  },
                  "human_override_rate": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "Fraction of escalations where the human overrode the governance agent's recommendation."
                  },
                  "mean_confidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "Average confidence score across all findings. Present when findings include confidence scores."
                  },
                  "thresholds": {
                    "type": "object",
                    "description": "Organization-defined thresholds for drift metrics. When a metric crosses its threshold, the governance agent SHOULD include a finding on the next check. Set by the organization in governance agent configuration, echoed here for visibility.",
                    "properties": {
                      "escalation_rate_max": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1,
                        "description": "Maximum acceptable escalation rate. A rate above this suggests policy miscalibration."
                      },
                      "escalation_rate_min": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1,
                        "description": "Minimum acceptable escalation rate. A rate below this may indicate eroding oversight."
                      },
                      "auto_approval_rate_max": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1,
                        "description": "Maximum acceptable auto-approval rate."
                      },
                      "human_override_rate_max": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1,
                        "description": "Maximum acceptable human override rate. A high rate suggests the governance agent's recommendations are poorly calibrated."
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "entries": {
            "type": "array",
            "description": "Ordered audit trail. Only present when include_entries is true.",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Entry identifier."
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "check",
                    "outcome",
                    "adjustment"
                  ],
                  "description": "Entry type."
                },
                "timestamp": {
                  "type": "string",
                  "format": "date-time",
                  "description": "ISO 8601 timestamp."
                },
                "plan_id": {
                  "type": "string",
                  "description": "Plan this entry belongs to. Present when querying multiple plans or a portfolio.",
                  "x-entity": "governance_plan"
                },
                "caller": {
                  "type": "string",
                  "format": "uri",
                  "description": "URL of the agent that made the request. Resolved from the credentials used on the governance callback."
                },
                "tool": {
                  "type": "string",
                  "description": "The AdCP tool (present for check entries)."
                },
                "verdict": {
                  "$ref": "https://adcontextprotocol.org/schemas/3.2.0-beta.4/enums/governance-decision.json",
                  "description": "Governance verdict (present for check entries). Renamed from `status` in 3.1 alongside check-governance-response for vocabulary consistency."
                },
                "check_type": {
                  "type": "string",
                  "enum": [
                    "intent",
                    "execution"
                  ],
                  "description": "Whether the check was an intent check (orchestrator) or execution check (seller). Inferred from the fields present on the original check request. Present for check entries."
                },
                "mode": {
                  "$ref": "https://adcontextprotocol.org/schemas/3.2.0-beta.4/enums/governance-mode.json",
                  "description": "Governance mode active at the moment this specific check was evaluated. Governance agents SHOULD populate this field on check entries, recording the mode from their runtime configuration at the moment check_governance was processed — not derived from a plan field. This is a per-check value: if the operator changes mode between checks for the same governed action, each entry records the mode active for that entry. A future `governed_actions[].mode` field would describe the action's current mode, which may differ from the most recent entry's `mode` if the plan has since been re-synced. Absent for outcome entries and for pre-3.1 governance agents that do not surface mode on audit responses."
                },
                "explanation": {
                  "type": "string",
                  "description": "Human-readable explanation of the governance decision (present for check entries)."
                },
                "policies_evaluated": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Policy IDs evaluated during this check. Includes registry policy IDs (resolved via the policy registry) and any inline `policy_id`s declared in the plan's `custom_policies`. Present for check entries."
                },
                "categories_evaluated": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Governance categories evaluated (e.g., 'budget_authority', 'regulatory_compliance'). Present for check entries."
                },
                "findings": {
                  "type": "array",
                  "description": "Findings from this check or outcome. Same structure as check_governance response findings.",
                  "items": {
                    "type": "object",
                    "properties": {
                      "category_id": {
                        "type": "string"
                      },
                      "policy_id": {
                        "type": "string",
                        "$comment": "x-entity deliberately omitted — audit log findings mirror check_governance findings and can reference either a governance_registry_policy or a governance_inline_policy (see #2685)."
                      },
                      "source_plan_id": {
                        "type": "string",
                        "description": "Plan whose policy triggered this finding when the audit entry aggregates findings across plans.",
                        "x-entity": "governance_plan"
                      },
                      "severity": {
                        "$ref": "https://adcontextprotocol.org/schemas/3.2.0-beta.4/enums/escalation-severity.json"
                      },
                      "explanation": {
                        "type": "string"
                      },
                      "details": {
                        "type": "object",
                        "description": "Structured finding details retained exactly as emitted by check_governance.",
                        "additionalProperties": true
                      },
                      "confidence": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "uncertainty_reason": {
                        "type": "string",
                        "description": "Reason the finding carries less than full confidence, retained exactly as emitted by check_governance."
                      },
                      "attestation_reference_digest": {
                        "type": "string",
                        "pattern": "^sha256:[a-f0-9]{64}$",
                        "description": "reference_digest of the runtime attestation evaluation this finding relied on."
                      }
                    },
                    "required": [
                      "category_id",
                      "severity",
                      "explanation"
                    ],
                    "additionalProperties": false
                  }
                },
                "delivery_statement": {
                  "type": "object",
                  "description": "Canonical seller statement retained on a delivery check entry.",
                  "properties": {
                    "statement_id": {
                      "type": "string",
                      "x-entity": "governance_delivery_statement"
                    },
                    "statement_digest": {
                      "type": "string",
                      "pattern": "^sha256:[a-f0-9]{64}$"
                    },
                    "sequence": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "issued_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "seller_reference": {
                      "type": "string"
                    },
                    "cumulative_spend": {
                      "type": "number",
                      "minimum": 0
                    },
                    "currency": {
                      "type": "string",
                      "pattern": "^[A-Z]{3}$"
                    },
                    "reporting_period": {
                      "type": "object",
                      "properties": {
                        "start": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "end": {
                          "type": "string",
                          "format": "date-time"
                        }
                      },
                      "required": [
                        "start",
                        "end"
                      ],
                      "additionalProperties": false
                    },
                    "canonical_payload": {
                      "type": "object",
                      "description": "Exact retained payload used to verify statement_digest after removing delivery_metrics.statement_digest.",
                      "properties": {
                        "seller_reference": {
                          "type": "string"
                        },
                        "delivery_metrics": {
                          "type": "object",
                          "additionalProperties": true
                        }
                      },
                      "required": [
                        "seller_reference",
                        "delivery_metrics"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "statement_id",
                    "statement_digest",
                    "sequence",
                    "issued_at",
                    "seller_reference",
                    "cumulative_spend",
                    "currency",
                    "reporting_period",
                    "canonical_payload"
                  ],
                  "additionalProperties": false
                },
                "outcome": {
                  "$ref": "https://adcontextprotocol.org/schemas/3.2.0-beta.4/enums/outcome-type.json",
                  "description": "Outcome type (present for outcome entries)."
                },
                "outcome_id": {
                  "type": "string",
                  "description": "Source completed outcome (present for adjustment entries).",
                  "x-entity": "governance_outcome"
                },
                "seller_adjustment_id": {
                  "type": "string",
                  "description": "Seller-issued source adjustment identifier (present for adjustment entries).",
                  "x-entity": "seller_adjustment"
                },
                "adjustment_type": {
                  "type": "string",
                  "enum": [
                    "decommitment",
                    "refund",
                    "credit",
                    "makegood"
                  ],
                  "description": "Commercial adjustment type (present for adjustment entries)."
                },
                "amount": {
                  "type": "object",
                  "description": "Adjustment amount and currency (present for adjustment entries).",
                  "properties": {
                    "amount": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "currency": {
                      "type": "string",
                      "pattern": "^[A-Z]{3}$"
                    }
                  },
                  "required": [
                    "amount",
                    "currency"
                  ],
                  "additionalProperties": false
                },
                "headroom_restored": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Current-obligation headroom restored by this adjustment. Zero for audit-only types."
                },
                "reason": {
                  "type": "string",
                  "description": "Seller-supplied adjustment reason."
                },
                "effective_at": {
                  "type": "string",
                  "format": "date-time",
                  "description": "When the seller's adjustment became effective."
                },
                "committed_budget": {
                  "type": "number",
                  "description": "Governance-authorized budget reserved (present for completed outcome entries)."
                },
                "reported_committed_budget": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Caller-reported seller amount retained for reconciliation. Never ledger authority."
                },
                "seller_reference": {
                  "type": "string",
                  "description": "Seller resource identifier retained on an outcome entry."
                },
                "delivery": {
                  "type": "object",
                  "description": "Buyer-attributed observation retained as audit evidence on a delivery outcome. It never overwrites the seller statement.",
                  "properties": {
                    "observation_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 255,
                      "description": "Stable buyer-issued identifier for this observation.",
                      "x-entity": "governance_delivery_observation"
                    },
                    "source": {
                      "type": "string",
                      "enum": [
                        "seller_statement_copy",
                        "buyer_measurement"
                      ],
                      "description": "Whether the buyer is forwarding the seller statement it received or reporting an independently measured observation. A forwarded seller statement is not independent evidence."
                    },
                    "observed_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "seller_statement_id": {
                      "type": "string",
                      "description": "Seller statement identifier as received by the buyer. Required for seller_statement_copy.",
                      "x-entity": "governance_delivery_statement"
                    },
                    "seller_statement_digest": {
                      "type": "string",
                      "pattern": "^sha256:[a-f0-9]{64}$",
                      "description": "Digest received with the seller statement. Governance compares it to the seller-authenticated canonical digest."
                    },
                    "reporting_period": {
                      "type": "object",
                      "description": "Start and end timestamps for the reporting window.",
                      "properties": {
                        "start": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "end": {
                          "type": "string",
                          "format": "date-time"
                        }
                      },
                      "required": [
                        "start",
                        "end"
                      ],
                      "additionalProperties": false
                    },
                    "cumulative_spend": {
                      "type": "number",
                      "minimum": 0,
                      "description": "Buyer-attributed cumulative spend for the governed action."
                    },
                    "currency": {
                      "type": "string",
                      "pattern": "^[A-Z]{3}$"
                    },
                    "period_closed": {
                      "type": "boolean",
                      "default": false,
                      "description": "Buyer-declared operational closure of this governance reporting period. When true, governance freezes the period after recording this observation. An unresolved mismatch becomes closed_unresolved and no longer blocks later governance. Closure is not final billing or commercial settlement."
                    },
                    "impressions": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "additionalProperties": true
                },
                "governance_context": {
                  "type": "string",
                  "description": "Governance context for this entry (present for check and outcome entries)."
                },
                "plan_hash": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{43}$",
                  "description": "Audit-layer binding to the plan revision this attestation was evaluated over — base64url_no_pad(SHA-256(JCS(plan_payload))) per Plan binding and audit in the campaign-governance specification. Present on check entries. Auditors and buyer-side compliance verify by recomputing over the retained plan revision and byte-comparing the decoded 32-byte digests."
                },
                "runtime_attestations": {
                  "type": "array",
                  "description": "Portable attestation presentations and their evaluator-of-record results retained as ordered pairs for this check entry. Auditors recompute each evaluation.reference_digest from JCS(reference), then recompute runtime_attestation_binding_digest from the ordered evaluations and attestation-bound findings.",
                  "items": {
                    "type": "object",
                    "properties": {
                      "reference": {
                        "$ref": "https://adcontextprotocol.org/schemas/3.2.0-beta.4/core/attestation-reference.json"
                      },
                      "evaluation": {
                        "$ref": "https://adcontextprotocol.org/schemas/3.2.0-beta.4/core/attestation-evaluation.json"
                      }
                    },
                    "required": [
                      "reference",
                      "evaluation"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1,
                  "maxItems": 10
                },
                "runtime_attestation_binding_digest": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$",
                  "description": "Binding digest copied from the check response and signed governance_context. Auditors recompute it from this entry's ordered runtime_attestations[].evaluation values plus findings carrying attestation_reference_digest after verifying each paired reference digest."
                },
                "purchase_type": {
                  "$ref": "https://adcontextprotocol.org/schemas/3.2.0-beta.4/enums/purchase-type.json",
                  "description": "Purchase type for this entry."
                },
                "outcome_status": {
                  "type": "string",
                  "description": "Outcome status (present for outcome entries)."
                },
                "delivery_reconciliation_status": {
                  "type": "string",
                  "enum": [
                    "consistent",
                    "measurement_variance",
                    "disputed",
                    "unmatched",
                    "closed_unresolved"
                  ]
                },
                "delivery_period_state": {
                  "type": "string",
                  "enum": [
                    "open",
                    "closed"
                  ],
                  "description": "Operational governance-window state for this delivery observation."
                },
                "adjustment_state": {
                  "type": "string",
                  "enum": [
                    "reported",
                    "verified",
                    "disputed"
                  ]
                },
                "verified_amount": {
                  "type": "number",
                  "minimum": 0
                },
                "evidence": {
                  "type": "object",
                  "properties": {
                    "evidence_id": {
                      "type": "string",
                      "x-entity": "governance_adjustment_evidence"
                    },
                    "evidence_type": {
                      "type": "string",
                      "enum": [
                        "decommitment_agreement",
                        "refund_settlement",
                        "credit_note",
                        "makegood_agreement"
                      ]
                    },
                    "digest": {
                      "type": "string",
                      "pattern": "^sha256:[a-f0-9]{64}$"
                    },
                    "issued_at": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": [
                    "evidence_id",
                    "evidence_type",
                    "digest",
                    "issued_at"
                  ],
                  "additionalProperties": false
                },
                "reviewed_by": {
                  "type": "string",
                  "format": "uri"
                },
                "reviewed_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "review_reason": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "type",
                "timestamp"
              ],
              "allOf": [
                {
                  "if": {
                    "required": [
                      "runtime_attestations"
                    ]
                  },
                  "then": {
                    "required": [
                      "runtime_attestation_binding_digest"
                    ]
                  }
                }
              ],
              "additionalProperties": false
            }
          },
          "governed_actions": {
            "type": "array",
            "description": "Per-action breakdown joined by the governance agent's stable opaque action binding. governance_context is the original intent context exposed for correlation; lifecycle tokens may differ because each approval is freshly signed.",
            "items": {
              "type": "object",
              "properties": {
                "governance_context": {
                  "type": "string",
                  "description": "Governance context correlating this action's lifecycle."
                },
                "purchase_type": {
                  "$ref": "https://adcontextprotocol.org/schemas/3.2.0-beta.4/enums/purchase-type.json",
                  "description": "Type of financial commitment."
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "active",
                    "suspended",
                    "completed"
                  ],
                  "description": "Action status."
                },
                "committed": {
                  "type": "number",
                  "description": "Gross authoritative commitment recorded for this action."
                },
                "adjustments_reported": {
                  "type": "number",
                  "description": "Sum of all append-only adjustment amounts for this action."
                },
                "adjustments_verified": {
                  "type": "number",
                  "description": "Buyer-accepted economic reductions for this action."
                },
                "net_cost": {
                  "type": "number",
                  "description": "Gross action commitment minus verified economic reductions."
                },
                "headroom_restored": {
                  "type": "number",
                  "description": "Verified adjustments eligible to restore headroom under the plan accounting mode."
                },
                "net_committed": {
                  "type": "number",
                  "description": "Current ledger obligation for this action after restored headroom."
                },
                "seller_reported_spend": {
                  "type": "number",
                  "minimum": 0
                },
                "buyer_observed_spend": {
                  "type": "number",
                  "minimum": 0
                },
                "delivery_reporting_period": {
                  "type": "object",
                  "properties": {
                    "start": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "end": {
                      "type": "string",
