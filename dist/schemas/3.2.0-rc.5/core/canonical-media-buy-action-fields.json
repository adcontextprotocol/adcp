{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://adcontextprotocol.org/schemas/3.2.0-rc.5/core/canonical-media-buy-action-fields.json",
  "title": "Canonical Media Buy Action Fields",
  "description": "Shared closed field set for task-discriminated canonical MediaBuy actions.",
  "type": "object",
  "properties": {
    "task": {
      "type": "string",
      "enum": [
        "control_media_buy",
        "refine_proposals",
        "sync_creatives"
      ]
    },
    "action": {
      "type": "string"
    },
    "mode": {
      "$ref": "https://adcontextprotocol.org/schemas/3.2.0-rc.5/enums/canonical-media-buy-action-mode.json"
    },
    "sla": {
      "$ref": "https://adcontextprotocol.org/schemas/3.2.0-rc.5/core/sla-window.json"
    },
    "change_term_id": {
      "$ref": "https://adcontextprotocol.org/schemas/3.2.0-rc.5/core/media-buy-change-term-id.json"
    },
    "terms_ref": {
      "$ref": "https://adcontextprotocol.org/schemas/3.2.0-rc.5/core/media-buy-legacy-terms-ref.json"
    },
    "applicable_package_ids": {
      "type": "array",
      "description": "Exact eligible packages for a package-scoped action; omission means all relevant packages.",
      "items": {
        "$ref": "https://adcontextprotocol.org/schemas/3.2.0-rc.5/core/applicable-package-id.json"
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "task",
    "action",
    "mode"
  ],
  "additionalProperties": false
}
