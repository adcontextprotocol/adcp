              "const": "targeting_restriction"
            },
            "restricted_attributes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/external:enums~1restricted-attribute.json"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind"
