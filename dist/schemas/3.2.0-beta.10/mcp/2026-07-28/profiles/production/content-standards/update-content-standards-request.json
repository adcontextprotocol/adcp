              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": {
              "type": "string",
              "const": "prior_authorization"
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind"
          ],
