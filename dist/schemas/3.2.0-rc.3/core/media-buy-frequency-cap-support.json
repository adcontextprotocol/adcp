{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://adcontextprotocol.org/schemas/3.2.0-rc.3/core/media-buy-frequency-cap-support.json",
  "title": "Media Buy Frequency Cap Support",
  "description": "Optional product support detail for aggregate MediaBuy frequency caps. Aggregate support in 3.2 is max-impressions only.",
  "allOf": [
    {
      "$ref": "https://adcontextprotocol.org/schemas/3.2.0-rc.3/core/frequency-cap-constraints.json"
    },
    {
      "type": "object",
      "properties": {
        "supported_control_modes": {
          "type": "array",
          "items": {
            "$ref": "https://adcontextprotocol.org/schemas/3.2.0-rc.3/enums/media-buy-frequency-cap-control-mode.json"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "not": {
        "required": [
          "suppression_constraints"
        ]
      }
    }
  ]
}
