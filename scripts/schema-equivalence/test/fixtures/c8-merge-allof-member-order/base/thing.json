{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/schemas/thing.json",
  "allOf": [
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "not": {
        "required": [
          "legacy_id"
        ]
      }
    },
    {
      "required": [
        "id"
      ],
      "not": {
        "required": [
          "deprecated"
        ]
      }
    },
    {
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name"
      ]
    }
  ]
}
