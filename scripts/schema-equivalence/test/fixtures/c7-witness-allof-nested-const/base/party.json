{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/schemas/party.json",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "brand"
        },
        "brand": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "brand"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "agent"
        },
        "agent_url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "type",
        "agent_url"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "resource"
        },
        "resource_type": {
          "type": "string",
          "format": "uri"
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "resource_type",
        "id"
      ]
    }
  ]
}
