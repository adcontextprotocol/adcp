{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/schemas/rights-response.json",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "rights_id": {
          "type": "string"
        },
        "refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "/schemas/grant-reference.json"
          }
        },
        "disclosure": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "text"
          ]
        }
      },
      "required": [
        "rights_id",
        "refs",
        "disclosure"
      ],
      "not": {
        "required": [
          "errors"
        ]
      }
    },
    {
      "type": "object",
      "properties": {
        "errors": {
          "type": "array",
          "minItems": 1
        }
      },
      "required": [
        "errors"
      ]
    }
  ]
}
