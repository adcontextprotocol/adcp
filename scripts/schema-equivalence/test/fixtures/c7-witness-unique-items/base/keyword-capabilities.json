{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/schemas/keyword-capabilities.json",
  "type": "object",
  "properties": {
    "match_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
