{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/schemas/a.json",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "video"
        },
        "duration": {
          "type": "number"
        }
      },
      "required": [
        "kind"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "image"
        },
        "width": {
          "type": "integer"
        }
      },
      "required": [
        "kind"
      ]
    }
  ]
}
