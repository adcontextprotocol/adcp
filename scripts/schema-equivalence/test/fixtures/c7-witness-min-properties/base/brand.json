{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/schemas/brand.json",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "authoritative_location": {
          "type": "string"
        }
      },
      "required": [
        "authoritative_location"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "names": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "/schemas/localized-name.json"
          }
        },
        "voice": {
          "type": "object",
          "properties": {
            "voice_id": {
              "type": "string"
            }
          }
        }
      },
      "required": [
        "id",
        "names"
      ],
      "additionalProperties": false
    }
  ]
}
