{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/schemas/label-request.json",
  "type": "object",
  "properties": {
    "token": {
      "type": "string",
      "pattern": "^(?=.*[0-9])(?=.*[a-z])[a-z0-9]{12}$"
    },
    "label": {
      "type": "string"
    }
  },
  "required": [
    "token",
    "label"
  ]
}
