{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/schemas/products-submitted.json",
  "type": "object",
  "allOf": [
    {
      "$ref": "/schemas/envelope.json"
    },
    {
      "$ref": "/schemas/task-submitted.json"
    }
  ],
  "properties": {
    "estimated_completion": {
      "type": "string"
    },
    "errors": {
      "$ref": "/schemas/task-errors.json"
    },
    "context": {
      "$ref": "/schemas/context.json"
    }
  },
  "not": {
    "anyOf": [
      {
        "required": [
          "products"
        ]
      },
      {
        "required": [
          "result"
        ]
      }
    ]
  }
}
