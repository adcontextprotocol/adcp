{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/schemas/budget-guidance.json",
  "type": "object",
  "properties": {
    "min": {
      "type": "number",
      "minimum": 0
    },
    "max": {
      "type": "number",
      "minimum": 0
    },
    "currency": {
      "type": "string"
    }
  },
  "required": [
    "currency"
  ],
  "anyOf": [
    {
      "required": [
        "min"
      ]
    },
    {
      "required": [
        "max"
      ]
    }
  ]
}
