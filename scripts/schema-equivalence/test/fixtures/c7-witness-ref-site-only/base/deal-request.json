{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/schemas/deal-request.json",
  "type": "object",
  "properties": {
    "seller": {
      "$ref": "/schemas/party.json"
    },
    "buyer": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "email": {
          "type": "string"
        }
      },
      "required": [
        "email"
      ]
    }
  },
  "required": [
    "seller"
  ]
}
