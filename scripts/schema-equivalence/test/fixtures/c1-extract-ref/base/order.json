{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/schemas/order.json",
  "type": "object",
  "properties": {
    "price": {
      "type": "object",
      "properties": {
        "amount": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "additionalProperties": false
    }
  }
}
