{
  "$schema": "/schemas/core/product.json",
  "product_id": "streamhaus_expandable_sticky_leaderboard",
  "name": "StreamHaus expandable sticky leaderboard",
  "description": "Seller-rendered premium display that opens at 640×210 or 320×210 and automatically collapses to a 70-pixel-high sticky header. The buyer supplies deterministic artwork for every state and breakpoint plus an optional 15-second video.",
  "publisher_properties": [
    {
      "publisher_domain": "streamhaus.example",
      "selection_type": "all"
    }
  ],
  "channels": ["display", "olv"],
  "delivery_type": "guaranteed",
  "pricing_options": [
    {
      "pricing_option_id": "sticky_flat_rate",
      "pricing_model": "flat_rate",
      "currency": "USD",
      "fixed_price": 18000
    }
  ],
  "reporting_capabilities": {
    "available_reporting_frequencies": ["daily"],
    "expected_delay_minutes": 120,
    "timezone": "America/New_York",
    "supports_webhooks": true,
    "available_metrics": ["impressions", "clicks", "spend", "ctr", "viewability", "completion_rate"],
    "date_range_support": "date_range"
  },
  "format_options": [
    {
      "format_kind": "seller_rendered_stateful_display",
      "format_option_id": "expandable_sticky_leaderboard",
      "display_name": "Expandable sticky leaderboard",
      "canonical_formats_only": true,
      "experimental": true,
      "params": {
        "experimental": true,
        "v1_translatable": false,
        "since_version": "3.2",
        "composition_model": "deterministic",
        "supply_mode": "rendered_canvases",
        "initial_state_id": "expanded",
        "states": [
          {
            "state_id": "expanded",
            "anchoring": "inline",
            "close_affordance": true,
            "breakpoints": [
              { "breakpoint_id": "desktop", "width": 640, "height": 210 },
              { "breakpoint_id": "mobile", "width": 320, "height": 210 }
            ]
          },
          {
            "state_id": "collapsed",
            "anchoring": "sticky_top",
            "close_affordance": true,
            "breakpoints": [
              { "breakpoint_id": "desktop", "width": 640, "height": 70 },
              { "breakpoint_id": "mobile", "width": 320, "height": 70 }
            ]
          }
        ],
        "transitions": [
          {
            "transition_id": "auto_collapse",
            "from_state_id": "expanded",
            "to_state_id": "collapsed",
            "trigger": "timer",
            "transition_mode": "animated",
            "delay_ms": 5000,
            "duration_ms": 300,
            "preserve_playback": true
          },
          {
            "transition_id": "user_expand",
            "from_state_id": "collapsed",
            "to_state_id": "expanded",
            "trigger": "user_action",
            "input": "expand_control",
            "transition_mode": "animated",
            "duration_ms": 300,
            "preserve_playback": true
          }
        ],
        "user_controls": {
          "dismissible": true,
          "user_collapsible": true
        },
        "duration_ms_exact": 15000,
        "aspect_ratio": "16:9",
        "containers": ["mp4"],
        "video_playback": "auto_muted",
        "max_initial_load_kb": 500,
        "polite_load": true
      }
    }
  ]
}
