{
  "$schema": "/schemas/core/product.json",
  "product_id": "streamhaus_coordinated_placements",
  "name": "StreamHaus coordinated homepage placements",
  "description": "An exclusive homepage product whose single creative manifest supplies an expandable sticky leaderboard and a 2560×1440 skin. The video is shared with the leaderboard, while the CTA is consumed by both components.",
  "publisher_properties": [
    {
      "publisher_domain": "streamhaus.example",
      "selection_type": "all"
    }
  ],
  "channels": ["display", "olv"],
  "delivery_type": "guaranteed",
  "exclusivity": "exclusive",
  "placements": [
    {
      "kind": "seller_inline",
      "placement_id": "homepage_masthead",
      "publisher_domain": "streamhaus.example",
      "name": "Homepage masthead",
      "mode": "included"
    },
    {
      "kind": "seller_inline",
      "placement_id": "homepage_skin",
      "publisher_domain": "streamhaus.example",
      "name": "Homepage skin",
      "mode": "included"
    }
  ],
  "pricing_options": [
    {
      "pricing_option_id": "coordinated_flat_rate",
      "pricing_model": "flat_rate",
      "currency": "USD",
      "fixed_price": 75000
    }
  ],
  "reporting_capabilities": {
    "available_reporting_frequencies": ["daily"],
    "expected_delay_minutes": 120,
    "timezone": "America/New_York",
    "supports_webhooks": true,
    "available_metrics": ["impressions", "clicks", "spend", "ctr", "viewability", "completion_rate"],
    "date_range_support": "date_range"
  },
  "format_options": [
    {
      "format_kind": "seller_rendered_stateful_display",
      "format_option_id": "coordinated_sticky_leaderboard",
      "display_name": "Takeover sticky leaderboard",
      "canonical_formats_only": true,
      "experimental": true,
      "params": {
        "experimental": true,
        "supply_mode": "rendered_canvases",
        "initial_state_id": "expanded",
        "states": [
          {
            "state_id": "expanded",
            "anchoring": "inline",
            "close_affordance": true,
            "breakpoints": [
              { "breakpoint_id": "desktop", "width": 640, "height": 210 },
              { "breakpoint_id": "mobile", "width": 320, "height": 210 }
            ]
          },
          {
            "state_id": "collapsed",
            "anchoring": "sticky_top",
            "close_affordance": true,
            "breakpoints": [
              { "breakpoint_id": "desktop", "width": 640, "height": 70 },
              { "breakpoint_id": "mobile", "width": 320, "height": 70 }
            ]
          }
        ],
        "transitions": [
          {
            "transition_id": "auto_collapse",
            "from_state_id": "expanded",
            "to_state_id": "collapsed",
            "trigger": "timer",
            "transition_mode": "animated",
            "delay_ms": 5000,
            "duration_ms": 300,
            "preserve_playback": true
          },
          {
            "transition_id": "user_expand",
            "from_state_id": "collapsed",
            "to_state_id": "expanded",
            "trigger": "user_action",
            "input": "expand_control",
            "transition_mode": "animated",
            "duration_ms": 300,
            "preserve_playback": true
          }
        ],
        "user_controls": { "dismissible": true, "user_collapsible": true },
        "duration_ms_exact": 15000,
        "aspect_ratio": "16:9",
        "containers": ["mp4"],
        "video_playback": "auto_muted"
      }
    },
    {
      "format_kind": "coordinated_placements",
      "format_option_id": "homepage_coordinated_placements",
      "display_name": "Coordinated homepage placements",
      "canonical_formats_only": true,
      "experimental": true,
      "params": {
        "experimental": true,
        "components": [
          {
            "component_id": "leaderboard",
            "placement_ref": {
              "publisher_domain": "streamhaus.example",
              "placement_id": "homepage_masthead"
            },
            "required": true,
            "format_option_ref": {
              "scope": "product",
              "format_option_id": "coordinated_sticky_leaderboard"
            }
          },
          {
            "component_id": "skin",
            "placement_ref": {
              "publisher_domain": "streamhaus.example",
              "placement_id": "homepage_skin"
            },
            "required": true,
            "canvas_constraints": [
              {
                "constraint": "safe_area",
                "region": { "x": 640, "y": 0, "width": 1280, "height": 1440, "unit": "px" }
              }
            ],
            "format_kind": "image",
            "params": {
              "width": 2560,
              "height": 1440,
              "image_formats": ["png", "jpg"]
            }
          }
        ],
        "shared_slots": [
          {
            "asset_group_id": "video_main",
            "asset_type": "video",
            "required": false,
            "consumed_by": ["leaderboard"]
          },
          {
            "asset_group_id": "cta",
            "asset_type": "text",
            "required": false,
            "consumed_by": ["leaderboard", "skin"]
          }
        ]
      }
    }
  ]
}
