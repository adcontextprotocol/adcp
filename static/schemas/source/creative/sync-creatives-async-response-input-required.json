{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/schemas/creative/sync-creatives-async-response-input-required.json",
  "title": "Sync Creatives - Input Required",
  "description": "Payload when sync_creatives task is paused waiting for buyer clarification or approval.",
  "allOf": [
    {
      "$ref": "/schemas/core/compact-task-input-required.json"
    }
  ],
  "properties": {
    "reason": {
      "description": "Reason code indicating why buyer input is needed",
      "$ref": "#/definitions/reason"
    }
  },
  "definitions": {
    "reason": {
      "type": "string",
      "enum": [
        "APPROVAL_REQUIRED",
        "ASSET_CONFIRMATION",
        "FORMAT_CLARIFICATION"
      ]
    }
  }
}
