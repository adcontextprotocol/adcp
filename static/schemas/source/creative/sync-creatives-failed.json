{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/schemas/creative/sync-creatives-failed.json",
  "title": "SyncCreativesError",
  "description": "Body of a failed sync_creatives response: operation-level errors, and none of the success fields. The completed body also admits this body.",
  "type": "object",
  "allOf": [
    { "$ref": "/schemas/core/task-error.json" }
  ],
  "additionalProperties": true,
  "not": {
    "anyOf": [
      {
        "required": ["creatives"]
      },
      {
        "required": ["merges"]
      },
      {
        "required": ["dry_run"]
      },
      {
        "required": ["sandbox"]
      },
      {
        "required": ["task_id"]
      },
      {
        "required": ["warnings"]
      }
    ]
  }
}
