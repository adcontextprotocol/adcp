{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/schemas/account/list-accounts-response.json",
  "title": "List Accounts Response",
  "description": "Response payload for list_accounts task",
  "type": "object",
  "allOf": [
    {
      "$ref": "/schemas/core/protocol-envelope.json"
    }
  ],
  "properties": {
    "accounts": {
      "type": "array",
      "description": "Array of accounts accessible to the authenticated agent. Each entry is the full Account object plus optional authorization. Buyer-declared entries include account_id, brand, operator, and any operator_unit, fixed currency, buyer-selected account timezone, and sandbox attributes so a buyer can recover its account IDs after a cold start. Sellers SHOULD return account_scope on every entry, with brand and/or operator wherever the scope names them, so a caller can map its buyers onto listed accounts. There is no preference order between scopes: the choice decides who is invoiced, so a person makes it.",
      "items": {
        "$ref": "/schemas/core/account-with-authorization.json"
      }
    },
    "errors": {
      "type": "array",
      "description": "Task-specific errors and warnings",
      "items": {
        "$ref": "/schemas/core/error.json"
      }
    },
    "account_requests": {
      "type": "array",
      "x-status": "experimental",
      "x-added-in": "3.3.0",
      "description": "Experimental (account.requests). The caller's account requests, present when the request set include_requests, request_ids, or requests_pagination. Newest updated_at first, paged by account_requests_pagination. Requests are not accounts: an open request has no account_id until it resolves.",
      "items": { "$ref": "/schemas/core/account-request-record.json" },
      "maxItems": 100
    },
    "account_requests_pagination": {
      "$ref": "/schemas/core/pagination-response.json",
      "x-status": "experimental",
      "x-added-in": "3.3.0",
      "description": "Experimental (account.requests). Paging for account_requests[], present whenever account_requests[] is. has_more true means more requests remain; pass the cursor in requests_pagination. The top-level pagination field pages accounts only."
    },
    "pagination": {
      "$ref": "/schemas/core/pagination-response.json"
    },
    "ext": {
      "$ref": "/schemas/core/ext.json"
    }
  },
  "required": [
    "accounts"
  ],
  "additionalProperties": true,
  "examples": [
    {
      "description": "Agency with multiple client accounts",
      "data": {
        "status": "completed",
        "accounts": [
          {
            "account_id": "acc_acme_pinnacle",
            "name": "Acme c/o Pinnacle",
            "advertiser": "Acme Corp",
            "billing_proxy": "Pinnacle Media",
          "brand": {
            "domain": "acme-corp.com",
            "countries": ["CA", "US"]
          },
          "operator": "pinnacle-media.com",
          "operator_unit": {
            "id": "seat_north_america_01",
            "name": "North America"
          },
          "currency": "USD",
            "billing": "operator",
            "account_scope": "operator_brand",
            "status": "active"
          },
          {
            "account_id": "acc_nova_pinnacle",
            "name": "Nova c/o Pinnacle",
            "advertiser": "Nova Brands",
            "billing_proxy": "Pinnacle Media",
            "brand": {
              "domain": "nova-brands.com",
              "brand_id": "spark"
            },
            "operator": "pinnacle-media.com",
            "billing": "operator",
            "account_scope": "operator_brand",
            "status": "active"
          },
          {
            "account_id": "acc_pinnacle",
            "name": "Pinnacle",
            "advertiser": "Pinnacle Media",
            "brand": {
              "domain": "pinnacle-media.com"
            },
            "operator": "pinnacle-media.com",
            "billing": "operator",
            "account_scope": "operator",
            "status": "active"
          }
        ],
        "pagination": {
          "has_more": false,
          "total_count": 3
        }
      }
    },
    {
      "description": "Direct advertiser with single account",
      "data": {
        "status": "completed",
        "accounts": [
          {
            "account_id": "acc_acme_direct",
            "name": "Acme",
            "advertiser": "Acme Corp",
            "brand": {
              "domain": "acme-corp.com"
            },
            "operator": "acme-corp.com",
            "billing": "operator",
            "account_scope": "brand",
            "status": "active",
            "rate_card": "acme_vip_2024"
          }
        ]
      }
    }
  ]
}
