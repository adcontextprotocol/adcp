{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/schemas/account/list-account-changes-failed.json",
  "title": "List Account Changes - Failed",
  "x-status": "experimental",
  "description": "Body of a failed list_account_changes response. Both error layers are present: the envelope's adcp_error and at least one errors[] entry.",
  "type": "object",
  "allOf": [
    { "$ref": "/schemas/core/task-error.json" }
  ],
  "properties": {
    "changes": { "$ref": "/schemas/account/list-account-changes-completed.json#/properties/changes" },
    "cursor": { "$ref": "/schemas/account/list-account-changes-completed.json#/properties/cursor" },
    "has_more": { "$ref": "/schemas/account/list-account-changes-completed.json#/properties/has_more" },
    "available_since": { "$ref": "/schemas/account/list-account-changes-completed.json#/properties/available_since" },
    "generated_at": { "$ref": "/schemas/account/list-account-changes-completed.json#/properties/generated_at" },
    "source_coverage": { "$ref": "/schemas/account/list-account-changes-completed.json#/properties/source_coverage" }
  },
  "required": ["adcp_error"],
  "additionalProperties": true
}
