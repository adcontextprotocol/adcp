{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/schemas/account/get-account-financials-failed.json",
  "title": "GetAccountFinancialsError",
  "description": "Body of a failed get_account_financials response: operation-level errors, and none of the success fields. The completed body also admits this body.",
  "type": "object",
  "allOf": [
    { "$ref": "/schemas/core/task-error.json" }
  ],
  "additionalProperties": true,
  "not": {
    "anyOf": [
      {
        "required": ["account"]
      },
      {
        "required": ["currency"]
      },
      {
        "required": ["period"]
      },
      {
        "required": ["timezone"]
      }
    ]
  }
}
