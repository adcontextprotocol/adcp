{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/schemas/governance/report-plan-adjustment-response.json",
  "title": "Report Plan Adjustment Response",
  "description": "Append-only adjustment lifecycle result and attributed plan accounting state.",
  "type": "object",
  "allOf": [{ "$ref": "/schemas/core/protocol-envelope.json" }],
  "x-status": "experimental",
  "properties": {
    "adjustment_id": {
      "type": "string",
      "description": "Governance-agent identifier for the adjustment record.",
      "x-entity": "governance_adjustment"
    },
    "adjustment_state": {
      "$ref": "/schemas/enums/plan-adjustment-state.json",
      "description": "reported has seller evidence but no buyer decision; verified was accepted by the plan owner; disputed was rejected by the plan owner. Only verified records can affect net cost or headroom."
    },
    "adjustment_type": {
      "$ref": "/schemas/enums/plan-adjustment-type.json"
    },
    "amount": {
      "type": "object",
      "properties": {
        "amount": { "type": "number", "exclusiveMinimum": 0 },
        "currency": { "$ref": "/schemas/core/currency-code.json" }
      },
      "required": ["amount", "currency"],
      "additionalProperties": false
    },
    "headroom_restored": {
      "type": "number",
      "minimum": 0,
      "description": "Amount by which current ledger commitment was reduced under the plan accounting mode."
    },
    "plan_summary": {
      "type": "object",
      "properties": {
        "accounting_mode": { "$ref": "/schemas/enums/governance-accounting-mode.json" },
        "gross_committed": { "type": "number", "minimum": 0 },
        "adjustments_reported": { "type": "number", "minimum": 0 },
        "adjustments_verified": { "type": "number", "minimum": 0 },
        "net_cost": { "type": "number", "minimum": 0 },
        "headroom_restored": { "type": "number", "minimum": 0 },
        "ledger_committed": { "type": "number", "minimum": 0 },
        "net_committed": { "type": "number", "minimum": 0 },
        "budget_remaining": { "type": "number" }
      },
      "required": ["accounting_mode", "gross_committed", "adjustments_reported", "adjustments_verified", "net_cost", "headroom_restored", "ledger_committed", "net_committed", "budget_remaining"],
      "additionalProperties": false
    },
    "context": { "$ref": "/schemas/core/context.json" },
    "ext": { "$ref": "/schemas/core/ext.json" }
  },
  "required": ["adjustment_id", "adjustment_state", "adjustment_type", "amount", "headroom_restored", "plan_summary"],
  "additionalProperties": true
}
