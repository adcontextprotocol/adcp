{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/schemas/content-standards/update-content-standards-response.json",
  "title": "Update Content Standards Response",
  "description": "Response from updating a content standards configuration",
  "allOf": [
    {
      "$ref": "/schemas/core/protocol-envelope.json"
    }
  ],
  "oneOf": [
    {
      "title": "UpdateContentStandardsSuccess",
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean",
          "const": true,
          "description": "Indicates the update was applied successfully"
        },
        "standards_id": {
          "type": "string",
          "description": "ID of the updated standards configuration"
        },
        "ext": {
          "$ref": "/schemas/core/ext.json"
        }
      },
      "required": [
        "success",
        "standards_id"
      ],
      "additionalProperties": true
    },
    { "$ref": "/schemas/content-standards/update-content-standards-failed.json" }
  ]
}
