{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/schemas/brand/rights-terms.json",
  "title": "Rights Terms",
  "description": "Contractual terms for a rights grant. Shared between acquire_rights and update_rights responses. The scope (uses, window, exclusivity) is defined in rights-scope.json; this schema adds the rights-agent pricing fields.",
  "x-status": "experimental",
  "type": "object",
  "allOf": [
    {
      "$ref": "/schemas/brand/rights-scope.json"
    },
    {
      "properties": {
        "pricing_option_id": {
          "type": "string"
        },
        "amount": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "period": {
          "$ref": "/schemas/enums/rights-billing-period.json"
        },
        "impression_cap": {
          "type": "integer",
          "minimum": 1
        },
        "overage_cpm": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "pricing_option_id",
        "amount",
        "currency"
      ]
    }
  ],
  "additionalProperties": true
}
