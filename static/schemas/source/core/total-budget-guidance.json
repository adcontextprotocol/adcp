{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/schemas/core/total-budget-guidance.json",
  "title": "Total Budget Guidance",
  "description": "Budget guidance as a range in one currency, with a minimum, a recommended amount, a maximum, or any combination.",
  "type": "object",
  "properties": {
    "min": {
      "type": "number",
      "minimum": 0
    },
    "recommended": {
      "type": "number",
      "minimum": 0
    },
    "max": {
      "type": "number",
      "minimum": 0
    },
    "currency": {
      "$ref": "/schemas/core/currency-code.json"
    }
  },
  "required": [
    "currency"
  ],
  "anyOf": [
    {
      "required": [
        "recommended"
      ]
    },
    {
      "required": [
        "min"
      ]
    },
    {
      "required": [
        "max"
      ]
    }
  ],
  "additionalProperties": true
}
