{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/schemas/core/canonical-measurement-terms.json",
  "title": "Canonical Measurement Terms",
  "description": "Compact billing-measurement and makegood terms. Vendor identity is a resolvable BrandKey; brand assets are never embedded.",
  "type": "object",
  "properties": {
    "billing_measurement": {
      "type": "object",
      "properties": {
        "vendor": { "$ref": "/schemas/core/brand-key.json" },
        "max_variance_percent": { "$ref": "/schemas/core/billing-variance-percent.json" },
        "measurement_window": { "$ref": "/schemas/core/measurement-window-id.json" },
        "finalization_deadline_hours": { "$ref": "/schemas/core/finalization-deadline-hours.json" }
      },
      "required": ["vendor"],
      "additionalProperties": false
    },
    "makegood_policy": { "$ref": "/schemas/core/canonical-makegood-policy.json" }
  },
  "additionalProperties": false
}
