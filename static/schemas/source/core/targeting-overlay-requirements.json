{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/schemas/core/targeting-overlay-requirements.json",
  "title": "Targeting Overlay Requirements",
  "description": "Buyer minimum requirements for targeting dimensions that will be selected on packages later. This request shape deliberately excludes seller limits such as max_values_per_package and max_packages. A returned Product.overlay_support covers a required field when: (1) the product field is true, meaning unrestricted protocol-valid support for that dimension; or (2) both values are objects, every required boolean is true in the product, and every required array is a subset of the corresponding product array. Missing or unknown required fields do not match. Numeric seller limits are disclosed only in Product.overlay_support and do not participate in requirement matching.",
  "type": "object",
  "definitions": {
    "required": { "type": "boolean", "const": true },
    "metroRequirement": {
      "anyOf": [
        { "$ref": "#/definitions/required" },
        {
          "type": "object",
          "properties": {
            "systems": {
              "type": "array",
              "items": { "$ref": "/schemas/enums/metro-system.json" },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "required": ["systems"],
          "additionalProperties": false
        }
      ]
    },
    "keywordRequirement": {
      "anyOf": [
        { "$ref": "#/definitions/required" },
        {
          "type": "object",
          "properties": {
            "supported_match_types": {
              "type": "array",
              "items": { "$ref": "/schemas/enums/match-type.json" },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "required": ["supported_match_types"],
          "additionalProperties": false
        }
      ]
    }
  },
  "properties": {
    "geo_countries": { "$ref": "#/definitions/required" },
    "geo_countries_exclude": { "$ref": "#/definitions/required" },
    "geo_regions": { "$ref": "#/definitions/required" },
    "geo_regions_exclude": { "$ref": "#/definitions/required" },
    "geo_metros": { "$ref": "#/definitions/metroRequirement" },
    "geo_metros_exclude": { "$ref": "#/definitions/metroRequirement" },
    "geo_postal_areas": {
      "anyOf": [
        { "$ref": "#/definitions/required" },
        { "$ref": "/schemas/core/postal-area-support.json" }
      ]
    },
    "geo_postal_areas_exclude": {
      "anyOf": [
        { "$ref": "#/definitions/required" },
        { "$ref": "/schemas/core/postal-area-support.json" }
      ]
    },
    "geo_proximity": {
      "anyOf": [
        { "$ref": "#/definitions/required" },
        {
          "type": "object",
          "properties": {
            "radius": { "$ref": "#/definitions/required" },
            "travel_time": { "$ref": "#/definitions/required" },
            "geometry": { "$ref": "#/definitions/required" },
            "transport_modes": {
              "type": "array",
              "items": { "$ref": "/schemas/enums/transport-mode.json" },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "minProperties": 1,
          "additionalProperties": false
        }
      ]
    },
    "daypart_targets": { "$ref": "#/definitions/required" },
    "audience_include": { "$ref": "#/definitions/required" },
    "audience_exclude": { "$ref": "#/definitions/required" },
    "signal_targeting_groups": { "$ref": "#/definitions/required" },
    "demographics": {
      "anyOf": [
        { "$ref": "#/definitions/required" },
        {
          "type": "object",
          "properties": { "age": { "$ref": "#/definitions/required" } },
          "required": ["age"],
          "additionalProperties": false
        }
      ]
    },
    "frequency_cap": { "$ref": "#/definitions/required" },
    "property_list": { "$ref": "#/definitions/required" },
    "property_list_exclude": { "$ref": "#/definitions/required" },
    "collection_list": { "$ref": "#/definitions/required" },
    "collection_list_exclude": { "$ref": "#/definitions/required" },
    "placement_selection": { "$ref": "#/definitions/required" },
    "age_restriction": { "$ref": "#/definitions/required" },
    "device_platform": { "$ref": "#/definitions/required" },
    "device_platform_exclude": { "$ref": "#/definitions/required" },
    "device_type": { "$ref": "#/definitions/required" },
    "device_type_exclude": { "$ref": "#/definitions/required" },
    "store_catchments": { "$ref": "#/definitions/required" },
    "language": { "$ref": "#/definitions/required" },
    "keyword_targets": { "$ref": "#/definitions/keywordRequirement" },
    "negative_keywords": { "$ref": "#/definitions/keywordRequirement" },
    "ext": { "$ref": "/schemas/core/ext.json" }
  },
  "minProperties": 1,
  "additionalProperties": false
}
