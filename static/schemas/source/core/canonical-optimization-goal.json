{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/schemas/core/canonical-optimization-goal.json",
  "title": "Canonical Optimization Goal",
  "description": "Canonical 3.2 optimization objective. Monetary execution policy belongs in BiddingPolicy; legacy monetary targets and unbound attention metrics are excluded.",
  "discriminator": { "propertyName": "kind" },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": { "type": "string", "const": "metric", "default": "metric" },
        "metric": {
          "$ref": "/schemas/enums/canonical-optimization-metric.json"
        },
        "standard": { "$ref": "/schemas/enums/viewability-standard.json" },
        "vendor": { "$ref": "/schemas/core/brand-key.json" },
        "reach_unit": { "$ref": "/schemas/enums/reach-unit.json" },
        "target_frequency": {
          "$ref": "/schemas/core/target-frequency.json"
        },
        "view_duration_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "target": {
          "$ref": "/schemas/core/threshold-rate-target.json"
        },
        "priority": { "type": "integer", "minimum": 1 }
      },
      "required": ["kind", "metric"],
      "allOf": [
        {
          "if": { "properties": { "metric": { "const": "viewable_rate" } }, "required": ["metric"] },
          "then": {
            "required": ["standard"],
            "properties": { "target": { "properties": { "value": { "maximum": 1 } } } }
          }
        },
        {
          "if": { "properties": { "metric": { "enum": ["viewable_rate", "viewed_seconds"] } }, "required": ["metric"] },
          "else": { "not": { "anyOf": [{ "required": ["standard"] }, { "required": ["vendor"] }] } }
        }
      ],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "kind": { "type": "string", "const": "event", "default": "event" },
        "event_sources": {
          "type": "array",
          "items": {
            "$ref": "/schemas/core/optimization-event-source.json"
          },
          "minItems": 1
        },
        "target": {
          "$ref": "/schemas/core/maximize-value-target.json"
        },
        "attribution_window": { "$ref": "/schemas/core/attribution-window.json" },
        "priority": { "type": "integer", "minimum": 1 }
      },
      "required": ["kind", "event_sources"],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "kind": { "type": "string", "const": "vendor_metric", "default": "vendor_metric" },
        "vendor": { "$ref": "/schemas/core/brand-key.json" },
        "metric_id": { "$ref": "/schemas/core/vendor-metric-id.json" },
        "target": {
          "$ref": "/schemas/core/threshold-rate-target.json"
        },
        "priority": { "type": "integer", "minimum": 1 }
      },
      "required": ["kind", "vendor", "metric_id"],
      "additionalProperties": true
    }
  ]
}
