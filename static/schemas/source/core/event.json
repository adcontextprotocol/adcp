{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/schemas/core/event.json",
  "title": "Event",
  "description": "A marketing event (conversion, engagement, or custom) for attribution and optimization",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Unique identifier for deduplication (scoped to event_type + event_source_id)",
      "minLength": 1,
      "maxLength": 256
    },
    "event_type": {
      "$ref": "/schemas/enums/event-type.json",
      "description": "Standard event type"
    },
    "event_time": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when the event occurred"
    },
    "user_match": {
      "$ref": "/schemas/core/user-match.json",
      "description": "User identifiers for attribution matching"
    },
    "custom_data": {
      "$ref": "/schemas/core/event-custom-data.json",
      "description": "Event-specific data (value, currency, items, etc.)"
    },
    "action_source": {
      "$ref": "/schemas/enums/action-source.json",
      "description": "Where the event originated"
    },
    "surface": {
      "$ref": "/schemas/core/event-surface.json",
      "description": "Optional structured surface context for the event, such as an owned channel, profile, feed, podcast, newsletter list, website, app, or store. Complements `action_source`; use it when optimization-relevant meaning would otherwise live only in platform-specific `ext` metadata."
    },
    "event_source_url": {
      "type": "string",
      "format": "uri",
      "description": "URL where the event occurred (required when action_source is 'website')"
    },
    "custom_event_name": {
      "type": "string",
      "description": "Name for custom events (used when event_type is 'custom')"
    },
    "ext": {
      "$ref": "/schemas/core/ext.json"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "watch_milestone"
          }
        },
        "required": ["event_type"]
      },
      "then": {
        "required": ["custom_data"],
        "properties": {
          "custom_data": {
            "allOf": [
              {
                "$ref": "/schemas/core/event-custom-data.json"
              },
              {
                "anyOf": [
                  {
                    "required": ["progress_percent"]
                  },
                  {
                    "required": ["progress_seconds"]
                  }
                ]
              }
            ]
          }
        }
      }
    }
  ],
  "required": ["event_id", "event_type", "event_time"],
  "additionalProperties": true,
  "examples": [
    {
      "event_id": "evt_purchase_12345",
      "event_type": "purchase",
      "event_time": "2026-01-15T14:30:00Z",
      "action_source": "website",
      "event_source_url": "https://www.example.com/checkout/confirm",
      "user_match": {
        "hashed_email": "a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2",
        "click_id": "abc123def456",
        "click_id_type": "gclid"
      },
      "custom_data": {
        "value": 149.99,
        "currency": "USD",
        "order_id": "order_98765",
        "num_items": 3
      }
    }
  ]
}
