{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/schemas/core/account-setup.json",
  "title": "Account Setup",
  "description": "Next steps a human must complete before an account can activate.",
  "type": "object",
  "properties": {
    "url": {
      "$ref": "/schemas/core/https-url.json",
      "description": "URL where the human can complete the required action (credit application, legal agreement, add funds)."
    },
    "message": {
      "type": "string",
      "description": "Human-readable description of what's needed."
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this setup link expires."
    },
    "waiting_on": {
      "$ref": "/schemas/enums/pending-action-party.json",
      "x-status": "experimental",
      "x-added-in": "3.3.0",
      "description": "Whose turn it is."
    },
    "kind": {
      "$ref": "/schemas/enums/pending-action-kind.json",
      "x-status": "experimental",
      "x-added-in": "3.3.0",
      "description": "What is needed."
    }
  },
  "required": [
    "message"
  ],
  "additionalProperties": true
}
