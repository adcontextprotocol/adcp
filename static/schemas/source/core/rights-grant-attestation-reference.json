{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/schemas/core/rights-grant-attestation-reference.json",
  "title": "Rights Grant Attestation Reference",
  "description": "An attestation reference for a rights grant: a brand-issued claim whose subject is a rights-grant resource.",
  "allOf": [
    {
      "$ref": "/schemas/core/attestation-reference.json"
    },
    {
      "type": "object",
      "properties": {
        "issuer": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "brand",
              "default": "brand"
            },
            "brand": {
              "$ref": "/schemas/core/brand-ref.json"
            }
          },
          "required": [
            "type",
            "brand"
          ]
        },
        "claim_type": {
          "type": "string",
          "const": "https://adcontextprotocol.org/claims/rights/grant"
        },
        "subject": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "resource"
            },
            "resource_type": {
              "type": "string",
              "const": "https://adcontextprotocol.org/claims/subjects/rights-grant"
            }
          },
          "required": [
            "type",
            "resource_type",
            "namespace",
            "id",
            "content_digest"
          ]
        }
      }
    }
  ]
}
