{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/schemas/core/data-subject-contestation.json",
  "title": "Data Subject Contestation",
  "description": "A contact point where a data subject can request human intervention, express their view, or contest an automated decision. It is a URL, an email address, or both, not a machine-callable API.",
  "type": "object",
  "properties": {
    "url": {
      "$ref": "/schemas/core/https-url.json"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string",
        "x-max-length-4.0": 128
      },
      "x-max-items-4.0": 32
    }
  },
  "anyOf": [
    {
      "required": [
        "url"
      ]
    },
    {
      "required": [
        "email"
      ]
    }
  ],
  "additionalProperties": true
}
