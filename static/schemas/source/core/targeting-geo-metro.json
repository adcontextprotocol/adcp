{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/schemas/core/targeting-geo-metro.json",
  "title": "Targeting Geo Metro",
  "description": "A metro-area classification system and the metro codes targeted within it.",
  "type": "object",
  "properties": {
    "system": {
      "$ref": "/schemas/enums/metro-system.json",
      "description": "Metro area classification system (e.g., 'nielsen_dma', 'uk_itl2')"
    },
    "values": {
      "type": "array",
      "description": "Metro codes within the system (e.g., ['501', '602'] for Nielsen DMAs)",
      "items": { "type": "string" },
      "minItems": 1
    }
  },
  "required": ["system", "values"],
  "additionalProperties": false
}
