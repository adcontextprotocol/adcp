{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/schemas/core/rights-disclosure.json",
  "title": "Rights Disclosure",
  "description": "A disclosure obligation: whether a disclosure is required and, when it is, the disclosure text.",
  "type": "object",
  "properties": {
    "required": {
      "type": "boolean"
    },
    "text": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "required"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "required": {
            "const": true
          }
        },
        "required": [
          "required"
        ]
      },
      "then": {
        "required": [
          "text"
        ]
      }
    }
  ],
  "additionalProperties": true
}
