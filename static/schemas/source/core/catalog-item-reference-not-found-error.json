{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/schemas/core/catalog-item-reference-not-found-error.json",
  "title": "Catalog Item Reference Not Found Error",
  "description": "Privacy-preserving error for an unknown, inaccessible, unauthorized, or stale-generation catalog item reference. The invariant closed shape prevents resource enumeration.",
  "type": "object",
  "properties": {
    "code": { "allOf": [{ "$ref": "/schemas/core/open-error-code.json" }, { "const": "REFERENCE_NOT_FOUND" }] },
    "message": { "allOf": [{ "$ref": "/schemas/core/error-message.json" }, { "const": "Catalog item not found" }] },
    "recovery": { "allOf": [{ "$ref": "/schemas/enums/error-recovery.json" }, { "const": "correctable" }] }
  },
  "required": ["code", "message", "recovery"],
  "additionalProperties": false
}
