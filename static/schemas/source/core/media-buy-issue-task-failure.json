{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/schemas/core/media-buy-issue-task-failure.json",
  "title": "Media Buy Issue Task Failure",
  "description": "A failed media buy issue result: outcome `failed` with one or more errors, and no issue.",
  "type": "object",
  "properties": {
    "outcome": {
      "type": "string",
      "const": "failed",
      "default": "failed"
    },
    "errors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "/schemas/core/error.json"
      }
    },
    "context": {
      "$ref": "/schemas/core/context.json"
    },
    "ext": {
      "$ref": "/schemas/core/ext.json"
    }
  },
  "required": [
    "outcome",
    "errors"
  ],
  "additionalProperties": true,
  "not": {
    "required": [
      "issue"
    ]
  }
}
