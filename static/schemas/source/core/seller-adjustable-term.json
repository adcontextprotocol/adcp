{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/schemas/core/seller-adjustable-term.json",
  "title": "Seller Adjustable Term",
  "x-status": "experimental",
  "x-added-in": "3.3.0",
  "description": "A purchase field the buyer pre-authorizes the seller to change unilaterally, and the bounds. Seller-authored, bound by accept_proposal and terms_digest like cancellation_terms. A change within the constraint and min_notice is a new revision with no offer; anything else needs a seller offer. A term never changes a unit price or raises what the buyer pays. Experimental in AdCP 3.3 (media_buy.seller_adjustment_allowances).",
  "type": "object",
  "properties": {
    "allowance_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9_.:-]{1,255}$",
      "x-entity": "seller_adjustment_allowance",
      "description": "Unique within the commercial terms. Applied adjustments, history entries and change records cite it."
    },
    "purchase_index": {
      "type": "integer",
      "minimum": 0,
      "description": "Position in commercial_terms.purchases; path points into it. Amendments preserve referenced positions."
    },
    "path": {
      "type": "string",
      "minLength": 2,
      "maxLength": 500,
      "pattern": "^/(budget|impressions|start_time|end_time|targeting_overlay)(/([^~/]|~[01])+)*$",
      "not": {
        "pattern": "/([0-9]+|-)(/|$)"
      },
      "description": "RFC 6901 pointer into the purchase, no array indexes. First token: budget, impressions, start_time, end_time or targeting_overlay (a later version may widen). Never pricing, product, measurement, bidding, goal or cap fields. MUST resolve to an existing value at acceptance."
    },
    "constraint": {
      "type": "object",
      "minProperties": 1,
      "description": "Bounds, at least one member. Within bounds means the new value is an alternate, or satisfies every other member. direction is relative to the current value; max_change_fraction and max_shift are net from the value in the most recently accepted terms. budget and impressions take direction decrease, min and max_change_fraction; start_time and end_time take earlier or later and max_shift; targeting_overlay takes alternates only. Trigger conditions are contractual, not encoded.",
      "properties": {
        "direction": {
          "$ref": "/schemas/enums/adjustment-direction.json"
        },
        "min": {
          "type": "number",
          "description": "Numeric: the new value MUST NOT be lower."
        },
        "max": {
          "type": "number",
          "description": "Numeric: the new value MUST NOT be higher."
        },
        "max_change_fraction": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "description": "Numeric: net change from the accepted value, as a fraction of it, MUST NOT exceed this."
        },
        "max_shift": {
          "allOf": [
            {
              "$ref": "/schemas/core/duration.json"
            },
            {
              "not": {
                "properties": {
                  "unit": {
                    "const": "campaign"
                  }
                },
                "required": [
                  "unit"
                ]
              }
            }
          ],
          "description": "Timestamp: net move from the accepted value MUST NOT exceed this."
        },
        "alternates": {
          "type": "array",
          "minItems": 1,
          "description": "Ordered replacement values, a forward-only chain after the accepted value (the primary is not listed). The seller MUST use the first available entry after the one in effect.",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255,
                "description": "Display name, such as the program title."
              },
              "value": {
                "type": [
                  "number",
                  "string",
                  "boolean",
                  "object",
                  "array",
                  "null"
                ],
                "description": "A complete replacement value, of the same shape as the field at path."
              }
            },
            "required": [
              "value"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "min_notice": {
      "allOf": [
        {
          "$ref": "/schemas/core/duration.json"
        },
        {
          "not": {
            "properties": {
              "unit": {
                "const": "campaign"
              }
            },
            "required": [
              "unit"
            ]
          }
        }
      ],
      "description": "Lead time from applied_at to the start of the affected period or item (timestamps: the earlier of old and new value), or to the end of the flight for a budget or volume. Required on start_time and end_time; a past time MUST NOT change."
    },
    "ext": {
      "$ref": "/schemas/core/ext.json"
    }
  },
  "required": [
    "allowance_id",
    "purchase_index",
    "path",
    "constraint"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "path": {
            "pattern": "^/(budget|impressions)$"
          }
        },
        "required": [
          "path"
        ]
      },
      "then": {
        "properties": {
          "constraint": {
            "required": [
              "direction"
            ],
            "properties": {
              "direction": {
                "const": "decrease"
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "max_shift"
                  ]
                },
                {
                  "required": [
                    "alternates"
                  ]
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "path": {
            "pattern": "^/(start_time|end_time)$"
          }
        },
        "required": [
          "path"
        ]
      },
      "then": {
        "required": [
          "min_notice"
        ],
        "properties": {
          "constraint": {
            "properties": {
              "direction": {
                "enum": [
                  "earlier",
                  "later"
                ]
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "min"
                  ]
                },
                {
                  "required": [
                    "max"
                  ]
                },
                {
                  "required": [
                    "max_change_fraction"
                  ]
                },
                {
                  "required": [
                    "alternates"
                  ]
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "path": {
            "pattern": "^/targeting_overlay(/|$)"
          }
        },
        "required": [
          "path"
        ]
      },
      "then": {
        "properties": {
          "constraint": {
            "required": [
              "alternates"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "direction"
                  ]
                },
                {
                  "required": [
                    "min"
                  ]
                },
                {
                  "required": [
                    "max"
                  ]
                },
                {
                  "required": [
                    "max_change_fraction"
                  ]
                },
                {
                  "required": [
                    "max_shift"
                  ]
                }
              ]
            }
          }
        }
      }
    }
  ]
}
