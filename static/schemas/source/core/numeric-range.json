{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/schemas/core/numeric-range.json",
  "title": "Numeric Range",
  "description": "A range of numeric values with a minimum and a maximum.",
  "type": "object",
  "properties": {
    "min": {
      "type": "number",
      "description": "Minimum value, inclusive."
    },
    "max": {
      "type": "number",
      "description": "Maximum value, inclusive."
    }
  },
  "required": [
    "min",
    "max"
  ],
  "additionalProperties": true
}
