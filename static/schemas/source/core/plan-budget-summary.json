{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/schemas/core/plan-budget-summary.json",
  "title": "Plan Budget Summary",
  "description": "A plan's budget state: accounting mode, gross and net commitments, reported and verified adjustments, restored headroom, and remaining budget.",
  "type": "object",
  "properties": {
    "accounting_mode": {
      "$ref": "/schemas/enums/governance-accounting-mode.json"
    },
    "gross_committed": {
      "type": "number",
      "minimum": 0
    },
    "adjustments_reported": {
      "type": "number",
      "minimum": 0
    },
    "adjustments_verified": {
      "type": "number",
      "minimum": 0
    },
    "net_cost": {
      "type": "number",
      "minimum": 0
    },
    "headroom_restored": {
      "type": "number",
      "minimum": 0
    },
    "ledger_committed": {
      "type": "number",
      "minimum": 0
    },
    "net_committed": {
      "type": "number",
      "minimum": 0
    },
    "budget_remaining": {
      "type": "number"
    }
  },
  "required": [
    "accounting_mode",
    "gross_committed",
    "adjustments_reported",
    "adjustments_verified",
    "net_cost",
    "headroom_restored",
    "ledger_committed",
    "net_committed",
    "budget_remaining"
  ],
  "additionalProperties": true
}
