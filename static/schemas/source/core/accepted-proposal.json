{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/schemas/core/accepted-proposal.json",
  "title": "Accepted Proposal",
  "description": "An accepted proposal: a canonical proposal with its media buy ID, acceptance time, commercial terms, and terms digest.",
  "allOf": [
    {
      "$ref": "/schemas/core/canonical-proposal.json"
    },
    {
      "properties": {
        "proposal_status": {
          "type": "string",
          "const": "accepted"
        },
        "media_buy_id": {
          "$ref": "/schemas/core/media-buy-id.json"
        }
      },
      "required": [
        "proposal_status",
        "media_buy_id",
        "accepted_at",
        "commercial_terms",
        "terms_digest"
      ]
    }
  ]
}
