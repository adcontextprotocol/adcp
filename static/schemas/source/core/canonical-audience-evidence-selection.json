{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/schemas/core/canonical-audience-evidence-selection.json",
  "title": "Canonical Audience Evidence Selection",
  "description": "Compact decision readback pinning the evidence snapshot that affected recommendation or eligibility.",
  "type": "object",
  "properties": {
    "evidence_id": { "$ref": "/schemas/core/audience-evidence-id.json" },
    "snapshot_id": { "$ref": "/schemas/core/audience-evidence-snapshot-id.json" },
    "version": { "$ref": "/schemas/core/audience-evidence-version.json" },
    "content_digest": { "$ref": "/schemas/core/sha256-digest.json" },
    "decision_use": { "$ref": "/schemas/enums/audience-evidence-decision-use.json" },
    "evidence": { "$ref": "/schemas/core/canonical-audience-evidence.json" },
    "verified_attestation_digests": { "type": "array", "items": { "$ref": "/schemas/core/sha256-digest.json" }, "minItems": 1, "uniqueItems": true },
    "ext": { "$ref": "/schemas/core/ext.json" }
  },
  "required": ["evidence_id", "snapshot_id", "version", "content_digest", "decision_use"],
  "additionalProperties": false
}
