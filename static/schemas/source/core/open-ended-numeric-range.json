{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/schemas/core/open-ended-numeric-range.json",
  "title": "Open-Ended Numeric Range",
  "description": "A range of numeric values with an inclusive minimum, an inclusive maximum, or both. An end that is absent leaves that side of the range unbounded.",
  "type": "object",
  "properties": {
    "min": {
      "type": "number",
      "description": "Minimum value, inclusive."
    },
    "max": {
      "type": "number",
      "description": "Maximum value, inclusive."
    }
  },
  "additionalProperties": true,
  "anyOf": [
    {
      "required": [
        "min"
      ]
    },
    {
      "required": [
        "max"
      ]
    }
  ]
}
