{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/schemas/core/numeric-value-range.json",
  "title": "Numeric Value Range",
  "description": "A range of numeric values with a minimum, a maximum, and an optional unit.",
  "type": "object",
  "properties": {
    "min": {
      "type": "number",
      "description": "Minimum value"
    },
    "max": {
      "type": "number",
      "description": "Maximum value"
    },
    "unit": {
      "type": "string",
      "description": "Unit of measurement (e.g., 'score', 'dollars', 'years')"
    }
  },
  "required": [
    "min",
    "max"
  ],
  "additionalProperties": true
}
