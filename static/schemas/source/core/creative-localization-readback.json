{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/schemas/core/creative-localization-readback.json",
  "title": "Creative Localization Readback",
  "description": "Exact provider-backed materialized localization state for one creative. Review and serving eligibility remain creative-wide on the enclosing creative; locale variants do not have independent lifecycle states. Presence means every source/target variant was read back completely. Sellers MUST return localization_unavailable on list_creatives rather than a partial or lossy localization object.",
  "x-adcp-validation": {
    "verifier_constraints": {
      "unique_variant_properties": [
        "locale_variant_id",
        "locale",
        "provider_variant_id"
      ],
      "exact_role_counts": { "source": 1 },
      "default_locale_variant_id": "must_reference_exactly_one_variant",
      "source_assets": "must_equal_enclosing_creative.assets",
      "locale_matching": "rfc4647_lookup",
      "locale_match_tie_break": "source_then_request_target_order"
    },
    "spec": "docs/creative/task-reference/list_creatives.mdx#localized-creative-readback"
  },
  "type": "object",
  "properties": {
    "default_locale_variant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "description": "The source or target locale variant used for unmatched opportunities when unmatched_locale_action is serve_default.",
      "x-entity": "creative_locale_variant"
    },
    "unmatched_locale_action": {
      "type": "string",
      "enum": ["serve_default", "do_not_serve"]
    },
    "locale_matching": {
      "type": "string",
      "const": "rfc4647_lookup",
      "description": "The deterministic matching algorithm applied to ordered locale preferences. RFC 4647 Lookup progressively truncates subtags until it finds an available variant."
    },
    "variants": {
      "type": "array",
      "description": "The source variant followed by every target variant. Assets are fully resolved after source inheritance. The enclosing creative status applies to the set as a whole.",
      "items": {
        "discriminator": {
          "propertyName": "role"
        },
        "oneOf": [
          {
            "title": "SourceLocalizationReadback",
            "type": "object",
            "properties": {
              "locale_variant_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255,
                "description": "Buyer-assigned stable locale-variant identity from the request.",
                "x-entity": "creative_locale_variant"
              },
              "locale": {
                "$ref": "/schemas/core/locale-tag.json"
              },
              "role": {
                "type": "string",
                "const": "source"
              },
              "assets": {
                "$ref": "#/definitions/resolvedAssets"
              },
              "provider_variant_id": {
                "type": "string",
                "minLength": 1,
                "description": "Stable provider-native identity or label for this exact locale execution."
              }
            },
            "required": [
              "locale_variant_id",
              "locale",
              "role",
              "assets",
              "provider_variant_id"
            ],
            "not": {
              "anyOf": [
                { "required": ["translation_mode"] },
                { "required": ["status"] },
                { "required": ["launch_status"] }
              ]
            },
            "additionalProperties": true
          },
          {
            "title": "TargetLocalizationReadback",
            "type": "object",
            "properties": {
              "locale_variant_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255,
                "description": "Buyer-assigned stable locale-variant identity from the request.",
                "x-entity": "creative_locale_variant"
              },
              "locale": {
                "$ref": "/schemas/core/locale-tag.json"
              },
              "role": {
                "type": "string",
                "const": "target"
              },
              "assets": {
                "$ref": "#/definitions/resolvedAssets"
              },
              "provider_variant_id": {
                "type": "string",
                "minLength": 1,
                "description": "Stable provider-native identity or label for this exact locale execution."
              }
            },
            "required": [
              "locale_variant_id",
              "locale",
              "role",
              "assets",
              "provider_variant_id"
            ],
            "not": {
              "anyOf": [
                { "required": ["translation_mode"] },
                { "required": ["status"] },
                { "required": ["launch_status"] }
              ]
            },
            "additionalProperties": true
          }
        ]
      },
      "minItems": 2,
      "maxItems": 51,
      "uniqueItems": true
    }
  },
  "required": [
    "default_locale_variant_id",
    "unmatched_locale_action",
    "locale_matching",
    "variants"
  ],
  "not": { "required": ["platform_id"] },
  "additionalProperties": true,
  "definitions": {
    "resolvedAssets": {
      "type": "object",
      "description": "Complete resolved assets for this locale, keyed by creative slot.",
      "minProperties": 1,
      "patternProperties": {
        "^[a-z0-9_]+$": {
          "anyOf": [
            { "$ref": "/schemas/core/assets/asset-union.json" },
            {
              "type": "array",
              "items": { "$ref": "/schemas/core/assets/asset-union.json" },
              "minItems": 1
            }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
