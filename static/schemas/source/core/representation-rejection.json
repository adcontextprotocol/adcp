{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/schemas/core/representation-rejection.json",
  "title": "Representation Rejection",
  "description": "Structured incompatibility reason for one candidate in a failed CreativeRepresentationSet resolution.",
  "type": "object",
  "properties": {
    "representation_id": { "type": "string", "minLength": 1, "x-entity": "creative_representation" },
    "code": {
      "type": "string",
      "enum": [
        "incompatible_format_kind",
        "format_option_mismatch",
        "unsupported_delivery_type",
        "vast_version_mismatch",
        "macro_unsupported",
        "tracker_contract_mismatch",
        "asset_requirement_failed",
        "other"
      ]
    },
    "message": { "type": "string", "minLength": 1 },
    "details": { "type": "object", "additionalProperties": true }
  },
  "required": ["representation_id", "code", "message"],
  "additionalProperties": true
}
