{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/schemas/core/distance.json",
  "title": "Distance",
  "description": "A non-negative distance, with its unit.",
  "type": "object",
  "properties": {
    "value": {
      "type": "number",
      "minimum": 0,
      "description": "Distance in the unit."
    },
    "unit": {
      "$ref": "/schemas/enums/distance-unit.json",
      "description": "Distance unit."
    }
  },
  "required": ["value", "unit"],
  "additionalProperties": true
}
