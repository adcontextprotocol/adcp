{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/schemas/core/canonical-pricing-option.json",
  "title": "Canonical Pricing Option",
  "description": "Self-contained selected pricing terms for compact product offers and accepted commercial snapshots. Deprecated execution hints such as max_bid are absent; bidding intent lives in BiddingPolicy.",
  "type": "object",
  "properties": {
    "pricing_option_id": { "type": "string", "minLength": 1, "x-entity": "product_pricing_option" },
    "pricing_model": {
      "type": "string",
      "enum": ["cpm", "vcpm", "cpc", "cpcv", "cpv", "cpp", "cpa", "revenue_share", "flat_rate", "time"]
    },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "fixed_price": { "type": "number", "minimum": 0 },
    "floor_price": { "type": "number", "minimum": 0 },
    "price_guidance": { "$ref": "/schemas/pricing-options/price-guidance.json" },
    "min_spend_per_package": { "type": "number", "minimum": 0 },
    "price_breakdown": { "$ref": "/schemas/pricing-options/price-breakdown.json" },
    "price_adjustments": {
      "$ref": "/schemas/pricing-options/price-adjustments.json",
      "x-added-in": "3.3.0",
      "description": "The selected option's complete adjustment table, retained verbatim and covered by terms_digest. On an offer, fixed_price is the base rate. In accepted purchase pricing, fixed_price is the resolved rate, base_fixed_price the declared rate, and price_breakdown the declared adjustments followed by the rows that fired."
    },
    "base_fixed_price": {
      "type": "number",
      "minimum": 0,
      "x-added-in": "3.3.0",
      "description": "The declared fixed_price before any price_adjustments row fired; present in accepted purchase pricing that carries price_adjustments so the resolved fixed_price is re-derivable."
    },
    "eligible_adjustments": {
      "type": "array",
      "items": { "$ref": "/schemas/enums/adjustment-kind.json" },
      "uniqueItems": true
    },
    "parameters": { "type": "object", "additionalProperties": true },
    "event_type": { "$ref": "/schemas/enums/event-type.json" },
    "custom_event_name": { "type": "string", "minLength": 1 },
    "event_source_id": { "type": "string", "minLength": 1, "x-entity": "event_source" },
    "commission_rate": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
    "commission_basis_description": { "type": "string", "minLength": 1, "maxLength": 1000 }
  },
  "required": ["pricing_option_id", "pricing_model", "currency"],
  "allOf": [
    { "not": { "required": ["fixed_price", "floor_price"] } },
    {
      "description": "price_adjustments is defined for per-unit and flat fixed prices only; cpa, cpp, time, and revenue_share options do not carry it.",
      "if": { "required": ["price_adjustments"] },
      "then": { "properties": { "pricing_model": { "enum": ["cpm", "vcpm", "cpc", "cpcv", "cpv", "flat_rate"] } } }
    },
    {
      "if": { "properties": { "pricing_model": { "const": "cpa" } }, "required": ["pricing_model"] },
      "then": { "required": ["event_type", "fixed_price"] }
    },
    {
      "if": { "properties": { "pricing_model": { "const": "revenue_share" } }, "required": ["pricing_model"] },
      "then": { "required": ["event_type", "event_source_id", "commission_rate", "commission_basis_description"] }
    },
    {
      "if": { "properties": { "pricing_model": { "enum": ["cpv", "cpp", "time"] } }, "required": ["pricing_model"] },
      "then": { "required": ["parameters"] }
    },
    {
      "if": { "properties": { "event_type": { "const": "custom" } }, "required": ["event_type"] },
      "then": { "required": ["custom_event_name"] }
    }
  ],
  "dependencies": { "price_adjustments": ["fixed_price"], "base_fixed_price": ["price_adjustments"] },
  "additionalProperties": false
}
