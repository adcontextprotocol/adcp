{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/schemas/sponsored-intelligence/si-terminate-session-request.json",
  "title": "SI Terminate Session Request",
  "description": "Request to terminate an SI session. Naturally idempotent — `session_id` is the dedup boundary, and terminating an already-terminated session is a no-op that returns the same terminal state. No `idempotency_key` is needed on this request.",
  "type": "object",
  "allOf": [
    {
      "$ref": "/schemas/core/version-envelope.json"
    }
  ],
  "x-status": "experimental",
  "x-mutates-state": true,
  "properties": {
    "session_id": {
      "type": "string",
      "description": "Session identifier to terminate",
      "x-entity": "si_session"
    },
    "reason": {
      "type": "string",
      "enum": [
        "handoff_transaction",
        "handoff_complete",
        "user_exit",
        "session_timeout",
        "host_terminated"
      ],
      "description": "Reason for termination"
    },
    "termination_context": {
      "type": "object",
      "description": "Context for the termination",
      "properties": {
        "summary": {
          "type": "string",
          "description": "Summary of the conversation"
        },
        "transaction_intent": {
          "type": "object",
          "description": "For handoff_transaction - what user wants to buy",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "purchase",
                "subscribe"
              ]
            },
            "product": {
              "type": "object",
              "description": "Product/service details"
            }
          },
          "additionalProperties": true
        },
        "cause": {
          "type": "string",
          "description": "For host_terminated - why host ended session"
        }
      },
      "additionalProperties": true
    },
    "context": {
      "$ref": "/schemas/core/context.json"
    },
    "ext": {
      "$ref": "/schemas/core/ext.json"
    }
  },
  "required": [
    "session_id",
    "reason"
  ],
  "additionalProperties": true,
  "examples": [
    {
      "session_id": "sess_abc123",
      "reason": "handoff_transaction",
      "termination_context": {
        "transaction_intent": {
          "action": "purchase",
          "product": {
            "type": "flight",
            "flight_number": "DL628"
          }
        }
      }
    },
    {
      "session_id": "sess_abc123",
      "reason": "handoff_complete"
    },
    {
      "session_id": "sess_abc123",
      "reason": "user_exit",
      "termination_context": {
        "summary": "The user viewed flight DL628, reached seat selection, and changed the topic."
      }
    },
    {
      "session_id": "sess_abc123",
      "reason": "session_timeout",
      "termination_context": {
        "summary": "No user activity for 300 seconds after 2026-01-18T10:25:00Z."
      }
    },
    {
      "session_id": "sess_abc123",
      "reason": "host_terminated",
      "termination_context": {
        "cause": "user_left_app"
      }
    }
  ]
}
