{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/schemas/sponsored-intelligence/si-terminate-session-response.json",
  "title": "SI Terminate Session Response",
  "description": "Confirmation of session termination",
  "type": "object",
  "allOf": [
    {
      "$ref": "/schemas/core/protocol-envelope.json"
    }
  ],
  "x-status": "experimental",
  "properties": {
    "session_id": {
      "type": "string",
      "description": "Terminated session identifier",
      "x-entity": "si_session"
    },
    "terminated": {
      "type": "boolean",
      "description": "Whether session was successfully terminated"
    },
    "session_status": {
      "$ref": "/schemas/enums/si-session-status.json",
      "description": "Resulting session state. 'complete' for handoff_transaction/handoff_complete, 'terminated' for user_exit/session_timeout/host_terminated."
    },
    "acp_handoff": {
      "type": "object",
      "description": "ACP checkout handoff data. Present when reason is handoff_transaction.",
      "properties": {
        "checkout_url": {
          "type": "string",
          "format": "uri",
          "description": "Brand's ACP checkout endpoint. Hosts MUST validate this is HTTPS before opening."
        },
        "checkout_token": {
          "type": "string",
          "description": "Opaque token for the checkout flow. The host passes this to the checkout endpoint to correlate the SI session with the transaction."
        },
        "payload": {
          "type": "object",
          "description": "Rich checkout context to pass to the ACP endpoint (product details, applied offers, pricing). Alternative to checkout_token for integrations that need structured data.",
          "additionalProperties": true
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "description": "When this handoff data expires. Hosts should initiate checkout before this time."
        }
      },
      "additionalProperties": true
    },
    "follow_up": {
      "type": "object",
      "description": "Suggested follow-up actions",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "save_for_later",
            "set_reminder",
            "subscribe_updates",
            "none"
          ]
        },
        "data": {
          "type": "object",
          "description": "Data for follow-up action"
        }
      },
      "additionalProperties": true
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "/schemas/core/error.json"
      }
    },
    "context": {
      "$ref": "/schemas/core/context.json"
    },
    "ext": {
      "$ref": "/schemas/core/ext.json"
    }
  },
  "required": [
    "session_id",
    "terminated"
  ],
  "additionalProperties": true,
  "examples": [
    {
      "status": "completed",
      "session_id": "sess_abc123",
      "terminated": true,
      "acp_handoff": {
        "checkout_url": "https://delta.com/acp/checkout",
        "payload": {
          "session_id": "sess_abc123",
          "flight": "DL628",
          "passenger": {
            "email": "jane@example.com",
            "name": "Jane Smith"
          },
          "applied_offers": [
            "delta_chatgpt_3313"
          ],
          "price": {
            "amount": 199,
            "currency": "USD"
          }
        },
        "expires_at": "2026-01-18T11:00:00Z"
      }
    },
    {
      "status": "completed",
      "session_id": "sess_abc123",
      "terminated": true,
      "follow_up": {
        "action": "save_for_later",
        "data": {
          "flights_discussed": [
            "DL628",
            "DL632"
          ],
          "destination": "BOS",
          "travel_date": "2026-01-27"
        }
      }
    },
    {
      "status": "completed",
      "session_id": "sess_abc123",
      "terminated": true,
      "follow_up": {
        "action": "set_reminder",
        "data": {
          "incomplete_booking": {
            "flight": "DL628",
            "step": "seat_selection"
          }
        }
      }
    },
    {
      "status": "completed",
      "session_id": "sess_abc123",
      "terminated": true
    }
  ]
}
