{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/schemas/sponsored-intelligence/si-initiate-session-response.json",
  "title": "SI Initiate Session Response",
  "description": "Brand agent's response to session initiation",
  "type": "object",
  "allOf": [
    {
      "$ref": "/schemas/core/protocol-envelope.json"
    }
  ],
  "x-status": "experimental",
  "properties": {
    "session_id": {
      "type": "string",
      "description": "Unique session identifier for subsequent messages",
      "x-entity": "si_session"
    },
    "response": {
      "type": "object",
      "description": "Brand agent's initial response",
      "properties": {
        "message": {
          "type": "string",
          "description": "Conversational message from brand agent"
        },
        "ui_elements": {
          "type": "array",
          "items": {
            "$ref": "/schemas/sponsored-intelligence/si-ui-element.json"
          },
          "description": "Visual components to render"
        }
      },
      "additionalProperties": true
    },
    "negotiated_capabilities": {
      "$ref": "/schemas/sponsored-intelligence/si-capabilities.json",
      "description": "Intersection of brand and host capabilities for this session"
    },
    "sponsored_context": {
      "$ref": "/schemas/sponsored-intelligence/si-sponsored-context.json",
      "description": "Declaration for sponsored context carried by the initial brand-agent response. Hosts MUST either honor the declared context_use and disclosure_obligation or reject the context before presenting, comparing, or otherwise using it."
    },
    "session_status": {
      "$ref": "/schemas/enums/si-session-status.json",
      "description": "Current session lifecycle state. Returned in initiation, message, and termination responses."
    },
    "session_ttl_seconds": {
      "type": "integer",
      "minimum": 1,
      "description": "Session inactivity timeout in seconds. After this duration without a message, the brand agent may terminate the session. Hosts SHOULD warn users before timeout when possible."
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "/schemas/core/error.json"
      },
      "description": "Errors during session initiation"
    },
    "context": {
      "$ref": "/schemas/core/context.json"
    },
    "ext": {
      "$ref": "/schemas/core/ext.json"
    }
  },
  "required": [
    "session_id",
    "session_status"
  ],
  "additionalProperties": true,
  "examples": [
    {
      "status": "completed",
      "session_id": "sess_abc123",
      "session_status": "active",
      "response": {
        "message": "Hi Jane! I found DL632 departing at 6:15 AM next Tuesday. Great news—as a SkyMiles Gold member, you qualify for our free Premium Economy upgrade on this flight.",
        "ui_elements": [
          {
            "type": "product_card",
            "data": {
              "title": "DL632 to Boston - Tue Jan 27",
              "subtitle": "6:15 AM → 9:42 AM (3h 27m)",
              "price": "$199",
              "badge": "Free Premium Economy Upgrade",
              "image_url": "https://delta.com/images/premium-economy.jpg",
              "cta": {
                "label": "Book with Upgrade",
                "action": "checkout"
              }
            }
          }
        ]
      },
      "negotiated_capabilities": {
        "modalities": {
          "conversational": true,
          "voice": true
        },
        "components": {
          "standard": [
            "text",
            "link",
            "image",
            "product_card",
            "carousel",
            "action_button"
          ]
        },
        "commerce": {
          "acp_checkout": true
        }
      }
    }
  ]
}
