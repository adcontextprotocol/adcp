{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/schemas/sponsored-intelligence/si-get-offering-response.json",
  "title": "SI Get Offering Response",
  "description": "Offering details, availability status, and optionally matching products. Use the offering_token in si_initiate_session for correlation.",
  "type": "object",
  "allOf": [
    {
      "$ref": "/schemas/core/version-envelope.json"
    },
    {
      "$ref": "/schemas/core/protocol-envelope.json"
    }
  ],
  "x-status": "experimental",
  "properties": {
    "available": {
      "type": "boolean",
      "description": "Whether the offering is currently available"
    },
    "offering_token": {
      "type": "string",
      "maxLength": 4096,
      "description": "Token to pass to si_initiate_session for session continuity. Brand stores the full query context server-side (products shown, order, context) so they can resolve references like 'the second one' when the session starts."
    },
    "ttl_seconds": {
      "type": "integer",
      "minimum": 0,
      "description": "How long this offering information is valid (seconds). Host should re-fetch after TTL expires."
    },
    "checked_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this offering information was retrieved"
    },
    "offering": {
      "type": "object",
      "description": "Offering details",
      "properties": {
        "offering_id": {
          "type": "string",
          "maxLength": 255,
          "description": "Offering identifier",
          "x-entity": "offering"
        },
        "title": {
          "type": "string",
          "maxLength": 2000,
          "description": "Offering title"
        },
        "summary": {
          "type": "string",
          "maxLength": 2000,
          "description": "Brief summary of the offering"
        },
        "tagline": {
          "type": "string",
          "maxLength": 255,
          "description": "Short promotional tagline"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "description": "When this offering expires"
        },
        "availability_status": {
          "$ref": "/schemas/enums/offering-availability-status.json",
          "description": "Machine-readable availability state for the offering. Optional; when omitted, derive availability from the top-level 'available' boolean and 'unavailable_reason'."
        },
        "price_hint": {
          "type": "string",
          "maxLength": 64,
          "description": "Price indication (e.g., 'from $199', '50% off')"
        },
        "image_url": {
          "type": "string",
          "format": "uri",
          "description": "Hero image for the offering"
        },
        "landing_url": {
          "type": "string",
          "format": "uri",
          "description": "Landing page URL"
        }
      },
      "additionalProperties": true
    },
    "matching_products": {
      "type": "array",
      "maxItems": 100,
      "description": "Products matching the request context. Only included if include_products was true.",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string",
            "maxLength": 255,
            "description": "Product identifier",
            "x-entity": "product"
          },
          "name": {
            "type": "string",
            "maxLength": 255,
            "description": "Product name"
          },
          "price": {
            "type": "string",
            "maxLength": 64,
            "description": "Display price (e.g., '$129', '$89.99')"
          },
          "original_price": {
            "type": "string",
            "maxLength": 64,
            "description": "Original price if on sale"
          },
          "image_url": {
            "type": "string",
            "format": "uri",
            "description": "Product image"
          },
          "availability_summary": {
            "type": "string",
            "maxLength": 2000,
            "description": "Brief availability info (e.g., 'In stock', 'Size 14 available', '3 left')"
          },
          "availability_status": {
            "$ref": "/schemas/enums/offering-availability-status.json",
            "description": "Machine-readable availability state for this product. Structured counterpart to availability_summary."
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Product detail page URL"
          }
        },
        "required": [
          "product_id",
          "name"
        ],
        "additionalProperties": true
      }
    },
    "sponsored_context": {
      "$ref": "/schemas/sponsored-intelligence/si-sponsored-context.json",
      "description": "Declaration for the sponsored context carried by this offering response. When present, it applies to the returned offering and matching_products package as a whole unless a future extension narrows the declaration to individual items. Hosts MUST either honor the declared context_use and disclosure_obligation or reject the context before using it."
    },
    "total_matching": {
      "type": "integer",
      "minimum": 0,
      "description": "Total number of products matching the context (may be more than returned in matching_products)"
    },
    "unavailable_reason": {
      "type": "string",
      "maxLength": 2000,
      "description": "If not available, why (e.g., 'expired', 'sold_out', 'region_restricted')"
    },
    "alternative_offering_ids": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "string",
        "maxLength": 255,
        "x-entity": "offering"
      },
      "description": "Alternative offerings to consider if this one is unavailable"
    },
    "errors": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "/schemas/core/error.json"
      },
      "description": "Errors during offering lookup"
    },
    "context": {
      "$ref": "/schemas/core/context.json"
    },
    "ext": {
      "$ref": "/schemas/core/ext.json"
    }
  },
  "required": [
    "available"
  ],
  "additionalProperties": true
}
