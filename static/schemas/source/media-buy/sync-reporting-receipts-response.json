{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/schemas/media-buy/sync-reporting-receipts-response.json",
  "title": "Sync Reporting Receipts Response",
  "x-status": "experimental",
  "description": "Per-receipt durable recording results for revisions and post-official adjustments. Successful readback lets a consumer prove the seller recorded its reconciliation outcome; failed results expose no cross-caller or cross-account resource metadata.",
  "type": "object",
  "allOf": [
    { "$ref": "/schemas/core/protocol-envelope.json" }
  ],
  "properties": {
    "status": { "type": "string", "const": "completed", "description": "Receipt batches complete synchronously with one result per submitted receipt." },
    "results": {
      "type": "array",
      "items": {
        "description": "A result carries a receipt or an adjustment receipt, never both, and a failed result carries neither.",
        "$ref": "#/definitions/receipt_result"
      },
      "minItems": 1,
      "maxItems": 100
    },
    "context": { "$ref": "/schemas/core/context.json" },
    "ext": { "$ref": "/schemas/core/ext.json" }
  },
  "required": ["status", "results"],
  "additionalProperties": true,
  "definitions": {
    "received_receipt": {
      "description": "A reporting receipt that states when the seller received it.",
      "allOf": [
        {
          "$ref": "/schemas/core/reporting-receipt.json"
        },
        {
          "required": [
            "received_at"
          ]
        }
      ]
    },
    "received_adjustment_receipt": {
      "description": "A reporting adjustment receipt that states when the seller received it.",
      "allOf": [
        {
          "$ref": "/schemas/core/reporting-adjustment-receipt.json"
        },
        {
          "required": [
            "received_at"
          ]
        }
      ]
    },
    "receipt_result": {
      "anyOf": [
        {
          "title": "Recorded reporting receipt",
          "type": "object",
          "properties": {
            "result": {
              "type": "string",
              "const": "recorded",
              "default": "recorded"
            },
            "receipt": {
              "$ref": "#/definitions/received_receipt"
            }
          },
          "required": [
            "result",
            "receipt"
          ],
          "not": {
            "required": [
              "adjustment_receipt"
            ]
          },
          "additionalProperties": true
        },
        {
          "title": "Unchanged reporting receipt",
          "type": "object",
          "properties": {
            "result": {
              "type": "string",
              "const": "unchanged",
              "default": "unchanged"
            },
            "receipt": {
              "$ref": "#/definitions/received_receipt"
            }
          },
          "required": [
            "result",
            "receipt"
          ],
          "not": {
            "required": [
              "adjustment_receipt"
            ]
          },
          "additionalProperties": true
        },
        {
          "title": "Recorded reporting adjustment receipt",
          "type": "object",
          "properties": {
            "result": {
              "type": "string",
              "const": "recorded",
              "default": "recorded"
            },
            "adjustment_receipt": {
              "$ref": "#/definitions/received_adjustment_receipt"
            }
          },
          "required": [
            "result",
            "adjustment_receipt"
          ],
          "not": {
            "required": [
              "receipt"
            ]
          },
          "additionalProperties": true
        },
        {
          "title": "Unchanged reporting adjustment receipt",
          "type": "object",
          "properties": {
            "result": {
              "type": "string",
              "const": "unchanged",
              "default": "unchanged"
            },
            "adjustment_receipt": {
              "$ref": "#/definitions/received_adjustment_receipt"
            }
          },
          "required": [
            "result",
            "adjustment_receipt"
          ],
          "not": {
            "required": [
              "receipt"
            ]
          },
          "additionalProperties": true
        },
        {
          "title": "Failed reporting receipt",
          "type": "object",
          "properties": {
            "result": {
              "type": "string",
              "const": "failed",
              "default": "failed"
            },
            "reporting_receipt_id": {
              "$ref": "/schemas/core/reporting-receipt-id.json"
            },
            "errors": {
              "type": "array",
              "items": {
                "$ref": "/schemas/core/error.json"
              },
              "minItems": 1,
              "maxItems": 16
            }
          },
          "required": [
            "result",
            "reporting_receipt_id",
            "errors"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "receipt"
                ]
              },
              {
                "required": [
                  "adjustment_receipt"
                ]
              }
            ]
          },
          "additionalProperties": true
        }
      ]
    }
  }
}
