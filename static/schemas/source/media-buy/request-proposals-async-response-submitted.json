{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/schemas/media-buy/request-proposals-async-response-submitted.json",
  "title": "Request Proposals - Submitted",
  "description": "Bounded submitted task envelope for request_proposals when consultative planning requires upstream queries or human review.",
  "allOf": [
    { "$ref": "/schemas/core/compact-task-submitted.json" }
  ],
  "properties": {
    "outcome": {
      "$ref": "/schemas/media-buy/request-proposals-response.json#/properties/outcome"
    },
    "reason": {
      "$ref": "/schemas/media-buy/request-proposals-response.json#/properties/reason"
    },
    "suggestions": {
      "$ref": "/schemas/media-buy/request-proposals-response.json#/properties/suggestions"
    },
    "proposals": {
      "$ref": "/schemas/media-buy/request-proposals-response.json#/properties/proposals"
    },
    "products": {
      "$ref": "/schemas/media-buy/request-proposals-response.json#/properties/products"
    },
    "collections": {
      "$ref": "/schemas/media-buy/request-proposals-response.json#/properties/collections"
    },
    "incomplete": {
      "$ref": "/schemas/media-buy/request-proposals-response.json#/properties/incomplete"
    },
    "purchase_continuation": {
      "$ref": "/schemas/media-buy/request-proposals-response.json#/properties/purchase_continuation"
    },
    "targeting_resolution": {
      "$ref": "/schemas/media-buy/request-proposals-response.json#/properties/targeting_resolution"
    },
    "later_proposals": {
      "$ref": "/schemas/media-buy/request-proposals-response.json#/properties/later_proposals"
    }
  },
  "dependencies": { "collections": ["products"] },
  "not": {
    "anyOf": [
      { "required": ["refinement_applied"] },
      { "required": ["pagination"] },
      { "required": ["unchanged"] },
      { "required": ["wholesale_feed_version"] },
      { "required": ["feed_version"] },
      { "required": ["pricing_version"] }
    ]
  }
}
