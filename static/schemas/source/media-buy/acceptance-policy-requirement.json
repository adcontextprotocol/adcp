{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/schemas/media-buy/acceptance-policy-requirement.json",
  "title": "Acceptance Policy Requirement",
  "description": "A typed prerequisite or restriction attached to a conditional seller-acceptance rule. The kind is coarse and machine-actionable; exact obligations remain in the referenced registry policies.",
  "type": "object",
  "discriminator": { "propertyName": "kind" },
  "oneOf": [
    {
      "properties": {
        "kind": { "type": "string", "const": "category_declaration" },
        "declaration": { "type": "string", "minLength": 1 },
        "description": { "$ref": "#/definitions/requirement_description" }
      },
      "required": ["kind"],
      "additionalProperties": false
    },
    {
      "properties": {
        "kind": { "type": "string", "const": "advertiser_verification" },
        "verification_scheme": { "type": "string", "minLength": 1 },
        "description": { "$ref": "#/definitions/requirement_description" }
      },
      "required": ["kind"],
      "additionalProperties": false
    },
    {
      "properties": {
        "kind": { "type": "string", "const": "advertiser_eligibility" },
        "criteria": {
          "type": "array",
          "items": { "$ref": "#/definitions/criterion_id" },
          "minItems": 1,
          "uniqueItems": true,
          "description": "Stable criteria such as domestic_entity, citizen_or_resident, official_election_authority, or eligible_agency."
        },
        "description": { "$ref": "#/definitions/requirement_description" }
      },
      "required": ["kind", "criteria"],
      "additionalProperties": false
    },
    {
      "properties": {
        "kind": { "type": "string", "const": "funding_restriction" },
        "criteria": {
          "type": "array",
          "items": { "$ref": "#/definitions/criterion_id" },
          "minItems": 1,
          "uniqueItems": true,
          "description": "Stable restrictions such as no_foreign_funding or sponsor_identity_required."
        },
        "description": { "$ref": "#/definitions/requirement_description" }
      },
      "required": ["kind", "criteria"],
      "additionalProperties": false
    },
    {
      "properties": {
        "kind": { "type": "string", "const": "certification" },
        "credential": { "$ref": "#/definitions/required_credential" },
        "description": { "$ref": "#/definitions/requirement_description" }
      },
      "required": ["kind"],
      "additionalProperties": false
    },
    {
      "properties": {
        "kind": { "type": "string", "const": "license" },
        "credential": { "$ref": "#/definitions/required_credential" },
        "description": { "$ref": "#/definitions/requirement_description" }
      },
      "required": ["kind"],
      "additionalProperties": false
    },
    {
      "properties": {
        "kind": { "type": "string", "const": "prior_authorization" },
        "description": { "$ref": "#/definitions/requirement_description" }
      },
      "required": ["kind"],
      "additionalProperties": false
    },
    {
      "properties": {
        "kind": { "type": "string", "const": "account_setup" },
        "description": { "$ref": "#/definitions/requirement_description" }
      },
      "required": ["kind"],
      "additionalProperties": false
    },
    {
      "properties": {
        "kind": { "type": "string", "const": "sales_assisted" },
        "description": { "$ref": "#/definitions/requirement_description" }
      },
      "required": ["kind"],
      "additionalProperties": false
    },
    {
      "properties": {
        "kind": { "type": "string", "const": "disclosure" },
        "format": { "type": "string", "minLength": 1 },
        "placement": { "type": "string", "minLength": 1 },
        "description": { "$ref": "#/definitions/requirement_description" }
      },
      "required": ["kind"],
      "additionalProperties": false
    },
    {
      "properties": {
        "kind": { "type": "string", "const": "targeting_restriction" },
        "restricted_attributes": {
          "type": "array",
          "items": { "$ref": "/schemas/enums/restricted-attribute.json" },
          "minItems": 1,
          "uniqueItems": true
        },
        "description": { "$ref": "#/definitions/requirement_description" }
      },
      "required": ["kind"],
      "additionalProperties": false
    },
    {
      "properties": {
        "kind": { "type": "string", "const": "creative_restriction" },
        "description": { "$ref": "#/definitions/requirement_description" }
      },
      "required": ["kind", "description"],
      "additionalProperties": false
    },
    {
      "properties": {
        "kind": { "type": "string", "const": "destination_restriction" },
        "description": { "$ref": "#/definitions/requirement_description" }
      },
      "required": ["kind", "description"],
      "additionalProperties": false
    },
    {
      "properties": {
        "kind": { "type": "string", "const": "format_restriction" },
        "format_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true,
          "deprecated": true,
          "x-deprecated-in": "3.2.0",
          "x-removed-in": "4.0.0",
          "description": "Deprecated in AdCP 3.2 and removed in AdCP 4.0. This named-format restriction is retained for 3.x compatibility; new policies identify canonical format options in description or an extension until a registry-stable format-option identity is standardized."
        },
        "description": { "$ref": "#/definitions/requirement_description" }
      },
      "required": ["kind"],
      "additionalProperties": false
    },
    {
      "properties": {
        "kind": { "type": "string", "const": "time_restriction" },
        "starts_at": { "type": "string", "format": "date-time" },
        "ends_at": { "type": "string", "format": "date-time" },
        "description": { "$ref": "#/definitions/requirement_description" }
      },
      "required": ["kind"],
      "additionalProperties": false
    },
    {
      "properties": {
        "kind": { "type": "string", "const": "transparency_reporting" },
        "description": { "$ref": "#/definitions/requirement_description" }
      },
      "required": ["kind"],
      "additionalProperties": false
    },
    {
      "properties": {
        "kind": { "type": "string", "const": "custom" },
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_.:-]*$" },
        "description": { "$ref": "#/definitions/requirement_description" },
        "ext": { "$ref": "/schemas/core/ext.json" }
      },
      "required": ["kind", "id", "description"],
      "additionalProperties": false
    }
  ],
  "definitions": {
    "criterion_id": {
      "title": "Acceptance Criterion ID",
      "description": "Stable identifier of an acceptance criterion, such as domestic_entity or eligible_agency.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:-]*$"
    },
    "requirement_description": {
      "title": "Requirement Description",
      "description": "Human-readable description of one acceptance-policy requirement.",
      "type": "string",
      "minLength": 1
    },
    "required_credential": {
      "title": "Required Credential",
      "description": "Name of the certification or license that an acceptance-policy requirement demands.",
      "type": "string",
      "minLength": 1
    }
  }
}
