{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/schemas/media-buy/report-media-buy-issue-response.json",
  "title": "Report Media Buy Issue Response",
  "x-added-in": "3.3.0",
  "description": "Stored issue snapshot or terminal task error, never both. The issue status is a domain lifecycle distinct from completion of the reporting/read task.",
  "type": "object",
  "allOf": [
    { "$ref": "/schemas/core/protocol-envelope.json" }
  ],
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "outcome": {
          "type": "string",
          "const": "recorded"
        },
        "issue": {
          "$ref": "/schemas/core/media-buy-issue.json"
        },
        "context": {
          "$ref": "/schemas/core/context.json"
        },
        "ext": {
          "$ref": "/schemas/core/ext.json"
        }
      },
      "required": [
        "outcome",
        "issue"
      ],
      "additionalProperties": true,
      "not": { "required": ["errors"] }
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "type": "string",
          "const": "failed"
        },
        "errors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "/schemas/core/error.json"
          }
        },
        "context": {
          "$ref": "/schemas/core/context.json"
        },
        "ext": {
          "$ref": "/schemas/core/ext.json"
        }
      },
      "required": [
        "outcome",
        "errors"
      ],
      "additionalProperties": true,
      "not": { "required": ["issue"] }
    }
  ],
  "discriminator": {
    "propertyName": "outcome"
  },
  "examples": [
    {
      "status": "completed",
      "outcome": "recorded",
      "issue": {
        "issue_id": "issue_123",
        "media_buy_id": "media_buy_789",
        "package_id": "package_video",
        "severity": "critical",
        "category": "tracking",
        "description": "An unapproved tracker is firing on the package. Please disable it at the seller ad server.",
        "status": "reported",
        "received_at": "2027-01-11T20:00:00Z"
      }
    }
  ]
}
