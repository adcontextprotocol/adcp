{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/schemas/media-buy/refine-proposals-response.json",
  "title": "Refine Proposals Response",
  "description": "One ordered result per requested source proposal. Revision results may carry multiple immutable draft proposals when alternatives were requested; finalization and hold extension each return one committed proposal per source. Products contains the compact canonical products needed to evaluate the resulting terms.",
  "type": "object",
  "allOf": [
    { "$ref": "/schemas/core/protocol-envelope.json" }
  ],
  "anyOf": [
    {
      "properties": { "status": { "type": "string", "const": "completed" } },
      "required": ["results", "products"],
      "not": {
        "anyOf": [
          { "required": ["task_id"] },
          { "required": ["expected_confirmation_at"] }
        ]
      }
    },
    {
      "$ref": "/schemas/core/compact-task-submitted.json"
    }
  ],
  "properties": {
    "results": {
      "type": "array",
      "description": "Results in the request's refinements[] order; position carries no ranking. If any result is finalized, every result MUST be finalized; under inventory_hold semantics a finalize batch either creates every requested hold or none, and under terms_only semantics (get_adcp_capabilities media_buy.proposal_refinement.hold_semantics, or a draft hold_policy with available false) it commits every requested proposal's terms or none, with no inventory hold placed for those entries. An extend_hold batch either extends every requested hold or none. Every returned proposal carries parent_proposal_id equal to the result's source_proposal_id, making negotiation lineage reconstructible from the proposals alone.",
      "minItems": 1,
      "items": {
        "type": "object",
        "discriminator": {
          "propertyName": "outcome"
        },
        "properties": {
          "source_proposal_id": {
            "type": "string",
            "minLength": 1,
            "x-entity": "proposal"
          },
          "outcome": {
            "type": "string",
            "enum": ["revised", "partial", "finalized", "unable"],
            "description": "finalized also reports a successful extend_hold: the proposal is the new committed successor whose parent_proposal_id is the extended source and whose expires_at is the later deadline."
          },
          "proposal": { "$ref": "/schemas/core/canonical-proposal.json" },
          "proposals": {
            "type": "array",
            "items": { "$ref": "/schemas/core/canonical-proposal.json" },
            "minItems": 1,
            "description": "Draft successors produced for a revision. Without alternatives this contains one proposal. With alternatives.count, revised contains exactly that many proposals with unique terms_digest values; fewer or commercially duplicate proposals require partial."
          },
          "reason_code": {
            "$ref": "/schemas/enums/proposal-refinement-reason.json",
            "description": "Single most-significant code for this result. constraint_unsatisfiable takes precedence over every other code; an alternatives shortfall alongside an unsatisfied constraint remains visible through proposals.length."
          },
          "reason": { "type": "string", "minLength": 1 },
          "unsatisfied_constraints": {
            "type": "array",
            "description": "Stable keys from the request constraints object that were not satisfied by every returned draft. A result carrying any key here MUST use outcome partial or unable, never revised.",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1,
            "uniqueItems": true
          },
          "unsatisfied_product_changes": {
            "allOf": [{ "$ref": "/schemas/core/product-change-map.json" }],
            "description": "Requested product actions not satisfied by every returned draft. This is a subset of the request product_changes map and is valid only on partial or unable results."
          },
          "unsatisfied_installment_changes": {
            "type": "array",
            "x-status": "experimental",
            "x-added-in": "3.3.0",
            "description": "Experimental (media_buy.installment_refinement). Requested installment actions not satisfied by every returned draft. Each entry repeats a request installment_changes entry exactly and adds the reason it was not satisfied. It is a subset of the request list and is valid only on partial or unable results, whose reason_code is constraint_unsatisfiable. Every draft on a partial result satisfies every entry absent from this list.",
            "items": {
              "allOf": [{ "$ref": "/schemas/core/installment-change.json" }],
              "properties": {
                "reason": { "type": "string", "minLength": 1, "maxLength": 1024, "description": "Why the seller did not satisfy this entry, for example that the installment is sold, held for another buyer, past its booking deadline, or sold only with others." }
              },
              "required": ["reason"]
            },
            "minItems": 1,
            "maxItems": 500
          },
          "suggestions": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1
          },
          "targeting_resolution": {
            "$ref": "/schemas/media-buy/get-products-targeting-resolution.json",
            "description": "Confirmation of structured targeting interpreted from this refinement's explicit hard prose instructions. Required when that interpretation materially affects the revised proposal's eligibility, pricing, or forecast; otherwise a best practice."
          }
        },
        "required": ["source_proposal_id", "outcome"],
        "oneOf": [
          {
            "properties": {
              "outcome": { "type": "string", "const": "revised" },
              "proposals": {
                "items": {
                  "properties": { "proposal_status": { "type": "string", "const": "draft" } },
                  "required": ["proposal_status", "parent_proposal_id"]
                }
              }
            },
            "required": ["outcome", "proposals"],
            "not": {
              "anyOf": [
                { "required": ["proposal"] },
                { "required": ["reason_code"] },
                { "required": ["reason"] },
                { "required": ["unsatisfied_constraints"] },
                { "required": ["unsatisfied_product_changes"] },
                { "required": ["unsatisfied_installment_changes"] }
              ]
            }
          },
          {
            "properties": {
              "outcome": { "type": "string", "const": "partial" },
              "proposals": {
                "items": {
                  "properties": { "proposal_status": { "type": "string", "const": "draft" } },
                  "required": ["proposal_status", "parent_proposal_id"]
                }
              }
            },
            "required": ["outcome", "proposals", "reason_code", "reason"],
            "not": { "required": ["proposal"] }
          },
          {
            "properties": {
              "outcome": { "type": "string", "const": "finalized" },
              "proposal": {
                "properties": {
                  "proposal_status": { "type": "string", "const": "committed" },
                  "expires_at": { "type": "string", "format": "date-time" }
                },
                "required": ["proposal_status", "expires_at", "parent_proposal_id"]
              }
            },
            "required": ["outcome", "proposal"],
            "not": {
              "anyOf": [
                { "required": ["proposals"] },
                { "required": ["reason_code"] },
                { "required": ["reason"] },
                { "required": ["unsatisfied_constraints"] },
                { "required": ["unsatisfied_product_changes"] },
                { "required": ["unsatisfied_installment_changes"] }
              ]
            }
          },
          {
            "properties": { "outcome": { "type": "string", "const": "unable" } },
            "required": ["outcome", "reason_code", "reason"],
            "not": {
              "anyOf": [
                { "required": ["proposal"] },
                { "required": ["proposals"] }
              ]
            }
          }
        ],
        "allOf": [
          {
            "if": {
              "properties": { "reason_code": { "const": "constraint_unsatisfiable" } },
              "required": ["reason_code"]
            },
            "then": {
              "anyOf": [
                { "required": ["unsatisfied_constraints"] },
                { "required": ["unsatisfied_product_changes"] },
                { "required": ["unsatisfied_installment_changes"] }
              ]
            }
          }
        ],
        "additionalProperties": true
      },
      "allOf": [
        {
          "if": {
            "contains": {
              "properties": { "outcome": { "type": "string", "const": "finalized" } },
              "required": ["outcome"]
            }
          },
          "then": {
            "items": {
              "properties": { "outcome": { "type": "string", "const": "finalized" } },
              "required": ["outcome"]
            }
          }
        }
      ]
    },
    "products": {
      "type": "array",
      "description": "Canonical products needed to evaluate the resulting terms. For revised or partial results whose effective criteria contain property or collection lists, each affected product MUST carry fresh list_applications receipts from the revision's product reevaluation. Finalization changes no terms and MAY repeat the receipts already bound to the source proposal rather than reevaluating them.",
      "items": { "$ref": "/schemas/core/canonical-product.json" }
    },
    "collections": {
      "type": "array",
      "description": "Experimental (media_buy.collection_cards). Full collection objects for collections referenced by the collections selectors of the returned products. Sellers MUST NOT return this array unless the request set include_collections to true; when it is set, sellers SHOULD include every referenced collection and MUST NOT include one that no returned product references. At most one entry per (publisher_domain, collection_id). If a key appears more than once, that collection is unresolvable from this response; buyers fall back to the publisher's adagents.json, as they do for an omitted collection, and ignore entries that no returned product references. These are convenience copies, never authorization evidence: a copy wins over adagents.json only on images, sample_content, url, description, season, cadence and distribution[].followers (see core/response-collection.json). Present only alongside products.",
      "minItems": 1,
      "items": { "$ref": "/schemas/core/response-collection.json" },
      "x-status": "experimental",
      "x-added-in": "3.3.0"
    },
    "expected_confirmation_at": {
      "type": "string",
      "format": "date-time",
      "x-added-in": "3.3.0",
      "description": "Optional estimate, on a submitted response to a finalize-only or extend_hold-only request, of when the seller expects to resolve the finalize or extension, for example when a creator, host or talent must agree before the hold or its extension. Same semantics as on `create_media_buy`: an estimate, not a commitment or expiry; buyers SHOULD schedule a status check for it and MUST NOT treat a passed timestamp as failure. Sellers SHOULD NOT send it on revise requests."
    },
    "errors": { "type": "array", "items": { "$ref": "/schemas/core/error.json" } },
    "context": { "$ref": "/schemas/core/context.json" },
    "ext": { "$ref": "/schemas/core/ext.json" }
  },
  "dependencies": {
    "collections": ["products"]
  },
  "not": {
    "anyOf": [
      { "required": ["proposals"] },
      { "required": ["refinement_applied"] },
      { "required": ["pagination"] }
    ]
  },
  "additionalProperties": true,
  "examples": [
