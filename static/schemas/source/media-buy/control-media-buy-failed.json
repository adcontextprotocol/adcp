{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/schemas/media-buy/control-media-buy-failed.json",
  "title": "Control Media Buy - Failed",
  "description": "Body of a failed control_media_buy response: at least one error, and no media buy or warnings.",
  "type": "object",
  "allOf": [
    { "$ref": "/schemas/core/task-error.json" }
  ],
  "additionalProperties": true,
  "not": {
    "anyOf": [
      {
        "required": ["media_buy_id"]
      },
      {
        "required": ["warnings"]
      }
    ]
  }
}
