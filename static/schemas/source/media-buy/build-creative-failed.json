{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/schemas/media-buy/build-creative-failed.json",
  "title": "BuildCreativeError",
  "description": "Body of a failed build_creative response: operation-level errors, and none of the success fields. The completed body also admits this body.",
  "type": "object",
  "allOf": [
    { "$ref": "/schemas/core/task-error.json" }
  ],
  "additionalProperties": true,
  "not": {
    "anyOf": [
      {
        "required": ["creative_manifest"]
      },
      {
        "required": ["creative_manifests"]
      },
      {
        "required": ["creatives"]
      },
      {
        "required": ["estimate"]
      }
    ]
  }
}
