{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/schemas/media-buy/log-event-failed.json",
  "title": "LogEventError",
  "description": "Body of a failed log_event response: operation-level errors, and none of the success fields. The completed body also admits this body.",
  "type": "object",
  "allOf": [
    { "$ref": "/schemas/core/task-error.json" }
  ],
  "additionalProperties": true,
  "not": {
    "anyOf": [
      {
        "required": ["events_received"]
      },
      {
        "required": ["events_processed"]
      },
      {
        "required": ["sandbox"]
      }
    ]
  }
}
