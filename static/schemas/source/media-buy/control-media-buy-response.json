{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/schemas/media-buy/control-media-buy-response.json",
  "title": "Control Media Buy Response",
  "description": "Result of applying operational controls without embedding the package or creative object graphs.",
  "type": "object",
  "allOf": [
    { "$ref": "/schemas/core/protocol-envelope.json" }
  ],
  "discriminator": {
    "propertyName": "status"
  },
  "oneOf": [
    {
      "title": "Control Applied",
      "type": "object",
      "properties": {
        "status": { "type": "string", "const": "completed", "default": "completed" },
        "media_buy_id": { "$ref": "/schemas/core/media-buy-id.json" },
        "revision": { "type": "integer", "minimum": 1 },
        "media_buy_status": { "$ref": "/schemas/enums/media-buy-status.json" },
        "implementation_date": { "type": ["string", "null"], "format": "date-time" },
        "affected_package_ids": {
          "type": "array",
          "items": { "$ref": "/schemas/core/package-id.json" },
          "uniqueItems": true
        },
        "available_actions": {
          "type": "array",
          "items": { "$ref": "/schemas/core/canonical-media-buy-action.json" },
          "uniqueItems": true
        },
        "warnings": {
          "type": "array",
          "description": "Non-blocking observations about this completed control. The control was still applied exactly as represented. Continuing conditions also appear as indicators on get_media_buys.",
          "items": {
            "allOf": [
              { "$ref": "/schemas/core/warning.json" },
              {
                "properties": {
                  "code": { "const": "inventory_shortfall_forecast" }
                }
              }
            ]
          },
          "minItems": 1
        },
        "context": { "$ref": "/schemas/core/context.json" },
        "ext": { "$ref": "/schemas/core/ext.json" }
      },
      "required": ["status", "media_buy_id", "revision"],
      "additionalProperties": true,
      "not": { "required": ["errors"] }
    },
    {
      "$ref": "/schemas/core/media-buy-failed-result.json"
    },
    {
      "$ref": "/schemas/core/task-submitted-response.json",
      "title": "Control Submitted"
    }
  ]
}
