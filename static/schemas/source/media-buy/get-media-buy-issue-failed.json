{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/schemas/media-buy/get-media-buy-issue-failed.json",
  "title": "Get Media Buy Issue - Failed",
  "description": "Body of a failed get_media_buy_issue response: outcome failed and at least one error. The completed body also admits this body.",
  "type": "object",
  "allOf": [
    { "$ref": "/schemas/core/protocol-envelope.json" }
  ],
  "properties": {
    "outcome": {
      "type": "string",
      "const": "failed"
    },
    "errors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "/schemas/core/error.json"
      }
    },
    "ext": {
      "$ref": "/schemas/core/ext.json"
    }
  },
  "required": [
    "outcome",
    "errors"
  ],
  "additionalProperties": true,
  "not": { "required": ["issue"] }
}
