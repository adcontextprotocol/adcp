{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/schemas/media-buy/refine-proposals-request.json",
  "title": "Refine Proposals Request",
  "description": "Create draft revisions, finalize draft proposals into held committed snapshots, or extend committed holds into new committed snapshots. Each result receives a new proposal_id and every source remains unchanged.",
  "x-tool-summary": "Revise draft proposals, finalize them into committed, inventory-held snapshots, or extend a committed hold.",
  "type": "object",
  "allOf": [{ "$ref": "/schemas/core/version-envelope.json" }],
  "x-mutates-state": true,
  "x-operation-family": "refine_proposals",
  "x-added-in": "3.2.0",
  "x-legacy-fallback": { "tool": "get_products", "mode": "orchestrated" },
  "properties": {
    "adcp_version": { "$ref": "/schemas/core/version-envelope.json#/properties/adcp_version" },
    "adcp_major_version": { "$ref": "/schemas/core/version-envelope.json#/properties/adcp_major_version" },
    "context_id": {
      "type": "string",
      "minLength": 1,
      "description": "MCP compatibility field: servers ignore this value; A2A uses transport-native Message/Task contextId."
    },
    "context": {
      "allOf": [{ "$ref": "/schemas/core/context.json" }],
      "x-adcp-schema-uri": "/schemas/core/context.json"
    },
    "governance_context": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "push_notification_config": {
      "allOf": [{ "$ref": "/schemas/core/push-notification-config.json" }],
      "x-adcp-schema-uri": "/schemas/core/push-notification-config.json"
    },
    "idempotency_key": {
      "type": "string",
      "description": "Client-generated key required for retry-safe proposal refinement.",
      "minLength": 16,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9_.:-]{16,255}$"
    },
    "refinements": {
      "type": "array",
      "description": "Proposal operations to apply, with at most 25 entries per request. revise creates a draft successor from a draft, committed, or accepted source. finalize MUST target a draft, reserves inventory, and creates a committed successor whose expires_at is the hold deadline. A batch containing finalize MUST contain only finalize entries and is atomic. extend_hold (experimental, media_buy.hold_extension) MUST target a committed, unexpired proposal that holds inventory and creates a committed successor with a later expires_at; a batch containing extend_hold MUST contain only extend_hold entries and is atomic. proposal_id values MUST be unique; results preserve request order.",
      "items": { "$ref": "/schemas/media-buy/proposal-refinement.json" },
      "minItems": 1,
      "maxItems": 25,
      "uniqueItems": true,
      "allOf": [
        {
          "if": {
            "contains": {
              "properties": { "action": { "type": "string", "const": "finalize" } },
              "required": ["action"]
            }
          },
          "then": {
            "items": {
              "properties": { "action": { "type": "string", "const": "finalize" } },
              "required": ["action"]
            }
          }
        },
        {
          "if": {
            "contains": {
              "properties": { "action": { "type": "string", "const": "extend_hold" } },
              "required": ["action"]
            }
          },
          "then": {
            "items": {
              "properties": { "action": { "type": "string", "const": "extend_hold" } },
              "required": ["action"]
            }
          }
        }
      ]
    },
    "include_collections": {
      "type": "boolean",
      "default": false,
      "description": "Experimental (media_buy.collection_cards). When true, asks the seller to return the response-level collections array: the full object for each collection the returned products' collections selectors reference. Sellers MUST NOT return collections unless this is true, and when it is true they SHOULD include every referenced collection. The 3.2 schema of this request rejects unknown fields, so a seller validating against it rejects the flag; send it only to a seller that lists media_buy.collection_cards in experimental_features. Buyers detect omitted collections by comparing product selectors with the returned array and resolve those from the publisher's adagents.json.",
      "x-status": "experimental",
      "x-added-in": "3.3.0"
    }
  },
  "required": ["idempotency_key", "refinements"],
  "additionalProperties": true,
  "examples": [
    {
      "idempotency_key": "typed-negotiation-sam-0001",
      "refinements": [
        {
          "proposal_id": "proposal_streamhaus_001",
          "action": "revise",
          "constraints": {
            "total_budget": {
              "max": 50000,
              "currency": "USD"
            },
            "cpm": {
              "max": 18,
              "currency": "USD"
            },
            "flight": {
              "end_no_earlier_than": "2026-10-31T23:59:59Z"
            }
          },
          "product_changes": {
            "premium_video_q4": "include",
            "display_standard_q4": "omit"
          },
          "criteria": {
            "targeting_overlay": {
              "geo_countries": [
                "US",
                "CA"
              ]
            }
          },
          "alternatives": {
            "count": 3
          },
          "ask": "Use materially different mixes and prioritize reach."
        }
      ]
    },
    {
      "idempotency_key": "typed-negotiation-sam-finalize-0001",
      "refinements": [
        {
          "proposal_id": "proposal_streamhaus_002a",
          "action": "finalize"
        }
      ]
    },
    {
      "idempotency_key": "typed-negotiation-sam-amend-0001",
      "refinements": [
        {
          "proposal_id": "proposal_streamhaus_accepted_004",
          "action": "revise",
          "change_kind": "amendment",
          "ask": "Extend the flight by two weeks and preserve the total budget."
        }
      ]
    },
    {
      "idempotency_key": "typed-negotiation-sam-cancel-0001",
      "refinements": [
        {
          "proposal_id": "proposal_streamhaus_accepted_004",
          "action": "revise",
          "change_kind": "cancellation",
          "ask": "Campaign objectives were met early; request an agreed wind-down."
        }
      ]
    },
    {
      "idempotency_key": "550e8400-e29b-41d4-a716-446655441002",
      "refinements": [
        {
          "proposal_id": "proposal_123",
          "action": "revise",
          "constraints": {
            "total_budget": {
              "max": 50000,
              "currency": "USD"
            },
            "cpm": {
              "max": 18,
              "currency": "USD"
            },
            "flight": {
              "end_no_earlier_than": "2026-10-31T23:59:59Z"
            }
          },
          "product_changes": {
            "premium_video": "include",
            "display_ros": "omit"
          },
          "alternatives": {
            "count": 3
          },
          "ask": "Use materially different product mixes while preserving reach."
        },
        {
          "proposal_id": "proposal_456",
          "action": "revise",
          "criteria": {
            "targeting_overlay": {
              "geo_countries": [
                "US",
                "CA"
              ]
            }
          }
        }
      ]
    },
    {
      "idempotency_key": "550e8400-e29b-41d4-a716-446655441007",
      "refinements": [
        {
          "proposal_id": "proposal_creators_q4",
          "action": "revise",
          "installment_changes": [
            {
              "product_id": "creator_juniper_vale",
              "installment_ref": {
                "collection_ref": {
                  "publisher_domain": "availnet.example",
                  "collection_id": "juniper_vale"
                },
                "installment_id": "2026-12-10"
              },
              "action": "omit"
            }
          ]
        }
      ]
    },
    {
      "idempotency_key": "550e8400-e29b-41d4-a716-446655441003",
      "refinements": [
        {
          "proposal_id": "proposal_draft_789",
          "action": "finalize"
        }
      ]
    },
    {
      "idempotency_key": "550e8400-e29b-41d4-a716-446655441021",
      "refinements": [
        {
          "proposal_id": "prop_committed_001",
          "action": "extend_hold"
        }
      ]
    },
    {
      "idempotency_key": "550e8400-e29b-41d4-a716-446655441013",
      "refinements": [
        {
          "proposal_id": "proposal_accepted_123",
          "action": "revise",
          "change_kind": "amendment",
          "ask": "Extend the flight by two weeks and add the premium video product."
        }
      ]
    }
  ]
}
