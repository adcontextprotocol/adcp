{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/schemas/media-buy/media-buy-commitment-failed.json",
  "title": "Media Buy Commitment - Failed",
  "description": "Shared body of a failed buy_products or accept_proposal response: at least one error, and no media buy or warnings.",
  "type": "object",
  "allOf": [
    { "$ref": "/schemas/core/task-error.json" }
  ],
  "additionalProperties": true,
  "not": {
    "anyOf": [
      {
        "required": ["media_buy_id"]
      },
      {
        "required": ["warnings"]
      }
    ]
  }
}
