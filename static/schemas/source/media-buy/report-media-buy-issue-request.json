{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/schemas/media-buy/report-media-buy-issue-request.json",
  "title": "Report Media Buy Issue Request",
  "x-added-in": "3.3.0",
  "description": "Raise a seller-action report against an authorized media buy, optionally scoped to a package or creative. Completion of this task means the report was stored, not human acknowledgement or resolution. Reporting does not pause a buy or remove a creative. Requires advertised media_buy.issue_reporting and a matching available_actions entry.",
  "x-tool-summary": "Report urgent seller-side delivery, creative, safety, or tracking issues.",
  "x-mutates-state": true,
  "x-operation-family": "report_media_buy_issue",
  "x-legacy-fallback": {
    "mode": "none"
  },
  "type": "object",
  "properties": {
    "adcp_version": {
      "$ref": "/schemas/core/version-envelope.json#/properties/adcp_version"
    },
    "adcp_major_version": {
      "$ref": "/schemas/core/version-envelope.json#/properties/adcp_major_version"
    },
    "account": {
      "$ref": "/schemas/core/canonical-account-ref.json"
    },
    "media_buy_id": {
      "$ref": "/schemas/core/media-buy-id.json"
    },
    "context": {
      "$ref": "/schemas/core/context.json"
    },
    "ext": {
      "$ref": "/schemas/core/ext.json"
    },
    "idempotency_key": {
      "$ref": "/schemas/core/idempotency-key.json"
    },
    "package_id": {
      "$ref": "/schemas/core/package-id.json"
    },
    "creative_id": {
      "$ref": "/schemas/core/creative-id.json"
    },
    "severity": {
      "$ref": "/schemas/enums/media-buy-issue-severity.json"
    },
    "category": {
      "$ref": "/schemas/enums/media-buy-issue-category.json"
    },
    "description": {
      "$ref": "/schemas/core/media-buy-issue-description.json"
    },
    "governance_context": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "push_notification_config": {
      "$ref": "/schemas/core/push-notification-config.json",
      "description": "Uniform SDK envelope field. Does not subscribe to issue state changes; use get_media_buy_issue to observe acknowledgement and resolution."
    }
  },
  "required": [
    "idempotency_key",
    "account",
    "media_buy_id",
    "severity",
    "category",
    "description"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "$ref": "/schemas/core/version-envelope.json"
    }
  ]
}
