{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/schemas/media-buy/sync-event-sources-failed.json",
  "title": "SyncEventSourcesError",
  "description": "Body of a failed sync_event_sources response: operation-level errors, and none of the success fields. The completed body also admits this body.",
  "type": "object",
  "allOf": [
    { "$ref": "/schemas/core/protocol-envelope.json" }
  ],
  "properties": {
    "errors": {
      "type": "array",
      "description": "Operation-level errors that prevented processing",
      "items": {
        "$ref": "/schemas/core/error.json"
      },
      "minItems": 1
    },
    "ext": {
      "$ref": "/schemas/core/ext.json"
    }
  },
  "required": [
    "errors"
  ],
  "additionalProperties": true,
  "not": {
    "anyOf": [
      {
        "required": [
          "event_sources"
        ]
      },
      {
        "required": [
          "sandbox"
        ]
      }
    ]
  }
}
