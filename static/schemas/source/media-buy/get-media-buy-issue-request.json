{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/schemas/media-buy/get-media-buy-issue-request.json",
  "title": "Get Media Buy Issue Request",
  "x-added-in": "3.3.0",
  "description": "Read the latest seller-owned state of one issue within an authorized account and media buy. The read remains available after the buy is paused, canceled, or completed. An issue_id does not grant access.",
  "x-tool-summary": "Read the acknowledgement and resolution of a media-buy issue.",
  "x-operation-family": "get_media_buy_issue",
  "x-legacy-fallback": {
    "mode": "none"
  },
  "type": "object",
  "properties": {
    "adcp_version": {
      "$ref": "/schemas/core/version-envelope.json#/properties/adcp_version"
    },
    "adcp_major_version": {
      "$ref": "/schemas/core/version-envelope.json#/properties/adcp_major_version"
    },
    "account": {
      "$ref": "/schemas/core/canonical-account-ref.json"
    },
    "media_buy_id": {
      "type": "string",
      "maxLength": 255,
      "minLength": 1,
      "x-entity": "media_buy"
    },
    "context": {
      "$ref": "/schemas/core/context.json"
    },
    "ext": {
      "$ref": "/schemas/core/ext.json"
    },
    "issue_id": {
      "type": "string",
      "maxLength": 255,
      "minLength": 1,
      "x-entity": "media_buy_issue"
    },
    "governance_context": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "push_notification_config": {
      "$ref": "/schemas/core/push-notification-config.json",
      "description": "Uniform SDK envelope field. Does not subscribe to issue state changes; use get_media_buy_issue to observe acknowledgement and resolution."
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 16,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9_.:-]{16,255}$",
      "description": "Optional uniform read-call replay key. Does not restart a report deadline."
    }
  },
  "required": [
    "account",
    "media_buy_id",
    "issue_id"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "$ref": "/schemas/core/version-envelope.json"
    }
  ]
}
