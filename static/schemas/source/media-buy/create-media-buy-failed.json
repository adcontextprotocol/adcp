{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/schemas/media-buy/create-media-buy-failed.json",
  "title": "CreateMediaBuyError",
  "description": "Body of a failed create_media_buy response: operation-level errors, and none of the success fields. The completed body also admits this body.",
  "type": "object",
  "allOf": [
    { "$ref": "/schemas/core/task-error.json" }
  ],
  "additionalProperties": true,
  "not": {
    "anyOf": [
      {
        "required": ["media_buy_id"]
      },
      {
        "required": ["packages"]
      },
      {
        "required": ["sandbox"]
      },
      {
        "required": ["warnings"]
      }
    ]
  }
}
