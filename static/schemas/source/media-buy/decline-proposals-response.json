{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/schemas/media-buy/decline-proposals-response.json",
  "title": "Decline Proposals Response",
  "description": "One ordered terminal result for each requested proposal decline.",
  "type": "object",
  "allOf": [
    { "$ref": "/schemas/core/protocol-envelope.json" }
  ],
  "anyOf": [
    {
      "properties": { "status": { "type": "string", "const": "completed" } },
      "required": ["results"],
      "not": { "required": ["task_id"] }
    },
    {
      "$ref": "/schemas/core/compact-task-submitted.json"
    }
  ],
  "properties": {
    "results": {
      "type": "array",
      "minItems": 0,
      "description": "One result per requested decline, in request order. Empty only when the request carried an empty declines array with an opportunity update.",
      "items": {
        "type": "object",
        "discriminator": { "propertyName": "outcome" },
        "properties": {
          "proposal_id": {
            "type": "string",
            "minLength": 1,
            "x-entity": "proposal"
          },
          "outcome": {
            "type": "string",
            "enum": ["declined", "unable"]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "description": "Why the seller could not apply a decline. Present only for outcome unable."
          }
        },
        "required": ["proposal_id", "outcome"],
        "oneOf": [
          {
            "properties": { "outcome": { "const": "declined" } },
            "required": ["outcome"],
            "not": { "required": ["reason"] }
          },
          {
            "properties": { "outcome": { "const": "unable" } },
            "required": ["outcome", "reason"]
          }
        ],
        "additionalProperties": false
      }
    },
    "status": { "type": "string", "enum": ["completed", "submitted"] },
    "task_id": { "type": "string", "minLength": 1, "x-entity": "task" },
    "errors": { "type": "array", "items": { "$ref": "/schemas/core/error.json" } },
    "context": { "$ref": "/schemas/core/context.json" },
    "ext": { "$ref": "/schemas/core/ext.json" }
  },
  "additionalProperties": false
}
