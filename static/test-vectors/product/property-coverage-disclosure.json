{
  "version": 1,
  "title": "AdCP 3.3 product property coverage disclosure vectors",
  "description": "Cross-SDK vectors for Product.property_coverage.disclosure (complete | partial | undisclosed) crossed with publisher_properties cardinality and inclusion-targeting declarations. Each case applies `overrides` to `base_product` with JSON Merge Patch semantics (null deletes a key) and states whether the result is schema-valid as a legacy Product (/schemas/core/product.json) and as a compact canonical Product (/schemas/core/canonical-product.json). Absent property_coverage means complete, never undisclosed.",
  "product_schemas": ["/schemas/core/product.json", "/schemas/core/canonical-product.json"],
  "base_product": {
    "product_id": "prod_network_run_of_network",
    "name": "Run of Network Mobile",
    "description": "Run-of-network mobile app inventory",
    "publisher_properties": [{ "publisher_domain": "news.example.com", "selection_type": "all" }],
    "format_options": [{ "format_option_id": "image_300x250", "format_kind": "image", "params": { "width": 300, "height": 250 } }],
    "delivery_type": "non_guaranteed",
    "pricing_options": [{ "pricing_option_id": "cpm_floor", "pricing_model": "cpm", "currency": "USD", "floor_price": 1 }],
    "reporting_capabilities": {
      "available_reporting_frequencies": ["daily"],
      "expected_delay_minutes": 60,
      "timezone": "UTC",
      "supports_webhooks": false,
      "available_metrics": ["impressions"],
      "date_range_support": "date_range"
    }
  },
  "vectors": [
    {
      "id": "absent-coverage-is-complete",
      "description": "No property_coverage: today's behavior. A non-empty roster is required and means complete.",
      "overrides": {},
      "valid": true
    },
    {
      "id": "absent-coverage-empty-roster-rejected",
      "description": "An omitted disclosure never means undisclosed, so an empty roster stays invalid.",
      "overrides": { "publisher_properties": [] },
      "valid": false
    },
    {
      "id": "explicit-complete",
      "overrides": { "property_coverage": { "disclosure": "complete" } },
      "valid": true
    },
    {
      "id": "complete-empty-roster-rejected",
      "overrides": { "property_coverage": { "disclosure": "complete" }, "publisher_properties": [] },
      "valid": false
    },
    {
      "id": "partial-with-known-properties",
      "description": "partial lists the properties the seller knows about; the list is not a delivery boundary.",
      "overrides": { "property_coverage": { "disclosure": "partial" } },
      "valid": true
    },
    {
      "id": "partial-empty-roster-rejected",
      "description": "A partial roster with no known property is undisclosed.",
      "overrides": { "property_coverage": { "disclosure": "partial" }, "publisher_properties": [] },
      "valid": false
    },
    {
      "id": "partial-with-inclusion-targeting",
      "description": "Inclusion targeting over the listed properties is expressible on a partial product.",
      "overrides": {
        "property_coverage": { "disclosure": "partial" },
        "property_targeting_allowed": true,
        "overlay_support": { "property_list": true }
      },
      "valid": true,
      "schemas": ["/schemas/core/product.json"]
    },
    {
      "id": "undisclosed-empty-roster",
      "overrides": { "property_coverage": { "disclosure": "undisclosed" }, "publisher_properties": [] },
      "valid": true
    },
    {
      "id": "undisclosed-exclusion-only",
      "description": "Exclusion stays expressible through overlay_support.property_list_exclude; disclosure and targetability are orthogonal.",
      "overrides": {
        "property_coverage": { "disclosure": "undisclosed" },
        "publisher_properties": [],
        "overlay_support": { "property_list_exclude": true }
      },
      "valid": true
    },
    {
      "id": "undisclosed-explicit-no-inclusion-targeting",
      "overrides": {
        "property_coverage": { "disclosure": "undisclosed" },
        "publisher_properties": [],
        "property_targeting_allowed": false
      },
      "valid": true,
      "schemas": ["/schemas/core/product.json"]
    },
    {
      "id": "undisclosed-with-listed-property-rejected",
      "description": "A seller that lists any property is partial, not undisclosed.",
      "overrides": { "property_coverage": { "disclosure": "undisclosed" } },
      "valid": false
    },
    {
      "id": "undisclosed-inclusion-targeting-rejected",
      "description": "Undisclosed products cannot offer inclusion targeting over properties they do not name.",
      "overrides": {
        "property_coverage": { "disclosure": "undisclosed" },
        "publisher_properties": [],
        "property_targeting_allowed": true
      },
      "valid": false,
      "schemas": ["/schemas/core/product.json"]
    },
    {
      "id": "undisclosed-inclusion-overlay-rejected",
      "description": "overlay_support.property_list promises inclusion targeting and is invalid on an undisclosed product.",
      "overrides": {
        "property_coverage": { "disclosure": "undisclosed" },
        "publisher_properties": [],
        "overlay_support": { "property_list": true }
      },
      "valid": false
    },
    {
      "id": "unknown-disclosure-rejected",
      "overrides": { "property_coverage": { "disclosure": "opaque" } },
      "valid": false
    },
    {
      "id": "coverage-missing-disclosure-rejected",
      "overrides": { "property_coverage": {} },
      "valid": false
    }
  ]
}
