{
  "version": 1,
  "name": "Delegation chains for demand-side grants",
  "specification": "https://adcontextprotocol.org/docs/building/by-layer/L2/accounts-and-agents#grants-in-trust-records-experimental",
  "description": "Cross-SDK vectors for the delegation-chain rule in L2 Grants in trust records, which is experimental in 3.3 (adcontextprotocol/adcp#8118, P7). Each vector gives an acts-for claim and the trust records that each registrable domain publishes, and the seller's expected outcome. `input.brand` is `account.brand`. `input.parent_organization` is the parent organization that brand.json resolves, or null for a standalone brand. `input.signer.operator` is the signer's operator, and `input.signer.origin` is the signer's canonical origin. `input.trust_records` maps each registrable domain to the `grants` and `exclusive_grants` of its trust.json; a domain that is absent publishes no grants. All domains are registrable domains already, so no Public Suffix List lookup is needed, and every record is fetched. `expected.outcome` is one of `implicit`, `authorized`, `grant_absent`, or `seller_discretion`. When no delegation chain covers the claim, the outcome is `grant_absent` if the parent organization's record sets `exclusive_grants: true`, and `seller_discretion` otherwise: the seller's own onboarding records decide. An `authorized` outcome gives the `effective` scopes, countries (null is global), and window (null is unbounded). Look up vectors by `id`; `description` prose may change.",
  "vectors": [
    {
      "id": "parent-grants-signer-operator",
      "description": "The parent organization grants the agency, and the agency operates the account and signs with its own agent.",
      "input": {
        "brand": {
          "domain": "nova-motors.example",
          "brand_id": "nova_motors",
          "countries": [
            "US"
          ]
        },
        "parent_organization": "nova-holdings.example",
        "account_operator": "pinnacle-agency.example",
        "signer": {
          "operator": "pinnacle-agency.example",
          "origin": "https://buyer.pinnacle-agency.example"
        },
        "trust_records": {
          "nova-holdings.example": {
            "grants": [
              {
                "grantee": "pinnacle-agency.example",
                "scopes": [
                  "adcp:media_buying"
                ],
                "profiles": {
                  "adcp": {
                    "brands": [
                      "nova_motors"
                    ]
                  }
                },
                "valid_until": "2027-06-30T00:00:00Z"
              }
            ],
            "exclusive_grants": true
          }
        },
        "check_time": "2026-10-24T12:00:00Z",
        "scope": "adcp:media_buying"
      },
      "expected": {
        "outcome": "authorized",
        "effective": {
          "scopes": [
            "adcp:media_buying"
          ],
          "countries": null,
          "valid_from": null,
          "valid_until": "2027-06-30T00:00:00Z"
        }
      }
    },
