  "vectors": [
    {
      "id": "compatible_counts_sum_and_incompatible_populations_refuse",
      "issue_example": 1,
      "description": "Outbound-click values from different media buys sum. Outbound clicks and all clicks are different populations and never share an aggregate.",
      "cases": [
        {
          "id": "outbound_clicks_across_buys",
          "operation": "combine",
          "contributions": [
            {
              "metric": "outbound_clicks",
              "value": 100,
              "finality": "official"
            },
            {
              "metric": "outbound_clicks",
              "value": 50,
              "finality": "official"
            }
          ],
          "expected": {
            "result": "aggregated",
            "value": 150
          }
        },
        {
          "id": "equal_comparability_under_different_names",
          "operation": "combine",
          "contributions": [
            {
              "metric": "outbound_clicks",
              "value": 100,
              "finality": "official"
            },
            {
              "metric": "outbound_clicks_by_site",
              "value": 40,
              "finality": "official"
            }
          ],
          "expected": {
            "result": "aggregated",
            "value": 140
          }
        },
        {
          "id": "outbound_clicks_with_all_clicks",
          "operation": "combine",
          "contributions": [
            {
              "metric": "outbound_clicks",
              "value": 100,
              "finality": "official"
            },
            {
              "metric": "clicks",
              "value": 400,
              "finality": "official"
            }
          ],
          "expected": {
            "result": "refused",
            "reason": "incompatible_comparability",
            "differing": [
              "population"
            ]
          }
        },
        {
          "id": "spend_in_different_currencies",
          "operation": "combine",
          "contributions": [
            {
              "metric": "spend",
              "value": 10,
              "finality": "official"
            },
            {
              "metric": "spend_eur",
              "value": 8,
              "finality": "official"
            }
          ],
          "expected": {
            "result": "refused",
            "reason": "incompatible_comparability",
            "differing": [
              "unit"
            ]
          }
        },
        {
          "id": "values_from_different_report_definitions",
          "operation": "combine",
          "contributions": [
            {
              "metric": "outbound_clicks",
              "value": 100,
              "finality": "official",
              "report_definition_sha256": "1111111111111111111111111111111111111111111111111111111111111111"
            },
            {
              "metric": "outbound_clicks",
              "value": 50,
              "finality": "official",
              "report_definition_sha256": "2222222222222222222222222222222222222222222222222222222222222222"
            }
          ],
          "expected": {
            "result": "refused",
            "reason": "different_report_definition"
          }
        }
      ]
    },
    {
      "id": "ratio_recomputed_from_summed_operands",
      "issue_example": 2,
      "description": "CTR is recomputed from summed clicks and impressions. Row CTR values are never averaged.",
      "cases": [
        {
          "id": "ctr_recomputed",
          "operation": "recompute_ratio",
          "metric": "ctr",
          "rows": [
            {
              "finality": "official",
              "values": {
                "clicks": 10,
                "impressions": 1000
              },
              "reported": {
                "ctr": 0.01
              }
            },
            {
              "finality": "official",
              "values": {
                "clicks": 90,
                "impressions": 4000
              },
              "reported": {
                "ctr": 0.0225
              }
            }
          ],
          "expected": {
            "result": "aggregated",
            "value": 0.02,
            "not_value": [
              0.01625,
              0.0325
            ]
          }
        },
        {
          "id": "cpm_applies_multiplier",
          "operation": "recompute_ratio",
          "metric": "cpm",
          "rows": [
            {
              "finality": "official",
              "values": {
                "spend": 5,
                "impressions": 2000
              }
            },
            {
              "finality": "official",
              "values": {
                "spend": 7.5,
                "impressions": 3000
              }
            }
          ],
          "expected": {
            "result": "aggregated",
            "value": 2.5
          }
        },
        {
          "id": "ctr_zero_denominator_null",
          "operation": "recompute_ratio",
          "metric": "ctr",
          "rows": [
            {
              "finality": "official",
              "values": {
                "clicks": 0,
                "impressions": 0
              }
            }
          ],
          "expected": {
            "result": "aggregated",
            "value": null
          }
        },
        {
          "id": "cpm_zero_denominator_zero",
          "operation": "recompute_ratio",
          "metric": "cpm",
          "rows": [
            {
              "finality": "official",
              "values": {
                "spend": 0,
                "impressions": 0
              }
            }
          ],
          "expected": {
            "result": "aggregated",
            "value": 0
          }
        },
        {
          "id": "cpc_zero_denominator_omitted",
          "operation": "recompute_ratio",
          "metric": "cpc",
          "rows": [
            {
              "finality": "official",
              "values": {
                "spend": 4,
                "clicks": 0
              }
            }
          ],
          "expected": {
            "result": "not_computable"
          }
        },
        {
          "id": "missing_operand",
          "operation": "recompute_ratio",
          "metric": "ctr",
          "rows": [
            {
              "finality": "official",
              "values": {
                "clicks": 10,
                "impressions": null
              }
            },
            {
              "finality": "official",
              "values": {
                "clicks": 90,
                "impressions": 4000
              }
            }
          ],
          "expected": {
            "result": "not_computable"
          }
        },
        {
          "id": "cumulative_additive_is_invalid",
          "operation": "validate_definition",
          "override": {
            "metrics": [
              {
                "name": "impressions",
                "source_expression": "impressions",
                "aggregation": "sum",
                "unit": "impressions",
                "aggregation_semantics": {
                  "kind": "additive",
                  "comparability": {
                    "population": "served_ad_events:v1",
                    "window_basis": "cumulative"
                  }
                }
              }
            ]
          },
          "expected": {
            "valid": false
          }
        }
      ]
    },
    {
      "id": "unique_values_require_pinned_dedup_identity",
      "issue_example": 3,
      "description": "Cross-buy reach is a bound unless the seller emits a value for a revision covering the union of the constituents under a metric with the same unique_unit, deduplication_identity, and comparability. A bound never feeds frequency.",
      "cases": [
        {
          "id": "no_dedup_evidence",
          "operation": "aggregate_unique",
          "metric": "reach",
          "constituents": [
            {
              "media_buy_ids": [
                "buy_a"
              ],
              "value": 400000
            },
            {
              "media_buy_ids": [
                "buy_b"
              ],
              "value": 350000
            }
          ],
          "combined": null,
          "expected": {
            "result": "bound",
            "bound": "sum_of_constituent_reach",
            "value": 750000,
            "may_feed_frequency": false
          }
        },
        {
          "id": "pinned_compatible_identity",
          "operation": "aggregate_unique",
          "metric": "reach",
          "constituents": [
            {
              "media_buy_ids": [
                "buy_a"
              ],
              "value": 400000
            },
            {
              "media_buy_ids": [
                "buy_b"
              ],
              "value": 350000
            }
          ],
          "combined": {
            "union_report_definition": "seller_graph_v3",
            "metric": "reach",
            "media_buy_ids": [
              "buy_a",
              "buy_b"
            ],
            "value": 620000
          },
          "expected": {
            "result": "unique",
            "value": 620000,
            "may_feed_frequency": true
          }
        },
        {
          "id": "incompatible_identity",
          "operation": "aggregate_unique",
          "metric": "reach",
          "constituents": [
            {
              "media_buy_ids": [
                "buy_a"
              ],
              "value": 400000
            },
            {
              "media_buy_ids": [
                "buy_b"
              ],
              "value": 350000
            }
          ],
          "combined": {
            "union_report_definition": "seller_graph_v2",
            "metric": "reach",
            "media_buy_ids": [
              "buy_a",
              "buy_b"
            ],
            "value": 620000
          },
          "expected": {
            "result": "bound",
            "bound": "sum_of_constituent_reach",
            "value": 750000,
            "may_feed_frequency": false
          }
        },
        {
          "id": "combined_value_does_not_cover_union",
          "operation": "aggregate_unique",
          "metric": "reach",
          "constituents": [
            {
              "media_buy_ids": [
                "buy_a"
              ],
              "value": 400000
            },
            {
              "media_buy_ids": [
                "buy_b"
              ],
              "value": 350000
            }
          ],
          "combined": {
            "union_report_definition": "seller_graph_v3",
            "metric": "reach",
            "media_buy_ids": [
              "buy_a"
            ],
            "value": 400000
          },
          "expected": {
            "result": "bound",
            "bound": "sum_of_constituent_reach",
            "value": 750000,
            "may_feed_frequency": false
          }
        },
        {
          "id": "consumer_may_not_sum_uniques",
          "operation": "combine",
          "contributions": [
            {
              "metric": "reach",
              "value": 400000,
              "finality": "official"
            },
            {
              "metric": "reach",
              "value": 350000,
              "finality": "official"
            }
          ],
          "expected": {
            "result": "refused",
            "reason": "non_additive_unique"
          }
        },
        {
          "id": "unique_unit_custom_is_invalid",
          "operation": "validate_definition",
          "override": {
            "metrics": [
              {
                "name": "reach",
                "source_expression": "x",
                "aggregation": "custom",
                "unit": "audience",
                "aggregation_semantics": {
                  "kind": "non_additive_unique",
                  "unique_unit": "custom",
                  "deduplication_identity": "seller_graph:v3",
                  "comparability": {
                    "population": "served_ad_events:v1",
                    "window_basis": "cumulative"
                  }
                }
              }
            ]
          },
          "expected": {
            "valid": false
          }
        }
      ]
    },
    {
      "id": "snapshot_and_official_are_separate_partitions",
      "issue_example": 4,
      "description": "A provisional snapshot value and an official value of the same metric never occupy one aggregate; each finality is aggregated in its own partition.",
      "cases": [
        {
          "id": "official_with_official",
          "operation": "combine",
          "contributions": [
            {
              "metric": "impressions",
              "value": 1000,
              "finality": "official"
            },
            {
              "metric": "impressions",
              "value": 2000,
              "finality": "official"
            }
          ],
          "expected": {
            "result": "aggregated",
            "value": 3000
          }
        },
        {
          "id": "snapshot_with_official",
          "operation": "combine",
          "contributions": [
            {
              "metric": "impressions",
              "value": 1000,
              "finality": "snapshot"
            },
            {
              "metric": "impressions",
              "value": 2000,
              "finality": "official"
            }
          ],
          "expected": {
            "result": "partitioned",
            "partitions": [
              {
                "finality": "snapshot",
                "value": 1000
              },
              {
                "finality": "official",
                "value": 2000
              }
            ]
          }
        },
        {
          "id": "ratio_operands_split_by_finality",
          "operation": "recompute_ratio",
          "metric": "ctr",
          "rows": [
            {
              "finality": "snapshot",
              "values": {
                "clicks": 10,
                "impressions": 1000
              }
            },
            {
              "finality": "official",
              "values": {
                "clicks": 90,
                "impressions": 4000
              }
            }
          ],
          "expected": {
            "result": "partitioned",
            "partitions": [
              {
                "finality": "snapshot",
                "value": 0.01
              },
              {
                "finality": "official",
                "value": 0.0225
              }
            ]
          }
        }
      ]
    },
    {
      "id": "attribution_windows_are_not_comparable",
