{
  "fixture_version": "1.0",
  "description": "Executable vectors for report-definition metric aggregation_semantics (contract_version 1.2). Each vector applies its cases to the shared report_definition. Operations: combine (additive and legacy values), recompute_ratio, aggregate_unique, validate_definition. Numeric results are compared with an absolute tolerance of 1e-9. Consumers MUST reproduce every expected result.",
  "report_definition": {
    "contract_version": "1.2",
    "media_type": "application/vnd.adcp.reporting-definition+json",
    "report_definition_id": "aggregation-v1",
    "reporting_profile": "aggregation-v1",
    "grain": "media-buy-day",
    "source": {
      "provider": {
        "domain": "seller.example.net"
      },
      "system": "fixture",
      "api_version": "1",
      "query_semantics": {}
    },
    "calendar": {
      "timezone_basis": "utc"
    },
    "metrics": [
      {
        "name": "impressions",
        "source_expression": "impressions",
        "aggregation": "sum",
        "aggregation_semantics": {
          "kind": "additive",
          "comparability": {
            "population": "served_ad_events:v1",
            "window_basis": "report_period"
          }
        },
        "unit": "impressions"
      },
      {
        "name": "spend",
        "source_expression": "spend",
        "aggregation": "sum",
        "aggregation_semantics": {
          "kind": "additive",
          "comparability": {
            "population": "billable_spend:v1",
            "window_basis": "report_period"
          }
        },
        "unit": "USD"
      },
      {
        "name": "spend_eur",
        "source_expression": "spend_eur",
        "aggregation": "sum",
        "aggregation_semantics": {
          "kind": "additive",
          "comparability": {
            "population": "billable_spend:v1",
            "window_basis": "report_period"
          }
        },
        "unit": "EUR"
      },
      {
        "name": "clicks",
        "source_expression": "all_clicks",
        "aggregation": "sum",
        "aggregation_semantics": {
          "kind": "additive",
          "comparability": {
            "population": "all_click_events:v1",
            "window_basis": "report_period"
          }
        },
        "unit": "clicks"
      },
      {
        "name": "outbound_clicks",
        "source_expression": "outbound_clicks",
        "aggregation": "sum",
        "aggregation_semantics": {
          "kind": "additive",
          "comparability": {
            "population": "outbound_click_events:v1",
