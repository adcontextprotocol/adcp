      {
        "name": "outbound_clicks_by_site",
        "source_expression": "outbound_clicks_by_site",
        "aggregation": "sum",
        "aggregation_semantics": {
          "kind": "additive",
          "comparability": {
            "population": "outbound_click_events:v1",
            "window_basis": "report_period"
          }
        },
        "unit": "clicks"
      },
      {
        "name": "conversions_7d_click",
        "source_expression": "conversions_7d_click",
        "aggregation": "sum",
        "aggregation_semantics": {
          "kind": "additive",
          "comparability": {
            "population": "attributed_conversions:v1",
            "window_basis": "report_period",
            "qualifier": {
              "attribution_window": {
                "interval": 7,
                "unit": "days"
              }
            }
          }
        },
        "unit": "conversions"
      },
      {
        "name": "conversions_28d_click",
        "source_expression": "conversions_28d_click",
        "aggregation": "sum",
        "aggregation_semantics": {
          "kind": "additive",
          "comparability": {
            "population": "attributed_conversions:v1",
            "window_basis": "report_period",
            "qualifier": {
              "attribution_window": {
                "interval": 28,
                "unit": "days"
              }
            }
          }
        },
        "unit": "conversions"
      },
      {
        "name": "ctr",
        "source_expression": "clicks / impressions",
        "aggregation": "ratio",
        "aggregation_semantics": {
          "kind": "recomputable_ratio",
          "numerator_metric": "clicks",
          "denominator_metric": "impressions",
          "zero_denominator": "null"
        },
        "unit": "ratio"
      },
      {
        "name": "cpm",
        "source_expression": "spend / impressions * 1000",
        "aggregation": "ratio",
        "aggregation_semantics": {
          "kind": "recomputable_ratio",
          "numerator_metric": "spend",
          "denominator_metric": "impressions",
          "zero_denominator": "zero",
          "multiplier": 1000
        },
        "unit": "USD"
      },
      {
        "name": "cpc",
        "source_expression": "spend / clicks",
        "aggregation": "ratio",
        "aggregation_semantics": {
          "kind": "recomputable_ratio",
          "numerator_metric": "spend",
          "denominator_metric": "clicks",
          "zero_denominator": "omitted"
        },
        "unit": "USD"
      },
      {
        "name": "reach",
        "source_expression": "count_distinct(person_id)",
        "aggregation": "custom",
        "aggregation_semantics": {
          "kind": "non_additive_unique",
          "unique_unit": "individuals",
          "deduplication_identity": "seller_graph:v3",
          "comparability": {
            "population": "served_ad_events:v1",
            "window_basis": "cumulative"
          }
        },
        "unit": "individuals"
      },
      {
        "name": "quality_score",
        "source_expression": "model_quality_score",
        "aggregation": "custom",
        "aggregation_semantics": {
          "kind": "opaque",
          "reason": "Proprietary score with no defined combination rule."
        }
      },
      {
        "name": "legacy_clicks",
        "source_expression": "clicks",
        "aggregation": "sum",
        "unit": "clicks"
      }
    ],
    "dimensions": [
