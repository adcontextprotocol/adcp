{
  "description": "Cross-version translation between consecutive AdCP minor releases (DR-0032, DR-0033): request down-conversion and response up-conversion on the client, response down-conversion on the server, release negotiation, and one-to-one account-key reduction.",
  "reference_implementation": "@adcp/sdk (adcontextprotocol/adcp-client#3372, #3376)",
  "version_pair": [
    "3.2",
    "3.1"
  ],
  "cases": [
    {
      "id": "create_media_buy-bid-amount-moves",
      "side": "client",
      "direction": "request_down",
      "tool": "create_media_buy",
      "from_version": "3.2",
      "to_version": "3.1",
      "note": "A media-buy bid_amount default is inherited as package bid_price; a package bid_amount moves to its own bid_price. Labels and rotation hints drop.",
      "input": {
        "idempotency_key": "vt-create-media-buy-0001",
        "account": {
          "brand": {
            "domain": "acme.example"
          },
          "operator": "pinnacle-media.example"
        },
        "brand": {
          "domain": "acme.example"
        },
        "start_time": "asap",
        "end_time": "2027-01-31T23:59:59Z",
        "packages": [
          {
            "product_id": "prod_1",
            "pricing_option_id": "po_1",
            "budget": 1000,
            "creative_assignments": [
              {
                "creative_id": "cr_1",
                "rotation_mode": "even"
              }
            ]
          },
          {
            "product_id": "prod_2",
            "pricing_option_id": "po_2",
            "budget": 500,
            "bidding": {
              "bid_amount": 9
            }
          }
        ],
        "name": "Q1 launch",
        "bidding": {
          "bid_amount": 4.5
        }
      },
      "expect": {
        "outcome": "converted",
        "output": {
          "idempotency_key": "vt-create-media-buy-0001",
          "account": {
            "brand": {
              "domain": "acme.example"
            },
            "operator": "pinnacle-media.example"
          },
          "brand": {
            "domain": "acme.example"
          },
          "start_time": "asap",
          "end_time": "2027-01-31T23:59:59Z",
          "packages": [
            {
              "product_id": "prod_1",
              "pricing_option_id": "po_1",
              "budget": 1000,
              "creative_assignments": [
                {
                  "creative_id": "cr_1"
                }
              ],
              "bid_price": 4.5
            },
            {
              "product_id": "prod_2",
              "pricing_option_id": "po_2",
              "budget": 500,
              "bid_price": 9
            }
          ]
        },
        "dropped": [
          "packages[0].creative_assignments[0].rotation_mode",
          "name"
        ],
        "moved": [
          {
            "from": "bidding",
            "to": "packages[0].bid_price"
          },
          {
            "from": "packages[1].bidding",
            "to": "packages[1].bid_price"
          }
        ]
      }
    },
