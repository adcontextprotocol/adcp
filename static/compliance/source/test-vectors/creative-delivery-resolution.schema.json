{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "creative-delivery-resolution.schema.json",
  "title": "Creative delivery resolution vectors",
  "type": "object",
  "properties": {
    "vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "source": { "$ref": "/schemas/core/creative-source.json" },
          "target": {
            "type": "object",
            "properties": {
              "format_kind": { "type": "string" },
              "supported_delivery_variants": {
                "type": "array",
                "items": { "type": "string" }
              },
              "vast_versions": {
                "type": "array",
                "items": { "$ref": "/schemas/enums/vast-version.json" }
              }
            },
            "required": ["format_kind"],
            "additionalProperties": true
          },
          "seller": {
            "type": "object",
            "properties": {
              "vast_versions": {
                "type": "array",
                "items": { "$ref": "/schemas/enums/vast-version.json" }
              }
            },
            "additionalProperties": true
          },
          "strategy": { "type": "string", "enum": ["source_order", "highest_compatible_vast"] },
          "expected": {
            "type": "object",
            "properties": {
              "selected_variant_id": { "type": ["string", "null"] },
              "compatible_variant_ids": { "type": "array", "items": { "type": "string" } },
              "retained_variant_ids": { "type": "array", "items": { "type": "string" } },
              "rejections": {
                "type": "array",
                "items": { "$ref": "/schemas/core/delivery-variant-rejection.json" }
              }
            },
            "required": ["selected_variant_id", "compatible_variant_ids", "retained_variant_ids", "rejections"]
          }
        },
        "required": ["name", "source", "target", "seller", "strategy", "expected"]
      }
    }
  },
  "required": ["vectors"]
}
