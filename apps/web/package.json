{
  "name": "adcp-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.4",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "ladle": "ladle serve",
    "ladle:build": "ladle build",
    "router:generate": "tsr generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check . --error-on-warnings && npm run lint:dependencies",
    "lint:fix": "biome check . --write",
    "format": "biome format . --write",
    "typecheck": "tsc -b --noEmit",
    "lint:dependencies": "node scripts/lint-unused-dependencies.js"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.90.10",
    "@tanstack/react-router": "^1.132.47",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "lucide-react": "^0.468.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.74.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.0.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@ladle/react": "^5.1.1",
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/router-cli": "^1.166.40",
    "@tanstack/router-plugin": "^1.132.51",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "@ladle/react": {
      "vite": "^6.4.3"
    }
  },
  "engines": {
    "node": ">=24 <25"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=10.9.4 <12",
      "onFail": "error"
    }
  }
}
