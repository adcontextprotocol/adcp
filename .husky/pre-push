#!/bin/sh

HUSKY_INIT="${XDG_CONFIG_HOME:-$HOME/.config}/husky/init.sh"
[ -f "$HUSKY_INIT" ] && . "$HUSKY_INIT"
[ "${HUSKY-}" = "0" ] && exit 0
export PATH="node_modules/.bin:$PATH"

# Verify version sync before pushing
npm run verify-version-sync

# Catch missing changesets locally before GitHub Actions. CI still runs the
# full Changesets CLI gate; this fast preflight avoids invoking that CLI from
# Git's pre-push environment, where stdin/ref handling is fragile.
BRANCH_NAME=$(git branch --show-current)
case "$BRANCH_NAME" in
  changeset-release/*|forward-merge/*|auto/docs-v*)
    echo "⏭  Release machinery branch — skipping changeset check"
    ;;
  *)
    CHANGESET_BASE="${ADCP_CHANGESET_BASE:-origin/main}"
    if git rev-parse --verify --quiet "$CHANGESET_BASE" >/dev/null; then
      echo "🔍 Checking changeset policy since $CHANGESET_BASE..."
      node scripts/check-changeset-protocol-scope.cjs "$CHANGESET_BASE" || exit 1

      if node scripts/check-changeset-protocol-scope.cjs "$CHANGESET_BASE" --is-status-exempt-maintenance; then
        echo "⏭  Changeset policy maintenance — skipping local changeset presence check"
      elif ! node scripts/check-changeset-protocol-scope.cjs "$CHANGESET_BASE" --has-protocol-scoped-changes; then
        echo "⏭  No protocol release-surface changes — skipping local changeset presence check"
      elif ! git diff --name-only --diff-filter=ACMR "$CHANGESET_BASE"...HEAD -- .changeset |
        grep -Eq '^\.changeset/[^/]+\.md$'; then
        echo "Missing protocol changeset. Add one with 'npx changeset' before pushing."
        echo "Run the full CI-equivalent check with:"
        echo "  npx --yes @changesets/cli@^3.0.0 status --since=$CHANGESET_BASE"
        exit 1
      else
        echo "✅ Protocol changeset present"
      fi
    else
      echo "⏭  $CHANGESET_BASE not found — skipping local changeset check"
    fi
    ;;
esac

# Only run docs validation when docs actually changed on this branch.
# CI (.github/workflows/broken-links.yml) is the authoritative check; this is a
# fast local pre-flight. A11y is skipped locally — add to CI if we want it gated.
UPSTREAM=$(git rev-parse --abbrev-ref --symbolic-full-name @{u} 2>/dev/null || echo "")
RANGE="${UPSTREAM:-origin/main}...HEAD"

DOC_PATHS='^(docs/|dist/docs/|mintlify-docs/|docs\.json|mint\.json|README\.md|server/src/addie/rules/|scripts/check-owned-links\.js|\.markdown-link-check\.json|\.github/workflows/broken-links\.yml)'

CHANGED=$(git diff --name-only "$RANGE" 2>/dev/null || echo "")

STORYBOARD_PATHS='^(server/src/training-agent/|server/src/services/hosted-compliance-version\.ts|server/tests/manual/run-storyboards\.ts|static/compliance/source/|dist/compliance/|scripts/build-compliance\.cjs|scripts/overlay-compliance-cache\.sh|scripts/run-storyboards-matrix\.sh|scripts/run-storyboards-3-0-compat\.sh|package\.json|package-lock\.json)'

# The storyboard matrix is a local advisory pre-flight; the
# training-agent-storyboards.yml workflow is the authoritative gate. It runs
# the training agent from the working tree, so it only grades the pushed ref
# when the tree is clean. With uncommitted changes it would grade something
# other than what is being pushed, so skip it and say so (#7478).
if echo "$CHANGED" | grep -Eq "$STORYBOARD_PATHS"; then
  if [ "${ADCP_SKIP_STORYBOARD_MATRIX:-}" = "1" ]; then
    echo "⏭  ADCP_SKIP_STORYBOARD_MATRIX=1 — skipping local storyboard matrix (CI is authoritative)"
  elif [ -n "$(git status --porcelain --untracked-files=no 2>/dev/null)" ]; then
    echo "⏭  Working tree has uncommitted changes — skipping local storyboard matrix."
    echo "   The matrix grades the working tree, not the pushed ref; CI (training-agent-storyboards.yml) is authoritative."
    echo "   Commit or stash to run it against HEAD, or run: bash scripts/run-storyboards-matrix.sh"
  else
    echo "🔍 Training-agent or compliance source changed — running storyboard matrix (~3min, advisory; CI is authoritative)..."
    bash scripts/run-storyboards-matrix.sh || exit 1
    echo "🔍 Verifying 3.0 storyboard compatibility..."
    bash scripts/run-storyboards-3-0-compat.sh || exit 1
  fi
else
  echo "⏭  No training-agent or compliance changes — skipping storyboard matrix"
fi

if echo "$CHANGED" | grep -Eq "$DOC_PATHS"; then
  echo "🔍 Docs changed — checking schema link convention..."
  npm run lint:schema-links --silent || exit 1

  echo "🔍 Docs changed — validating Mintlify navigation..."
  node tests/docs-nav-validation.test.cjs || exit 1
  echo "✅ Docs validation passed"
else
  echo "⏭  No docs changes — skipping Mintlify checks"
fi
