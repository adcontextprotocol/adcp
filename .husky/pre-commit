#!/bin/sh

HUSKY_INIT="${XDG_CONFIG_HOME:-$HOME/.config}/husky/init.sh"
[ -f "$HUSKY_INIT" ] && . "$HUSKY_INIT"
[ "${HUSKY-}" = "0" ] && exit 0
export PATH="node_modules/.bin:$PATH"

# Runs the image check (advisory) and the leaves of `npm run precommit`,
# concurrently where they are independent; see scripts/profile-precommit.mjs.
# Each run's logs and reports go to .hook-runs/<stamp>-hook/.
# Opt-in: ADCP_PRECOMMIT_PROFILE=1 profiles the same run (CPU, memory,
# per-file timings); the commit passes or fails the same way.
if [ -n "${ADCP_PRECOMMIT_PROFILE-}" ]; then
  exec node scripts/profile-precommit.mjs run --as-hook
fi

exec node scripts/profile-precommit.mjs hook
