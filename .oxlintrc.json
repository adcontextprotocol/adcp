{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/refs/tags/oxlint_v1.94.0/npm/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "off"
  },
  "ignorePatterns": [
    "dist/**",
    "**/node_modules/**",
    "server/public/assets/**",
    "server/public/vendor/**",
    "tests/fixtures/**"
  ],
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "vars": "all",
        "args": "after-used",
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrors": "none",
        "destructuredArrayIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ],
    "no-useless-assignment": "error",
    "no-constant-condition": "error",
    "no-unexpected-multiline": "error"
  }
}
