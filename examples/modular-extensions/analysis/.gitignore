# analysis/run_all.sh writes intermediate files next to the outputs this directory ships.
# Only the shipped outputs are tracked; everything else a run writes stays out of git.
__pycache__/
schema-graph/raw/*
!schema-graph/raw/placement.json
kernel-cut/raw/*
!kernel-cut/raw/placement2.json
!kernel-cut/raw/layers.json
!kernel-cut/raw/dag2.json
!kernel-cut/raw/caps2.json
