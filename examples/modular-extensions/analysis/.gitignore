churn/raw/agg-cut-29-error-codes-registry/*
!churn/raw/agg-cut-29/report.md
!churn/raw/agg-cut-29/summary.json
!churn/raw/agg-cut-29/release_modules.csv
!churn/raw/agg-cut-29/kernel_nonadditive.csv
!churn/raw/agg-cut-29-error-codes-registry/report.md
!churn/raw/agg-cut-29-error-codes-registry/summary.json
!churn/raw/agg-cut-29-error-codes-registry/release_modules.csv
module-cut/raw/*
!module-cut/raw/comparison.md
!module-cut/raw/sweeps.json
!module-cut/raw/metrics-*.json
!module-cut/raw/buying-delivery/
!module-cut/raw/agg-buying-delivery/
module-cut/raw/buying-delivery/*
module-cut/raw/agg-buying-delivery/*
!module-cut/raw/buying-delivery/placement.json
!module-cut/raw/buying-delivery/layers.json
!module-cut/raw/buying-delivery/dag.json
