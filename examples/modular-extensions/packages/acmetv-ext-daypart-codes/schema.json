{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AcmeTV Daypart Codes Extension",
  "definitions": {
    "DaypartCodes": {
      "title": "Daypart Codes",
      "type": "object",
      "properties": {
        "dayparts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "code": { "type": "string", "pattern": "^[A-Z]{2}[0-9]$" },
              "label": { "type": "string" },
              "start": { "type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$" },
              "end": { "type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$" }
            },
            "required": ["code", "start", "end"],
            "additionalProperties": false
          }
        }
      },
      "required": ["dayparts"],
      "additionalProperties": false
    }
  }
}
